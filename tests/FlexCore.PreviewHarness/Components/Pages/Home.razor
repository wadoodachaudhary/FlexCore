@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Live program preview</PageTitle>

<h1>Live program preview</h1>
<p class="note">The windows are real programs on this server. Clicks and keystrokes in a GUI window are delivered to that process. The web window is the same server, shown in the page and openable in its own tab.</p>

<ConverterShell EnableRunPreview="true"
                Mode="ConverterShellMode.RunPreview"
                AutoMode="false"
                ShowInstructions="false"
                OwnerKey="harness-user"
                SourcePreview="@_source"
                TargetPreview="@_target"
                SourcePreviewLabel="Source"
                TargetPreviewLabel="Target"
                AutoStartPreview="true"
                SourceKinds="@_kinds"
                TargetKinds="@_kinds"
                SourceKindId="source"
                TargetKindId="target"
                FooterText="Run / Preview keeps the programs on the server." />

<ProgramPreviewGroup GroupLabel="GUI, console, and web"
                     OwnerKey="harness-user"
                     AutoStart="true"
                     Items="@_group" />

@code {
    private static readonly IReadOnlyList<ConverterKind> _kinds =
    [
        new() { Id = "source", Label = "Source program" },
        new() { Id = "target", Label = "Target program" }
    ];

    private readonly ProgramLaunch _source = Launch("source_form.py");
    private readonly ProgramLaunch _target = Launch("target_form.py");
    private readonly IReadOnlyList<ProgramPreviewPane> _group =
    [
        new() { Label = "GUI", Chrome = ProgramPreviewChrome.Windows, Icon = "W", Launch = Launch("source_form.py") },
        new()
        {
            Label = "Console",
            Chrome = ProgramPreviewChrome.Fusion,
            Icon = "Qt",
            Launch = new ProgramLaunch
            {
                FileName = "python3",
                Arguments = ["-c", "print('console-ready', flush=True); input()"],
                Kind = ProgramPreviewKind.Console
            }
        },
        new() { Label = "Web", Chrome = ProgramPreviewChrome.Browser, Icon = "B", Launch = WebLaunch() }
    ];

    private static ProgramLaunch WebLaunch() => new()
    {
        FileName = "python3",
        Arguments = [Path.Combine(AppContext.BaseDirectory, "Fixtures", "Preview", "web_ok.py"), "{port}"],
        WorkingDirectory = AppContext.BaseDirectory,
        Kind = ProgramPreviewKind.Web
    };

    private static ProgramLaunch Launch(string script) => new()
    {
        FileName = "python3",
        Arguments = [Path.Combine(AppContext.BaseDirectory, "Fixtures", "Preview", script)],
        WorkingDirectory = AppContext.BaseDirectory,
        Kind = ProgramPreviewKind.Gui
    };
}
