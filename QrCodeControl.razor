@namespace Fx.ControlKit
@inherits FlexControlBase

<div class="fx-qrcode @CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (ErrorMessage is not null)
    {
        <span class="fx-qrcode-error" role="alert">@ErrorMessage</span>
    }
    else if (_matrix is not null)
    {
        <svg viewBox="0 0 @_matrix.Width @_matrix.Height" width="@Size" height="@Size"
             shape-rendering="crispEdges" role="img" aria-label="@(AriaLabel ?? $"QR code: {Value}")">
            <rect width="@_matrix.Width" height="@_matrix.Height" fill="@BackgroundColor" />
            <path d="@_svgPath" fill="@ForegroundColor" />
        </svg>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "FlexCore";
    [Parameter] public int Size { get; set; } = 150;
    [Parameter] public string ForegroundColor { get; set; } = "#000000";
    [Parameter] public string BackgroundColor { get; set; } = "#ffffff";
    [Parameter] public QrErrorCorrectionLevel ErrorCorrection { get; set; } = QrErrorCorrectionLevel.Medium;
    [Parameter] public string? AriaLabel { get; set; }
    public string? ErrorMessage { get; private set; }

    private ZXing.Common.BitMatrix? _matrix;
    private string _svgPath = "";

    protected override void OnParametersSet()
    {
        _matrix = null;
        _svgPath = "";
        ErrorMessage = null;
        if (string.IsNullOrEmpty(Value)) return;
        try
        {
            var level = ErrorCorrection switch
            {
                QrErrorCorrectionLevel.Low => ZXing.QrCode.Internal.ErrorCorrectionLevel.L,
                QrErrorCorrectionLevel.Medium => ZXing.QrCode.Internal.ErrorCorrectionLevel.M,
                QrErrorCorrectionLevel.Quartile => ZXing.QrCode.Internal.ErrorCorrectionLevel.Q,
                QrErrorCorrectionLevel.High => ZXing.QrCode.Internal.ErrorCorrectionLevel.H,
                _ => throw new ArgumentException("Unsupported QR error correction level.")
            };
            _matrix = new ZXing.MultiFormatWriter().encode(Value, ZXing.BarcodeFormat.QR_CODE, 0, 0,
                new Dictionary<ZXing.EncodeHintType, object>
                {
                    [ZXing.EncodeHintType.CHARACTER_SET] = "UTF-8",
                    [ZXing.EncodeHintType.ERROR_CORRECTION] = level,
                    [ZXing.EncodeHintType.MARGIN] = 4
                });
            var path = new System.Text.StringBuilder();
            for (var y = 0; y < _matrix.Height; y++)
                for (var x = 0; x < _matrix.Width;)
                {
                    if (!_matrix[x, y]) { x++; continue; }
                    var start = x++;
                    while (x < _matrix.Width && _matrix[x, y]) x++;
                    path.Append(System.FormattableString.Invariant($"M{start},{y}h{x - start}v1h{start - x}z "));
                }
            _svgPath = path.ToString();
        }
        catch (Exception ex) when (ex is ArgumentException or ZXing.WriterException)
        {
            ErrorMessage = $"Cannot encode QR code: {ex.Message}";
        }
    }
}
