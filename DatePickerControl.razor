@namespace Fx.ControlKit
@inherits FlexControlBase
@implements IAsyncDisposable
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime

@if (Visible)
{
    <div @ref="_hostElement"
         class="fx-datepicker-host @CssClass" style="@Style" id="@Id" @attributes="AdditionalAttributes"
         @onclick:stopPropagation="true"
         @onmousedown:stopPropagation="true"
         @ondblclick:stopPropagation="true"
         @onkeydown:stopPropagation="true">
        <div class="@InputGroupClass">
            <input type="text"
                   class="fx-datepicker-input"
                   @ref="_inputElement"
                   value="@_inputText"
                   @oninput="OnInputTextChange"
                   @onfocus="HandleInputFocus"
                   @onblur="OnInputBlur"
                   @onkeydown="OnInputKeyDown"
                   @ondblclick="OnInputDoubleClick"
                   tabindex="@(CellHost is null ? null : -1)"
                   placeholder="@ResolvedPlaceholder"
                   aria-label="@AriaLabel"
                   aria-expanded="@(_isOpen ? "true" : "false")"
                   aria-invalid="@(_validationMessage != null ? "true" : null)"
                   disabled="@(!Enabled)" />
            @if (ShowTriggerButton)
            {
                <button type="button"
                        class="fx-datepicker-trigger"
                        tabindex="@(CellHost is not null || _skipCalendarButtonOnNextTab ? -1 : 0)"
                        @onmousedown:preventDefault="true"
                        @onclick="OnTriggerClick"
                        @onfocus="HandleTriggerFocus"
                        @onblur="HandleTriggerBlur"
                        @onkeydown="HandleTriggerKeyDown"
                        @onkeydown:preventDefault="CalendarButtonKeyDown.HasDelegate"
                        disabled="@(!Enabled)"
                        aria-label="Toggle calendar">
                    📅
                </button>
            }
        </div>

        @if (_validationMessage != null)
        {
            <div class="fx-datepicker-validation-pill" role="alert" aria-live="assertive">
                @_validationMessage
            </div>
        }

        @if (_isOpen && Enabled)
        {
            @* The manual popover promotes this wrapper to the browser top layer.
               It remains in Blazor's DOM tree, unlike a body portal, so normal
               render/disposal cleanup remains safe.
               Mouse presses anywhere in the calendar keep focus in the date
               input (the keyboard never loses its place, and a blur while the
               calendar is open can only mean focus went elsewhere — see
               OnInputBlur). ShowTime's embedded time box must take focus, so
               there only the buttons suppress it. *@
            <div @ref="_popupLayerElement"
                 @key="_dropdownOpenKey"
                 popover="manual"
                 class="fx-datepicker-popup-layer">
                <button type="button" class="fx-datepicker-backdrop" tabindex="-1" @onmousedown:preventDefault="true" @onclick="CloseDropdown"></button>

                <CascadingValue TValue="ICellEditorHost" Value="null">
                <div @ref="_dropdownElement"
                     class="fx-datepicker-dropdown @(_expanded && ShowCalendarSidebar ? "expanded" : "minimal")"
                     @onmousedown:preventDefault="@(!ShowTime)">
                <!-- Left Section: Main Calendar -->
                <div class="fx-calendar-main">
                    <button type="button" class="fx-nav-btn fx-nav-prev" @onmousedown:preventDefault="true" @onclick="PrevMonth" title="Previous Month" aria-label="Previous month">◄</button>
                    <button type="button" class="fx-nav-btn fx-nav-next" @onmousedown:preventDefault="true" @onclick="NextMonth" title="Next Month" aria-label="Next month">►</button>

                    @if (ShowCalendarSidebar)
                    {
                        <button type="button" class="fx-expand-btn" @onmousedown:preventDefault="true" @onclick="ToggleExpand" title="Toggle Sidebar">
                            @(_expanded ? "◀" : "▶")
                        </button>
                    }

                    <div class="fx-months-viewport">
                        <div class="fx-calendar-months-grid">
                            @foreach (var monthStart in GetCalendarMonths())
                            {
                                <div class="fx-month-panel">
                                    <div class="fx-month-title">@monthStart.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</div>

                                    <div class="fx-weekdays">
                                        @foreach (var dayName in GetWeekdayNames())
                                        {
                                            <span class="fx-weekday">@dayName</span>
                                        }
                                    </div>

                                    <div class="fx-days-grid">
                                        @foreach (var cellDate in GetDaysInGrid(monthStart))
                                        {
                                            if (!cellDate.HasValue)
                                            {
                                                <span class="fx-day-cell" aria-hidden="true"></span>
                                                continue;
                                            }
                                            var date = cellDate.Value;
                                            var isCurrentMonth = date.Month == monthStart.Month && date.Year == monthStart.Year;
                                            var isSelected = Value.HasValue && date.Date == Value.Value.Date;
                                            var isToday = date.Date == DateTime.Today;
                                            var isDisabled = IsDateDisabled(date);
                                            var isKeyboardFocused = _isOpen && date.Date == _keyboardDate.Date;
                                            var cellClass = string.Join(" ", new[]
                                            {
                                                "fx-day-cell",
                                                isCurrentMonth ? "in-month" : "out-month",
                                                isSelected ? "selected" : "",
                                                isToday ? "today" : "",
                                                isKeyboardFocused ? "keyboard-focused" : "",
                                                isDisabled ? "disabled" : ""
                                            }.Where(c => !string.IsNullOrEmpty(c)));

                                            <button type="button"
                                                    class="@cellClass"
                                                    disabled="@isDisabled"
                                                    tabindex="-1"
                                                    @onmousedown:preventDefault="true"
                                                    @onclick="() => SelectDay(date)">
                                                <span class="fx-day-number">@date.Day</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <button type="button" class="fx-today-link" @onmousedown:preventDefault="true" @onclick="() => SelectShortcut(DateTime.Today)">
                        Today: @TodayText
                    </button>

                    <!-- Optional Time Picker -->
                    @if (ShowTime)
                    {
                        <div class="fx-time-picker">
                            <span class="fx-time-label">Time:</span>
                            <TimePickerControl Value="@(new TimeOnly((_hour%12)+(_ampm=="PM"?12:0),_minute))" ValueChanged="SetClockAsync" Enabled="@Enabled" Culture="@EffectiveCulture" AriaLabel="Time" Width="170px" />
                        </div>
                    }
                </div>

                <!-- Right Section: Sidebar (Expanded Mode) -->
                @if (_expanded && ShowCalendarSidebar)
                {
                    <div class="fx-calendar-sidebar">
                        <div class="fx-sidebar-section">
                            <span class="fx-section-title">Shortcuts</span>
                            <div class="fx-shortcuts-grid">
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(DateTime.Today)">Today</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(DateTime.Today.AddDays(-1))">Yesterday</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(DateTime.Today.AddDays(1))">Tomorrow</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(GetStartOfWeek())">Start of Week</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(GetEndOfWeek())">End of Week</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(DateTime.Today.AddDays(7))">Next Week</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1))">Start of Month</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn" @onclick="() => SelectShortcut(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1))">End of Month</button>
                                <button type="button" @onmousedown:preventDefault="true" class="fx-shortcut-btn fx-clear-btn" @onclick="ClearValue">Clear Date</button>
                            </div>
                        </div>

                        <!-- Quick Month Grid -->
                        <div class="fx-sidebar-section">
                            <span class="fx-section-title">Months</span>
                            <div class="fx-months-grid">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var monthIdx = m;
                                    var isCurrent = _viewMonth == monthIdx;
                                    <button type="button"
                                            class="fx-month-btn @(isCurrent ? "active" : "")"
                                            @onmousedown:preventDefault="true"
                                            @onclick="() => SelectMonthShortcut(monthIdx)">
                                        @CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(monthIdx)
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Quick Decade Year Selector -->
                        <div class="fx-sidebar-section">
                            <span class="fx-section-title">Years (@_decadeStart - @(_decadeStart + 11))</span>
                            <div class="fx-decade-header">
                                <button type="button" class="fx-decade-nav" @onmousedown:preventDefault="true" @onclick="PrevDecade">◀</button>
                                <button type="button" class="fx-decade-nav" @onmousedown:preventDefault="true" @onclick="NextDecade">▶</button>
                            </div>
                            <div class="fx-years-grid">
                                @for (int y = _decadeStart; y < _decadeStart + 12; y++)
                                {
                                    var yearVal = y;
                                    var isCurrent = _viewYear == yearVal;
                                    <button type="button"
                                            class="fx-year-btn @(isCurrent ? "active" : "")"
                                            @onmousedown:preventDefault="true"
                                            @onclick="() => SelectYearShortcut(yearVal)">
                                        @yearVal
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
                </div>
                </CascadingValue>
            </div>
        }
    </div>
}

@code {
    public async Task FocusAsync() { try { await _inputElement.FocusAsync(preventScroll: true); } catch { } }
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<DateTime?>>? ValueExpression { get; set; }

    [Parameter] public string? Format { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool ShowTime { get; set; }
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }
    [Parameter] public bool ShowCalendarSidebar { get; set; }
    [Parameter] public IEnumerable<string>? ParseFormats { get; set; }
    [Parameter] public CultureInfo? Culture { get; set; }
    [Parameter] public bool ShowTriggerButton { get; set; } = true;
    [Parameter] public bool OpenCalendarOnDoubleClick { get; set; }

    /// <summary>Focus the date input when the control first renders (an in-cell
    /// editor that has just mounted must take the keyboard). Applied once —
    /// later re-renders never pull focus back.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Open the calendar when this becomes true, once (latched) — the
    /// in-cell-editor contract shared with DropDownListControl: Enter on a date
    /// cell drops the calendar, and a fast second click that raced the editor
    /// swap still opens it. Checked every render, like the dropdown.</summary>
    [Parameter] public bool OpenOnRender { get; set; }
    private bool _autoFocusApplied;
    private bool _openOnRenderLatched;

    /// <summary>Text the input starts with instead of the formatted
    /// <see cref="Value"/>, applied once when the control mounts: an in-cell
    /// editor started by typing a character begins its entry with that
    /// character (vsFlexGrid Editable). It is a draft — Enter, blur or a
    /// navigation key parses it; Escape discards it.</summary>
    [Parameter] public string? InitialText { get; set; }
    private bool _initialTextApplied;

    /// <summary>Set when this control is the editor of a hosted cell (a TreeGrid
    /// cell-edit template): the host decides focus, opening and the Tab stop, takes
    /// the keys the picker does not consume, and is told when the edit ends — the
    /// page wires nothing. Cursor phase: closed, no focus, no Tab stop. Editing
    /// phase: focus on mount; the calendar opens when the host asks AND the value
    /// is blank (typed text is the entry for a filled date); typing that started
    /// the edit seeds the text.</summary>
    [CascadingParameter] private ICellEditorHost? CellHost { get; set; }

    private bool EffectiveAutoFocus => CellHost is null ? AutoFocus : CellHost.IsEditing;
    private bool EffectiveOpenOnRender => CellHost is null
        ? OpenOnRender
        : CellHost.IsEditing && (OpenOnRender || CellHost.OpenOnRender) && string.IsNullOrWhiteSpace(_inputText);
    private string? EffectiveInitialText => InitialText ?? (CellHost is { IsEditing: true } ? CellHost.InitialText : null);

    /// <summary>
    /// The DOM owns the text while typing: the input renders its initial
    /// value ONCE and parent re-renders never reset it (same contract as
    /// TextBoxControl.Uncontrolled — the fix for typed characters being
    /// reverted by mid-edit renders).
    /// </summary>
    [Parameter] public bool Uncontrolled { get; set; }
    [Parameter] public EventCallback<string?> ValidationChanged { get; set; }
    private DateTime? _lastParameterValue;
    private bool _valueInitialized;

    /// <summary>Raw text per keystroke, render-free (an Action, not an
    /// EventCallback) — grid batch editors track the in-progress value here.</summary>
    [Parameter] public Action<string?>? InputValueChanged { get; set; }

    /// <summary>Hands the input element to the host (grid focus handling).</summary>
    [Parameter] public Action<ElementReference>? ElementReferenceCaptured { get; set; }

    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    /// <summary>
    /// Handles keyboard navigation away from the calendar trigger. GridControl
    /// uses this to commit the date editor and continue to the next cell after
    /// the trigger has received its own Tab stop.
    /// </summary>
    [Parameter] public EventCallback<KeyboardEventArgs> CalendarButtonKeyDown { get; set; }

    private string ResolvedFormat => Format ?? (ShowTime ? "MM/dd/yyyy hh:mm tt" : "MM/dd/yyyy");
    private string ResolvedPlaceholder => Placeholder ?? ResolvedFormat;
    private string ViewMonthYearText => new DateTime(_viewYear, _viewMonth, 1).ToString("MMMM yyyy", CultureInfo.CurrentCulture);
    private string TodayText => DateTime.Today.ToString("M/d/yyyy", CultureInfo.InvariantCulture);
    private CultureInfo EffectiveCulture => Culture ?? CultureInfo.InvariantCulture;
    private string InputGroupClass => ShowTriggerButton
        ? "fx-datepicker-input-group"
        : "fx-datepicker-input-group fx-datepicker-input-group-no-trigger";

    private string _inputText = "";
    private string? _validationMessage;
    private bool _uncontrolledInitialized;
    private ElementReference _inputElement;
    private bool _isOpen = false;
    private bool _expanded = false;
    private ElementReference _hostElement;
    private ElementReference _popupLayerElement;
    private ElementReference _dropdownElement;
    private IJSObjectReference? _controlJsModule;
    private int _dropdownOpenKey;
    private bool _focusInputAfterOpen;
    private bool _tabbingToTrigger;
    private bool _skipCalendarButtonOnNextTab;
    private DateTime _keyboardDate = DateTime.Today;

    // View State (what month/year the popup calendar is currently focused on)
    private int _viewMonth = DateTime.Today.Month;
    private int _viewYear = DateTime.Today.Year;

    // Time Selection fields
    private int _hour = 12;
    private int _minute = 0;
    private string _ampm = "AM";

    // Decade state for quick year selector
    private int _decadeStart;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Uncontrolled)
        {
            // Initial value only — a parent re-render must not wipe the text
            // the user is typing.
            if (!_uncontrolledInitialized)
            {
                _uncontrolledInitialized = true;
                _inputText = Value.HasValue ? FormatDate(Value.Value) : "";
            }
        }
        else if (!_valueInitialized || Value != _lastParameterValue)
        {
            _inputText = Value.HasValue ? FormatDate(Value.Value) : "";
            _validationMessage = null;
        }
        _valueInitialized = true;
        _lastParameterValue = Value;
        _decadeStart = (_viewYear / 12) * 12;

        if (!_initialTextApplied)
        {
            _initialTextApplied = true;
            if (EffectiveInitialText is { } initial)
                _inputText = initial;
        }
    }

    protected override void OnInitialized()
    {
        // Registered inside the mount render, before any key can arrive: keys the
        // user presses before this instance has focus reach it through the host.
        if (CellHost is { IsEditing: true })
            CellHost.AttachKeyRelay(RelayHostKeyAsync);
    }

    private async Task RelayHostKeyAsync(KeyboardEventArgs e)
    {
        if (!e.AltKey && !e.CtrlKey && !e.MetaKey && e.Key is { Length: 1 } && !char.IsControl(e.Key[0]))
        {
            // The input is not focused yet (the text would otherwise have gone
            // straight into it), so a re-render carrying the new text is safe.
            var wasOpen = _isOpen;
            if (wasOpen)
            {
                // Typing switches to text entry (the OnInputTextChange rule): with the
                // calendar open, Enter / Space would pick the highlighted DAY over the
                // typed text. The open path had claimed the autofocus for its own
                // focus step, which is gated on the calendar being open — re-arm it.
                CloseDropdown();
                _focusInputAfterOpen = false;
                _autoFocusApplied = false;
            }
            // Once the input exists in the browser the character is appended THERE
            // (its input event carries it back): a key the user types into the
            // freshly focused input in the same instant is then kept in DOM order
            // instead of being overwritten by a render carrying the server's text.
            // Before the first render is acknowledged no focus call is in flight, so
            // the rendered text is safe — and it keeps the typed start's open-on-render
            // rule (non-blank text never summons the calendar).
            if (_rendered && await AppendTypedTextAsync(e.Key))
            {
                if (wasOpen) StateHasChanged();
                return;
            }
            _inputText += e.Key;
            _validationMessage = null;
            InputValueChanged?.Invoke(_inputText);
            StateHasChanged();
            return;
        }
        await OnInputKeyDown(e);
    }

    /// <summary>The picker's own focus step: under a cell host it goes through the host,
    /// which focuses only while it still owns the keyboard.</summary>
    private async Task FocusInputForHostAsync()
    {
        try
        {
            if (CellHost is not null)
                await CellHost.FocusAsync(_inputElement);
            else
                await _inputElement.FocusAsync(preventScroll: true);
        }
        catch { }
    }

    private static string TextJsModulePath =>
        FxJsAsset.Versioned($"./_content/{typeof(DatePickerControl).Assembly.GetName().Name}/textbox-control.js");
    private IJSObjectReference? _textJsModule;
    private bool _rendered;
    // Text appended in the browser whose input event has not come back yet.
    private bool _domAppendPending;

    /// <summary>Appends a relayed character to the browser's input as if typed (the
    /// TextBox's appendTypedText); false when the browser cannot be reached.</summary>
    private async Task<bool> AppendTypedTextAsync(string text)
    {
        try
        {
            _textJsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", TextJsModulePath);
            await _textJsModule.InvokeVoidAsync("appendTypedText", _inputElement, text);
            _domAppendPending = true;
            return true;
        }
        catch { return false; }
    }

    /// <summary>A commit or row key arriving while an appended character's input event
    /// is still in flight would act on a draft missing that character: read the input
    /// back first (the read is ordered after the append on the same connection).</summary>
    private async Task SyncInputTextFromDomAsync()
    {
        _domAppendPending = false;
        if (_textJsModule is null) return;
        try
        {
            var text = await _textJsModule.InvokeAsync<string?>("getTextValue", _inputElement);
            if (text is not null && text != _inputText)
            {
                _inputText = text;
                _validationMessage = null;
                InputValueChanged?.Invoke(_inputText);
            }
        }
        catch { }
    }

    /// <summary>Keys this control does not consume: the explicit handler first, then
    /// the cell host (both, never either/or).</summary>
    private async Task ForwardKeyAsync(KeyboardEventArgs e)
    {
        if (OnKeyDown.HasDelegate)
            await OnKeyDown.InvokeAsync(e);
        if (CellHost is not null)
            await CellHost.KeyDownAsync(e);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _rendered = true;
            ElementReferenceCaptured?.Invoke(_inputElement);
        }

        if (EffectiveOpenOnRender && !_openOnRenderLatched && Enabled)
        {
            _openOnRenderLatched = true;
            _autoFocusApplied = true;   // opening focuses the input itself
            OpenDropdown();
            StateHasChanged();
            return;
        }

        if (EffectiveAutoFocus && !_autoFocusApplied && Enabled)
        {
            _autoFocusApplied = true;
            await FocusInputForHostAsync();
        }

        if (_isOpen && Enabled)
        {
            if (_focusInputAfterOpen)
            {
                _focusInputAfterOpen = false;
                await FocusInputForHostAsync();
            }
            await PositionDropdownAsync();
        }
    }

    private static string ControlJsModulePath =>
        FxJsAsset.Versioned($"./_content/{typeof(DatePickerControl).Assembly.GetName().Name}/grid-control.js");

    private async Task PositionDropdownAsync()
    {
        try
        {
            _controlJsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", ControlJsModulePath);
            await _controlJsModule.InvokeVoidAsync(
                "positionDatePickerDropdown",
                _hostElement,
                _dropdownElement,
                _popupLayerElement);
        }
        catch
        {
            // CSS absolute positioning remains as the no-JS fallback.
        }
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString(ResolvedFormat, EffectiveCulture);
    }

    private void ToggleDropdown()
    {
        if (_isOpen)
        {
            CloseDropdown();
        }
        else
        {
            OpenDropdown();
        }
    }

    /// <summary>Mouse on the 📅 trigger. Under a cell host the press never moves
    /// focus (the trigger is no Tab stop and its mousedown is suppressed), so no blur
    /// commits a typed draft: commit it here before the calendar seeds its highlight
    /// from <see cref="Value"/> — otherwise it opens on the stale date and Enter /
    /// Space picks that over the typed text. An invalid draft keeps its message and
    /// opens nothing. Without a host the click only toggles, as before: a grid batch
    /// editor tracks its draft itself, and parsing here would raise ValueChanged into
    /// its commit and unmount it before the calendar opened.</summary>
    private async Task OnTriggerClick()
    {
        if (!Enabled) return;
        if (CellHost is not null && !_isOpen && _inputText != (Value.HasValue ? FormatDate(Value.Value) : ""))
        {
            await ParseInputText(true);
            if (_validationMessage != null)
                return;
        }
        ToggleDropdown();
    }

    private void OpenDropdown()
    {
        _skipCalendarButtonOnNextTab = false;
        _expanded = false;
        _dropdownOpenKey++;
        _isOpen = true;
        _focusInputAfterOpen = true;
        var focusDate = ClampKeyboardDate(Value ?? DateTime.Today);
        _keyboardDate = focusDate.Date;
        _viewMonth = focusDate.Month;
        _viewYear = focusDate.Year;
        _decadeStart = (_viewYear / 12) * 12;

        if (ShowTime)
        {
            InitializeTime(focusDate);
        }
    }

    private void CloseDropdown()
    {
        _isOpen = false;
    }

    private void ToggleExpand()
    {
        _expanded = !_expanded;
    }

    private async Task OnInputTextChange(ChangeEventArgs e)
    {
        _skipCalendarButtonOnNextTab = false;
        _domAppendPending = false;
        // Typing switches to text entry: with the calendar still open, Enter and
        // Space would pick the highlighted DAY instead of the typed date.
        if (_isOpen)
            CloseDropdown();
        _inputText = e.Value?.ToString() ?? "";
        _validationMessage = null;
        InputValueChanged?.Invoke(_inputText);
        if (ValidationChanged.HasDelegate) await ValidationChanged.InvokeAsync(DraftError());
    }

    private async Task OnInputBlur()
    {
        // Focus left the control with the calendar open (a page-level Tab, a
        // programmatic move — presses inside the calendar never blur the input):
        // close it and commit the typed text, rather than leave an orphaned
        // popup behind. ShowTime's time box takes focus legitimately.
        if (_isOpen && !ShowTime)
        {
            CloseDropdown();
            await ParseInputText(true);
            CellHost?.EndEdit();
            return;
        }

        if (_isOpen || _tabbingToTrigger || _skipCalendarButtonOnNextTab)
            return;

        await ParseInputText(true);
        // Focus left a hosted editor (a page-level Tab, a click elsewhere): the
        // edit is over. The host only takes the keyboard back when focus was lost.
        CellHost?.EndEdit();
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (_domAppendPending && e.Key is "Enter" or "NumpadEnter" or "Tab")
            await SyncInputTextFromDomAsync();

        // Tab is about to land on this control's own 📅 button (the next Tab stop):
        // the blur that follows must not commit yet. Under a cell host the button is
        // no Tab stop (tabindex -1) — Tab leaves the tree and the blur commits.
        if (CellHost is null
            && Enabled
            && ShowTriggerButton
            && !_isOpen
            && !_skipCalendarButtonOnNextTab
            && e.Key == "Tab"
            && !e.ShiftKey)
        {
            _tabbingToTrigger = true;
            return;
        }

        _tabbingToTrigger = false;

        if (Enabled && (string.Equals(e.Key, "F4", StringComparison.OrdinalIgnoreCase)
            || (e.AltKey && e.Key == "ArrowDown")))
        {
            ToggleDropdown();
            return;
        }

        if (_isOpen)
        {
            switch (e.Key)
            {
                case "ArrowLeft":
                    MoveKeyboardDateByDays(-1);
                    return;
                case "ArrowRight":
                    MoveKeyboardDateByDays(1);
                    return;
                case "ArrowUp":
                    MoveKeyboardDateByDays(-7);
                    return;
                case "ArrowDown":
                    MoveKeyboardDateByDays(7);
                    return;
                case "PageUp":
                    MoveKeyboardDateByMonths(e.ShiftKey ? -12 : -1);
                    return;
                case "PageDown":
                    MoveKeyboardDateByMonths(e.ShiftKey ? 12 : 1);
                    return;
                case "Home":
                    MoveKeyboardDateByDays(-(int)_keyboardDate.DayOfWeek);
                    return;
                case "End":
                    MoveKeyboardDateByDays(6 - (int)_keyboardDate.DayOfWeek);
                    return;
                case "Enter":
                case "NumpadEnter":
                case " ":
                case "Spacebar":
                    await SelectDay(_keyboardDate);
                    return;
                case "Escape":
                    CloseDropdown();
                    return;
                case "Tab":
                    CloseDropdown();
                    break;
            }
        }

        if (e.Key is "Enter" or "NumpadEnter")
        {
            // Owner spec (2026-08-16): typed text commits on Enter; Enter on a
            // BLANK field summons the calendar instead, when the calendar is a
            // visible option. The 2026-09-07 FlexCore sync dropped this, so Enter
            // on an empty date never opened anything. The key is consumed — a
            // host must not also treat it as "done".
            if (ShowTriggerButton && Enabled && string.IsNullOrWhiteSpace(_inputText))
            {
                OpenDropdown();
                return;
            }
            await ParseInputText(true);
            _skipCalendarButtonOnNextTab = _validationMessage == null;
            // Invalid text stays for correction (VB6 ValidateEdit Cancel): a host
            // that treats Enter as "done" must not close over it and drop it.
            if (_validationMessage != null)
                return;
        }
        else if (e.Key == "Escape")
        {
            CloseDropdown();
            // Under a cell host Escape cancels the edit (vsFlexGrid): the draft reverts
            // to the value, so a later blur re-parses the same value and commits
            // nothing. A form field keeps its typed text, as before.
            if (CellHost is not null)
            {
                _inputText = Value.HasValue ? FormatDate(Value.Value) : "";
                _validationMessage = null;
                InputValueChanged?.Invoke(_inputText);
                if (ValidationChanged.HasDelegate) await ValidationChanged.InvokeAsync(null);
            }
        }
        else if (CellHost is not null && !e.AltKey && !e.CtrlKey && !e.MetaKey
                 && e.Key is "ArrowUp" or "Up" or "ArrowDown" or "Down" or "ArrowLeft" or "Left" or "ArrowRight" or "Right")
        {
            // A hosted date editor keeps its caret keys (owner 2026-09-11): Left / Right
            // never leave the text, Up / Down are its start / end. Only Tab, Enter and
            // Escape reach the host. (A grid editor — no host, OnKeyDown wired — is
            // untouched: its own path commits and moves.)
            return;
        }
        else if (e.Key == "Tab" && CellHost is not null && !e.AltKey && !e.CtrlKey && !e.MetaKey)
        {
            // Tab moves rows (vsFlexGrid TabBehavior=1) and the host unmounts this
            // control: commit the draft first. Invalid text keeps the editor with its
            // message showing (VB6 ValidateEdit Cancel).
            await ParseInputText(true);
            if (_validationMessage != null)
                return;
        }

        await ForwardKeyAsync(e);
    }

    private void HandleTriggerFocus()
    {
        _tabbingToTrigger = false;
    }

    private void HandleInputFocus()
    {
        _skipCalendarButtonOnNextTab = false;
    }

    private async Task HandleTriggerBlur()
    {
        if (!_isOpen && !CalendarButtonKeyDown.HasDelegate)
            await ParseInputText(true);
    }

    private async Task HandleTriggerKeyDown(KeyboardEventArgs e)
    {
        if (!Enabled)
            return;

        var isActivationKey = e.Key is "Enter" or "NumpadEnter" or " " or "Spacebar";
        if (isActivationKey)
        {
            if (CalendarButtonKeyDown.HasDelegate)
                ToggleDropdown();
            return;
        }

        if (string.Equals(e.Key, "F4", StringComparison.OrdinalIgnoreCase)
            || (e.AltKey && e.Key == "ArrowDown"))
        {
            ToggleDropdown();
            return;
        }

        if (e.Key == "Escape" && _isOpen)
        {
            CloseDropdown();
            try { await _inputElement.FocusAsync(preventScroll: true); } catch { }
            return;
        }

        if (e.Key != "Tab" || !CalendarButtonKeyDown.HasDelegate)
            return;

        if (e.ShiftKey)
        {
            try { await _inputElement.FocusAsync(preventScroll: true); } catch { }
            return;
        }

        await CalendarButtonKeyDown.InvokeAsync(e);
    }

    private void OnInputDoubleClick()
    {
        if (OpenCalendarOnDoubleClick && Enabled)
            OpenDropdown();
    }

    private async Task ParseInputText(bool formatIfValid)
    {
        if (string.IsNullOrWhiteSpace(_inputText))
        {
            _validationMessage = null;
            await UpdateValue(null);
            return;
        }

        var formats = GetParseFormats();

        if (DateTime.TryParseExact(_inputText.Trim(), formats, EffectiveCulture, DateTimeStyles.AllowWhiteSpaces, out var parsed))
        {
            _validationMessage = null;
            await UpdateValue(parsed);
            if (formatIfValid)
            {
                _inputText = FormatDate(parsed);
            }
        }
        else if (DateTime.TryParse(_inputText.Trim(), EffectiveCulture, DateTimeStyles.AllowWhiteSpaces, out var parsedFallback)
                 || DateTime.TryParse(_inputText.Trim(), CultureInfo.CurrentCulture, DateTimeStyles.AllowWhiteSpaces, out parsedFallback)
                 || DateTime.TryParse(_inputText.Trim(), CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out parsedFallback))
        {
            _validationMessage = null;
            await UpdateValue(parsedFallback);
            if (formatIfValid)
            {
                _inputText = FormatDate(parsedFallback);
            }
        }
        else
        {
            _validationMessage = ShowTime
                ? "Enter a valid date and time."
                : "Invalid date. Use MM/DD/YYYY, MMDDYYYY, or MMDDYY.";
            await ValidationChanged.InvokeAsync(_validationMessage);
            // Keep the invalid text visible so the user can correct it.
        }
    }

    private string? DraftError()
    {
        if (string.IsNullOrWhiteSpace(_inputText)) return null;
        return DateTime.TryParseExact(_inputText.Trim(), GetParseFormats(), EffectiveCulture, DateTimeStyles.AllowWhiteSpaces, out _)
            || DateTime.TryParse(_inputText.Trim(), EffectiveCulture, DateTimeStyles.AllowWhiteSpaces, out _)
            || DateTime.TryParse(_inputText.Trim(), CultureInfo.CurrentCulture, DateTimeStyles.AllowWhiteSpaces, out _)
            || DateTime.TryParse(_inputText.Trim(), CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out _) ? null : "Enter a valid date.";
    }

    private string[] GetParseFormats()
    {
        var defaults = ShowTime
            ? new[]
            {
                ResolvedFormat, "MM/dd/yyyy hh:mm tt", "M/d/yyyy h:mm tt",
                "MM/dd/yyyy HH:mm", "M/d/yyyy H:mm", "yyyy-MM-dd HH:mm",
                "yyyy-MM-ddTHH:mm", "yyyy-MM-dd hh:mm tt", "MM/dd/yyyy",
                "M/d/yyyy", "yyyy-MM-dd", "dd-MMM-yy", "d-MMM-yy",
                "dd-MMM-yyyy", "d-MMM-yyyy", "dd/MM/yyyy HH:mm",
                "d/M/yyyy H:mm", "dd/MM/yyyy", "d/M/yyyy"
            }
            : new[]
            {
                ResolvedFormat, "MM/dd/yyyy", "M/d/yyyy", "yyyy-MM-dd",
                "MM-dd-yyyy", "M-d-yyyy", "MMM d, yyyy", "MMMM d, yyyy",
                "dd-MMM-yy", "d-MMM-yy", "dd-MMM-yyyy", "d-MMM-yyyy",
                "dd/MM/yyyy", "d/M/yyyy", "yyyyMMdd", "MMddyyyy", "MMddyy"
            };

        return (ParseFormats ?? Array.Empty<string>())
            .Concat(defaults)
            .Where(format => !string.IsNullOrWhiteSpace(format))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private async Task UpdateValue(DateTime? newValue)
    {
        _validationMessage = null;
        if (newValue.HasValue)
        {
            if (MinDate.HasValue && newValue < MinDate.Value)
                newValue = MinDate.Value;
            if (MaxDate.HasValue && newValue > MaxDate.Value)
                newValue = MaxDate.Value;
        }

        await ValidationChanged.InvokeAsync(null);
        _lastParameterValue = newValue;
        var changed = Value != newValue;
        Value = newValue;
        _inputText = newValue.HasValue ? FormatDate(newValue.Value) : "";

        if (changed && ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
    }

    // --- Calendar Nav ---
    private void PrevMonth()
    {
        if (_viewYear == 1 && _viewMonth == 1)
            return;
        if (_viewMonth == 1)
        {
            _viewMonth = 12;
            _viewYear--;
        }
        else
        {
            _viewMonth--;
        }
        _decadeStart = (_viewYear / 12) * 12;
    }

    private void NextMonth()
    {
        if (_viewYear == 9999 && _viewMonth == 12)
            return;
        if (_viewMonth == 12)
        {
            _viewMonth = 1;
            _viewYear++;
        }
        else
        {
            _viewMonth++;
        }
        _decadeStart = (_viewYear / 12) * 12;
    }

    private void OnViewMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            _viewMonth = m;
        }
    }

    private void OnViewYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y))
        {
            _viewYear = y;
            _decadeStart = (_viewYear / 12) * 12;
        }
    }

    // --- Days Generation ---
    private string[] GetWeekdayNames()
    {
        return new[] { "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa" };
    }

    private IEnumerable<DateTime> GetCalendarMonths()
    {
        yield return new DateTime(_viewYear, _viewMonth, 1);
    }

    private IReadOnlyList<DateTime?> GetDaysInGrid(DateTime monthStart) => CalendarDateMath.DaysForMonth(monthStart, DayOfWeek.Sunday);

    private bool IsDateDisabled(DateTime date)
    {
        if (MinDate.HasValue && date.Date < MinDate.Value.Date) return true;
        if (MaxDate.HasValue && date.Date > MaxDate.Value.Date) return true;
        return false;
    }

    private DateTime ClampKeyboardDate(DateTime date)
    {
        var clamped = date.Date;
        if (MinDate.HasValue && clamped < MinDate.Value.Date)
            clamped = MinDate.Value.Date;
        if (MaxDate.HasValue && clamped > MaxDate.Value.Date)
            clamped = MaxDate.Value.Date;
        return clamped;
    }

    private void MoveKeyboardDateByDays(int days)
    {
        var ticks = Math.Clamp(_keyboardDate.Ticks + (long)days * TimeSpan.TicksPerDay,
            DateTime.MinValue.Ticks, DateTime.MaxValue.Date.Ticks);
        SetKeyboardDate(new DateTime(ticks));
    }

    private void MoveKeyboardDateByMonths(int months)
    {
        var targetMonth = (_keyboardDate.Year - 1) * 12 + _keyboardDate.Month - 1 + months;
        if (targetMonth < 0 || targetMonth >= 9999 * 12)
            return;
        SetKeyboardDate(_keyboardDate.AddMonths(months));
    }

    private void SetKeyboardDate(DateTime date)
    {
        _keyboardDate = ClampKeyboardDate(date);
        _viewMonth = _keyboardDate.Month;
        _viewYear = _keyboardDate.Year;
        _decadeStart = (_viewYear / 12) * 12;
    }

    private async Task SelectDay(DateTime date)
    {
        if (ShowTime)
        {
            int h = _hour % 12;
            if (_ampm == "PM") h += 12;
            date = new DateTime(date.Year, date.Month, date.Day, h, _minute, 0);
        }
        else
        {
            date = date.Date;
        }

        await UpdateValue(date);
        CloseDropdown();
        CellHost?.EndEdit();
    }

    private async Task ClearValue()
    {
        await UpdateValue(null);
        CloseDropdown();
        CellHost?.EndEdit();
    }

    // --- Time Picker Handlers ---
    private void InitializeTime(DateTime dt)
    {
        _hour = dt.Hour % 12;
        if (_hour == 0) _hour = 12;
        _minute = dt.Minute;
        _ampm = dt.Hour >= 12 ? "PM" : "AM";
    }

    private async Task SetClockAsync(TimeOnly? value)
    {
        if(value==null)return;
        _hour=value.Value.Hour%12; if(_hour==0)_hour=12;
        _minute=value.Value.Minute;_ampm=value.Value.Hour>=12?"PM":"AM";
        await UpdateTimeOnValue();
    }

    private async Task OnHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var h))
        {
            _hour = h;
            await UpdateTimeOnValue();
        }
    }

    private async Task OnMinuteChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            _minute = m;
            await UpdateTimeOnValue();
        }
    }

    private async Task OnAmPmChanged(ChangeEventArgs e)
    {
        _ampm = e.Value?.ToString() ?? "AM";
        await UpdateTimeOnValue();
    }

    private async Task UpdateTimeOnValue()
    {
        if (Value.HasValue)
        {
            var date = Value.Value;
            int h = _hour % 12;
            if (_ampm == "PM") h += 12;
            var updated = new DateTime(date.Year, date.Month, date.Day, h, _minute, 0);
            await UpdateValue(updated);
        }
    }

    // --- Sidebar Shortcuts ---
    private async Task SelectShortcut(DateTime? date)
    {
        if (date.HasValue)
        {
            var d = date.Value;
            if (ShowTime)
            {
                int h = _hour % 12;
                if (_ampm == "PM") h += 12;
                d = new DateTime(d.Year, d.Month, d.Day, h, _minute, 0);
            }
            await UpdateValue(d);
            _viewMonth = d.Month;
            _viewYear = d.Year;
            _decadeStart = (_viewYear / 12) * 12;
        }
        else
        {
            await UpdateValue(null);
        }
        CloseDropdown();
        CellHost?.EndEdit();
    }

    private void SelectMonthShortcut(int month)
    {
        _viewMonth = month;
    }

    private void SelectYearShortcut(int year)
    {
        _viewYear = year;
        _decadeStart = (_viewYear / 12) * 12;
    }

    private void PrevDecade()
    {
        _decadeStart -= 12;
    }

    private void NextDecade()
    {
        _decadeStart += 12;
    }

    private DateTime GetStartOfWeek()
    {
        var today = DateTime.Today;
        return today.AddDays(-(int)today.DayOfWeek);
    }

    private DateTime GetEndOfWeek()
    {
        var today = DateTime.Today;
        return today.AddDays(6 - (int)today.DayOfWeek);
    }

    public async ValueTask DisposeAsync()
    {
        CellHost?.AttachKeyRelay(null);
        if (_controlJsModule != null)
        {
            try
            {
                await _controlJsModule.DisposeAsync();
            }
            catch
            {
                // Best-effort cleanup.
            }
        }
        if (_textJsModule != null)
        {
            try { await _textJsModule.DisposeAsync(); } catch { }
        }
    }
}
