@namespace Fx.ControlKit
@inherits FlexControlBase

<div class="fx-slider-host @(Disabled ? "fx-slider-disabled" : "") @CssClass" style="@Style">
    <input type="range"
           class="fx-slider-range"
           min="@Min"
           max="@Max"
           step="@Step"
           value="@Value"
           disabled="@Disabled"
           @oninput="HandleInput"
           @onchange="HandleChange"
           @attributes="AdditionalAttributes" />
    @if (ShowValue)
    {
        <span class="fx-slider-value">@Value</span>
    }
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool ShowValue { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;

    private async Task HandleInput(ChangeEventArgs e)
    {
        if (Disabled) return;
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            Value = val;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(val);
            }
        }
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (Disabled) return;
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            Value = val;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(val);
            }
        }
    }
}
