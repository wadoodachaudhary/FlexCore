@namespace Fx.ControlKit
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Visible)
{
    <CascadingValue Value="@ContentFocusScope" IsFixed="true">
    <CascadingValue Value="@_defaultButtonScope" IsFixed="true">
    <div class="@OverlayCssClass"
         @onclick="HandleOverlayClick"
         @onmousedown="@(CloseOnOverlayClick ? EventCallback.Factory.Create<MouseEventArgs>(this, HandleOverlayPress) : default)"
         @onmousemove="HandleOverlayMouseMove"
         @onmouseup="e => HandleOverlayMouseUp(e, true)"
         @onmouseleave="e => HandleOverlayMouseUp(e, false)"
         tabindex="0"
         @onkeydown="HandleKeyDown">
        <div class="@DialogCssClass" style="@DialogStyle" role="dialog" aria-modal="@(IsModal ? "true" : null)"
             data-fx-dialog-enter="@(OnEnter.HasDelegate ? "true" : null)"
             aria-label="@AriaLabel" aria-labelledby="@(string.IsNullOrWhiteSpace(AriaLabel) && !string.IsNullOrWhiteSpace(Header) ? _titleId : null)"
             aria-describedby="@AriaDescribedBy" tabindex="-1" @ref="_dialogElement" @onclick:stopPropagation="true"
             @onmousedown="@(CloseOnOverlayClick ? EventCallback.Factory.Create<MouseEventArgs>(this, HandleDialogPress) : default)"
             @onmouseup="@(CloseOnOverlayClick ? EventCallback.Factory.Create<MouseEventArgs>(this, HandleDialogRelease) : default)">
            <div class="fx-dialog-header"
                 @onmousedown="HandleDragStart"
                 @onmousedown:preventDefault="true"
                 @onmousedown:stopPropagation="true"
                 @oncontextmenu="HandleHeaderContextMenu"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">
                @if (ShowWindowIcon)
                {
                    <button class="fx-dialog-window-icon"
                            type="button"
                            title="Window menu"
                            aria-label="Window menu"
                            @onmousedown:preventDefault="true"
                            @onmousedown:stopPropagation="true"
                            @onclick="HandleWindowIconClick"
                            @onclick:stopPropagation="true"></button>
                }
                <span id="@_titleId" class="fx-dialog-title">@Header</span>
                @if (ShowCloseIcon)
                {
                    <button class="fx-dialog-close"
                            type="button"
                            title="Close"
                            aria-label="Close"
                            @onmousedown:stopPropagation="true"
                            @onclick="HandleClose">×</button>
                }
            </div>
            <div class="fx-dialog-body">
                @ChildContent
            </div>
            @if (FooterContent != null)
            {
                <div class="fx-dialog-footer">
                    @FooterContent
                </div>
            }
            @if (Resizable)
            {
                <span class="fx-dialog-resize-handle fx-dialog-resize-n" @onmousedown='e => HandleResizeStart("n", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
                <span class="fx-dialog-resize-handle fx-dialog-resize-e" @onmousedown='e => HandleResizeStart("e", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
                <span class="fx-dialog-resize-handle fx-dialog-resize-s" @onmousedown='e => HandleResizeStart("s", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
                <span class="fx-dialog-resize-handle fx-dialog-resize-w" @onmousedown='e => HandleResizeStart("w", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
                <span class="fx-dialog-resize-handle fx-dialog-resize-ne" @onmousedown='e => HandleResizeStart("ne", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
                <span class="fx-dialog-resize-handle fx-dialog-resize-se" @onmousedown='e => HandleResizeStart("se", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
                <span class="fx-dialog-resize-handle fx-dialog-resize-sw" @onmousedown='e => HandleResizeStart("sw", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
                <span class="fx-dialog-resize-handle fx-dialog-resize-nw" @onmousedown='e => HandleResizeStart("nw", e)' @onmousedown:preventDefault="true" @onmousedown:stopPropagation="true"></span>
            }
        </div>
        @if (_systemMenuVisible)
        {
            <div class="fx-dialog-system-menu-backdrop"
                 @onclick="CloseSystemMenu"
                 @onclick:stopPropagation="true"
                 @oncontextmenu="CloseSystemMenu"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true"></div>
            <div class="fx-dialog-system-menu"
                 style="@SystemMenuStyle"
                 role="menu"
                 @onclick:stopPropagation="true"
                 @oncontextmenu:stopPropagation="true">
                <button type="button" role="menuitem" disabled>Restore</button>
                <button type="button" role="menuitem" disabled="@(!Draggable)" @onclick="HandleSystemMenuMove">Move</button>
                <button type="button" role="menuitem" disabled>Size</button>
                <button type="button" role="menuitem" disabled>Minimize</button>
                <button type="button" role="menuitem" disabled>Maximize</button>
                <span class="fx-dialog-system-menu-separator"></span>
                <button type="button" role="menuitem" class="fx-dialog-system-menu-close" @onclick="HandleSystemMenuClose">
                    <span class="fx-dialog-system-menu-close-label">
                        <span class="fx-dialog-system-menu-close-icon" aria-hidden="true">×</span>
                        <span>Close</span>
                    </span>
                    <span>Alt+F4</span>
                </button>
            </div>
        }
    </div>
    </CascadingValue>
    </CascadingValue>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public DialogPosition? Position { get; set; }
    [Parameter] public EventCallback<DialogPosition> PositionChanged { get; set; }
    private DialogPosition? _lastPosition;

    /// <summary>
    /// Focus the first focusable control in the dialog when it opens, so
    /// keyboard input goes to the popup instead of the window under it.
    /// </summary>
    [Parameter] public bool AutoFocus { get; set; } = true;
    private readonly string _titleId = $"fx-dialog-title-{Guid.NewGuid():N}";
    [Parameter] public string? Header { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? AriaDescribedBy { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }
    [Parameter] public bool IsModal { get; set; } = true;
    [Parameter] public bool ShowCloseIcon { get; set; } = true;
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>
    /// When set, Escape invokes this instead of the <see cref="OnClose"/>
    /// path — for dialogs whose ✕/close COMMITS while Escape must CANCEL.
    /// </summary>
    [Parameter] public EventCallback OnEscape { get; set; }

    /// <summary>
    /// The dialog's default button (VB6 CommandButton.Default = True): a plain Enter anywhere in the
    /// dialog invokes this, after the focused control has handled the key, so a value it commits on
    /// Enter lands first. Enter is left to the control on buttons and links (Enter presses them), in
    /// multi-line editors, grids, tree grids and tabs, on an open dropdown, in a nested dialog, and
    /// inside any element marked <c>data-fx-enter-owner</c>. A control that keeps the key itself (a date
    /// it cannot parse, say) vetoes it through the cascaded <see cref="DefaultButtonScope"/>. Point it at
    /// the default button's handler, and have that handler do nothing while the button is disabled.
    /// </summary>
    [Parameter] public EventCallback OnEnter { get; set; }

    private readonly DefaultButtonScope _defaultButtonScope = new();
    private bool _enterRunning;

    /// <summary>Ctrl+Enter requests close (the OnClose path) — the keyboard
    /// "OK" for dialogs whose close commits.</summary>
    [Parameter] public bool CloseOnCtrlEnter { get; set; }
    [Parameter] public bool CloseOnOverlayClick { get; set; }
    [Parameter] public bool Draggable { get; set; } = true;
    [Parameter] public bool ShowSystemMenu { get; set; } = true;
    [Parameter] public bool ShowWindowIcon { get; set; }
    [Parameter] public bool Resizable { get; set; } = true;
    [Parameter] public double MinResizeWidth { get; set; } = 320;
    [Parameter] public double MinResizeHeight { get; set; } = 160;
    [Parameter] public double MaxResizeWidth { get; set; }
    [Parameter] public double MaxResizeHeight { get; set; }
    [Parameter] public string? CssClass { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<string?> WidthChanged { get; set; }
    [Parameter] public EventCallback<string?> HeightChanged { get; set; }

    private bool _isResizing;
    // A press on the title bar ("move") or a resize handle (its edge) whose box is still being measured:
    // a gesture starts from where the box is painted, which a host rule may have put somewhere other
    // than the stored offset. The pointer keeps moving meanwhile, and may even be released; the last
    // point seen before the release is applied once the box is known. Presses run one after another,
    // so a second press measures the box the first one moved.
    private sealed class GesturePress(string kind, double x, double y, int generation)
    {
        public string Kind { get; } = kind;
        public double X { get; } = x;
        public double Y { get; } = y;
        public int Generation { get; } = generation;
        public double? PendingX { get; set; }
        public double? PendingY { get; set; }
        public bool Released { get; set; }
    }
    private GesturePress? _press;
    private Task _pressChain = Task.CompletedTask;
    private int _openGenerationForPress;
    private double _gestureOffsetBeforeX;
    private double _gestureOffsetBeforeY;
    private bool _resizeChangedWidth;
    private bool _resizeChangedHeight;
    private double? _resizeRuntimeWidthBefore;
    private double? _resizeRuntimeHeightBefore;
    private string? _resizeEdge;
    private double _resizeStartX;
    private double _resizeStartY;
    private double _resizeStartWidth;
    private double _resizeStartHeight;
    private double _resizeStartOffsetX;
    private double _resizeStartOffsetY;
    private double _resizeMinWidth;
    private double _resizeMinHeight;
    private double _resizeMaxWidth;
    private double _resizeMaxHeight;
    // How the overlay places the box on each axis: 0 start, 0.5 centre, 1 end.
    private double _resizeAlignX = 0.5;
    private double _resizeAlignY = 0.5;
    private double? _runtimeWidth;
    private double? _runtimeHeight;
    private bool _suppressNextOverlayClick;
    private bool _isDragging;
    private bool _moveArmed;
    private double _dragStartX;
    private double _dragStartY;
    private double _dragStartOffsetX;
    private double _dragStartOffsetY;
    private double _dialogOffsetX;
    private double _dialogOffsetY;
    private bool _systemMenuVisible;
    private ElementReference _dialogElement;
    private PopupFocusScope? _focusScope;
    private PopupFocusScope ContentFocusScope => _focusScope ??= new PopupFocusScope(AutoFocus);
    private bool _autoFocusApplied;
    private bool _wasVisibleForFocus;
    private bool _openerCaptured;

    private async Task CaptureOpenerEarlyAsync()
    {
        try { await _focusModule!.InvokeVoidAsync("captureFocus"); }
        catch { /* circuit teardown */ }
    }
    private bool _keysRegisteredForShow;
    private DotNetObjectReference<DialogControl>? _selfRef;
    private IJSObjectReference? _focusModule;
    private double _systemMenuX;
    private double _systemMenuY;

    // Versioned per build: the module URL is not fingerprinted by the asset
    // pipeline, so without the cache-buster a browser can keep executing a
    // STALE dialog-control.js forever.
    private string DialogJsModulePath =>
        FxJsAsset.Versioned($"./_content/{GetType().Assembly.GetName().Name}/dialog-control.js");

    private string OverlayCssClass
    {
        get
        {
            var cls = "fx-dialog-overlay";
            if (_isResizing || _press != null || _isDragging)
                cls += " fx-dialog-overlay-resizing";
            if (_isDragging)
                cls += " fx-dialog-overlay-dragging";
            else if (_moveArmed)
                cls += " fx-dialog-overlay-move-armed";
            // Non-modal: the overlay stops dimming and stops intercepting the pointer, so
            // the app behind stays fully interactive (VB6 non-modal .Show). During a drag
            // or resize the -resizing class re-enables pointer capture on the overlay so
            // the mousemove/mouseup handlers (which live on the overlay) keep tracking.
            if (!IsModal)
                cls += " fx-dialog-overlay-nonmodal";
            return cls;
        }
    }

    private string DialogCssClass
    {
        get
        {
            var parts = new List<string> { "fx-dialog" };
            if (Resizable)
                parts.Add("fx-dialog-resizable");
            if (Draggable)
                parts.Add("fx-dialog-draggable");
            if (_isDragging)
                parts.Add("fx-dialog-dragging");
            else if (_moveArmed)
                parts.Add("fx-dialog-move-armed");
            if (_isResizing)
                parts.Add("fx-dialog-resizing");
            if (!string.IsNullOrWhiteSpace(CssClass))
                parts.Add(CssClass);
            return string.Join(" ", parts);
        }
    }

    private string DialogStyle
    {
        get
        {
            var parts = new List<string>();

            if (_runtimeWidth.HasValue)
                parts.Add($"width:{Px(_runtimeWidth.Value)}");
            else if (!string.IsNullOrWhiteSpace(Width))
                parts.Add($"width:{Width}");

            if (_runtimeHeight.HasValue)
                parts.Add($"height:{Px(ClampResize(_runtimeHeight.Value, MinResizeHeight, MaxResizeHeight))}");
            else if (!string.IsNullOrWhiteSpace(Height))
            {
                var heightPixels = TryParsePixelValue(Height);
                parts.Add(heightPixels.HasValue
                    ? $"height:{Px(ClampResize(heightPixels.Value, MinResizeHeight, MaxResizeHeight))}"
                    : $"height:{Height}");
            }

            // A relative shift, not a transform: a transformed box becomes the containing block of every
            // position:fixed popup inside it (menus, dropdown panels, nested dialogs), which would then
            // open displaced by the offset.
            if (_dialogOffsetX != 0 || _dialogOffsetY != 0)
                parts.Add($"position:relative;left:{Px(_dialogOffsetX)};top:{Px(_dialogOffsetY)}");

            return string.Join(";", parts);
        }
    }

    private static string Px(double value) => value.ToString("0.##", CultureInfo.InvariantCulture) + "px";

    private string SystemMenuStyle => $"left:{Px(_systemMenuX)};top:{Px(_systemMenuY)}";

    // A press on a dialog button that slides off onto the backdrop (or the reverse) ends in
    // a click on the overlay, the nearest element containing both points. Only a press AND a
    // release on the backdrop close the dialog; anything else would discard its edits.
    private bool _pressInsideDialog;
    private bool _pressOnBackdrop;
    private bool _releaseInsideDialog;

    private void HandleDialogPress()
    {
        _pressInsideDialog = true;
        _suppressNextRenderOnce = true;
    }

    private void HandleDialogRelease() => _releaseInsideDialog = true;

    // Runs after HandleDialogPress for a press inside the dialog: the event bubbles to the overlay.
    // Only a primary press counts: a right press never clicks, and while the system menu is open
    // its own backdrop takes the click, so either would leave a stale backdrop press behind.
    private void HandleOverlayPress(MouseEventArgs e)
    {
        _pressOnBackdrop = e.Button == 0 && !_pressInsideDialog && !_systemMenuVisible;
        _pressInsideDialog = false;
        _releaseInsideDialog = false;
        _suppressNextOverlayClick = false;
        _suppressNextRenderOnce = true;
    }

    private async Task HandleOverlayClick()
    {
        var backdropClick = _pressOnBackdrop && !_releaseInsideDialog;
        _pressOnBackdrop = false;
        _releaseInsideDialog = false;

        if (_systemMenuVisible)
        {
            _systemMenuVisible = false;
            return;
        }

        if (_suppressNextOverlayClick)
        {
            _suppressNextOverlayClick = false;
            return;
        }

        if (_isResizing)
            return;

        if (!CloseOnOverlayClick || !backdropClick)
            return;

        await RequestClose();
    }

    private async Task HandleClose()
    {
        _systemMenuVisible = false;
        await RequestClose();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_moveArmed && e.Key == "Escape")
        {
            _moveArmed = false;
            return;
        }

        if (e.AltKey && string.Equals(e.Key, "F4", StringComparison.OrdinalIgnoreCase))
        {
            _systemMenuVisible = false;
            await RequestClose();
            return;
        }

        // Escape / Ctrl+Enter are handled by the CAPTURE-phase JS listener
        // (registerDialogKeys) so they work even when the focused control stops
        // keydown propagation — do not double-handle them here.
        if (e.Key == "Escape" || (e.CtrlKey && (e.Key == "Enter" || e.Key == "NumpadEnter")))
            return;

        // Every other key is content typing — this handler fires once per
        // keystroke anywhere in the dialog, and re-rendering the dialog (and
        // its content fragments) per character is what makes popup editors
        // sluggish.
        _suppressNextRenderOnce = true;
    }

    private bool _suppressNextRenderOnce;

    protected override bool ShouldRender()
    {
        if (_suppressNextRenderOnce)
        {
            _suppressNextRenderOnce = false;
            return false;
        }

        return true;
    }

    private Task HandleOverlayMouseMove(MouseEventArgs e)
    {
        if (_press is { } press)
        {
            // Hover after the release is not part of the gesture.
            if (!press.Released)
                (press.PendingX, press.PendingY) = (e.ClientX, e.ClientY);
        }
        else if (_isDragging)
            ApplyDrag(e.ClientX, e.ClientY);
        else if (_isResizing)
            ApplyResize(e.ClientX, e.ClientY);
        return Task.CompletedTask;
    }

    // Also the overlay's mouseleave: the gesture ends where the pointer left.
    private async Task HandleOverlayMouseUp(MouseEventArgs e, bool suppressOverlayClick)
    {
        if (_press is { } press)
        {
            // Released before the box was measured: the press applies this point and finishes itself.
            // The click this release produces arrives before then, so it is suppressed now.
            if (!press.Released)
            {
                (press.PendingX, press.PendingY) = (e.ClientX, e.ClientY);
                press.Released = true;
                if (suppressOverlayClick)
                    _suppressNextOverlayClick = true;
            }
            return;
        }

        if (!_isDragging && !_isResizing)
            return;
        if (_isDragging)
            ApplyDrag(e.ClientX, e.ClientY);
        else
            ApplyResize(e.ClientX, e.ClientY);
        if (suppressOverlayClick)
            _suppressNextOverlayClick = true;
        await FinishGestureAsync();
    }

    private Task HandleDragStart(MouseEventArgs e)
    {
        if (!Draggable || e.Button != 0)
            return Task.CompletedTask;

        _systemMenuVisible = false;
        _moveArmed = false;
        return BeginGestureAsync("move", e);
    }

    // Shared by the title bar and the resize handles. The press takes the pointer at once; it starts
    // after any earlier press has finished.
    private Task BeginGestureAsync(string kind, MouseEventArgs e)
    {
        var press = new GesturePress(kind, e.ClientX, e.ClientY, _openGenerationForPress);
        _press = press;
        var previous = _pressChain;
        var run = RunPressAsync(press, previous);
        _pressChain = run;
        return run;
    }

    private async Task RunPressAsync(GesturePress press, Task previous)
    {
        try { await previous; } catch { /* the earlier press failed on its own */ }

        // A gesture whose release was never seen (released outside the window) ends here, so its host
        // still hears about it, and paints it before this press measures the box.
        if (_isDragging || _isResizing)
        {
            await FinishGestureAsync();
            StateHasChanged();
        }

        double[]? box = null;
        if (Visible && press.Generation == _openGenerationForPress)
        {
            try
            {
                _focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", DialogJsModulePath);
                box = await _focusModule.InvokeAsync<double[]?>("measureDialogBox", _dialogElement);
            }
            catch { /* stale module or circuit teardown: the stored offset and declared size are the fallback */ }
        }

        // The pointer now belongs to this press's gesture, or to a newer press.
        if (_press == press)
            _press = null;
        // Closed, or closed and reopened, while the measurement was out.
        if (!Visible || press.Generation != _openGenerationForPress)
            return;

        var kind = press.Kind;
        var measured = box is { Length: 10 } && box[0] > 0 && box[1] > 0;
        _gestureOffsetBeforeX = _dialogOffsetX;
        _gestureOffsetBeforeY = _dialogOffsetY;
        if (measured)
        {
            _dialogOffsetX = box![8];
            _dialogOffsetY = box[9];
        }

        if (kind == "move")
        {
            _dragStartX = press.X;
            _dragStartY = press.Y;
            _dragStartOffsetX = _dialogOffsetX;
            _dragStartOffsetY = _dialogOffsetY;
            _isDragging = true;
        }
        else
        {
            _resizeEdge = kind;
            _resizeStartX = press.X;
            _resizeStartY = press.Y;
            _resizeStartWidth = measured ? box![0] : ResolveCurrentWidth();
            _resizeStartHeight = measured ? box![1] : ResolveCurrentHeight();
            _resizeStartOffsetX = _dialogOffsetX;
            _resizeStartOffsetY = _dialogOffsetY;
            _resizeMinWidth = Math.Max(MinResizeWidth, measured ? box![2] : 0);
            _resizeMinHeight = Math.Max(MinResizeHeight, measured ? box![3] : 0);
            // CSS lets a minimum win over a smaller maximum; so does the resize.
            _resizeMaxWidth = MinimumWins(TighterLimit(MaxResizeWidth, measured ? box![4] : 0), _resizeMinWidth);
            _resizeMaxHeight = MinimumWins(TighterLimit(MaxResizeHeight, measured ? box![5] : 0), _resizeMinHeight);
            _resizeAlignX = measured ? box![6] : 0.5;
            _resizeAlignY = measured ? box![7] : 0.5;
            _resizeRuntimeWidthBefore = _runtimeWidth;
            _resizeRuntimeHeightBefore = _runtimeHeight;
            _resizeChangedWidth = _resizeChangedHeight = false;
            _isResizing = true;
        }

        if (press.PendingX is { } x && press.PendingY is { } y)
        {
            if (_isDragging) ApplyDrag(x, y);
            else ApplyResize(x, y);
        }
        if (press.Released)
        {
            await FinishGestureAsync();
            StateHasChanged();
        }
    }

    private void ApplyDrag(double clientX, double clientY)
    {
        _dialogOffsetX = _dragStartOffsetX + clientX - _dragStartX;
        _dialogOffsetY = _dragStartOffsetY + clientY - _dragStartY;
    }

    private Task FinishGestureAsync() => _isDragging ? FinishDragAsync() : _isResizing ? FinishResize() : Task.CompletedTask;

    private async Task FinishDragAsync()
    {
        _isDragging = false;
        // _lastPosition stays the host's last Position: a host that does not bind it must not see the
        // moved window snap back on its next render, and one that does bind it gets the new value.
        if (_dialogOffsetX != _gestureOffsetBeforeX || _dialogOffsetY != _gestureOffsetBeforeY)
            await PositionChanged.InvokeAsync(new DialogPosition(_dialogOffsetX, _dialogOffsetY));
    }

    private Task HandleHeaderContextMenu(MouseEventArgs e)
        => OpenSystemMenuAt(e.ClientX, e.ClientY);

    private Task HandleWindowIconClick(MouseEventArgs e)
        => OpenSystemMenuAt(e.ClientX, e.ClientY);

    private Task OpenSystemMenuAt(double x, double y)
    {
        if (!ShowSystemMenu)
            return Task.CompletedTask;

        _systemMenuVisible = true;
        _systemMenuX = x;
        _systemMenuY = y;
        return Task.CompletedTask;
    }

    private Task CloseSystemMenu()
    {
        _systemMenuVisible = false;
        return Task.CompletedTask;
    }

    private Task HandleSystemMenuMove()
    {
        _systemMenuVisible = false;
        _moveArmed = Draggable;
        return Task.CompletedTask;
    }

    private async Task HandleSystemMenuClose()
    {
        _systemMenuVisible = false;
        await RequestClose();
    }

    // A resize starts from the box as rendered — CSS caps and non-pixel sizes included — and from where it
    // is painted, and the edge opposite the dragged one stays put: the overlay re-aligns a box whose size
    // changes, so the offset takes that shift back.
    private Task HandleResizeStart(string edge, MouseEventArgs e)
    {
        if (!Resizable || e.Button != 0)
            return Task.CompletedTask;

        _systemMenuVisible = false;
        _moveArmed = false;
        return BeginGestureAsync(edge, e);
    }

    private static double TighterLimit(double a, double b)
        => a > 0 && b > 0 ? Math.Min(a, b) : Math.Max(a, b);

    private static double MinimumWins(double maximum, double minimum)
        => maximum > 0 && maximum < minimum ? minimum : maximum;

    private void ApplyResize(double clientX, double clientY)
    {
        if (string.IsNullOrWhiteSpace(_resizeEdge))
            return;

        var dx = clientX - _resizeStartX;
        var dy = clientY - _resizeStartY;
        var west = _resizeEdge.Contains('w');
        var north = _resizeEdge.Contains('n');

        // An axis the pointer has not moved on keeps its rendered size (a click on a handle changes nothing,
        // even on a box smaller than the resize minimum).
        if (west || _resizeEdge.Contains('e'))
        {
            var width = dx == 0 ? _resizeStartWidth : ClampResize(_resizeStartWidth + (west ? -dx : dx), _resizeMinWidth, _resizeMaxWidth);
            var grown = width - _resizeStartWidth;
            _resizeChangedWidth = Math.Abs(grown) >= 0.5;
            _runtimeWidth = width;
            _dialogOffsetX = _resizeStartOffsetX + (west ? -(1 - _resizeAlignX) : _resizeAlignX) * grown;
        }

        if (north || _resizeEdge.Contains('s'))
        {
            var height = dy == 0 ? _resizeStartHeight : ClampResize(_resizeStartHeight + (north ? -dy : dy), _resizeMinHeight, _resizeMaxHeight);
            var grown = height - _resizeStartHeight;
            _resizeChangedHeight = Math.Abs(grown) >= 0.5;
            _runtimeHeight = height;
            _dialogOffsetY = _resizeStartOffsetY + (north ? -(1 - _resizeAlignY) : _resizeAlignY) * grown;
        }
    }

    private async Task FinishResize()
    {
        _isResizing = false;
        _resizeEdge = null;

        // A dimension the gesture did not change keeps its declared size, and its host hears nothing.
        if (!_resizeChangedWidth)
        {
            _runtimeWidth = _resizeRuntimeWidthBefore;
            _dialogOffsetX = _resizeStartOffsetX;
        }
        if (!_resizeChangedHeight)
        {
            _runtimeHeight = _resizeRuntimeHeightBefore;
            _dialogOffsetY = _resizeStartOffsetY;
        }

        // Read before the host runs: a newer gesture may start while it does.
        var moved = _dialogOffsetX != _gestureOffsetBeforeX || _dialogOffsetY != _gestureOffsetBeforeY;
        var position = new DialogPosition(_dialogOffsetX, _dialogOffsetY);
        var newWidth = _resizeChangedWidth && _runtimeWidth.HasValue ? Px(_runtimeWidth.Value) : null;
        var newHeight = _resizeChangedHeight && _runtimeHeight.HasValue ? Px(_runtimeHeight.Value) : null;
        if (newWidth != null) Width = newWidth;
        if (newHeight != null) Height = newHeight;

        // Position first: a host that places the window itself (FDBGrid's resting rule) then never paints
        // the new size at the old spot.
        if (moved)
            await PositionChanged.InvokeAsync(position);
        if (newWidth != null && WidthChanged.HasDelegate)
            await WidthChanged.InvokeAsync(newWidth);
        if (newHeight != null && HeightChanged.HasDelegate)
            await HeightChanged.InvokeAsync(newHeight);
    }

    private bool _lastVisible;

    protected override void OnParametersSet()
    {
        if (Visible && !_lastVisible)
        {
            _runtimeWidth = null;
            _runtimeHeight = null;
            _dialogOffsetX = Position?.X ?? 0;
            _dialogOffsetY = Position?.Y ?? 0;
            _systemMenuVisible = false;
            _isDragging = false;
            _isResizing = false;
            _press = null;
            _openGenerationForPress++;
            _moveArmed = false;

            // Rising edge: the dialog renders AFTER this method, so a capture
            // enqueued HERE reaches the browser BEFORE the render batch that
            // creates the dialog — document.activeElement is still the true
            // caller and the capture cannot race the dialog's own content
            // focusing itself (FPickList's grid, an AutoFocus field, ...).
            // Needs the focus module already imported; hidden dialogs preload
            // it in OnAfterRenderAsync, covering every open after first render.
            if (_focusModule != null)
            {
                _wasVisibleForFocus = true;
                _openerCaptured = true;
                _ = CaptureOpenerEarlyAsync();
            }
            else
            {
                // First-ever open with no hidden pre-render: the late,
                // root-aware capture in OnAfterRenderAsync is the fallback.
                _openerCaptured = false;
            }
        }
        if (Position != _lastPosition && !_isDragging && !_isResizing)
        {
            _dialogOffsetX = Position?.X ?? 0; _dialogOffsetY = Position?.Y ?? 0;
        }
        _lastPosition = Position;
        _lastVisible = Visible;
    }

    private double ResolveCurrentWidth()
    {
        return _runtimeWidth ?? TryParsePixelValue(Width) ?? 640;
    }

    private double ResolveCurrentHeight()
    {
        return _runtimeHeight ?? TryParsePixelValue(Height) ?? 360;
    }

    private static double? TryParsePixelValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var trimmed = value.Trim();
        if (!trimmed.EndsWith("px", StringComparison.OrdinalIgnoreCase))
            return null;

        return double.TryParse(trimmed[..^2], NumberStyles.Float, CultureInfo.InvariantCulture, out var pixels) ? pixels : null;
    }

    private static double ClampResize(double value, double minimum, double maximum)
    {
        var clamped = Math.Max(minimum, value);
        if (maximum > 0)
            clamped = Math.Min(maximum, clamped);
        return clamped;
    }

    private async Task RequestClose()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
        if (Closed.HasDelegate)
            await Closed.InvokeAsync();
        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible)
        {
            _autoFocusApplied = false;
            _focusScope = null;
            _keysRegisteredForShow = false;
            _openerCaptured = false;
            // Preload the focus module while hidden: the rising-edge capture in
            // OnParametersSet can only be enqueued pre-render when the module
            // already exists, and importing it here also installs the module's
            // focus-history tracker before any dialog ever opens.
            if (_focusModule == null)
            {
                try { _focusModule = await JS.InvokeAsync<IJSObjectReference>("import", DialogJsModulePath); }
                catch { /* prerender — retried on the open path */ }
            }
            // The popup must yield focus back to the caller it took it from.
            if (_wasVisibleForFocus)
            {
                _wasVisibleForFocus = false;
                if (_focusModule != null)
                {
                    try { await _focusModule.InvokeVoidAsync("restoreFocus"); } catch { /* circuit gone */ }
                }
            }
            return;
        }

        if (!_keysRegisteredForShow)
        {
            _keysRegisteredForShow = true;
            try
            {
                _focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", DialogJsModulePath);
                _selfRef ??= DotNetObjectReference.Create(this);
                await _focusModule.InvokeVoidAsync("registerDialogKeys", _dialogElement, _selfRef);
            }
            catch { /* prerender / circuit teardown */ }
        }

        if (_autoFocusApplied)
            return;
        _autoFocusApplied = true;
        _wasVisibleForFocus = true;

        try
        {
            _focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", DialogJsModulePath);
            // The capture runs an interop round trip behind the render, so the
            // dialog's own content (an FPickList grid, an AutoFocus field) may
            // already hold focus. Passing our root lets captureFocus reject
            // in-dialog holders and reach back to the real caller.
            if (!AutoFocus)
            {
                if (!_openerCaptured)
                    await _focusModule.InvokeVoidAsync("captureFocus", _dialogElement);
            }
            else if (ContentFocusScope.HasClaim)
            {
                if (!_openerCaptured)
                    await _focusModule.InvokeVoidAsync("captureFocus", _dialogElement);
                // A text entry of the popup's own keeps the caret; the
                // claimant then only prepares its keyboard state.
                var yieldToTextEntry = false;
                try { yieldToTextEntry = await _focusModule.InvokeAsync<bool>("hasOwnTextEntry", _dialogElement); }
                catch { /* stale module — leave the focus to the claimant */ }
                await ContentFocusScope.ApplyClaimedFocusAsync(!yieldToTextEntry);

                // Assume held: a stale module must never undo a live claim.
                var held = true;
                if (!yieldToTextEntry)
                {
                    try { held = await _focusModule.InvokeAsync<bool>("holdFocusWithin", _dialogElement); }
                    catch { /* stale module — the claim already took focus */ }
                }

                if (yieldToTextEntry || !held)
                    await _focusModule.InvokeVoidAsync("focusContent", _dialogElement);
            }
            else
            {
                ContentFocusScope.MarkHostFocusPass();
                if (!_openerCaptured)
                    await _focusModule.InvokeVoidAsync("captureFocus", _dialogElement);
                await _focusModule.InvokeVoidAsync("focusContent", _dialogElement);
            }
        }
        catch
        {
            // Prerender / circuit teardown — at minimum pull focus into the
            // dialog so keys stop reaching the window underneath.
            if (AutoFocus && !ContentFocusScope.HostFocusPassRan)
            {
                try { await _dialogElement.FocusAsync(); } catch { /* disposed */ }
            }
        }
    }

    [JSInvokable]
    public async Task OnDialogContentEscapeAsync()
    {
        if (_moveArmed)
        {
            _moveArmed = false;
            return;
        }

        if (OnEscape.HasDelegate)
        {
            await OnEscape.InvokeAsync();
            return;
        }

        if (CloseOnEscape)
            await RequestClose();
    }

    [JSInvokable]
    public async Task OnDialogContentEnterAsync()
    {
        if (_moveArmed || !Visible || !OnEnter.HasDelegate || _enterRunning)
            return;

        _enterRunning = true;   // a second Enter while the default button is still running is dropped
        try
        {
            if (await _defaultButtonScope.TakeConsumedEnterAsync() || !Visible)
                return;

            await OnEnter.InvokeAsync();
        }
        finally
        {
            _enterRunning = false;
        }
    }

    [JSInvokable]
    public async Task OnDialogContentCtrlEnterAsync()
    {
        if (CloseOnCtrlEnter)
            await RequestClose();
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        if (_focusModule != null)
        {
            // Torn down while still open: the caller was pushed on the shared
            // restore stack and nothing else will ever pop it.
            if (_wasVisibleForFocus)
            {
                _wasVisibleForFocus = false;
                try { await _focusModule.InvokeVoidAsync("restoreFocus"); } catch { /* circuit gone */ }
            }
            try { await _focusModule.DisposeAsync(); } catch { /* circuit gone */ }
        }
    }
}
