@namespace Fx.ControlKit
@inherits FlexControlBase

<CascadingValue Value="this" IsFixed="true">
    <div class="fx-carousel @CssClass" style="@Style" @attributes="AdditionalAttributes">
        <div class="fx-carousel-inner">
            @ChildContent
        </div>

        @if (ShowNavButtons && _items.Count > 1)
        {
            <button type="button" class="fx-carousel-btn fx-carousel-prev" aria-label="Previous" @onclick="Prev">
                <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
            </button>
            <button type="button" class="fx-carousel-btn fx-carousel-next" aria-label="Next" @onclick="Next">
                <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
            </button>
        }

        @if (ShowIndicators && _items.Count > 1)
        {
            <div class="fx-carousel-indicators">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var idx = i;
                    <button type="button"
                            class="fx-carousel-indicator @(idx == ActiveIndex ? "active" : "")"
                            aria-label="@($"Slide {idx + 1}")"
                            @onclick="() => SelectSlide(idx)"></button>
                }
            </div>
        }
    </div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int ActiveIndex { get; set; } = 0;
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    [Parameter] public bool ShowNavButtons { get; set; } = true;
    [Parameter] public bool ShowIndicators { get; set; } = true;

    private readonly List<CarouselItemControl> _items = new();

    internal void RegisterItem(CarouselItemControl item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
            StateHasChanged();
        }
    }

    internal void UnregisterItem(CarouselItemControl item)
    {
        _items.Remove(item);
        if (ActiveIndex >= _items.Count && _items.Count > 0)
        {
            ActiveIndex = _items.Count - 1;
        }
        StateHasChanged();
    }

    internal bool IsActive(CarouselItemControl item)
    {
        var idx = _items.IndexOf(item);
        return idx == ActiveIndex;
    }

    public async Task Next()
    {
        if (_items.Count == 0) return;
        ActiveIndex = (ActiveIndex + 1) % _items.Count;
        if (ActiveIndexChanged.HasDelegate)
        {
            await ActiveIndexChanged.InvokeAsync(ActiveIndex);
        }
        StateHasChanged();
    }

    public async Task Prev()
    {
        if (_items.Count == 0) return;
        ActiveIndex = (ActiveIndex - 1 + _items.Count) % _items.Count;
        if (ActiveIndexChanged.HasDelegate)
        {
            await ActiveIndexChanged.InvokeAsync(ActiveIndex);
        }
        StateHasChanged();
    }

    public async Task SelectSlide(int index)
    {
        if (index < 0 || index >= _items.Count) return;
        ActiveIndex = index;
        if (ActiveIndexChanged.HasDelegate)
        {
            await ActiveIndexChanged.InvokeAsync(ActiveIndex);
        }
        StateHasChanged();
    }
}
