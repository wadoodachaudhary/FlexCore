@implements IDisposable
@inject NotificationService Notifications
@inject IServiceProvider Services

@if (_items.Count > 0)
{
    <div class="fx-notification-container" style="@ZoomStyle">
        @foreach (var n in _items)
        {
            <div class="fx-notification fx-notification-@n.Level.ToString().ToLowerInvariant()"
                 @key="n.Id">
                <div class="fx-notification-icon">
                    @switch (n.Level)
                    {
                        @* An X-shaped glyph here reads as a second close button —
                           the error icon is an exclamation mark instead. *@
                        case NotificationLevel.Error:
                            <span style="font-weight:700">!</span>
                            break;
                        case NotificationLevel.Warning:
                            <span>&#x26A0;</span>
                            break;
                        case NotificationLevel.Success:
                            <span>&#x2714;</span>
                            break;
                        case NotificationLevel.Info:
                            <span>&#x2139;</span>
                            break;
                    }
                </div>
                <div class="fx-notification-body">
                    <div class="fx-notification-message">@n.Message</div>
                    @if (!string.IsNullOrEmpty(n.Detail))
                    {
                        <div class="fx-notification-detail">@n.Detail</div>
                    }
                </div>
                <button class="fx-notification-close" @onclick="() => Notifications.Dismiss(n.Id)">&times;</button>
            </div>
        }
    </div>
}

@code {
    private List<Notification> _items = new();
    private ZoomService? _zoomService;

    [CascadingParameter] private PageControl? AncestorPageControl { get; set; }

    // Toast hosts usually live at layout level, outside any PageControl, so the
    // container publishes the --fx-zoom scope itself when a ZoomService exists.
    private string? ZoomStyle =>
        _zoomService is not null && AncestorPageControl is null
            ? _zoomService.ZoomScopeStyle
            : null;

    protected override void OnInitialized()
    {
        _zoomService = Services.GetService(typeof(ZoomService)) as ZoomService;
        if (_zoomService is not null)
            _zoomService.OnZoomChanged += HandleChange;
        Notifications.OnChange += HandleChange;
        Refresh();
    }

    private void HandleChange()
    {
        InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        _items = Notifications.Notifications.ToList();
    }

    public void Dispose()
    {
        if (_zoomService is not null)
            _zoomService.OnZoomChanged -= HandleChange;
        Notifications.OnChange -= HandleChange;
    }
}
