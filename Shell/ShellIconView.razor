@namespace Fx.ControlKit.Shell

@if (Icon != ShellIcon.None && !string.IsNullOrEmpty(Body))
{
    <svg class="fx-shell-glyph @CssClass" viewBox="0 0 24 24" width="@Px" height="@Px" aria-hidden="true" focusable="false">
        @((MarkupString)Body)
    </svg>
}

@code {
    [Parameter] public ShellIcon Icon { get; set; }
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? CssClass { get; set; }

    private string Body => ShellIconPaths.Markup(Icon);
    private string Px => Size + "px";
}
