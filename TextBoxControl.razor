@namespace Fx.ControlKit
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Linq.Expressions
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (HostCursorPhase)
{
    @* A hosted cell in the cursor phase shows its display, not an input. *@
}
else if (Multiline)
{
    if (ValueExpression is not null && !UpdateOnInput && !OnKeyDown.HasDelegate && InputValueChanged is null && !AutoFocus && !SelectOnFocus && !ReplaceOnFirstInput && !SelectAllOnDoubleClick && !UseClassicContextMenu
        && TypingBehavior != TextBoxTypingBehavior.ClientBuffered)
    {
        <InputTextArea class="@ResolvedCssClass"
                       Value="@Value"
                       ValueChanged="@ValueChanged"
                       ValueExpression="@ValueExpression"
                       @onblur="@BlurDispatch"
                       @attributes="MergedAttributes" />
    }
    else
    {
        <textarea class="@ResolvedCssClass"
                  @bind:event="oninput"
                  @bind:get="EffectiveValue"
                  @bind:set="OnNativeInput"
                  @onchange="OnNativeChange"
                  @onblur="@BlurDispatch"
                  @onfocus="OnInputFocus"
                  @ondblclick="OnInputDoubleClick"
                  @oncontextmenu="OpenTextContextMenuAsync"
                  @oncontextmenu:preventDefault="UseClassicContextMenu"
                  @oncontextmenu:stopPropagation="UseClassicContextMenu"
                  @ref="_inputElement"
                  @onclick:stopPropagation="true"
                  @onmousedown:stopPropagation="true"
                  @onkeydown="@KeyDownDispatch"
                  @onkeydown:stopPropagation="@KeyDownStopsPropagation"
                  @attributes="MergedAttributes"></textarea>
    }
}
else
{
    if (IsPasswordInput)
    {
        <div class="fx-textbox fx-textbox-password-host" style="@HostWidthStyle">
            <input class="@ResolvedPasswordInputCssClass"
                   @bind:event="oninput"
                   @bind:get="EffectiveValue"
                   @bind:set="OnNativeInput"
                   @onchange="OnNativeChange"
                   @onblur="@BlurDispatch"
                   @onfocus="OnInputFocus"
                   @ondblclick="OnInputDoubleClick"
                   @oncontextmenu="OpenTextContextMenuAsync"
                   @oncontextmenu:preventDefault="UseClassicContextMenu"
                   @oncontextmenu:stopPropagation="UseClassicContextMenu"
                   @ref="_inputElement"
                   @onclick:stopPropagation="true"
                   @onmousedown:stopPropagation="true"
                   @onkeydown="@KeyDownDispatch"
                   @onkeydown:stopPropagation="@KeyDownStopsPropagation"
                   @attributes="MergedAttributes" />
            <canvas class="fx-textbox-password-reveal" hidden aria-hidden="true"
                    width="1" height="1" @ref="_passwordRevealElement"></canvas>
            @* Mouse-only affordance: keeps the form's tab order the same as a plain password box. *@
            <button type="button"
                    class="fx-textbox-password-toggle"
                    tabindex="-1"
                    aria-label="@PasswordToggleLabel"
                    title="@PasswordToggleLabel"
                    aria-pressed="@_showPassword"
                    disabled="@(!Enabled)"
                    @onclick="TogglePasswordVisibility"
                    @onclick:stopPropagation="true"
                    @onmousedown:preventDefault="true"
                    @onmousedown:stopPropagation="true">
                @if (_showPassword)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3 3l18 18" />
                        <path d="M10.7 10.7a2 2 0 0 0 2.6 2.6" />
                        <path d="M9.9 4.2A10.6 10.6 0 0 1 12 4c5 0 8.5 4.1 10 8-.5 1.3-1.3 2.6-2.3 3.7" />
                        <path d="M6.5 6.5C4.4 7.9 2.9 10.1 2 12c1.5 3.9 5 8 10 8 1.8 0 3.4-.5 4.8-1.3" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M2 12s3.5-8 10-8 10 8 10 8-3.5 8-10 8S2 12 2 12z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                }
            </button>
        </div>
    }
    else if (ValueExpression is not null && !UpdateOnInput && !OnKeyDown.HasDelegate && InputValueChanged is null && !AutoFocus && !SelectOnFocus && !ReplaceOnFirstInput && !SelectAllOnDoubleClick && !UseClassicContextMenu
             && TypingBehavior != TextBoxTypingBehavior.ClientBuffered)
    {
        <InputText class="@ResolvedCssClass"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   ValueExpression="@ValueExpression"
                   @onblur="@BlurDispatch"
                   @attributes="MergedAttributes" />
    }
    else
    {
        @* Propagation policy matches the textarea/password branches. It must stay
           CONDITIONAL: the grid's cell editor supplies OnKeyDown, and pages rely on
           keys bubbling from an open editor to their own handlers (FCommunities
           Ctrl+S / Ctrl+Delete, FItems OnHostKeyDown, the grid's EditOnEnterKey and
           "..." picker paths). The per-character cost is removed by
           TypingKeysStayLocal instead, which drops only printable/Backspace/Delete
           at the DOM level and leaves shortcut keys free to bubble. *@
        <input class="@ResolvedCssClass"
               @bind:event="oninput"
               @bind:get="EffectiveValue"
               @bind:set="OnNativeInput"
               @onchange="OnNativeChange"
               @onblur="@BlurDispatch"
               @onfocus="OnInputFocus"
               @ondblclick="OnInputDoubleClick"
               @oncontextmenu="OpenTextContextMenuAsync"
               @oncontextmenu:preventDefault="UseClassicContextMenu"
               @oncontextmenu:stopPropagation="UseClassicContextMenu"
               @ref="_inputElement"
               @onclick:stopPropagation="true"
               @onmousedown:stopPropagation="true"
               @onkeydown="@KeyDownDispatch"
               @onkeydown:stopPropagation="@KeyDownStopsPropagation"
               @attributes="MergedAttributes" />
    }
}

@if (_showTextContextMenu)
{
    <div class="fx-text-context-backdrop"
         @onclick="CloseTextContextMenu"
         @oncontextmenu="CloseTextContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="fx-text-context-menu"
         style="@TextContextMenuStyle"
         @onclick:stopPropagation="true"
         @onmousedown:stopPropagation="true">
        @if (HasTextContextMenuItem(TextContextMenuItems.Undo))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("undo")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("undo"))">Undo</button>
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Cut))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("cut")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("cut"))">Cut</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Copy))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("copy")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("copy"))">Copy</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Paste))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("paste")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("paste"))">Paste</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Delete))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("delete")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("delete"))">Delete</button>
        }
        @if (HasAnyTextContextMenuItem(TextContextMenuItems.Cut | TextContextMenuItems.Copy | TextContextMenuItems.Paste | TextContextMenuItems.Delete)
            && HasTextContextMenuItem(TextContextMenuItems.SelectAll))
        {
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.SelectAll))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("selectAll")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("selectAll"))">Select All</button>
        }
        @if (HasAnyTextContextMenuItem(TextContextMenuItems.ReadingOrder | TextContextMenuItems.UnicodeOptions | TextContextMenuItems.Ime | TextContextMenuItems.Reconversion))
        {
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.ReadingOrder))
        {
            <button type="button"
                    class="@(_textContextMenuState.IsRightToLeft ? "is-checked" : null)"
                    disabled="@IsTextContextCommandDisabled("readingOrder")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("readingOrder"))">Right to left Reading order</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.UnicodeOptions))
        {
            <button type="button" disabled>Show Unicode control characters</button>
            <button type="button" disabled>
                <span>Insert Unicode control character</span>
                <span class="fx-text-context-arrow">&gt;</span>
            </button>
        }
        @if (HasAnyTextContextMenuItem(TextContextMenuItems.Ime | TextContextMenuItems.Reconversion))
        {
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Ime))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("ime")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("ime"))">Open IME</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Reconversion))
        {
            <button type="button" disabled>Reconversion</button>
        }
    </div>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    private void NotifyNativeFieldChanged()
    {
        if (CascadedEditContext is not null && ValueExpression is not null)
            CascadedEditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
    }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? CssClass { get; set; }
    /// <summary>CSS width of the control (e.g. "250px", "100%"). Applied as an inline
    /// style so it wins over any class width; for a password box it sizes the host
    /// wrapper and the input fills it. Mirrors NumericTextBoxControl / DropDownListControl.
    /// Before this existed the attribute fell through to the &lt;input&gt; as an HTML
    /// <c>width</c> attribute, which browsers honour only for type=image.</summary>
    [Parameter] public string? Width { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string InputType { get; set; } = "text";
    /// <summary>Briefly reveal only the character just typed into a masked password
    /// input. Browser-local; pasted, autofilled and programmatic values stay masked.</summary>
    [Parameter] public bool RevealLastTypedCharacter { get; set; } = true;
    /// <summary>Local password echo lifetime in milliseconds. Zero disables it;
    /// values above 2000 are capped so an accidental setting cannot leave it visible.</summary>
    [Parameter] public int PasswordRevealDurationMs { get; set; } = 400;
    [Parameter] public int? Rows { get; set; }
    [Parameter] public Dictionary<string, object>? HtmlAttributes { get; set; }
    [Parameter] public Action<ElementReference>? ElementReferenceCaptured { get; set; }
    [Parameter] public bool UpdateOnInput { get; set; }
    [Parameter] public Action<string?>? InputValueChanged { get; set; }
    [Parameter] public TextBoxTypingBehavior TypingBehavior { get; set; } = TextBoxTypingBehavior.ServerBacked;

    /// <summary>Browser-owned draft mode (no JS). The starting value is seeded
    /// once; native input then updates the draft independently of parent Value
    /// parameters. Parent renders therefore retain the typed text and caret.
    /// Typed text is reported through <see cref="InputValueChanged"/> and
    /// <see cref="ValueChanged"/>. Use a fresh <c>@key</c> per edit session to
    /// seed a new starting value.</summary>
    [Parameter] public bool Uncontrolled { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public bool SelectOnFocus { get; set; }
    [Parameter] public bool ReplaceOnFirstInput { get; set; }
    [Parameter] public bool SelectAllOnDoubleClick { get; set; }
    [Parameter] public bool UseClassicContextMenu { get; set; }
    [Parameter] public TextContextMenuItems ContextMenuItems { get; set; } = TextContextMenuItems.Legacy;
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback OnBlur { get; set; }

    /// <summary>ClientBuffered form editors: with an <see cref="OnKeyDown"/> host the
    /// client listener owns Enter/Tab/arrows (it prevents the default so a grid can
    /// move its own active cell). Set this on a plain form field so Tab still commits
    /// the draft and reports to <see cref="OnKeyDown"/> once, but the browser's native
    /// focus traversal is left alone. Grid cell editors leave it false.</summary>
    [Parameter] public bool KeepNativeTab { get; set; }

    /// <summary>Set when this control is the editor of a hosted cell (a TreeGrid
    /// cell-edit template): the host decides focus and the Tab stop, takes the
    /// keys the box does not consume, and is told when the edit ends — the page
    /// wires nothing. Cursor phase: renders NOTHING (the cell shows its display).
    /// Editing phase: a browser-owned draft (ClientBuffered) starting from the
    /// host's InitialText when typing began the edit, focused on mount; Enter /
    /// Escape / Up / Down go to the host, blur ends the edit, Tab stays native.</summary>
    [CascadingParameter] private ICellEditorHost? CellHost { get; set; }

    private bool HostCursorPhase => CellHost is { IsEditing: false };
    private bool HostEditing => CellHost is { IsEditing: true };
    private bool EffectiveAutoFocus => AutoFocus || HostEditing;
    private bool EffectiveKeepNativeTab => KeepNativeTab || CellHost is not null;
    private TextBoxTypingBehavior EffectiveTypingBehavior =>
        CellHost is null ? TypingBehavior : TextBoxTypingBehavior.ClientBuffered;
    private bool HandlesNavigationKeys => OnKeyDown.HasDelegate || CellHost is not null;
    private readonly System.Text.StringBuilder _relayedText = new();
    private bool _disposed;

    /// <summary>Under a host the input's Blazor keydown handler exists only until
    /// the browser listener has attached (the pre-attach window): afterwards the
    /// listener owns the commit keys and shortcut keys bubble natively to the page,
    /// so no key is ever dispatched to both the input and the host tree.</summary>
    private bool KeyDownBound => OnKeyDown.HasDelegate || (CellHost is not null && !_clientBufferedTypingAttached);
    private bool KeyDownStopsPropagation => CellHost is null ? !OnKeyDown.HasDelegate : !_clientBufferedTypingAttached;

    protected override void OnInitialized()
    {
        // Registered inside the mount render, before any key can arrive.
        if (HostEditing)
            CellHost!.AttachKeyRelay(RelayHostKeyAsync);
    }

    private async Task RelayHostKeyAsync(KeyboardEventArgs e)
    {
        if (!e.AltKey && !e.CtrlKey && !e.MetaKey && e.Key is { Length: 1 } && !char.IsControl(e.Key[0]))
        {
            // Typed before the input existed / had focus: appended to the browser
            // draft once the listener is attached (order preserved).
            if (_clientBufferedTypingAttached && !_disposed)
            {
                var module = await GetControlJsModuleAsync();
                if (module != null)
                    try { await module.InvokeVoidAsync("appendTypedText", _inputElement, e.Key); } catch { }
            }
            else
                _relayedText.Append(e.Key);
            return;
        }
        await OnNativeKeyDown(e);
    }

    /// <summary>Keys this control does not consume: the explicit handler first, then
    /// the cell host (both, never either/or).</summary>
    private async Task ForwardKeyAsync(KeyboardEventArgs e)
    {
        if (OnKeyDown.HasDelegate)
            await OnKeyDown.InvokeAsync(e);
        if (CellHost is not null)
            await CellHost.KeyDownAsync(e);
    }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Printable keys plus Backspace/Delete are handled entirely in the
    /// browser and never dispatched to the server. Only for UNCONTROLLED editors
    /// whose host does not act on typing keys (the grid's in-cell editor): it
    /// removes one SignalR round trip per character.</summary>
    [Parameter] public bool TypingKeysStayLocal { get; set; }

    /// <summary>Bound only when a host is actually listening. Blazor dispatches every
    /// bound keydown to the server, so an always-bound handler cost one SignalR round
    /// trip per character on every textbox in the app for a handler that did nothing.</summary>
    private EventCallback<KeyboardEventArgs> KeyDownDispatch =>
        KeyDownBound
            ? EventCallback.Factory.Create<KeyboardEventArgs>(this, OnNativeKeyDown)
            : default;

    private EventCallback<FocusEventArgs> BlurDispatch =>
        OnBlur.HasDelegate || CellHost is not null
            ? EventCallback.Factory.Create<FocusEventArgs>(this, OnNativeBlur)
            : default;

    /// <summary>Raised when a PASTE was clipped by MaxLength. The browser clamps
    /// before any input event, so this is the only way a host can learn that
    /// characters were dropped. Args: (pastedLength, maxLength).</summary>
    [Parameter] public EventCallback<(int PastedLength, int MaxLength)> OnPasteTruncated { get; set; }

    private DotNetObjectReference<TextBoxControl>? _pasteNoticeRef;
    private DotNetObjectReference<TextBoxControl>? _clientBufferedTypingRef;

    [JSInvokable]
    public async Task OnPasteTruncatedAsync(int pastedLength, int maxLength)
    {
        if (OnPasteTruncated.HasDelegate)
            await OnPasteTruncated.InvokeAsync((pastedLength, maxLength));
    }

    private async Task OnNativeKeyDown(KeyboardEventArgs e)
    {
        // A hosted cell editor keeps its caret keys (owner 2026-09-11): Left / Right
        // never leave the text, Up / Down are its start / end, Page keys stay local —
        // none of them reaches the host (the browser listener keeps them local once
        // attached; this covers the relay and the pre-attach binding).
        if (CellHost is not null && !e.AltKey && !e.CtrlKey && !e.MetaKey
            && e.Key is "ArrowUp" or "Up" or "ArrowDown" or "Down" or "ArrowLeft" or "Left" or "ArrowRight" or "Right" or "PageUp" or "PageDown")
            return;

        // ClientBuffered normally sends the complete DOM value through its
        // client listener. During the brief mount window before that listener
        // attaches, this Blazor fallback receives the key instead; synchronize
        // the browser-owned value before the host commits Enter/Tab/navigation.
        if (EffectiveTypingBehavior == TextBoxTypingBehavior.ClientBuffered
            && IsClientBufferedCommitKey(e))
        {
            await SynchronizeClientBufferedDomValueAsync();
        }

        await ForwardKeyAsync(e);
    }

    private static bool IsClientBufferedCommitKey(KeyboardEventArgs e)
    {
        var controlBoundaryKey = (e.CtrlKey || e.MetaKey)
            && e.Key is "Home" or "End";

        if (e.AltKey || ((e.CtrlKey || e.MetaKey) && !controlBoundaryKey))
            return false;

        var horizontalCaretKey = !e.ShiftKey
            && e.Key is "ArrowLeft" or "ArrowRight";

        return e.Key is "Enter"
            or "NumpadEnter"
            or "Tab"
            or "ArrowUp"
            or "ArrowDown"
            or "PageUp"
            or "PageDown"
            || controlBoundaryKey
            || horizontalCaretKey;
    }

    private async Task OnNativeBlur(FocusEventArgs _)
    {
        await SynchronizeClientBufferedDomValueAsync();
        if (OnBlur.HasDelegate)
            await OnBlur.InvokeAsync();
        // Focus left a hosted editor (a page-level Tab, a click elsewhere): the
        // edit is over. A blur fired by the editor's own removal never gets here —
        // the renderer drops events of a disposed component.
        CellHost?.EndEdit();
    }

    private async Task SynchronizeClientBufferedDomValueAsync()
    {
        if (EffectiveTypingBehavior != TextBoxTypingBehavior.ClientBuffered)
            return;

        var module = await GetControlJsModuleAsync();
        if (module == null)
            return;

        try
        {
            var value = await module.InvokeAsync<string?>("getTextValue", _inputElement);
            var committedValue = value ?? string.Empty;
            // Characters the host relayed before the browser listener attached are
            // not in the DOM yet (they are appended after enableClientBufferedTyping
            // returns): a commit key that arrives first must still carry them. The
            // buffer stays, so an editor that survives the key still gets them into
            // its draft; a disposed one discards them.
            if (CellHost is not null && !_clientBufferedTypingAttached && _relayedText.Length > 0)
                committedValue += _relayedText.ToString();
            if (MaxLength is > 0 && committedValue.Length > MaxLength.Value)
                committedValue = committedValue[..MaxLength.Value];

            Value = committedValue;
            _uncontrolledValue = committedValue;
            _uncontrolledInitialized = true;
            _suppressNextNativeInputRender = true;
            InputValueChanged?.Invoke(committedValue);
            if (ValueChanged.HasDelegate)
                await ValueChanged.InvokeAsync(committedValue);
        }
        catch
        {
            // The editor may have unmounted while a navigation key was in flight.
        }
    }

    /// <summary>Focuses the input through Blazor's element API.</summary>
    public ValueTask FocusAsync(bool preventScroll = true) => _inputElement.FocusAsync(preventScroll);

    [JSInvokable]
    public Task CommitClientBufferedTypingAsync(
        string? value,
        string key,
        bool shiftKey,
        bool ctrlKey,
        bool altKey,
        bool metaKey)
    {
        return InvokeAsync(async () =>
        {
            if (!string.Equals(key, "Escape", StringComparison.Ordinal))
            {
                var committedValue = value ?? string.Empty;
                if (MaxLength is > 0 && committedValue.Length > MaxLength.Value)
                    committedValue = committedValue[..MaxLength.Value];

                Value = committedValue;
                _uncontrolledValue = committedValue;
                _uncontrolledInitialized = true;
                _suppressNextNativeInputRender = true;
                InputValueChanged?.Invoke(committedValue);
                if (ValueChanged.HasDelegate)
                    await ValueChanged.InvokeAsync(committedValue);
            }

            // A value-only flush: a page shortcut (Ctrl+S…) is about to bubble past a
            // hosted editor and the page must act on the current draft. Nothing else.
            if (string.Equals(key, "Sync", StringComparison.Ordinal))
                return;

            if (string.Equals(key, "Blur", StringComparison.Ordinal))
            {
                if (OnBlur.HasDelegate)
                    await OnBlur.InvokeAsync();
                CellHost?.EndEdit();
                return;
            }

            // A hosted editor's caret keys never reach the host (see OnNativeKeyDown) —
            // the browser listener keeps them local; this is the belt for the braces.
            if (CellHost is not null && !altKey && !ctrlKey && !metaKey
                && key is "ArrowUp" or "ArrowDown" or "ArrowLeft" or "ArrowRight" or "PageUp" or "PageDown")
                return;

            if (HandlesNavigationKeys)
            {
                await ForwardKeyAsync(new KeyboardEventArgs
                {
                    Key = key,
                    ShiftKey = shiftKey,
                    CtrlKey = ctrlKey,
                    AltKey = altKey,
                    MetaKey = metaKey
                });
            }
        });
    }

    private ElementReference _inputElement;
    private ElementReference _passwordRevealElement;
    private ElementReference _passwordRevealInput;
    private bool _passwordRevealAttached;
    private int _passwordRevealDurationMs;
    private IJSObjectReference? _controlJsModule;
    private bool _showTextContextMenu;
    private int _textContextMenuX;
    private int _textContextMenuY;
    private TextContextMenuState _textContextMenuState = new();
    private bool _suppressNextNativeInputRender;
    private bool _showPassword;
    private bool _clientBufferedTypingAttached;
    private bool _clientBufferedHandlesNavigationKeys;
    private bool _clientBufferedKeepNativeTab;

    // Browser-owned draft: seed from Value once, then track native input.
    // Parent Value changes must not overwrite a live draft.
    private string? _uncontrolledValue;
    private bool _uncontrolledInitialized;

    /// <summary>The value rendered into the input. In Uncontrolled mode this is the
    /// browser's latest draft (independent of parent re-renders); otherwise it
    /// tracks the live <see cref="Value"/>.</summary>
    private bool UsesBrowserOwnedValue =>
        Uncontrolled || EffectiveTypingBehavior == TextBoxTypingBehavior.ClientBuffered;

    private string? EffectiveValue => UsesBrowserOwnedValue ? _uncontrolledValue : Value;

    private bool IsPasswordInput =>
        !Multiline && string.Equals(InputType, "password", StringComparison.OrdinalIgnoreCase);

    private string EffectiveInputType => IsPasswordInput && _showPassword ? "text" : InputType;

    private string PasswordToggleLabel => _showPassword ? "Hide password" : "Show password";

    protected override void OnParametersSet()
    {
        if (UsesBrowserOwnedValue && !_uncontrolledInitialized)
        {
            // Typing started a hosted edit: the typed text REPLACES the value
            // (vsFlexGrid Editable — the first character begins the entry).
            _uncontrolledValue = HostEditing && CellHost!.InitialText is { } initial ? initial : Value;
            _uncontrolledInitialized = true;
        }
        else if (!UsesBrowserOwnedValue)
        {
            _uncontrolledValue = null;
            _uncontrolledInitialized = false;
        }
    }

    protected override bool ShouldRender()
    {
        if (_suppressNextNativeInputRender)
        {
            _suppressNextNativeInputRender = false;
            return false;
        }

        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A hosted cell in the cursor phase rendered no input: no element to hand
        // out, nothing to attach, no interop (every row move mounts one of these).
        if (HostCursorPhase || _disposed)
            return;

        ElementReferenceCaptured?.Invoke(_inputElement);

        var wantsClientBufferedTyping = EffectiveTypingBehavior == TextBoxTypingBehavior.ClientBuffered;
        var handlesNavigationKeys = HandlesNavigationKeys;
        var keepNativeTab = EffectiveKeepNativeTab;
        var clientBindingChanged = wantsClientBufferedTyping != _clientBufferedTypingAttached
            || (wantsClientBufferedTyping
                && (handlesNavigationKeys != _clientBufferedHandlesNavigationKeys
                    || keepNativeTab != _clientBufferedKeepNativeTab));
        var revealDuration = IsPasswordInput && Enabled && !_showPassword && RevealLastTypedCharacter
            ? Math.Clamp(PasswordRevealDurationMs, 0, 2000) : 0;
        var passwordBindingChanged = revealDuration != _passwordRevealDurationMs
            || (_passwordRevealAttached && _passwordRevealInput.Id != _inputElement.Id);

        // Only AutoFocus seizes focus on load. SelectOnFocus must NOT auto-focus on render — otherwise a
        // second SelectOnFocus field (e.g. Description) steals focus from the AutoFocus field (Number).
        // SelectOnFocus still selects the text when the user actually focuses the field (OnInputFocus).
        var needsFirstRenderSetup = firstRender
            && (EffectiveAutoFocus || ReplaceOnFirstInput || TypingKeysStayLocal
                || (MaxLength is > 0 && OnPasteTruncated.HasDelegate));
        if (!needsFirstRenderSetup && !clientBindingChanged && !passwordBindingChanged)
            return;

        var module = await GetControlJsModuleAsync();
        // Disposed while the import was in flight (a cell editor whose edit ended
        // before it finished mounting): its element is gone — every call below
        // would fault the renderer.
        if (module == null || _disposed)
            return;

        if (passwordBindingChanged)
        {
            try
            {
                if (_passwordRevealAttached)
                    await module.InvokeVoidAsync("configurePasswordReveal", _passwordRevealInput, null, 0);
                _passwordRevealAttached = false;
                _passwordRevealDurationMs = 0;
                if (revealDuration > 0)
                {
                    await module.InvokeVoidAsync("configurePasswordReveal", _inputElement, _passwordRevealElement, revealDuration);
                    _passwordRevealInput = _inputElement;
                    _passwordRevealAttached = true;
                    _passwordRevealDurationMs = revealDuration;
                }
            }
            catch
            {
                // Progressive enhancement: the native password input remains masked.
                _passwordRevealAttached = false;
                _passwordRevealDurationMs = 0;
            }
        }

        if (clientBindingChanged)
        {
            try
            {
                if (wantsClientBufferedTyping)
                {
                    _clientBufferedTypingRef ??= DotNetObjectReference.Create(this);
                    await module.InvokeVoidAsync(
                        "enableClientBufferedTyping",
                        _inputElement,
                        _clientBufferedTypingRef,
                        handlesNavigationKeys,
                        keepNativeTab,
                        // A hosted cell editor: lands its draft before a page shortcut
                        // (Ctrl+S…) bubbles on, and keeps its caret keys (arrows, Page)
                        // local — the host moves rows on Tab, Enter and Escape only.
                        CellHost is not null);
                    _clientBufferedTypingAttached = true;
                    _clientBufferedHandlesNavigationKeys = handlesNavigationKeys;
                    _clientBufferedKeepNativeTab = keepNativeTab;
                    if (CellHost is not null && !_disposed)
                    {
                        // Characters relayed by the host before the listener existed.
                        if (_relayedText.Length > 0)
                        {
                            var relayed = _relayedText.ToString();
                            _relayedText.Clear();
                            try { await module.InvokeVoidAsync("appendTypedText", _inputElement, relayed); } catch { }
                        }
                        // The pre-attach Blazor keydown binding comes off now (KeyDownBound).
                        StateHasChanged();
                    }
                }
                else
                {
                    await module.InvokeVoidAsync("disableClientBufferedTyping", _inputElement);
                    _clientBufferedTypingAttached = false;
                    _clientBufferedHandlesNavigationKeys = false;
                    _clientBufferedKeepNativeTab = false;
                }
            }
            catch
            {
                _clientBufferedTypingAttached = false;
            }
        }

        if (!needsFirstRenderSetup || _disposed)
            return;

        // Best effort from here: the element can be gone (an edit that ended mid-mount).
        try
        {
            if (ReplaceOnFirstInput)
                await module.InvokeVoidAsync("enableReplaceOnFirstInput", _inputElement);
            if (TypingKeysStayLocal && !wantsClientBufferedTyping)
                await module.InvokeVoidAsync("suppressTypingKeyDispatch", _inputElement);
            if (MaxLength is > 0 && OnPasteTruncated.HasDelegate)
            {
                _pasteNoticeRef ??= DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("enableMaxLengthPasteNotice", _inputElement, _pasteNoticeRef, MaxLength.Value);
            }
            if (EffectiveAutoFocus && !_disposed)
            {
                // Hosted: the host focuses only while it still owns the keyboard.
                if (CellHost is not null)
                    await CellHost.FocusAsync(_inputElement, SelectOnFocus);
                else
                    await module.InvokeVoidAsync("focus", _inputElement, SelectOnFocus);
            }
        }
        catch
        {
            // Disposed or detached mid-mount.
        }
    }

    private string ResolvedCssClass
    {
        get
        {
            var classes = new List<string>();
            if (!string.IsNullOrWhiteSpace(CssClass))
                classes.Add(CssClass);
            if (HtmlAttributes != null && HtmlAttributes.TryGetValue("class", out var htmlClass))
                classes.Add(htmlClass?.ToString() ?? string.Empty);
            if (AdditionalAttributes != null && AdditionalAttributes.TryGetValue("class", out var extraClass))
                classes.Add(extraClass?.ToString() ?? string.Empty);
            return string.Join(" ", classes.Where(c => !string.IsNullOrWhiteSpace(c)));
        }
    }

    private string ResolvedPasswordInputCssClass
    {
        get
        {
            var classes = new List<string> { "fx-textbox-password-input" };
            if (!string.IsNullOrWhiteSpace(ResolvedCssClass))
                classes.Add(ResolvedCssClass);
            return string.Join(" ", classes);
        }
    }

    private string? HostWidthStyle =>
        string.IsNullOrWhiteSpace(Width) ? null : $"width:{Width};";

    private IReadOnlyDictionary<string, object> MergedAttributes
    {
        get
        {
            var merged = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            if (AdditionalAttributes != null)
            {
                foreach (var kv in AdditionalAttributes)
                {
                    if (!string.Equals(kv.Key, "class", StringComparison.OrdinalIgnoreCase))
                        merged[kv.Key] = kv.Value;
                }
            }
            if (HtmlAttributes != null)
            {
                foreach (var kv in HtmlAttributes)
                {
                    if (!string.Equals(kv.Key, "class", StringComparison.OrdinalIgnoreCase))
                        merged[kv.Key] = kv.Value;
                }
            }

            if (!string.IsNullOrWhiteSpace(Placeholder) && !merged.ContainsKey("placeholder"))
                merged["placeholder"] = Placeholder;
            if (MaxLength.HasValue && !merged.ContainsKey("maxlength"))
                merged["maxlength"] = MaxLength.Value;
            if (Rows.HasValue && !merged.ContainsKey("rows"))
                merged["rows"] = Rows.Value;
            if (!Enabled && !merged.ContainsKey("disabled"))
                merged["disabled"] = "disabled";
            if (IsPasswordInput)
                merged["type"] = EffectiveInputType;
            else if (!Multiline && !string.IsNullOrWhiteSpace(InputType) && !merged.ContainsKey("type"))
                merged["type"] = InputType;
            if (AutoFocus && !merged.ContainsKey("autofocus"))
                merged["autofocus"] = "autofocus";
            // Marks the input for the pre-attach typing shield in
            // textbox-control.js: typing keys stay local from the very first
            // render, before enableClientBufferedTyping's round trip lands.
            if (EffectiveTypingBehavior == TextBoxTypingBehavior.ClientBuffered)
                merged["data-fx-cb-pending"] = "1";

            if (!string.IsNullOrWhiteSpace(Width))
            {
                // Password boxes size the wrapper (HostWidthStyle) and the input fills it.
                var width = IsPasswordInput ? "100%" : Width;
                var existing = merged.TryGetValue("style", out var st) ? st?.ToString()?.Trim() : null;
                merged["style"] = string.IsNullOrEmpty(existing)
                    ? $"width:{width};"
                    : $"width:{width};{existing}{(existing.EndsWith(';') ? "" : ";")}";
            }
            return merged;
        }
    }

    private async Task OnNativeInput(string? typed)
    {
        if (UsesBrowserOwnedValue)
        {
            // @bind updates Blazor's value frame for each input event. Keep
            // its getter in sync before invoking a parent callback: otherwise
            // a parent render compares the typed value with the mount-time
            // snapshot and writes the old text back into the live input.
            _uncontrolledValue = typed;
            InputValueChanged?.Invoke(typed);
            _suppressNextNativeInputRender = true;
            if (UpdateOnInput && ValueChanged.HasDelegate)
                await ValueChanged.InvokeAsync(typed);
            if (UpdateOnInput) NotifyNativeFieldChanged();
            return;
        }

        // Controlled (default): the bind getter/setter keeps the DOM synchronized
        // when this value or the parent's ValueChanged callback rewrites the input.
        // Commit to the parent on each keystroke only when UpdateOnInput; otherwise
        // the parent is notified on change (blur/Enter).
        Value = typed;
        InputValueChanged?.Invoke(Value);
        if (!UpdateOnInput)
            _suppressNextNativeInputRender = true;
        if (UpdateOnInput && ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(Value);
        if (UpdateOnInput) NotifyNativeFieldChanged();
    }

    private Task OnNativeChange(ChangeEventArgs e) =>
        UpdateOnInput ? Task.CompletedTask : OnNativeValueChanged(e);

    private async Task OnNativeValueChanged(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        if (UsesBrowserOwnedValue)
            _uncontrolledValue = Value;
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(Value);
        NotifyNativeFieldChanged();
    }

    private async Task OnInputFocus()
    {
        if (!SelectOnFocus && !ReplaceOnFirstInput)
            return;

        var module = await GetControlJsModuleAsync();
        if (module == null)
            return;

        if (ReplaceOnFirstInput)
            await module.InvokeVoidAsync("armReplaceOnFirstInput", _inputElement);

        if (SelectOnFocus)
            await module.InvokeVoidAsync("select", _inputElement);
    }

    private async Task OnInputDoubleClick()
    {
        if (!SelectAllOnDoubleClick)
            return;

        var module = await GetControlJsModuleAsync();
        if (module != null)
            await module.InvokeVoidAsync("select", _inputElement);
    }

    private async Task OpenTextContextMenuAsync(MouseEventArgs e)
    {
        if (!UseClassicContextMenu)
            return;

        var module = await GetControlJsModuleAsync();
        if (module == null)
            return;

        try
        {
            _textContextMenuState = await module.InvokeAsync<TextContextMenuState>(
                "getTextContextMenuState", _inputElement);
            var position = await module.InvokeAsync<TextContextMenuPosition>(
                "positionTextContextMenu", e.ClientX, e.ClientY);
            _textContextMenuX = (int)Math.Round(position.X);
            _textContextMenuY = (int)Math.Round(position.Y);
            _showTextContextMenu = true;
        }
        catch
        {
            _showTextContextMenu = false;
        }
    }

    private void CloseTextContextMenu() => _showTextContextMenu = false;

    private void TogglePasswordVisibility()
    {
        _suppressNextNativeInputRender = false;
        _showPassword = !_showPassword;
    }

    private string TextContextMenuStyle => $"left:{_textContextMenuX}px;top:{_textContextMenuY}px";

    private bool HasTextContextMenuItem(TextContextMenuItems item) =>
        (ContextMenuItems & item) == item;

    private bool HasAnyTextContextMenuItem(TextContextMenuItems items) =>
        (ContextMenuItems & items) != 0;

    private bool IsTextContextCommandDisabled(string command) => command switch
    {
        "undo" => !Enabled,
        "cut" => !Enabled || !_textContextMenuState.HasSelection,
        "copy" => !_textContextMenuState.HasSelection,
        "paste" => !Enabled,
        "delete" => !Enabled || !_textContextMenuState.HasSelection,
        "selectAll" => !_textContextMenuState.HasValue || _textContextMenuState.AllSelected,
        "ime" => !Enabled,
        _ => false
    };

    private async Task ExecuteTextContextCommandAsync(string command)
    {
        _showTextContextMenu = false;
        var module = await GetControlJsModuleAsync();
        if (module == null)
            return;

        try
        {
            var result = await module.InvokeAsync<TextContextCommandResult>(
                "applyTextContextCommand", _inputElement, command);
            if (result.ValueChanged)
            {
                Value = result.Value;
                if (ValueChanged.HasDelegate)
                    await ValueChanged.InvokeAsync(Value);
            }
        }
        catch
        {
            // Browser clipboard commands are best-effort and may be blocked by policy.
        }
    }

    private async ValueTask<IJSObjectReference?> GetControlJsModuleAsync()
    {
        if (_controlJsModule != null) return _controlJsModule;
        try
        {
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", FxJsAsset.Versioned($"./_content/{GetType().Assembly.GetName().Name}/textbox-control.js"));
            if (_disposed)
            {
                // Torn down while the import was in flight (a cell edit that ended
                // mid-mount): nobody would dispose it later.
                try { await module.DisposeAsync(); } catch { }
                return null;
            }
            return _controlJsModule = module;
        }
        catch
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CellHost?.AttachKeyRelay(null);
        if (_passwordRevealAttached && _controlJsModule != null)
        {
            try { await _controlJsModule.InvokeVoidAsync("configurePasswordReveal", _passwordRevealInput, null, 0); }
            catch { }
        }
        if (_clientBufferedTypingAttached && _controlJsModule != null)
        {
            try { await _controlJsModule.InvokeVoidAsync("disableClientBufferedTyping", _inputElement); }
            catch { }
        }
        _clientBufferedTypingRef?.Dispose();
        _clientBufferedTypingRef = null;
        _pasteNoticeRef?.Dispose();
        _pasteNoticeRef = null;
        if (_controlJsModule != null)
        {
            try { await _controlJsModule.DisposeAsync(); }
            catch { }
        }
    }
}
