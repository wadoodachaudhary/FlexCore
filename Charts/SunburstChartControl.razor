@namespace Fx.ControlKit.Charts
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="fx-sunburst-container @CssClass" style="@ContainerStyle" @onmousemove="HandleMouseMove" @onmouseleave="HandleMouseLeave">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="fx-sunburst-title">@Title</div>
    }

    @if (ShowBreadcrumb && _currentRoot != null)
    {
        <div class="fx-sunburst-breadcrumbs">
            <button type="button" class="fx-breadcrumb-btn @(_currentRoot == RootNode ? "active" : "")"
                    @onclick="() => SetDrilldownNode(RootNode)">
                <span>🌍</span> @(RootNode?.Name ?? "World")
            </button>
            @foreach (var ancestor in GetBreadcrumbPath())
            {
                <span class="fx-breadcrumb-sep">›</span>
                <button type="button" class="fx-breadcrumb-btn @(ancestor == _currentRoot ? "active" : "")"
                        @onclick="() => SetDrilldownNode(ancestor)">
                    @ancestor.Name
                </button>
            }
        </div>
    }

    <div class="fx-sunburst-viewport">
        <svg viewBox="0 0 @ViewBoxSize @ViewBoxSize"
             preserveAspectRatio="xMidYMid meet"
             class="fx-sunburst-svg"
             xmlns="http://www.w3.org/2000/svg">
            <defs>
                <filter id="sunburstGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#000000" flood-opacity="0.35" />
                </filter>
            </defs>

            <!-- Annular Ring Slices -->
            <g class="fx-sunburst-slices">
                @foreach (var arc in _arcs)
                {
                    var isHovered = _hoveredArc?.Node.Id == arc.Node.Id;
                    var isHighlighted = HighlightedNodeId == arc.Node.Id;
                    var isDimmed = (_hoveredArc != null && !isHovered && !IsAncestorOrDescendant(_hoveredArc.Node, arc.Node))
                                   || (!string.IsNullOrEmpty(HighlightedNodeId) && !isHighlighted);

                    <path d="@arc.GenerateSvgPath(Cx, Cy)"
                          fill="@arc.FillColor"
                          stroke="@(isHovered || isHighlighted ? "#ffffff" : arc.StrokeColor)"
                          stroke-width="@(isHovered || isHighlighted ? 2.0 : arc.StrokeWidth)"
                          class="fx-sunburst-slice @(isHovered ? "hovered" : "") @(isHighlighted ? "highlighted" : "") @(isDimmed ? "dimmed" : "")"
                          style="cursor: @(arc.Node.Children.Count > 0 ? "pointer" : "default");"
                          filter="@(isHovered || isHighlighted ? "url(#sunburstGlow)" : null)"
                          @onmouseover="() => HandleArcMouseOver(arc)"
                          @onmouseout="() => HandleArcMouseOut(arc)"
                          @onclick="() => HandleArcClick(arc)" />
                }
            </g>

            <!-- Slice Text Labels -->
            @if (ShowLabels)
            {
                <g class="fx-sunburst-labels" pointer-events="none">
                    @foreach (var arc in _arcs)
                    {
                        @if (IsLabelDisplayable(arc))
                        {
                            var (lx, ly, rot, isFlipped) = arc.GetLabelTransform(Cx, Cy);
                            var isHovered = _hoveredArc?.Node.Id == arc.Node.Id;
                            var maxChars = GetMaxLabelChars(arc);
                            var displayName = TruncateLabel(arc.Node.Name, maxChars);

                            <g>
                                <text x="@lx.ToString("0.##", CultureInfo.InvariantCulture)"
                                      y="@ly.ToString("0.##", CultureInfo.InvariantCulture)"
                                      transform="rotate(@rot.ToString("0.##", CultureInfo.InvariantCulture) @lx.ToString("0.##", CultureInfo.InvariantCulture) @ly.ToString("0.##", CultureInfo.InvariantCulture))"
                                      text-anchor="middle"
                                      dominant-baseline="central"
                                      fill="#ffffff"
                                      class="fx-sunburst-label level-@arc.Level @(isHovered ? "active" : "")">
                                    @displayName
                                </text>
                            </g>
                        }
                    }
                </g>
            }

            <!-- Center Hub Circle -->
            <g class="fx-sunburst-center-group" @onclick="HandleCenterClick" style="cursor: @(_currentRoot != RootNode ? "pointer" : "default");">
                <circle cx="@Cx"
                        cy="@Cy"
                        r="@CenterRadius"
                        fill="@CenterCircleFill"
                        class="fx-sunburst-center-circle @(_currentRoot != RootNode ? "drilldown-active" : "")"
                        filter="url(#sunburstGlow)"
                        @onmouseover="HandleCenterMouseOver"
                        @onmouseout="HandleCenterMouseOut" />

                <!-- Center Text -->
                <text x="@Cx"
                      y="@(Cy - 14)"
                      text-anchor="middle"
                      class="fx-center-sub">
                    @CenterTitleText
                </text>

                <text x="@Cx"
                      y="@(Cy + 10)"
                      text-anchor="middle"
                      class="fx-center-val">
                    @CenterValueText
                </text>

                @if (_currentRoot != RootNode)
                {
                    <g>
                        <text x="@Cx"
                              y="@(Cy + 30)"
                              text-anchor="middle"
                              class="fx-center-hint">
                            ◀ Click to zoom out
                        </text>
                    </g>
                }
                else if (_hoveredArc == null)
                {
                    <g>
                        <text x="@Cx"
                              y="@(Cy + 28)"
                              text-anchor="middle"
                              class="fx-center-subtitle">
                            Across the World
                        </text>
                    </g>
                }
            </g>
        </svg>

        <!-- Floating Tooltip Card (faithful to article & screenshot) -->
        @if (_hoveredArc != null)
        {
            var node = _hoveredArc.Node;
            var totalCases = node.TotalValue;
            var totalDeaths = node.TotalSecondaryValue;
            var parentTotal = node.Parent?.TotalValue ?? (RootNode?.TotalValue ?? totalCases);
            var pctOfParent = parentTotal > 0 ? (totalCases / parentTotal * 100.0) : 100.0;
            var pctOfWorld = (RootNode?.TotalValue ?? 0) > 0 ? (totalCases / RootNode!.TotalValue * 100.0) : 100.0;

            <div class="fx-sunburst-tooltip" style="@TooltipStyle">
                <div class="fx-tooltip-title">
                    <span class="fx-tooltip-indicator" style="background: @_hoveredArc.FillColor;"></span>
                    <span>@node.Name</span>
                    @if (node.Children.Count > 0)
                    {
                        <span class="fx-tooltip-badge">@node.Children.Count regions</span>
                    }
                </div>
                <div class="fx-tooltip-body">
                    <div class="fx-tooltip-stat">
                        <span class="fx-stat-lbl">Total @MetricName:</span>
                        <strong class="fx-stat-val">@totalCases.ToString(ValueFormat, CultureInfo.CurrentCulture)</strong>
                    </div>
                    @if (node.SecondaryValue.HasValue || totalDeaths > 0)
                    {
                        <div class="fx-tooltip-stat">
                            <span class="fx-stat-lbl">Total @SecondaryMetricName:</span>
                            <strong class="fx-stat-val">@totalDeaths.ToString(ValueFormat, CultureInfo.CurrentCulture)</strong>
                        </div>
                    }
                    @if (node.Depth == 2)
                    {
                        <div class="fx-tooltip-stat text-muted">
                            <span class="fx-stat-lbl">% of @(node.Parent?.Name ?? "Continent"):</span>
                            <span class="fx-stat-val">@pctOfParent.ToString("0.1")%</span>
                        </div>
                    }
                    <div class="fx-tooltip-stat text-muted">
                        <span class="fx-stat-lbl">% of World:</span>
                        <span class="fx-stat-val">@pctOfWorld.ToString("0.1")%</span>
                    </div>
                    @if (node.Children.Count > 0 && EnableDrilldown)
                    {
                        <div class="fx-tooltip-hint">Click continent to drill down</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public SunburstNode? RootNode { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "620px";
    [Parameter] public double CenterRadiusRatio { get; set; } = 0.28;
    [Parameter] public string ValueFormat { get; set; } = "N0";
    [Parameter] public string MetricName { get; set; } = "Cases";
    [Parameter] public string SecondaryMetricName { get; set; } = "Deaths";
    [Parameter] public string CenterTitle { get; set; } = "TOTAL CASES";
    [Parameter] public string CenterColor { get; set; } = "#56abf6";
    [Parameter] public bool EnableDrilldown { get; set; } = true;
    [Parameter] public bool ShowBreadcrumb { get; set; } = true;
    [Parameter] public bool ShowLabels { get; set; } = true;
    [Parameter] public string? HighlightedNodeId { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<SunburstNode> OnNodeClick { get; set; }
    [Parameter] public EventCallback<SunburstNode?> OnNodeHover { get; set; }

    private SunburstNode? _currentRoot;
    private SunburstArc? _hoveredArc;
    private bool _isCenterHovered;
    private List<SunburstArc> _arcs = new();

    private const double ViewBoxSize = 700.0;
    private const double Cx = ViewBoxSize / 2.0;
    private const double Cy = ViewBoxSize / 2.0;
    private const double MaxRadius = 325.0;

    private double _pointerX = 0;
    private double _pointerY = 0;

    private double CenterRadius => MaxRadius * Math.Clamp(CenterRadiusRatio, 0.15, 0.45);

    private string ContainerStyle => $"width:{Width}; max-width:100%; position:relative;";

    private string CenterCircleFill =>
        _isCenterHovered && _currentRoot != RootNode
            ? SunburstColorHelper.Darken(_currentRoot?.Color ?? CenterColor, 0.15)
            : (_currentRoot?.Color ?? CenterColor);

    private string CenterTitleText =>
        _currentRoot != null && _currentRoot != RootNode
            ? _currentRoot.Name.ToUpperInvariant()
            : CenterTitle;

    private string CenterValueText =>
        _currentRoot != null
            ? _currentRoot.TotalValue.ToString(ValueFormat, CultureInfo.CurrentCulture)
            : "0";

    private string TooltipStyle
    {
        get
        {
            var left = Math.Clamp(_pointerX + 16, 10, 850);
            var top = Math.Clamp(_pointerY - 20, 10, 750);
            return $"left:{left.ToString("0", CultureInfo.InvariantCulture)}px; top:{top.ToString("0", CultureInfo.InvariantCulture)}px;";
        }
    }

    protected override void OnParametersSet()
    {
        if (_currentRoot == null || (_currentRoot != RootNode && !IsDescendant(RootNode, _currentRoot)))
        {
            _currentRoot = RootNode;
        }
        RecomputeArcs();
    }

    private bool IsDescendant(SunburstNode? ancestor, SunburstNode? node)
    {
        if (ancestor == null || node == null) return false;
        var curr = node.Parent;
        while (curr != null)
        {
            if (curr == ancestor) return true;
            curr = curr.Parent;
        }
        return false;
    }

    private bool IsAncestorOrDescendant(SunburstNode a, SunburstNode b)
    {
        return a == b || IsDescendant(a, b) || IsDescendant(b, a);
    }

    private void RecomputeArcs()
    {
        _arcs.Clear();
        if (_currentRoot == null || _currentRoot.Children.Count == 0)
            return;

        var availableThickness = MaxRadius - CenterRadius;
        var maxDepth = GetMaxDepthBelow(_currentRoot);
        var levels = Math.Max(1, maxDepth);
        var levelWidth = availableThickness / levels;

        var totalVal = _currentRoot.Children.Sum(c => c.TotalValue);
        if (totalVal <= 0) return;

        // Partition ring 1 (Direct children of _currentRoot, e.g. Continents)
        double currentAngle = -Math.PI / 2.0; // Start at 12 o'clock

        for (int i = 0; i < _currentRoot.Children.Count; i++)
        {
            var child = _currentRoot.Children[i];
            var childVal = child.TotalValue;
            var childSpan = (childVal / totalVal) * (2.0 * Math.PI);
            var childEnd = currentAngle + childSpan;

            var r1 = CenterRadius;
            var r2 = levels > 1 ? CenterRadius + levelWidth : MaxRadius;

            var baseColor = child.Color ?? GetDefaultColor(i);
            var childArc = new SunburstArc
            {
                Node = child,
                Level = 1,
                InnerRadius = r1,
                OuterRadius = r2,
                StartAngle = currentAngle,
                EndAngle = childEnd,
                FillColor = baseColor,
                StrokeColor = "#ffffff",
                StrokeWidth = 1.0
            };
            _arcs.Add(childArc);

            // Partition ring 2 (Grandchildren, e.g. Countries)
            if (child.Children.Count > 0 && levels > 1)
            {
                var gTotal = child.Children.Sum(g => g.TotalValue);
                if (gTotal > 0)
                {
                    double gCurrentAngle = currentAngle;
                    for (int j = 0; j < child.Children.Count; j++)
                    {
                        var gChild = child.Children[j];
                        var gVal = gChild.TotalValue;
                        var gSpan = childSpan * (gVal / gTotal);
                        var gEnd = gCurrentAngle + gSpan;

                        // Create realistic depth shading as described in the article
                        var shadeFactor = 0.82 + (j % 5) * 0.05;
                        var countryColor = gChild.Color ?? SunburstColorHelper.AdjustLightness(baseColor, shadeFactor);

                        var gArc = new SunburstArc
                        {
                            Node = gChild,
                            Level = 2,
                            InnerRadius = r2,
                            OuterRadius = MaxRadius,
                            StartAngle = gCurrentAngle,
                            EndAngle = gEnd,
                            FillColor = countryColor,
                            StrokeColor = "#ffffff",
                            StrokeWidth = 0.5
                        };
                        _arcs.Add(gArc);
                        gCurrentAngle = gEnd;
                    }
                }
            }

            currentAngle = childEnd;
        }
    }

    private int GetMaxDepthBelow(SunburstNode node)
    {
        if (node.Children.Count == 0) return 0;
        return 1 + node.Children.Max(GetMaxDepthBelow);
    }

    private bool IsLabelDisplayable(SunburstArc arc)
    {
        // Don't render text on tiny slivers
        if (arc.AngularSpan < 0.045)
            return false;

        // On outer ring, require slightly more angle for long text
        if (arc.Level == 2 && arc.AngularSpan < 0.065)
            return false;

        return true;
    }

    private int GetMaxLabelChars(SunburstArc arc)
    {
        var arcLength = arc.MidRadius * arc.AngularSpan;
        return (int)Math.Max(3, arcLength / 7.5);
    }

    private string TruncateLabel(string name, int maxChars)
    {
        if (string.IsNullOrEmpty(name)) return "";
        if (name.Length <= maxChars) return name;
        if (maxChars <= 3) return name.Substring(0, Math.Min(name.Length, maxChars));
        return name.Substring(0, maxChars - 1) + "…";
    }

    private void HandleArcMouseOver(SunburstArc arc)
    {
        _hoveredArc = arc;
        OnNodeHover.InvokeAsync(arc.Node);
    }

    private void HandleArcMouseOut(SunburstArc arc)
    {
        if (_hoveredArc == arc)
        {
            _hoveredArc = null;
            OnNodeHover.InvokeAsync(null);
        }
    }

    private async Task HandleArcClick(SunburstArc arc)
    {
        await OnNodeClick.InvokeAsync(arc.Node);
        if (EnableDrilldown && arc.Node.Children.Count > 0)
        {
            _currentRoot = arc.Node;
            RecomputeArcs();
            StateHasChanged();
        }
    }

    private void HandleCenterClick()
    {
        if (!EnableDrilldown) return;
        if (_currentRoot != RootNode && _currentRoot != null)
        {
            _currentRoot = _currentRoot.Parent ?? RootNode;
            RecomputeArcs();
            StateHasChanged();
        }
    }

    private void HandleCenterMouseOver()
    {
        if (_currentRoot != RootNode)
            _isCenterHovered = true;
    }

    private void HandleCenterMouseOut()
    {
        _isCenterHovered = false;
    }

    private void SetDrilldownNode(SunburstNode? node)
    {
        if (node == null) return;
        _currentRoot = node;
        RecomputeArcs();
        StateHasChanged();
    }

    private IEnumerable<SunburstNode> GetBreadcrumbPath()
    {
        if (_currentRoot == null || _currentRoot == RootNode)
            return Enumerable.Empty<SunburstNode>();

        var list = new List<SunburstNode>();
        var curr = _currentRoot;
        while (curr != null && curr != RootNode)
        {
            list.Insert(0, curr);
            curr = curr.Parent;
        }
        return list;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        _pointerX = e.OffsetX;
        _pointerY = e.OffsetY;
    }

    private void HandleMouseLeave()
    {
        _hoveredArc = null;
    }

    private static string GetDefaultColor(int index)
    {
        string[] palette = { "#63c6c1", "#adc965", "#e25b45", "#7C79A2", "#FBAF0A", "#FFC1A6", "#4db6ac", "#81c784" };
        return palette[index % palette.Length];
    }
}
