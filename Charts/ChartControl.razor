@namespace Fx.ControlKit.Charts
@using System.Globalization
@using Microsoft.AspNetCore.Components

@*
    ChartControl — comprehensive SVG charting component.

    Supports 30+ chart types rendered as pure SVG with no JS dependencies.

    Backwards-compatible usage (single-series horizontal bars):
        <ChartControl Title="My Chart"
                      Bars="@(new[] { new ChartBar("Q1", 100), new ChartBar("Q2", 250) })" />

    Multi-row mode (unchanged):
        <ChartControl DataSource="@rows" LabelField="Name" ValueFields="@fields" />

    New SVG chart mode:
        <ChartControl Type="ChartType.Line"
                      Series="@mySeries"
                      Title="Revenue Over Time"
                      Height="400px" />
*@

<div class="fx-chart @CssClass" style="@RootStyle" @onmouseleave="TipLeave">
    @if (ReportPlot is not null && PrintedSummaryPlot.Supports(ReportPlot))
    {
        var drawing = PrintedSummaryPlot.Draw(ReportPlot, _effectiveSeries, PrintWidthPoints, PrintHeightPoints);
        <img alt="@Title" src="@drawing.ToDataUrl()" style="display:block;width:100%;height:@Height;" />
    }
    else if (CategoryLegend)
    {
        var drawing = PrintedCategoryBarChart.Draw(Type, _effectiveSeries, Title ?? "",
            PrintWidthPoints > 0 ? PrintWidthPoints : 600, PrintHeightPoints > 0 ? PrintHeightPoints : 300,
            ShowLegend, ColorPalette, XAxis, YAxis, ShowAxisLabels, ReportPlot?.RightCategoryLegend);
        <img alt="@Title" src="@drawing.ToDataUrl()" style="display:block;width:100%;height:@Height;" />
    }
    else if (ThreeDimensional)
    {
        var drawing = PrintedBarChart3D.Draw(Type, _effectiveSeries, Title ?? "",
            PrintWidthPoints > 0 ? PrintWidthPoints : 600, PrintHeightPoints > 0 ? PrintHeightPoints : 300,
            ShowLegend, ColorPalette, XAxis, YAxis, ShowAxisLabels);
        <img alt="@Title" src="@drawing.ToDataUrl()" style="display:block;width:100%;height:@Height;" />
    }
    else if (PrintWidthPoints > 0 && PrintHeightPoints > 0 && Type is ChartType.Line or ChartType.Surface or ChartType.Ohlc or ChartType.HorizontalBar or ChartType.Area or ChartType.Pie or ChartType.Donut or ChartType.Radar or ChartType.Funnel or ChartType.Gauge or ChartType.Scatter or ChartType.Bubble)
    {
        var drawing = PrintedStageChart.Draw(Type, _effectiveSeries, Title ?? "", PrintWidthPoints, PrintHeightPoints, ShowLegend, EffectivePalette, PrintReportGroupChart, XAxis);
        <img alt="@Title" src="@drawing.ToDataUrl()" style="display:block;width:100%;height:@Height;" />
    }
    else
    {
    @if (!string.IsNullOrEmpty(Title) && !UsePrintBarLayout)
    {
        <div class="fx-chart-title">@Title</div>
    }

    @if (UseLegacyMode)
    {
        @* === LEGACY: Single-series horizontal bars === *@
        @if (Bars is { Count: > 0 })
        {
            <div class="fx-chart-rows">
                @foreach (var bar in Bars)
                {
                    <div class="fx-chart-row">
                        @if (ShowLabels)
                        {
                            <div class="fx-chart-row-label" style="@LabelStyle">@bar.Label</div>
                        }
                        <div class="fx-chart-row-bar-container">
                            <div class="fx-chart-row-bar"
                                 style="width:@PercentOf(bar.Value, _maxValue)%; background:@ResolveBarColor(bar);"
                                 title="@bar.Label: @bar.Value.ToString("N2", CultureInfo.CurrentCulture)"></div>
                            @if (ShowValues)
                            {
                                <span class="fx-chart-row-value">@bar.Value.ToString(ValueFormat, CultureInfo.CurrentCulture)</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (HasMultiRowData)
        {
            <div class="fx-chart-multi">
                @foreach (var row in _resolvedRows)
                {
                    <div class="fx-chart-multi-row">
                        @if (ShowLabels)
                        {
                            <div class="fx-chart-multi-label" style="@LabelStyle" title="@row.Label">@row.Label</div>
                        }
                        <div class="fx-chart-multi-bars">
                            @for (var i = 0; i < row.Values.Count; i++)
                            {
                                var v = row.Values[i];
                                var lbl = i < (ValueLabels?.Count ?? 0) ? ValueLabels![i] : "";
                                <div class="fx-chart-bar-cell" title="@lbl: @v.ToString("N2", CultureInfo.CurrentCulture)">
                                    <div class="fx-chart-bar"
                                         style="height:@PercentOf(v, _maxValue)%; background:@(BarColor ?? "#2563eb");"></div>
                                    @if (ShowValues)
                                    {
                                        <span class="fx-chart-bar-value">@v.ToString(ValueFormat, CultureInfo.CurrentCulture)</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (ShowAxisLabels && ValueLabels is { Count: > 0 })
            {
                <div class="fx-chart-axis">
                    <div class="fx-chart-axis-label-spacer"></div>
                    <div class="fx-chart-axis-bars">
                        @foreach (var lbl in ValueLabels)
                        {
                            <div class="fx-chart-axis-tick">@lbl</div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="fx-chart-empty">No data</div>
        }
    }
    else
    {
        @* === NEW SVG CHART MODE === *@
        @if (_effectiveSeries.Count == 0 && Type is not (ChartType.Gauge or ChartType.ArcGauge or ChartType.LinearGauge or ChartType.RadialGauge or ChartType.KpiCard))
        {
            <div class="fx-chart-empty">No data</div>
        }
        else
        {
            @switch (Type)
            {
                case ChartType.KpiCard:
                    @RenderKpiCard()
                    break;
                case ChartType.Gauge:
                    @RenderGauge()
                    break;
                case ChartType.Sparkline:
                    @RenderSparkline()
                    break;
                case ChartType.Pie:
                case ChartType.Donut:
                    @RenderPieDonut()
                    break;
                case ChartType.Sunburst:
                    @RenderSunburst()
                    break;
                case ChartType.Radar:
                    @RenderRadar()
                    break;
                case ChartType.Funnel:
                case ChartType.Pyramid:
                    @RenderFunnelPyramid()
                    break;
                case ChartType.Heatmap:
                    @RenderHeatmap()
                    break;
                case ChartType.Scatter:
                case ChartType.Bubble:
                    @RenderScatterBubble()
                    break;
                case ChartType.Gantt:
                    @RenderGantt()
                    break;
                case ChartType.BoxPlot:
                    @RenderBoxPlot()
                    break;
                case ChartType.DotPlot:
                    @RenderDotPlot()
                    break;
                case ChartType.Waterfall:
                    @RenderWaterfall()
                    break;
                case ChartType.Histogram:
                    @RenderHistogram()
                    break;
                case ChartType.Line:
                case ChartType.MultiLine:
                case ChartType.Spline:
                case ChartType.StepLine:
                case ChartType.Area:
                case ChartType.StackedArea:
                    @RenderLineArea()
                    break;
                case ChartType.Candlestick:
                case ChartType.Ohlc:
                case ChartType.HighLow:
                    @RenderFinancialChart()
                    break;
                case ChartType.Bullet:
                    @RenderBullet()
                    break;
                case ChartType.RangeBar:
                case ChartType.RangeColumn:
                case ChartType.RangeArea:
                    @RenderRangeChart()
                    break;
                case ChartType.Sankey:
                    @RenderSankey()
                    break;
                case ChartType.LinearGauge:
                case ChartType.ArcGauge:
                case ChartType.RadialGauge:
                    @RenderAdvancedGauges()
                    break;
                default:
                    @RenderBarChart()
                    break;
            }

            @if (ShowTooltips && _tip is { } tip)
            {
                <div class="fx-chart-tooltip @(_tipLeft ? "fx-tip-left" : "") @(_tipUp ? "fx-tip-up" : "")" style="left:@(F0(_tipX))px;top:@(F0(_tipY))px" role="status">
                    @if (TooltipTemplate is not null)
                    {
                        @TooltipTemplate(tip)
                    }
                    else
                    {
                        <div class="fx-chart-tooltip-title"><span class="fx-chart-tooltip-swatch" style="background:@tip.Color"></span>@tip.Title</div>
                        @foreach (var row in TooltipRows(tip))
                        {
                            <div class="fx-chart-tooltip-row">@if (row.Name.Length > 0) { <span>@row.Name</span> }<b>@row.Value</b></div>
                        }
                    }
                </div>
            }

            @if (ShowLegend && _effectiveSeries.Count > 1)
            {
                <div class="fx-chart-legend">
                    @for (var i = 0; i < _effectiveSeries.Count; i++)
                    {
                        var s = _effectiveSeries[i];
                        <div class="fx-chart-legend-item">
                            <div class="fx-chart-legend-swatch" style="background:@GetSeriesColor(i)"></div>
                            <span>@s.Name</span>
                        </div>
                    }
                </div>
            }
        }
    }
    }
</div>

@code {
    #region Parameters — Legacy (backwards compatible)

    /// <summary>Type of each row in DataSource (multi-row mode).</summary>
    [Parameter] public Type? RowType { get; set; }

    /// <summary>Optional title shown above the chart.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>CSS width (e.g. "100%", "400px"). Default: full width.</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>Extra CSS class on the root container.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Single-series bars — used when no DataSource is supplied.</summary>
    [Parameter] public IList<ChartBar>? Bars { get; set; }

    /// <summary>Multi-row data source. Each row is rendered as its own grouped-bar chart.</summary>
    [Parameter] public System.Collections.IEnumerable? DataSource { get; set; }

    /// <summary>Property name on each row to use as the row label (multi-row mode).</summary>
    [Parameter] public string? LabelField { get; set; }

    /// <summary>Property names on each row to use as bar values (multi-row mode).</summary>
    [Parameter] public IList<string>? ValueFields { get; set; }

    /// <summary>Optional human-readable labels for each value field (axis ticks).</summary>
    [Parameter] public IList<string>? ValueLabels { get; set; }

    /// <summary>Show the row label column. Default true.</summary>
    [Parameter] public bool ShowLabels { get; set; } = true;

    /// <summary>Show numeric value next to each bar / above each bar. Default false.</summary>
    [Parameter] public bool ShowValues { get; set; } = false;

    /// <summary>Format string for value labels (default "N2").</summary>
    [Parameter] public string ValueFormat { get; set; } = "N2";

    /// <summary>Render the bottom axis labels in multi-row mode. Default true.</summary>
    [Parameter] public bool ShowAxisLabels { get; set; } = true;

    /// <summary>Default bar color. Override per-bar via ChartBar.Color.</summary>
    [Parameter] public string? BarColor { get; set; } = "#2563eb";

    /// <summary>Inline style applied to the row label cell.</summary>
    [Parameter] public string? LabelStyle { get; set; } = "min-width:160px;";

    #endregion

    #region Parameters — New

    /// <summary>Chart visualization type.</summary>
    [Parameter] public ChartType Type { get; set; } = ChartType.Bar;

    /// <summary>Draw grouped, stacked or percentage bars with perspective faces.</summary>
    [Parameter] public Fx.ControlKit.Reports.ReportAnalysisDefinition? ReportPlot { get; set; }
    [Parameter] public bool ThreeDimensional { get; set; }
    /// <summary>Use the classic printed bar scene and category-key legend.</summary>
    [Parameter] public bool CategoryLegend { get; set; }

    /// <summary>Multi-series data for new SVG chart modes.</summary>
    [Parameter] public List<ChartSeries>? Series { get; set; }

    /// <summary>X-axis configuration.</summary>
    [Parameter] public ChartAxis? XAxis { get; set; }

    /// <summary>Y-axis configuration.</summary>
    [Parameter] public ChartAxis? YAxis { get; set; }

    /// <summary>Legend configuration.</summary>
    [Parameter] public ChartLegend? Legend { get; set; }

    /// <summary>Chart height CSS value.</summary>
    [Parameter] public string? Height { get; set; } = "300px";

    /// <summary>Enable CSS animation on chart elements.</summary>
    [Parameter] public bool Animate { get; set; } = false;

    /// <summary>Custom color palette for series.</summary>
    [Parameter] public bool ColorBarsByCategory { get; set; }
    [Parameter] public bool PrintReportGroupChart { get; set; }
    [Parameter] public double PrintWidthPoints { get; set; }
    [Parameter] public double PrintHeightPoints { get; set; }
    private bool UsePrintBarLayout => Type == ChartType.Bar && PrintWidthPoints > 0 && PrintHeightPoints > 0;

    [Parameter] public string[]? ColorPalette { get; set; }

    // Rise and fall colours (2026-10-31): the candlestick, OHLC and waterfall green and red, settable so a themed page can match them.
    /// <summary>Rising candles and OHLC bars, and positive Waterfall steps. Unset: green (candle body #22c55e, outline and steps #16a34a).</summary>
    [Parameter] public string? UpColor { get; set; }
    /// <summary>Falling candles and OHLC bars, and negative Waterfall steps. Unset: red (candle body #ef4444, outline and steps #dc2626).</summary>
    [Parameter] public string? DownColor { get; set; }

    /// <summary>Donut inner radius as proportion of outer radius (0-1).</summary>
    [Parameter] public double? InnerRadius { get; set; }

    /// <summary>Gauge current value.</summary>
    [Parameter] public double? GaugeValue { get; set; }

    /// <summary>Gauge minimum value.</summary>
    [Parameter] public double? GaugeMin { get; set; }

    /// <summary>Gauge maximum value.</summary>
    [Parameter] public double? GaugeMax { get; set; }
    [Parameter] public IReadOnlyList<GaugeRange> GaugeRanges { get; set; } = Array.Empty<GaugeRange>();
    [Parameter] public IReadOnlyList<GaugePointer> GaugePointers { get; set; } = Array.Empty<GaugePointer>();
    [Parameter] public bool GaugeCircular { get; set; }
    [Parameter] public int GaugeTickCount { get; set; } = 5;
    [Parameter] public bool GaugeShowValue { get; set; } = true;
    [Parameter] public string GaugeLabelFormat { get; set; } = "0";

    /// <summary>KPI display value.</summary>
    [Parameter] public string? KpiValue { get; set; }

    /// <summary>KPI descriptive label.</summary>
    [Parameter] public string? KpiLabel { get; set; }

    /// <summary>KPI trend indicator (e.g. "+12%", "-5%", "up", "down").</summary>
    [Parameter] public string? KpiTrend { get; set; }

    // Tooltips (2026-10-31): a card follows the pointer over bars, slices, points, cells and flows; no script, Blazor events only.
    /// <summary>Shows a card when the pointer is over a shape. Off, the shapes keep their native &lt;title&gt; text instead.</summary>
    [Parameter] public bool ShowTooltips { get; set; } = true;
    /// <summary>.NET numeric format for the numbers in the default card. Unset: whole numbers print as N0, the rest as N2.</summary>
    [Parameter] public string? TooltipValueFormat { get; set; }
    /// <summary>Text pattern for the card body, replacing the default rows: {series} {label} {category} {title} {value} {value2}…{value5}
    /// {percent} {open} {high} {low} {close} {min} {max} {size}; a format after a colon applies to numbers ({value:N0}); \n starts a row.</summary>
    [Parameter] public string? TooltipFormat { get; set; }
    /// <summary>Code-side text for the card body, lines separated by \n; return null to fall back to TooltipFormat or the default rows.</summary>
    [Parameter] public Func<ChartTooltipContext, string?>? TooltipFormatter { get; set; }
    /// <summary>Replaces the whole card content.</summary>
    [Parameter] public RenderFragment<ChartTooltipContext>? TooltipTemplate { get; set; }
    /// <summary>Raised with the context when the pointer enters a shape and with null when it leaves the shape or the chart.</summary>
    [Parameter] public EventCallback<ChartTooltipContext?> PointHover { get; set; }

    #endregion

    #region State

    private double _maxValue = 1;
    private List<ResolvedRow> _resolvedRows = new();
    private bool HasMultiRowData => _resolvedRows.Count > 0;
    private List<ChartSeries> _effectiveSeries = new();

    private static readonly string[] DefaultPalette =
    {
        "#2563eb", "#dc2626", "#16a34a", "#ca8a04", "#9333ea", "#0891b2", "#e11d48", "#4f46e5"
    };

    private bool UseLegacyMode =>
        Series == null && (Bars != null || DataSource != null);

    private bool ShowLegend =>
        Legend?.Visible ?? true;

    private string RootStyle
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrEmpty(Width)) parts.Add($"width:{Width}");
            return string.Join(";", parts);
        }
    }

    private string[] EffectivePalette => ColorPalette ?? DefaultPalette;

    #endregion

    #region Lifecycle

    protected override void OnParametersSet()
    {
        if (CategoryLegend && (ThreeDimensional || !PrintedCategoryBarChart.Supports(Type)))
            throw new NotSupportedException("Category legends require a flat bar chart.");
        if (ThreeDimensional && !PrintedBarChart3D.Supports(Type))
            throw new NotSupportedException("3D rendering is available for bar charts.");
        if (UseLegacyMode)
        {
            ResolveLegacyData();
            if (ThreeDimensional || CategoryLegend)
            {
                if (Bars is { Count: > 0 })
                    _effectiveSeries = [new("Value", Type, Bars.Select(bar => new ChartDataPoint(bar.Label, bar.Value, bar.Color ?? BarColor)))];
                else
                    _effectiveSeries = Enumerable.Range(0, ValueFields?.Count ?? 0).Select(index => new ChartSeries(
                        index < (ValueLabels?.Count ?? 0) ? ValueLabels![index] : ValueFields![index], Type,
                        _resolvedRows.Select(row => new ChartDataPoint(row.Label, row.Values[index])))).ToList();
            }
        }
        else
        {
            _effectiveSeries = Series ?? new List<ChartSeries>();
        }
    }

    private void ResolveLegacyData()
    {
        if (Bars is { Count: > 0 })
        {
            _maxValue = Bars.Max(b => b.Value);
            if (_maxValue <= 0) _maxValue = 1;
            _resolvedRows.Clear();
            return;
        }

        _resolvedRows.Clear();
        if (DataSource == null || ValueFields == null || ValueFields.Count == 0) return;

        foreach (var item in DataSource)
        {
            if (item == null) continue;
            var label = LabelField != null ? GetPropertyString(item, LabelField) : "";
            var values = new List<double>(ValueFields.Count);
            foreach (var f in ValueFields)
                values.Add(GetPropertyDouble(item, f));
            _resolvedRows.Add(new ResolvedRow(label, values));
        }

        var allValues = _resolvedRows.SelectMany(r => r.Values);
        _maxValue = allValues.Any() ? allValues.Max() : 1;
        if (_maxValue <= 0) _maxValue = 1;
    }

    #endregion

    #region Tooltips (2026-10-31)
    private ChartTooltipContext? _tip;
    private double _tipX, _tipY;
    private bool _tipLeft, _tipUp;

    /// <summary>The pointer entered a shape: keep the pointer position, note which part of the drawing the shape is in so the card
    /// opens towards the middle, and tell the host. One round trip per shape, none per pixel.</summary>
    private async Task TipEnter(MouseEventArgs e, ChartTooltipContext ctx, double sx, double sy, double vbW, double vbH)
    {
        if (!ShowTooltips) return;
        _tip = ctx; _tipX = e.ClientX; _tipY = e.ClientY;
        _tipLeft = sx > vbW * 0.55; _tipUp = sy > vbH * 0.6;
        if (PointHover.HasDelegate) await PointHover.InvokeAsync(ctx);
    }

    private async Task TipLeave()
    {
        if (_tip is null) return;
        _tip = null;
        if (PointHover.HasDelegate) await PointHover.InvokeAsync(null);
    }

    /// <summary>Builds the context for a shape; without explicit fields the card shows the value, with the share when one is given,
    /// named after the series when several are drawn.</summary>
    private ChartTooltipContext MakeCtx(int si, int pi, string color, string title, double value, double? pct = null, ChartTooltipField[]? fields = null, string? label = null)
    {
        var series = si >= 0 && si < _effectiveSeries.Count ? _effectiveSeries[si] : new ChartSeries();
        var point = pi >= 0 && pi < series.DataPoints.Count ? series.DataPoints[pi] : new ChartDataPoint(label ?? title, value);
        var rows = fields ?? (pct is { } share
            ? new[] { new ChartTooltipField("Value", Fmt(value)), new ChartTooltipField("Share", share.ToString("0.#", CultureInfo.CurrentCulture) + "%") }
            : new[] { new ChartTooltipField(_effectiveSeries.Count > 1 && !string.IsNullOrEmpty(series.Name) ? series.Name : "Value", Fmt(value)) });
        return new ChartTooltipContext
        {
            Type = Type, Series = series, SeriesIndex = si, Point = point, PointIndex = pi,
            Title = title, Label = label ?? title, Value = value, Color = color, Percentage = pct, Fields = rows
        };
    }

    /// <summary>Numbers in the card: TooltipValueFormat, else N0 for whole numbers and N2 for the rest.</summary>
    private string Fmt(double v, string? format = null) =>
        v.ToString(format ?? TooltipValueFormat ?? (Math.Abs(v - Math.Round(v)) < 1e-9 && Math.Abs(v) < 1e15 ? "N0" : "N2"), CultureInfo.CurrentCulture);

    private ChartTooltipField Fld(string name, double v) => new(name, Fmt(v));

    /// <summary>The rows of the default card: the formatter's text, else the format pattern, else the context's own fields.</summary>
    private IReadOnlyList<ChartTooltipField> TooltipRows(ChartTooltipContext ctx)
    {
        var text = TooltipFormatter?.Invoke(ctx) ?? (TooltipFormat is null ? null : ApplyTooltipFormat(TooltipFormat, ctx));
        if (text is null) return ctx.Fields;
        return text.Split('\n').Select(l => new ChartTooltipField("", l.TrimEnd('\r'))).ToList();
    }

    private static readonly System.Text.RegularExpressions.Regex TooltipPlaceholder =
        new(@"\{(\w+)(?::([^}]+))?\}", System.Text.RegularExpressions.RegexOptions.Compiled);

    private string ApplyTooltipFormat(string pattern, ChartTooltipContext ctx) => TooltipPlaceholder.Replace(pattern, m =>
    {
        var key = m.Groups[1].Value.ToLowerInvariant();
        var format = m.Groups[2].Success ? m.Groups[2].Value : null;
        var point = ctx.Point;
        double? number = key switch
        {
            "value" => ctx.Value,
            "value2" or "size" or "high" or "max" or "target" => point.Value2,
            "value3" or "low" => point.Value3,
            "value4" or "close" => point.Value4,
            "value5" => point.Value5,
            "open" or "min" or "actual" => point.Value,
            "percent" => ctx.Percentage,
            _ => null,
        };
        if (number is { } n) return key == "percent" && format is null ? n.ToString("0.#", CultureInfo.CurrentCulture) + "%" : Fmt(n, format);
        return key switch { "series" => ctx.SeriesName ?? "", "label" => ctx.Label, "category" => point.Category ?? "", "title" => ctx.Title, _ => m.Value };
    });
    #endregion

    #region Helpers

    private string GetSeriesColor(int index)
    {
        if (index < _effectiveSeries.Count)
        {
            var series = _effectiveSeries[index];
            if (!string.IsNullOrEmpty(series.Color)) return series.Color!;
        }
        return EffectivePalette[index % EffectivePalette.Length];
    }

    private string GetPointColor(ChartDataPoint point, int seriesIndex, int pointIndex)
    {
        if (!string.IsNullOrEmpty(point.Color)) return point.Color!;
        if (_effectiveSeries.Count > 1) return GetSeriesColor(seriesIndex);
        return EffectivePalette[pointIndex % EffectivePalette.Length];
    }

    // Themed colours (2026-10-31): Range, HighLow, Sankey, Bullet, the Pareto line and the Heatmap ramp drew fixed colours and ignored
    // ColorPalette. They keep those colours by default and take the caller's colours when given, so a themed page themes them too.

    /// <summary>ColorPalette[index] when the palette has that entry, otherwise the type's own fixed colour. No cycling: a secondary role
    /// (a target line, a Pareto line) never falls onto the same colour as the primary one.</summary>
    private string PaletteOr(int index, string fallback) =>
        ColorPalette is not null && index < ColorPalette.Length && !string.IsNullOrEmpty(ColorPalette[index]) ? ColorPalette[index] : fallback;

    /// <summary>A single-series type's main colour: the first series' Color, then ColorPalette[0], then the fallback.</summary>
    private string ThemedSeriesColor(string fallback) =>
        _effectiveSeries.Count > 0 && !string.IsNullOrEmpty(_effectiveSeries[0].Color) ? _effectiveSeries[0].Color! : PaletteOr(0, fallback);

    /// <summary>The point's Color when set, otherwise <see cref="ThemedSeriesColor"/>.</summary>
    private string ThemedPointColor(ChartDataPoint point, string fallback) =>
        !string.IsNullOrEmpty(point.Color) ? point.Color! : ThemedSeriesColor(fallback);

    /// <summary>UpColor or DownColor for a rise (true) or fall, or the type's own colour when that parameter is unset or empty.</summary>
    private string DirectionColor(bool rising, string upFallback, string downFallback) =>
        rising ? (string.IsNullOrEmpty(UpColor) ? upFallback : UpColor) : (string.IsNullOrEmpty(DownColor) ? downFallback : DownColor);

    /// <summary>"#rgb" or "#rrggbb" as bytes; null for anything else (a named colour, rgb(), a variable).</summary>
    private static (int R, int G, int B)? ParseHex(string? color)
    {
        if (string.IsNullOrEmpty(color) || color[0] != '#') return null;
        var hex = color.Length == 4 ? string.Concat(color[1], color[1], color[2], color[2], color[3], color[3]) : color.Length == 7 ? color[1..] : null;
        return hex is not null && int.TryParse(hex, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var v)
            ? ((v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF) : null;
    }

    private static string F(double v) => v.ToString("F2", CultureInfo.InvariantCulture);
    private static string F1(double v) => v.ToString("F1", CultureInfo.InvariantCulture);
    private static string F0(double v) => v.ToString("F0", CultureInfo.InvariantCulture);

    private static string PercentOf(double value, double max)
    {
        if (max <= 0) return "0";
        var pct = (value / max) * 100.0;
        if (pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        return pct.ToString("F2", CultureInfo.InvariantCulture);
    }

    private string ResolveBarColor(ChartBar bar) =>
        !string.IsNullOrEmpty(bar.Color) ? bar.Color! : (BarColor ?? "#2563eb");

    private static string GetPropertyString(object obj, string propName)
    {
        var p = obj.GetType().GetProperty(propName);
        return p?.GetValue(obj)?.ToString() ?? "";
    }

    private static double GetPropertyDouble(object obj, string propName)
    {
        var p = obj.GetType().GetProperty(propName);
        if (p == null) return 0;
        var v = p.GetValue(obj);
        if (v == null) return 0;
        try { return Convert.ToDouble(v, CultureInfo.InvariantCulture); }
        catch { return 0; }
    }

    private (double min, double max) GetDataRange(List<ChartSeries> series)
    {
        var allValues = series.SelectMany(s => s.DataPoints.Where(p => !p.IsEmpty).Select(p => p.Value));
        if (!allValues.Any()) return (0, 1);
        var min = allValues.Min();
        var max = allValues.Max();
        if (Math.Abs(max - min) < 0.001) { min -= 1; max += 1; }
        return (min, max);
    }

    private (double min, double max) GetNiceRange(double dataMin, double dataMax)
    {
        var min = YAxis?.Min ?? (dataMin >= 0 ? 0 : dataMin * 1.1);
        var max = YAxis?.Max ?? dataMax * 1.1;
        if (max <= min) max = min + 1;
        return (min, max);
    }

    private List<double> GetTicks(double min, double max, int count)
    {
        var ticks = new List<double>();
        var step = (max - min) / (count - 1);
        for (int i = 0; i < count; i++)
            ticks.Add(min + step * i);
        return ticks;
    }

    /// <summary>
    /// Helper to emit SVG text elements. Razor treats &lt;text&gt; as a directive,
    /// so we build the markup as a raw MarkupString instead.
    /// </summary>
    private static MarkupString SvgText(string x, string y, string content,
        string? anchor = null, string? fontSize = null, string? fill = null,
        string? fontWeight = null, string? transform = null, string? fontStyle = null)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<text");
        sb.Append($" x=\"{x}\" y=\"{y}\"");
        if (anchor != null) sb.Append($" text-anchor=\"{anchor}\"");
        if (fontSize != null) sb.Append($" font-size=\"{fontSize}\"");
        if (fill != null) sb.Append($" fill=\"{fill}\"");
        if (fontWeight != null) sb.Append($" font-weight=\"{fontWeight}\"");
        if (fontStyle != null) sb.Append($" font-style=\"{fontStyle}\"");
        if (transform != null) sb.Append($" transform=\"{transform}\"");
        sb.Append('>');
        sb.Append(System.Net.WebUtility.HtmlEncode(content));
        sb.Append("</text>");
        return new MarkupString(sb.ToString());
    }

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..max] : s;

    private record ResolvedRow(string Label, List<double> Values);

    #endregion

    #region Render — Bar Charts (Bar, HorizontalBar, GroupedBar, StackedBar, StackedBar100, Pareto, ComboBarLine)

    private RenderFragment RenderBarChart() => __builder =>
    {
        var print = UsePrintBarLayout;
        double svgW = print ? PrintWidthPoints : 600, svgH = print ? PrintHeightPoints : 300;
        double padL = print ? svgW * .063 : 60, padR = print ? svgW * .027 : 20;
        double padT = print ? svgH * .13 : 20, padB = print ? svgH * .22 : 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        var series = _effectiveSeries;
        if (series.Count == 0) return;

        var labels = series[0].DataPoints.Select(p => p.Label).ToList();
        int n = labels.Count;
        if (n == 0) return;

        bool isStacked = Type == ChartType.StackedBar || Type == ChartType.StackedBar100;
        bool isGrouped = Type == ChartType.GroupedBar || (series.Count > 1 && !isStacked);
        bool isPareto = Type == ChartType.Pareto;
        bool isCombo = Type == ChartType.ComboBarLine;

        double maxVal;
        if (isStacked || Type == ChartType.StackedBar100)
        {
            maxVal = 0;
            for (int i = 0; i < n; i++)
            {
                double sum = series.Sum(s => i < s.DataPoints.Count ? Math.Abs(s.DataPoints[i].Value) : 0);
                if (sum > maxVal) maxVal = sum;
            }
            if (Type == ChartType.StackedBar100) maxVal = 100;
        }
        else
        {
            maxVal = series.SelectMany(s => s.DataPoints.Where(p => !p.IsEmpty).Select(p => p.Value)).DefaultIfEmpty(0).Max();
        }
        if (maxVal <= 0) maxVal = 1;
        var minVal = isStacked ? 0 : Math.Min(0, series.SelectMany(s => s.DataPoints.Where(p => !p.IsEmpty).Select(p => p.Value)).DefaultIfEmpty(0).Min());
        var (rangeMin, rangeMax) = GetNiceRange(minVal, maxVal);

        int tickCount = Math.Max(2, YAxis?.TickCount ?? 5);
        if (print && YAxis?.Min == null && YAxis?.Max == null)
        {
            (rangeMin, rangeMax, tickCount) = BarPrintScale.Range(minVal, maxVal);
        }
        double barGroupWidth = plotW / n;
        double barGap = barGroupWidth * 0.2;
        double usableWidth = barGroupWidth - barGap;
        var categoryCaptions = labels.Select(label => print ? label : Truncate(label, 10)).ToArray();
        var visibleLabels = ChartAxisLabelLayout.Select(categoryCaptions,
            index => padL + (index+.5)*barGroupWidth, print ? 6.5 : 10, bold: print, italic: print, axis: XAxis);

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             width="100%" style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @if (print)
            {
                @SvgText(F(svgW / 2), F(padT * .72), Title ?? "", anchor: "middle", fontSize: "10", fontWeight: "bold")
                <rect x="@F(padL)" y="@F(padT)" width="@F(plotW)" height="@F(plotH)" fill="none" stroke="black" stroke-width=".75" />
            }
            @{ var ticks = GetTicks(rangeMin, rangeMax, tickCount); }
            @foreach (var tick in ticks)
            {
                double y = padT + plotH - (tick - rangeMin) / (rangeMax - rangeMin) * plotH;
                @if (YAxis?.ShowGridLines != false)
                {
                <line x1="@F(padL)" y1="@F(y)" x2="@F(svgW - padR)" y2="@F(y)"
                      stroke="@(print ? "black" : "#e5e7eb")" stroke-width="@(print ? ".75" : "1")" stroke-dasharray="@(print ? null : "4,2")" />
                }
                @SvgText(F(padL - (print ? 3 : 8)), F(y + (print ? 2 : 4)), F0(tick), anchor: "end", fontSize: print ? "6.5" : "10", fill: print ? "black" : "#6b7280", fontWeight: print ? "bold" : null)
            }

            <line x1="@F(padL)" y1="@F(padT)" x2="@F(padL)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />
            <line x1="@F(padL)" y1="@F(padT + plotH)" x2="@F(svgW - padR)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />

            @for (int i = 0; i < n; i++)
            {
                double groupX = padL + i * barGroupWidth + barGap / 2;

                if (isStacked)
                {
                    double cumY = 0;
                    for (int si = 0; si < series.Count; si++)
                    {
                        if (i < series[si].DataPoints.Count && series[si].DataPoints[i].IsEmpty) continue;
                        double val = i < series[si].DataPoints.Count ? series[si].DataPoints[i].Value : 0;
                        if (Type == ChartType.StackedBar100)
                        {
                            double total = series.Sum(s => i < s.DataPoints.Count ? s.DataPoints[i].Value : 0);
                            val = total > 0 ? (val / total) * 100 : 0;
                        }
                        double barH = (val / (rangeMax - rangeMin)) * plotH;
                        double barY = padT + plotH - cumY - barH;
                        var sIdx = si; var pIdx = i;
                        <rect class="fx-pt" x="@F(groupX)" y="@F(barY)" width="@F(usableWidth)" height="@F(Math.Max(barH, 0))"
                              fill="@GetSeriesColor(si)" rx="2"
                              @onmouseover="e => TipEnter(e, MakeCtx(sIdx, pIdx, GetSeriesColor(sIdx), labels[pIdx], val), groupX + usableWidth / 2, barY, svgW, svgH)" @onmouseout="TipLeave">
                            @if (!ShowTooltips) { <title>@series[si].Name: @F1(val)</title> }
                        </rect>
                        cumY += barH;
                    }
                }
                else if (isGrouped)
                {
                    double subBarW = usableWidth / series.Count;
                    for (int si = 0; si < series.Count; si++)
                    {
                        if (i < series[si].DataPoints.Count && series[si].DataPoints[i].IsEmpty) continue;
                        double val = i < series[si].DataPoints.Count ? series[si].DataPoints[i].Value : 0;
                        double zeroY = Math.Clamp(padT + plotH - (0 - rangeMin) / (rangeMax - rangeMin) * plotH, padT, padT + plotH);   // YAxis.Min > 0 / Max < 0 put zero outside the plot
                        double valueY = Math.Clamp(padT + plotH - (val - rangeMin) / (rangeMax - rangeMin) * plotH, padT, padT + plotH);
                        double barH = Math.Abs(valueY - zeroY);
                        double barY = Math.Min(valueY, zeroY);
                        double barX = groupX + si * subBarW;
                        var sIdx = si; var pIdx = i;
                        <rect class="fx-pt" x="@F(barX)" y="@F(barY)" width="@F(subBarW * 0.9)" height="@F(Math.Max(barH, 0))"
                              fill="@GetSeriesColor(si)" rx="2"
                              @onmouseover="e => TipEnter(e, MakeCtx(sIdx, pIdx, GetSeriesColor(sIdx), labels[pIdx], val), barX + subBarW * 0.45, barY, svgW, svgH)" @onmouseout="TipLeave">
                            @if (!ShowTooltips) { <title>@series[si].Name: @F1(val)</title> }
                        </rect>
                    }
                }
                else if (i >= series[0].DataPoints.Count || !series[0].DataPoints[i].IsEmpty)
                {
                    double val = i < series[0].DataPoints.Count ? series[0].DataPoints[i].Value : 0;
                    double zeroY = Math.Clamp(padT + plotH - (0 - rangeMin) / (rangeMax - rangeMin) * plotH, padT, padT + plotH);   // YAxis.Min > 0 / Max < 0 put zero outside the plot
                    double valueY = Math.Clamp(padT + plotH - (val - rangeMin) / (rangeMax - rangeMin) * plotH, padT, padT + plotH);
                    double barH = Math.Abs(valueY - zeroY);
                    double barY = Math.Min(valueY, zeroY);
                    string color = i < series[0].DataPoints.Count && !string.IsNullOrEmpty(series[0].DataPoints[i].Color)
                        ? series[0].DataPoints[i].Color!
                        : ColorBarsByCategory ? GetPointColor(series[0].DataPoints[i], 0, i) : GetSeriesColor(0);
                    var pIdx = i;
                    <rect class="fx-pt" x="@F(groupX)" y="@F(barY)" width="@F(usableWidth)" height="@F(Math.Max(barH, 0))"
                          fill="@color" rx="@(print ? 0 : 2)"
                          @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, color, labels[pIdx], val), groupX + usableWidth / 2, barY, svgW, svgH)" @onmouseout="TipLeave">
                        @if (!ShowTooltips) { <title>@labels[i]: @F1(val)</title> }
                    </rect>
                }

                if (ShowAxisLabels && visibleLabels.Contains(i))
                {
                    double labelX = groupX + usableWidth / 2;
                    @SvgText(F(labelX), F(padT + plotH + (print ? 10 : 16)), categoryCaptions[i], anchor: "middle", fontSize: print ? "6.5" : "10", fill: print ? "black" : "#6b7280", fontWeight: print ? "bold" : null, fontStyle: print ? "italic" : null)
                }
            }

            @if (isPareto && series.Count > 0 && n > 0)
            {
                double totalVal = series[0].DataPoints.Sum(p => p.Value);
                double cum = 0;
                var points = new List<string>();
                for (int i = 0; i < n; i++)
                {
                    cum += series[0].DataPoints[i].Value;
                    double pct = totalVal > 0 ? cum / totalVal : 0;
                    double px = padL + i * barGroupWidth + barGroupWidth / 2;
                    double py = padT + plotH - pct * plotH;
                    points.Add($"{F(px)},{F(py)}");
                }
                <polyline points="@string.Join(" ", points)" fill="none"
                          stroke="@PaletteOr(1, "#dc2626")" stroke-width="2" />
            }

            @if (isCombo && series.Count > 1)
            {
                var lineSeries = series[1];
                var lineMax = lineSeries.DataPoints.Select(p => p.Value).DefaultIfEmpty(0).Max();
                if (lineMax <= 0) lineMax = 1;
                var points = new List<string>();
                for (int i = 0; i < lineSeries.DataPoints.Count && i < n; i++)
                {
                    double px = padL + i * barGroupWidth + barGroupWidth / 2;
                    double py = padT + plotH - (lineSeries.DataPoints[i].Value / lineMax) * plotH;
                    points.Add($"{F(px)},{F(py)}");
                }
                <polyline points="@string.Join(" ", points)" fill="none"
                          stroke="@GetSeriesColor(1)" stroke-width="2" />
                @foreach (var pt in points)
                {
                    var coords = pt.Split(',');
                    <circle cx="@coords[0]" cy="@coords[1]" r="3" fill="@GetSeriesColor(1)" />
                }
            }

            @if (!string.IsNullOrEmpty(YAxis?.Title))
            {
                @SvgText("14", F(padT + plotH / 2), YAxis!.Title!, anchor: "middle", fontSize: "11", fill: "#374151",
                    transform: $"rotate(-90, 14, {F(padT + plotH / 2)})")
            }
            @if (!string.IsNullOrEmpty(XAxis?.Title))
            {
                @SvgText(F(padL + plotW / 2), F(svgH - 4), XAxis!.Title!, anchor: "middle", fontSize: "11", fill: "#374151")
            }
        </svg>
    };

    #endregion

    #region Render — Line/Area Charts

    private RenderFragment RenderLineArea() => __builder =>
    {
        const double svgW = 600, svgH = 300;
        const double padL = 60, padR = 20, padT = 20, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        var series = _effectiveSeries;
        if (series.Count == 0) return;

        var (dataMin, dataMax) = GetDataRange(series);
        var (rangeMin, rangeMax) = GetNiceRange(dataMin, dataMax);
        int maxPoints = series.Max(s => s.DataPoints.Count);
        if (maxPoints == 0) return;

        bool isArea = Type == ChartType.Area || Type == ChartType.StackedArea;
        bool isStep = Type == ChartType.StepLine;
        bool isSpline = Type == ChartType.Spline;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @{ var ticks = GetTicks(rangeMin, rangeMax, YAxis?.TickCount ?? 5); }
            @foreach (var tick in ticks)
            {
                double y = padT + plotH - (tick - rangeMin) / (rangeMax - rangeMin) * plotH;
                <line x1="@F(padL)" y1="@F(y)" x2="@F(svgW - padR)" y2="@F(y)"
                      stroke="#e5e7eb" stroke-width="1" stroke-dasharray="4,2" />
                @SvgText(F(padL - 8), F(y + 4), F0(tick), anchor: "end", fontSize: "10", fill: "#6b7280")
            }

            <line x1="@F(padL)" y1="@F(padT)" x2="@F(padL)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />
            <line x1="@F(padL)" y1="@F(padT + plotH)" x2="@F(svgW - padR)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />

            @for (int si = 0; si < series.Count; si++)
            {
                var s = series[si];
                var pts = s.DataPoints;
                if (pts.Count == 0) continue;

                if (Type == ChartType.Line && pts.Any(point => point.IsEmpty))
                {
                    var path = new System.Text.StringBuilder();
                    var move = true;
                    for (var index = 0; index < pts.Count; index++)
                    {
                        if (pts[index].IsEmpty) { move = true; continue; }
                        var x = padL + (maxPoints > 1 ? (double)index / (maxPoints - 1) * plotW : plotW / 2);
                        var y = padT + plotH - (pts[index].Value - rangeMin) / (rangeMax - rangeMin) * plotH;
                        path.Append(move ? "M" : " L").Append(F(x)).Append(',').Append(F(y));
                        move = false;
                        var sIdxG = si; var pIdxG = index;
                        <circle class="fx-pt" cx="@F(x)" cy="@F(y)" r="3" fill="@GetSeriesColor(si)" stroke="transparent" stroke-width="10"
                                @onmouseover="e => TipEnter(e, MakeCtx(sIdxG, pIdxG, GetSeriesColor(sIdxG), pts[pIdxG].Label, pts[pIdxG].Value), x, y, svgW, svgH)" @onmouseout="TipLeave">
                            @if (!ShowTooltips) { <title>@pts[index].Label: @F1(pts[index].Value)</title> }
                        </circle>
                    }
                    <path d="@path.ToString()" fill="none" stroke="@GetSeriesColor(si)" stroke-width="2" />
                    continue;
                }

                var pointCoords = new List<(double x, double y, int i)>();
                for (int i = 0; i < pts.Count; i++)
                {
                    double x = padL + (maxPoints > 1 ? (double)i / (maxPoints - 1) * plotW : plotW / 2);
                    double y = padT + plotH - (pts[i].Value - rangeMin) / (rangeMax - rangeMin) * plotH;
                    pointCoords.Add((x, y, i));
                }

                string pathData;
                if (isStep)
                {
                    var sb = new System.Text.StringBuilder();
                    for (int i = 0; i < pointCoords.Count; i++)
                    {
                        if (i == 0) sb.Append($"M{F(pointCoords[i].x)},{F(pointCoords[i].y)}");
                        else
                        {
                            sb.Append($" H{F(pointCoords[i].x)}");
                            sb.Append($" V{F(pointCoords[i].y)}");
                        }
                    }
                    pathData = sb.ToString();
                }
                else if (isSpline && pointCoords.Count > 2)
                {
                    var sb = new System.Text.StringBuilder();
                    sb.Append($"M{F(pointCoords[0].x)},{F(pointCoords[0].y)}");
                    for (int i = 1; i < pointCoords.Count; i++)
                    {
                        var prev = pointCoords[i - 1];
                        var curr = pointCoords[i];
                        double cpx = (prev.x + curr.x) / 2;
                        sb.Append($" C{F(cpx)},{F(prev.y)} {F(cpx)},{F(curr.y)} {F(curr.x)},{F(curr.y)}");
                    }
                    pathData = sb.ToString();
                }
                else
                {
                    pathData = "M" + string.Join(" L", pointCoords.Select(p => $"{F(p.x)},{F(p.y)}"));
                }

                string color = GetSeriesColor(si);

                @if (isArea)
                {
                    string areaPath = pathData +
                        $" L{F(pointCoords[^1].x)},{F(padT + plotH)} L{F(pointCoords[0].x)},{F(padT + plotH)} Z";
                    <path d="@areaPath" fill="@color" fill-opacity="0.15" stroke="none" />
                }

                <path d="@pathData" fill="none" stroke="@color" stroke-width="2" />

                var sIdx = si;
                @foreach (var (x, y, pi) in pointCoords)
                {
                    <circle class="fx-pt" cx="@F(x)" cy="@F(y)" r="3" fill="@color" stroke="transparent" stroke-width="10"
                            @onmouseover="e => TipEnter(e, MakeCtx(sIdx, pi, color, pts[pi].Label, pts[pi].Value), x, y, svgW, svgH)" @onmouseout="TipLeave">
                        @if (!ShowTooltips) { <title>@pts[pi].Label: @F1(pts[pi].Value)</title> }
                    </circle>
                }
            }

            @if (ShowAxisLabels && series[0].DataPoints.Count > 0)
            {
                var captions = series[0].DataPoints.Select(point => Truncate(point.Label, 8)).ToArray();
                double LabelX(int index) => padL + (maxPoints > 1 ? (double)index/(maxPoints-1)*plotW : plotW/2);
                var visibleLabels = ChartAxisLabelLayout.Select(captions, LabelX, 10, axis: XAxis);
                foreach (var index in visibleLabels.Order())
                {
                    @SvgText(F(LabelX(index)), F(padT + plotH + 16), captions[index], anchor: "middle", fontSize: "10", fill: "#6b7280")
                }
            }

            @if (!string.IsNullOrEmpty(YAxis?.Title))
            {
                @SvgText("14", F(padT + plotH / 2), YAxis!.Title!, anchor: "middle", fontSize: "11", fill: "#374151",
                    transform: $"rotate(-90, 14, {F(padT + plotH / 2)})")
            }
            @if (!string.IsNullOrEmpty(XAxis?.Title))
            {
                @SvgText(F(padL + plotW / 2), F(svgH - 4), XAxis!.Title!, anchor: "middle", fontSize: "11", fill: "#374151")
            }
        </svg>
    };

    #endregion

    #region Render — Sparkline

    private RenderFragment RenderSparkline() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        var pts = _effectiveSeries[0].DataPoints;
        double minV = pts.Min(p => p.Value);
        double maxV = pts.Max(p => p.Value);
        if (Math.Abs(maxV - minV) < 0.001) { minV -= 1; maxV += 1; }

        const double w = 200, h = 40;
        var coords = new List<string>();
        for (int i = 0; i < pts.Count; i++)
        {
            double x = pts.Count > 1 ? (double)i / (pts.Count - 1) * w : w / 2;
            double y = h - (pts[i].Value - minV) / (maxV - minV) * h;
            coords.Add($"{F(x)},{F(y)}");
        }

        string color = GetSeriesColor(0);

        <svg viewBox="0 0 @F0(w) @F0(h)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "40px"); width:100%;" xmlns="http://www.w3.org/2000/svg">
            <polyline points="@string.Join(" ", coords)" fill="none"
                      stroke="@color" stroke-width="1.5" />
        </svg>
    };

    #endregion

    #region Render — Pie / Donut

    private RenderFragment RenderPieDonut() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        var pts = _effectiveSeries[0].DataPoints;
        double total = pts.Sum(p => Math.Abs(p.Value));
        if (total <= 0) return;

        const double size = 300;
        double cx = size / 2, cy = size / 2;
        double radius = size * 0.4;
        double inner = Type == ChartType.Donut ? radius * (InnerRadius ?? 0.6) : 0;

        double startAngle = -Math.PI / 2;

        <svg viewBox="0 0 @F0(size) @F0(size)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">
            @for (int i = 0; i < pts.Count; i++)
            {
                double sliceAngle = (Math.Abs(pts[i].Value) / total) * 2 * Math.PI;
                double endAngle = startAngle + sliceAngle;
                int largeArc = sliceAngle > Math.PI ? 1 : 0;

                double x1 = cx + radius * Math.Cos(startAngle);
                double y1 = cy + radius * Math.Sin(startAngle);
                double x2 = cx + radius * Math.Cos(endAngle);
                double y2 = cy + radius * Math.Sin(endAngle);

                string path;
                if (inner > 0)
                {
                    double ix1 = cx + inner * Math.Cos(startAngle);
                    double iy1 = cy + inner * Math.Sin(startAngle);
                    double ix2 = cx + inner * Math.Cos(endAngle);
                    double iy2 = cy + inner * Math.Sin(endAngle);
                    path = $"M{F(ix1)},{F(iy1)} L{F(x1)},{F(y1)} A{F(radius)},{F(radius)} 0 {largeArc} 1 {F(x2)},{F(y2)} L{F(ix2)},{F(iy2)} A{F(inner)},{F(inner)} 0 {largeArc} 0 {F(ix1)},{F(iy1)} Z";
                }
                else
                {
                    path = $"M{F(cx)},{F(cy)} L{F(x1)},{F(y1)} A{F(radius)},{F(radius)} 0 {largeArc} 1 {F(x2)},{F(y2)} Z";
                }

                string color = GetPointColor(pts[i], 0, i);
                double pct = (Math.Abs(pts[i].Value) / total) * 100;

                var pIdx = i;
                double midAngle = (startAngle + endAngle) / 2;
                double tipX = cx + radius * 0.6 * Math.Cos(midAngle), tipY = cy + radius * 0.6 * Math.Sin(midAngle);
                <path class="fx-pt" d="@path" fill="@color" stroke="white" stroke-width="1.5"
                      @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, color, pts[pIdx].Label, pts[pIdx].Value, pct), tipX, tipY, size, size)" @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@pts[i].Label: @F1(pts[i].Value) (@F1(pct)%)</title> }
                </path>

                startAngle = endAngle;
            }
        </svg>

        <div class="fx-chart-legend">
            @for (int i = 0; i < pts.Count; i++)
            {
                string color = GetPointColor(pts[i], 0, i);
                <div class="fx-chart-legend-item">
                    <div class="fx-chart-legend-swatch" style="background:@color"></div>
                    <span>@pts[i].Label</span>
                </div>
            }
        </div>
    };

    #endregion

    #region Render — Sunburst

    private RenderFragment RenderSunburst() => __builder =>
    {
        var root = BuildSunburstFromSeries();
        if (root == null) return;
        <SunburstChartControl RootNode="@root" Height="@(Height ?? "360px")" EnableDrilldown="true" ShowBreadcrumb="true" />
    };

    private SunburstNode? BuildSunburstFromSeries()
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return null;
        var pts = _effectiveSeries[0].DataPoints;
        var root = new SunburstNode(string.IsNullOrEmpty(Title) ? "Total" : Title, 0);
        var groups = pts.GroupBy(p => string.IsNullOrEmpty(p.Category) ? "General" : p.Category);
        int idx = 0;
        foreach (var grp in groups)
        {
            var catNode = new SunburstNode(grp.Key, 0, GetSeriesColor(idx++));
            foreach (var pt in grp)
            {
                var ptColor = pt.Color ?? SunburstColorHelper.Darken(catNode.Color ?? "#4a90e2", 0.08);
                catNode.AddChild(new SunburstNode(pt.Label, pt.Value, pt.Value2 ?? 0, ptColor));
            }
            root.AddChild(catNode);
        }
        return root;
    }

    #endregion

    #region Render — Scatter / Bubble

    private RenderFragment RenderScatterBubble() => __builder =>
    {
        const double svgW = 600, svgH = 300;
        const double padL = 60, padR = 20, padT = 20, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        var series = _effectiveSeries;
        if (series.Count == 0) return;

        var allPoints = series.SelectMany(s => s.DataPoints).Where(p => !p.IsEmpty).ToList();
        if (allPoints.Count == 0) return;
        double xMin = 0, xMax = 1, yMin = 0, yMax = 1;

        var xValues = allPoints.Select(p =>
        {
            double.TryParse(p.Label, NumberStyles.Any, CultureInfo.InvariantCulture, out var v);
            return v;
        }).ToList();
        if (xValues.Count > 0) { xMin = xValues.Min(); xMax = xValues.Max(); }
        if (Math.Abs(xMax - xMin) < 0.001) { xMin -= 1; xMax += 1; }

        yMin = allPoints.Min(p => p.Value);
        yMax = allPoints.Max(p => p.Value);
        if (Math.Abs(yMax - yMin) < 0.001) { yMin -= 1; yMax += 1; }

        double bubbleMax = Type == ChartType.Bubble
            ? allPoints.Where(p => p.Value2.HasValue).Select(p => p.Value2!.Value).DefaultIfEmpty(1).Max()
            : 1;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @{ var yTicks = GetTicks(yMin, yMax, 5); }
            @foreach (var tick in yTicks)
            {
                double y = padT + plotH - (tick - yMin) / (yMax - yMin) * plotH;
                <line x1="@F(padL)" y1="@F(y)" x2="@F(svgW - padR)" y2="@F(y)"
                      stroke="#e5e7eb" stroke-width="1" stroke-dasharray="4,2" />
                @SvgText(F(padL - 8), F(y + 4), F0(tick), anchor: "end", fontSize: "10", fill: "#6b7280")
            }

            <line x1="@F(padL)" y1="@F(padT + plotH)" x2="@F(svgW - padR)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />
            <line x1="@F(padL)" y1="@F(padT)" x2="@F(padL)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />

            @for (int si = 0; si < series.Count; si++)
            {
                string color = GetSeriesColor(si);
                for (int pi = 0; pi < series[si].DataPoints.Count; pi++)
                {
                    var pt = series[si].DataPoints[pi];
                    var sIdx = si; var pIdx = pi;
                    double.TryParse(pt.Label, NumberStyles.Any, CultureInfo.InvariantCulture, out var xVal);
                    double px = padL + (xVal - xMin) / (xMax - xMin) * plotW;
                    double py = padT + plotH - (pt.Value - yMin) / (yMax - yMin) * plotH;
                    double r = Type == ChartType.Bubble && pt.Value2.HasValue
                        ? 4 + (Math.Max(0, pt.Value2.Value) / Math.Max(double.Epsilon, bubbleMax)) * 20
                        : 5;
                    var scatterFields = Type == ChartType.Bubble && pt.Value2.HasValue
                        ? new[] { Fld("X", xVal), Fld("Y", pt.Value), Fld("Size", pt.Value2.Value) }
                        : new[] { Fld("X", xVal), Fld("Y", pt.Value) };
                    <circle class="fx-pt" cx="@F(px)" cy="@F(py)" r="@F(r)" fill="@color" fill-opacity="0.7" stroke="@color"
                            @onmouseover="e => TipEnter(e, MakeCtx(sIdx, pIdx, color, string.IsNullOrEmpty(series[sIdx].Name) ? pt.Label : series[sIdx].Name, pt.Value, null, scatterFields, pt.Label), px, py, svgW, svgH)" @onmouseout="TipLeave">
                        @if (!ShowTooltips) { <title>(@F1(xVal), @F1(pt.Value))</title> }
                    </circle>
                }
            }
        </svg>
    };

    #endregion

    #region Render — Radar

    private RenderFragment RenderRadar() => __builder =>
    {
        if (_effectiveSeries.Count == 0) return;

        const double size = 300;
        double cx = size / 2, cy = size / 2;
        double radius = size * 0.38;

        var labels = _effectiveSeries[0].DataPoints.Select(p => p.Label).ToList();
        int n = labels.Count;
        if (n < 3) return;

        double maxVal = _effectiveSeries.SelectMany(s => s.DataPoints.Select(p => p.Value)).DefaultIfEmpty(1).Max();
        if (maxVal <= 0) maxVal = 1;

        <svg viewBox="0 0 @F0(size) @F0(size)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @for (int ring = 1; ring <= 4; ring++)
            {
                double r = radius * ring / 4.0;
                var ringPts = new List<string>();
                for (int i = 0; i < n; i++)
                {
                    double angle = -Math.PI / 2 + 2 * Math.PI * i / n;
                    ringPts.Add($"{F(cx + r * Math.Cos(angle))},{F(cy + r * Math.Sin(angle))}");
                }
                <polygon points="@string.Join(" ", ringPts)" fill="none" stroke="#e5e7eb" stroke-width="0.5" />
            }

            @for (int i = 0; i < n; i++)
            {
                double angle = -Math.PI / 2 + 2 * Math.PI * i / n;
                double ex = cx + radius * Math.Cos(angle);
                double ey = cy + radius * Math.Sin(angle);
                <line x1="@F(cx)" y1="@F(cy)" x2="@F(ex)" y2="@F(ey)"
                      stroke="#d1d5db" stroke-width="0.5" />
                double lx = cx + (radius + 14) * Math.Cos(angle);
                double ly = cy + (radius + 14) * Math.Sin(angle);
                @SvgText(F(lx), F(ly), Truncate(labels[i], 8), anchor: "middle", fontSize: "9", fill: "#6b7280")
            }

            @for (int si = 0; si < _effectiveSeries.Count; si++)
            {
                var s = _effectiveSeries[si];
                var polyPts = new List<string>();
                for (int i = 0; i < n && i < s.DataPoints.Count; i++)
                {
                    double angle = -Math.PI / 2 + 2 * Math.PI * i / n;
                    double r = (s.DataPoints[i].Value / maxVal) * radius;
                    polyPts.Add($"{F(cx + r * Math.Cos(angle))},{F(cy + r * Math.Sin(angle))}");
                }
                string color = GetSeriesColor(si);
                <polygon points="@string.Join(" ", polyPts)" fill="@color" fill-opacity="0.2"
                         stroke="@color" stroke-width="2" />
                @if (ShowTooltips)
                {
                    var sIdx = si;
                    for (int i = 0; i < n && i < s.DataPoints.Count; i++)
                    {
                        var pIdx = i;
                        double angle = -Math.PI / 2 + 2 * Math.PI * i / n;
                        double r = (s.DataPoints[i].Value / maxVal) * radius;
                        double vx = cx + r * Math.Cos(angle), vy = cy + r * Math.Sin(angle);
                        <circle class="fx-pt" cx="@F(vx)" cy="@F(vy)" r="3" fill="@color" stroke="transparent" stroke-width="10"
                                @onmouseover="e => TipEnter(e, MakeCtx(sIdx, pIdx, color, labels[pIdx], s.DataPoints[pIdx].Value), vx, vy, size, size)" @onmouseout="TipLeave" />
                    }
                }
            }
        </svg>
    };

    #endregion

    #region Render — Gauge

    private RenderFragment RenderGauge() => @<GaugeVisualControl Type="@Type" Value="@(GaugeValue ?? _effectiveSeries.FirstOrDefault()?.DataPoints.FirstOrDefault()?.Value ?? 0)"
        Min="@(GaugeMin ?? 0)" Max="@(GaugeMax ?? 100)" Ranges="@GaugeRanges" Pointers="@GaugePointers" Circular="@GaugeCircular"
        Color="@GetSeriesColor(0)" TickCount="@GaugeTickCount" ShowValue="@GaugeShowValue" LabelFormat="@GaugeLabelFormat" ValueFormat="@ValueFormat" Height="@(Height ?? "260px")" />;

    #endregion

    #region Render — KPI Card

    private RenderFragment RenderKpiCard() => __builder =>
    {
        string trendClass = "";
        string arrow = "";
        if (!string.IsNullOrEmpty(KpiTrend))
        {
            if (KpiTrend!.StartsWith("+") || KpiTrend.Contains("up", StringComparison.OrdinalIgnoreCase))
