    #region Render — Waterfall

    private RenderFragment RenderWaterfall() => __builder =>
    {
        const double svgW = 600, svgH = 300;
        const double padL = 60, padR = 20, padT = 20, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        var pts = _effectiveSeries[0].DataPoints;
        int n = pts.Count;

        var cumulative = new double[n + 1];
        cumulative[0] = 0;
        for (int i = 0; i < n; i++)
            cumulative[i + 1] = cumulative[i] + pts[i].Value;

        double minCum = cumulative.Min();
        double maxCum = cumulative.Max();
        if (Math.Abs(maxCum - minCum) < 0.001) { minCum -= 1; maxCum += 1; }
        var (rangeMin, rangeMax) = GetNiceRange(minCum, maxCum);

        double barW = plotW / n;
        double gap = barW * 0.2;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @{ var ticks = GetTicks(rangeMin, rangeMax, 5); }
            @foreach (var tick in ticks)
            {
                double y = padT + plotH - (tick - rangeMin) / (rangeMax - rangeMin) * plotH;
                <line x1="@F(padL)" y1="@F(y)" x2="@F(svgW - padR)" y2="@F(y)"
                      stroke="#e5e7eb" stroke-width="1" stroke-dasharray="4,2" />
                @SvgText(F(padL - 8), F(y + 4), F0(tick), anchor: "end", fontSize: "10", fill: "#6b7280")
            }

            <line x1="@F(padL)" y1="@F(padT + plotH)" x2="@F(svgW - padR)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />

            @for (int i = 0; i < n; i++)
            {
                double val = pts[i].Value;
                double barStart = Math.Min(cumulative[i], cumulative[i + 1]);
                double barEnd = Math.Max(cumulative[i], cumulative[i + 1]);

                double y1 = padT + plotH - (barEnd - rangeMin) / (rangeMax - rangeMin) * plotH;
                double y2 = padT + plotH - (barStart - rangeMin) / (rangeMax - rangeMin) * plotH;
                double barH = Math.Max(y2 - y1, 1);
                double x = padL + i * barW + gap / 2;

                string color = DirectionColor(val >= 0, "#16a34a", "#dc2626");
                if (!string.IsNullOrEmpty(pts[i].Color)) color = pts[i].Color!;

                var pIdx = i;
                var waterfallFields = new[] { new ChartTooltipField("Change", (val >= 0 ? "+" : "") + Fmt(val)), Fld("Running total", cumulative[i + 1]) };
                <rect class="fx-pt" x="@F(x)" y="@F(y1)" width="@F(barW - gap)" height="@F(barH)"
                      fill="@color" rx="2"
                      @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, color, pts[pIdx].Label, val, null, waterfallFields), x + (barW - gap) / 2, y1, svgW, svgH)" @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@pts[i].Label: @(val >= 0 ? "+" : "")@F1(val)</title> }
                </rect>

                @if (i < n - 1)
                {
                    double connY = padT + plotH - (cumulative[i + 1] - rangeMin) / (rangeMax - rangeMin) * plotH;
                    <line x1="@F(x + barW - gap)" y1="@F(connY)" x2="@F(x + barW + gap / 2)" y2="@F(connY)"
                          stroke="#9ca3af" stroke-width="1" stroke-dasharray="2,2" />
                }

                @SvgText(F(x + (barW - gap) / 2), F(padT + plotH + 16), Truncate(pts[i].Label, 8), anchor: "middle", fontSize: "9", fill: "#6b7280")
            }
        </svg>
    };

    #endregion

    #region Render — Heatmap

    private RenderFragment RenderHeatmap() => __builder =>
    {
        if (_effectiveSeries.Count == 0) return;

        const double svgW = 600, svgH = 300;
        const double padL = 80, padR = 20, padT = 30, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        var categories = _effectiveSeries.Select(s => s.Name).ToList();
        var labels = _effectiveSeries[0].DataPoints.Select(p => p.Label).ToList();
        int rows = categories.Count;
        int cols = labels.Count;
        if (rows == 0 || cols == 0) return;

        double cellW = plotW / cols;
        double cellH = plotH / rows;

        double minVal = _effectiveSeries.SelectMany(s => s.DataPoints.Select(p => p.Value)).Min();
        double maxVal = _effectiveSeries.SelectMany(s => s.DataPoints.Select(p => p.Value)).Max();
        if (Math.Abs(maxVal - minVal) < 0.001) { minVal = 0; maxVal = 1; }

        // Each row is a series, so series colours do not apply. A hex ColorPalette[0] sets the ramp: from a 10% tint of it at the lowest
        // value to the colour itself at the highest. Unset (or not hex): the built-in ramp from (235,245,255) to (35,45,215).
        var rampTop = ParseHex(PaletteOr(0, ""));

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @for (int r = 0; r < rows; r++)
            {
                @SvgText(F(padL - 6), F(padT + r * cellH + cellH / 2 + 4), Truncate(categories[r], 10),
                    anchor: "end", fontSize: "10", fill: "#6b7280")

                @for (int c = 0; c < cols && c < _effectiveSeries[r].DataPoints.Count; c++)
                {
                    double val = _effectiveSeries[r].DataPoints[c].Value;
                    double norm = (val - minVal) / (maxVal - minVal);
                    int r2, g2, b2;
                    if (rampTop is var (tr, tg, tb))
                    {
                        double t = 0.1 + 0.9 * norm;
                        r2 = (int)Math.Round(255 + (tr - 255) * t);
                        g2 = (int)Math.Round(255 + (tg - 255) * t);
                        b2 = (int)Math.Round(255 + (tb - 255) * t);
                    }
                    else
                    {
                        r2 = (int)(235 - norm * 200);
                        g2 = (int)(245 - norm * 200);
                        b2 = (int)(255 - norm * 40);
                    }
                    string color = $"rgb({r2},{g2},{b2})";

                    var rIdx = r; var cIdx = c;
                    <rect class="fx-pt" x="@F(padL + c * cellW)" y="@F(padT + r * cellH)"
                          width="@F(cellW - 1)" height="@F(cellH - 1)" fill="@color" rx="2"
                          @onmouseover='e => TipEnter(e, MakeCtx(rIdx, cIdx, color, $"{categories[rIdx]} / {labels[cIdx]}", val, null, null, labels[cIdx]), padL + (cIdx + 0.5) * cellW, padT + rIdx * cellH, svgW, svgH)' @onmouseout="TipLeave">
                        @if (!ShowTooltips) { <title>@categories[r] / @labels[c]: @F1(val)</title> }
                    </rect>
                }
            }

            @for (int c = 0; c < cols; c++)
            {
                @SvgText(F(padL + c * cellW + cellW / 2), F(padT + rows * cellH + 14), Truncate(labels[c], 8),
                    anchor: "middle", fontSize: "9", fill: "#6b7280")
            }
        </svg>
    };

    #endregion

    #region Render — Gantt

    private RenderFragment RenderGantt() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        const double svgW = 600, svgH = 300;
        const double padL = 100, padR = 20, padT = 20, padB = 30;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        var pts = _effectiveSeries[0].DataPoints;
        int n = pts.Count;

        double minStart = pts.Min(p => p.Value);
        double maxEnd = pts.Max(p => p.Value2 ?? p.Value + 1);
        if (Math.Abs(maxEnd - minStart) < 0.001) maxEnd = minStart + 1;

        double rowH = Math.Min(plotH / n, 30);

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @for (int t = 0; t <= 4; t++)
            {
                double x = padL + t * plotW / 4;
                <line x1="@F(x)" y1="@F(padT)" x2="@F(x)" y2="@F(padT + plotH)"
                      stroke="#e5e7eb" stroke-width="1" stroke-dasharray="4,2" />
                double tickVal = minStart + t * (maxEnd - minStart) / 4;
                @SvgText(F(x), F(padT + plotH + 14), F0(tickVal), anchor: "middle", fontSize: "9", fill: "#6b7280")
            }

            @for (int i = 0; i < n; i++)
            {
                double start = pts[i].Value;
                double end = pts[i].Value2 ?? start + 1;
                var geometry = TimelineScale.Bar(start, end, minStart, maxEnd, plotW);
                double x1 = padL + geometry.Left;
                double x2 = x1 + geometry.Width;
                double y = padT + i * rowH + rowH * 0.2;
                double h = rowH * 0.6;
                string color = GetPointColor(pts[i], 0, i);

                var pIdx = i;
                var ganttFields = new[] { new ChartTooltipField("Start", F0(start)), new ChartTooltipField("End", F0(end)) };
                <rect class="fx-pt" x="@F(x1)" y="@F(y)" width="@F(Math.Max(x2 - x1, 2))" height="@F(h)"
                      fill="@color" rx="3"
                      @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, color, pts[pIdx].Label, start, null, ganttFields), (x1 + x2) / 2, y, svgW, svgH)" @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@pts[i].Label: @F0(start) - @F0(end)</title> }
                </rect>

                @SvgText(F(padL - 6), F(y + h / 2 + 4), Truncate(pts[i].Label, 12),
                    anchor: "end", fontSize: "10", fill: "#374151")
            }
        </svg>
    };

    #endregion

    #region Render — BoxPlot

    private RenderFragment RenderBoxPlot() => __builder =>
    {
        const double svgW = 600, svgH = 300;
        const double padL = 60, padR = 20, padT = 20, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        var pts = _effectiveSeries[0].DataPoints;
        int n = pts.Count;

        double allMin = pts.Min(p => p.Value);
        double allMax = pts.Max(p => p.Value2 ?? p.Value);
        var (rangeMin, rangeMax) = GetNiceRange(allMin, allMax);

        double boxW = plotW / n;
        double gap = boxW * 0.3;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @{ var ticks = GetTicks(rangeMin, rangeMax, 5); }
            @foreach (var tick in ticks)
            {
                double y = padT + plotH - (tick - rangeMin) / (rangeMax - rangeMin) * plotH;
                <line x1="@F(padL)" y1="@F(y)" x2="@F(svgW - padR)" y2="@F(y)"
                      stroke="#e5e7eb" stroke-width="1" stroke-dasharray="4,2" />
                @SvgText(F(padL - 8), F(y + 4), F0(tick), anchor: "end", fontSize: "10", fill: "#6b7280")
            }

            <line x1="@F(padL)" y1="@F(padT + plotH)" x2="@F(svgW - padR)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />

            @for (int i = 0; i < n; i++)
            {
                var p = pts[i];
                double low = p.Value;
                double high = p.Value2 ?? p.Value;
                double q1 = p.Value3 ?? low;
                double q3 = p.Value4 ?? high;
                double median = p.Value5 ?? (q1 + q3) / 2;

                double bx = padL + i * boxW + boxW / 2;
                double halfW = (boxW - gap) / 2;

                double yLow = padT + plotH - (low - rangeMin) / (rangeMax - rangeMin) * plotH;
                double yHigh = padT + plotH - (high - rangeMin) / (rangeMax - rangeMin) * plotH;
                double yQ1 = padT + plotH - (q1 - rangeMin) / (rangeMax - rangeMin) * plotH;
                double yQ3 = padT + plotH - (q3 - rangeMin) / (rangeMax - rangeMin) * plotH;
                double yMed = padT + plotH - (median - rangeMin) / (rangeMax - rangeMin) * plotH;

                <line x1="@F(bx)" y1="@F(yLow)" x2="@F(bx)" y2="@F(yHigh)"
                      stroke="#374151" stroke-width="1" />
                <line x1="@F(bx - halfW * 0.5)" y1="@F(yLow)" x2="@F(bx + halfW * 0.5)" y2="@F(yLow)"
                      stroke="#374151" stroke-width="1" />
                <line x1="@F(bx - halfW * 0.5)" y1="@F(yHigh)" x2="@F(bx + halfW * 0.5)" y2="@F(yHigh)"
                      stroke="#374151" stroke-width="1" />
                var pIdx = i;
                var boxFields = new[] { Fld("Max", high), Fld("Q3", q3), Fld("Median", median), Fld("Q1", q1), Fld("Min", low) };
                <rect class="fx-pt" x="@F(bx - halfW)" y="@F(yQ3)" width="@F(halfW * 2)"
                      height="@F(Math.Max(yQ1 - yQ3, 1))" fill="@GetSeriesColor(0)" fill-opacity="0.3"
                      stroke="@GetSeriesColor(0)" stroke-width="1.5" rx="2"
                      @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, GetSeriesColor(0), p.Label, median, null, boxFields), bx, yQ3, svgW, svgH)" @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@p.Label: Q1=@F1(q1) Med=@F1(median) Q3=@F1(q3)</title> }
                </rect>
                <line x1="@F(bx - halfW)" y1="@F(yMed)" x2="@F(bx + halfW)" y2="@F(yMed)"
                      stroke="@GetSeriesColor(0)" stroke-width="2" />

                @SvgText(F(bx), F(padT + plotH + 16), Truncate(p.Label, 8),
                    anchor: "middle", fontSize: "9", fill: "#6b7280")
            }
        </svg>
    };

    #endregion

    #region Render — DotPlot

    private RenderFragment RenderDotPlot() => __builder =>
    {
        const double svgW = 600, svgH = 300;
        const double padL = 100, padR = 30, padT = 20, padB = 30;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        var pts = _effectiveSeries[0].DataPoints;
        int n = pts.Count;

        double minVal = pts.Min(p => p.Value);
        double maxVal = pts.Max(p => p.Value);
        if (Math.Abs(maxVal - minVal) < 0.001) { minVal -= 1; maxVal += 1; }

        double rowH = plotH / n;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            <line x1="@F(padL)" y1="@F(padT + plotH)" x2="@F(svgW - padR)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />

            @{ var xTicks = GetTicks(minVal, maxVal, 5); }
            @foreach (var tick in xTicks)
            {
                double x = padL + (tick - minVal) / (maxVal - minVal) * plotW;
                <line x1="@F(x)" y1="@F(padT)" x2="@F(x)" y2="@F(padT + plotH)"
                      stroke="#e5e7eb" stroke-width="1" stroke-dasharray="4,2" />
                @SvgText(F(x), F(padT + plotH + 14), F0(tick), anchor: "middle", fontSize: "9", fill: "#6b7280")
            }

            @for (int i = 0; i < n; i++)
            {
                double y = padT + i * rowH + rowH / 2;
                double x = padL + (pts[i].Value - minVal) / (maxVal - minVal) * plotW;
                string color = GetPointColor(pts[i], 0, i);

                <line x1="@F(padL)" y1="@F(y)" x2="@F(x)" y2="@F(y)"
                      stroke="#e5e7eb" stroke-width="1" />
                var pIdx = i;
                <circle class="fx-pt" cx="@F(x)" cy="@F(y)" r="5" fill="@color" stroke="transparent" stroke-width="8"
                        @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, color, pts[pIdx].Label, pts[pIdx].Value), x, y, svgW, svgH)" @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@pts[i].Label: @F1(pts[i].Value)</title> }
                </circle>
                @SvgText(F(padL - 6), F(y + 4), Truncate(pts[i].Label, 12),
                    anchor: "end", fontSize: "10", fill: "#374151")
            }
        </svg>
    };

    #endregion

    #region Render — Histogram

    private RenderFragment RenderHistogram() => __builder =>
    {
        const double svgW = 600, svgH = 300;
        const double padL = 60, padR = 20, padT = 20, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        var pts = _effectiveSeries[0].DataPoints;
        int n = pts.Count;

        double maxVal = pts.Max(p => p.Value);
        if (maxVal <= 0) maxVal = 1;
        var (rangeMin, rangeMax) = GetNiceRange(0, maxVal);

        double barW = plotW / n;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @{ var ticks = GetTicks(rangeMin, rangeMax, 5); }
            @foreach (var tick in ticks)
            {
                double y = padT + plotH - (tick - rangeMin) / (rangeMax - rangeMin) * plotH;
                <line x1="@F(padL)" y1="@F(y)" x2="@F(svgW - padR)" y2="@F(y)"
                      stroke="#e5e7eb" stroke-width="1" stroke-dasharray="4,2" />
                @SvgText(F(padL - 8), F(y + 4), F0(tick), anchor: "end", fontSize: "10", fill: "#6b7280")
            }

            <line x1="@F(padL)" y1="@F(padT + plotH)" x2="@F(svgW - padR)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />
            <line x1="@F(padL)" y1="@F(padT)" x2="@F(padL)" y2="@F(padT + plotH)"
                  stroke="#9ca3af" stroke-width="1" />

            @for (int i = 0; i < n; i++)
            {
                double val = pts[i].Value;
                double barH = ((val - rangeMin) / (rangeMax - rangeMin)) * plotH;
                double x = padL + i * barW;
                double y = padT + plotH - barH;

                var pIdx = i;
                var binFields = new[] { Fld("Count", val) };
                <rect class="fx-pt" x="@F(x)" y="@F(y)" width="@F(barW)" height="@F(Math.Max(barH, 0))"
                      fill="@GetSeriesColor(0)" stroke="white" stroke-width="0.5"
                      @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, GetSeriesColor(0), pts[pIdx].Label, val, null, binFields), x + barW / 2, y, svgW, svgH)" @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@pts[i].Label: @F1(val)</title> }
                </rect>

                @if (i % Math.Max(1, n / 8) == 0)
                {
                    @SvgText(F(x + barW / 2), F(padT + plotH + 14), pts[i].Label,
                        anchor: "middle", fontSize: "9", fill: "#6b7280")
                }
            }
        </svg>
    };

    #endregion

    #region Render — Funnel / Pyramid

    private RenderFragment RenderFunnelPyramid() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;

        const double svgW = 400, svgH = 300;
        const double padT = 20, padB = 20;
        double plotH = svgH - padT - padB;

        var pts = _effectiveSeries[0].DataPoints;
        int n = pts.Count;
        double maxVal = pts.Max(p => Math.Abs(p.Value));
        if (maxVal <= 0) maxVal = 1;
        double tipTotal = pts.Sum(p => Math.Abs(p.Value));

        bool isPyramid = Type == ChartType.Pyramid;
        double segH = plotH / n;
        double fcx = svgW / 2;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            @for (int i = 0; i < n; i++)
            {
                int idx = isPyramid ? n - 1 - i : i;
                double val = Math.Abs(pts[idx].Value);
                double nextVal = (i + 1 < n)
                    ? Math.Abs(pts[isPyramid ? n - 2 - i : i + 1].Value)
                    : 0;

                double topW = (val / maxVal) * (svgW * 0.8);
                double botW = (i + 1 < n) ? (nextVal / maxVal) * (svgW * 0.8) : topW * 0.2;
                if (isPyramid) { (topW, botW) = (botW, topW); }

                double y = padT + i * segH;
                string color = GetPointColor(pts[idx], 0, idx);

                double x1 = fcx - topW / 2;
                double x2 = fcx + topW / 2;
                double x3 = fcx + botW / 2;
                double x4 = fcx - botW / 2;

                double share = tipTotal > 0 ? val / tipTotal * 100 : 0;
                <polygon class="fx-pt" points="@F(x1),@F(y) @F(x2),@F(y) @F(x3),@F(y + segH) @F(x4),@F(y + segH)"
                         fill="@color" stroke="white" stroke-width="1.5"
                         @onmouseover="e => TipEnter(e, MakeCtx(0, idx, color, pts[idx].Label, pts[idx].Value, share), fcx, y + segH / 2, svgW, svgH)" @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@pts[idx].Label: @F1(pts[idx].Value)</title> }
                </polygon>

                @SvgText(F(fcx), F(y + segH / 2 + 4), pts[idx].Label,
                    anchor: "middle", fontSize: "11", fill: "white", fontWeight: "500")
            }
        </svg>
    };

    #endregion

    #region Render — Financial Charts (Candlestick, Ohlc, HighLow)

    private RenderFragment RenderFinancialChart() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;
        var pts = _effectiveSeries[0].DataPoints;

        double svgW = 600, svgH = 320;
        double padL = 50, padR = 20, padT = 30, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        double minVal = pts.Min(p => p.Low);
        double maxVal = pts.Max(p => p.High);
        if (minVal == maxVal) { maxVal += 1; minVal -= 1; }
        double range = maxVal - minVal;

        int n = pts.Count;
        double slotW = plotW / n;
        double candleW = Math.Min(24, slotW * 0.65);
        var captions = pts.Select(point => point.Label).ToArray();
        var visibleLabels = ChartAxisLabelLayout.Select(captions, index => padL+(index+.5)*slotW, 10, axis: XAxis);

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "320px");" xmlns="http://www.w3.org/2000/svg">

            <!-- Grid & Y-Axis Ticks -->
            @for (int i = 0; i <= 4; i++)
            {
                double tickVal = minVal + (range * i / 4.0);
                double y = padT + plotH - (plotH * (tickVal - minVal) / range);
                <line x1="@F(padL)" y1="@F(y)" x2="@F(padL + plotW)" y2="@F(y)" stroke="#e5e7eb" stroke-dasharray="3,3" />
                @SvgText(F(padL - 8), F(y + 4), F1(tickVal), anchor: "end", fontSize: "10", fill: "#6b7280")
            }

            @for (int i = 0; i < n; i++)
            {
                var p = pts[i];
                double cx = padL + i * slotW + slotW / 2.0;
                double yHigh = padT + plotH - (plotH * (p.High - minVal) / range);
                double yLow = padT + plotH - (plotH * (p.Low - minVal) / range);
                double yOpen = padT + plotH - (plotH * (p.Open - minVal) / range);
                double yClose = padT + plotH - (plotH * (p.Close - minVal) / range);

                bool isBullish = p.Close >= p.Open;
                string candleColor = DirectionColor(isBullish, "#16a34a", "#dc2626");
                string bodyColor = DirectionColor(isBullish, "#22c55e", "#ef4444");

                if (Type == ChartType.Candlestick)
                {
                    double bodyTop = Math.Min(yOpen, yClose);
                    double bodyHeight = Math.Max(2, Math.Abs(yClose - yOpen));

                    <!-- High-Low Wick -->
                    <line x1="@F(cx)" y1="@F(yHigh)" x2="@F(cx)" y2="@F(yLow)" stroke="@candleColor" stroke-width="1.5" />
                    <!-- Real Body -->
                    <rect x="@F(cx - candleW / 2)" y="@F(bodyTop)" width="@F(candleW)" height="@F(bodyHeight)"
                          fill="@bodyColor" stroke="@candleColor" stroke-width="1" rx="1">
                        @if (!ShowTooltips) { <title>@p.Label&#10;Open: @p.Open&#10;High: @p.High&#10;Low: @p.Low&#10;Close: @p.Close</title> }
                    </rect>
                }
                else if (Type == ChartType.Ohlc)
                {
                    <!-- High-Low Line -->
                    <line x1="@F(cx)" y1="@F(yHigh)" x2="@F(cx)" y2="@F(yLow)" stroke="@candleColor" stroke-width="1.5" />
                    <!-- Left Open Tick -->
                    <line x1="@F(cx - candleW / 2)" y1="@F(yOpen)" x2="@F(cx)" y2="@F(yOpen)" stroke="@candleColor" stroke-width="1.5" />
                    <!-- Right Close Tick -->
                    <line x1="@F(cx)" y1="@F(yClose)" x2="@F(cx + candleW / 2)" y2="@F(yClose)" stroke="@candleColor" stroke-width="1.5" />
                }
                else // HighLow
                {
                    candleColor = ThemedPointColor(p, "#2563eb");
                    <line x1="@F(cx)" y1="@F(yHigh)" x2="@F(cx)" y2="@F(yLow)" stroke="@candleColor" stroke-width="2.5" />
                }

                @if (ShowTooltips)
                {
                    var pIdx = i;
                    var priceFields = Type == ChartType.HighLow
                        ? new[] { Fld("High", p.High), Fld("Low", p.Low) }
                        : new[] { Fld("Open", p.Open), Fld("High", p.High), Fld("Low", p.Low), Fld("Close", p.Close) };
                    <rect class="fx-pt-hit" x="@F(cx - slotW * 0.4)" y="@F(yHigh)" width="@F(slotW * 0.8)" height="@F(Math.Max(yLow - yHigh, 4))" fill="transparent"
                          @onmouseover="e => TipEnter(e, MakeCtx(0, pIdx, candleColor, p.Label, p.Close, null, priceFields), cx, yHigh, svgW, svgH)" @onmouseout="TipLeave" />
                }
                @if (ShowAxisLabels && visibleLabels.Contains(i))
                {
                    @SvgText(F(cx), F(padT + plotH + 16), captions[i], anchor: "middle", fontSize: "10", fill: "#6b7280")
                }
            }
        </svg>
    };

    #endregion

    #region Render — Bullet Chart

    private RenderFragment RenderBullet() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;
        var pts = _effectiveSeries[0].DataPoints;

        double svgW = 600, svgH = Math.Max(120, pts.Count * 60.0);
        double padL = 100, padR = 40, padT = 20;
        double plotW = svgW - padL - padR;

        double maxVal = pts.Max(p => Math.Max(p.Actual, p.Target)) * 1.2;
        if (maxVal <= 0) maxVal = 100;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? $"{svgH}px");" xmlns="http://www.w3.org/2000/svg">

            @for (int i = 0; i < pts.Count; i++)
            {
                var p = pts[i];
                double y = padT + i * 50;
                double h = 28;

                <!-- Background Qualitative Ranges (Bad: 60%, Satisfactory: 85%, Good: 100%) -->
                <rect x="@F(padL)" y="@F(y)" width="@F(plotW)" height="@F(h)" fill="#f1f5f9" rx="2" />
                <rect x="@F(padL)" y="@F(y)" width="@F(plotW * 0.85)" height="@F(h)" fill="#e2e8f0" rx="2" />
                <rect x="@F(padL)" y="@F(y)" width="@F(plotW * 0.60)" height="@F(h)" fill="#cbd5e1" rx="2" />

                <!-- Actual Value Bar (dark slate unless coloured) -->
                double actualW = (p.Actual / maxVal) * plotW;
                var pIdx = i;
                var bulletFields = new[] { Fld("Actual", p.Actual), Fld("Target", p.Target) };
                var actualColor = ThemedPointColor(p, "#1e293b");
                <rect class="fx-pt" x="@F(padL)" y="@F(y + h * 0.25)" width="@F(actualW)" height="@F(h * 0.5)" fill="@actualColor" rx="1"
                      @onmouseover='e => TipEnter(e, MakeCtx(0, pIdx, actualColor, p.Label, p.Actual, null, bulletFields), padL + actualW / 2, y, svgW, svgH)' @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@p.Label: Actual=@p.Actual, Target=@p.Target</title> }
                </rect>

                <!-- Target Line (red unless ColorPalette has an entry 1) -->
                double targetX = padL + (p.Target / maxVal) * plotW;
                <line x1="@F(targetX)" y1="@F(y + 2)" x2="@F(targetX)" y2="@F(y + h - 2)" stroke="@PaletteOr(1, "#dc2626")" stroke-width="3" />

                <!-- Label -->
                @SvgText(F(padL - 10), F(y + h / 2 + 4), p.Label, anchor: "end", fontSize: "11", fill: "#1e293b", fontWeight: "600")
            }
        </svg>
    };

    #endregion

    #region Render — Range Charts (RangeBar, RangeColumn, RangeArea)

    private RenderFragment RenderRangeChart() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;
        var pts = _effectiveSeries[0].DataPoints;

        double svgW = 600, svgH = 300;
        double padL = 60, padR = 20, padT = 30, padB = 40;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        double minVal = pts.Min(p => p.Value);
        double maxVal = pts.Max(p => p.Value2 ?? p.Value);
        if (minVal == maxVal) { maxVal += 10; minVal -= 10; }
        double range = maxVal - minVal;

        int n = pts.Count;
        double slotW = plotW / n;
        double barW = slotW * 0.6;

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "300px");" xmlns="http://www.w3.org/2000/svg">

            <!-- Grid -->
            @for (int i = 0; i <= 4; i++)
            {
                double tickVal = minVal + (range * i / 4.0);
                double y = padT + plotH - (plotH * (tickVal - minVal) / range);
                <line x1="@F(padL)" y1="@F(y)" x2="@F(padL + plotW)" y2="@F(y)" stroke="#e5e7eb" stroke-dasharray="3,3" />
                @SvgText(F(padL - 8), F(y + 4), F0(tickVal), anchor: "end", fontSize: "10", fill: "#6b7280")
            }

            @for (int i = 0; i < n; i++)
            {
                var p = pts[i];
                double cx = padL + i * slotW + slotW / 2.0;
                double valMin = p.Value;
                double valMax = p.Value2 ?? p.Value;
                double yTop = padT + plotH - (plotH * (valMax - minVal) / range);
                double yBot = padT + plotH - (plotH * (valMin - minVal) / range);
                double barH = Math.Max(3, yBot - yTop);

                var pIdx = i;
                var rangeFields = new[] { Fld("Min", valMin), Fld("Max", valMax) };
                var rangeColor = ThemedPointColor(p, "#3b82f6");
                <rect class="fx-pt" x="@F(cx - barW / 2)" y="@F(yTop)" width="@F(barW)" height="@F(barH)"
                      fill="@rangeColor" opacity="0.85" rx="3"
                      @onmouseover='e => TipEnter(e, MakeCtx(0, pIdx, rangeColor, p.Label, valMax, null, rangeFields), cx, yTop, svgW, svgH)' @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@p.Label: @valMin - @valMax</title> }
                </rect>

                @SvgText(F(cx), F(padT + plotH + 16), Truncate(p.Label, 8), anchor: "middle", fontSize: "10", fill: "#6b7280")
            }
        </svg>
    };

    #endregion

    #region Render — Sankey Flow Diagram

    private RenderFragment RenderSankey() => __builder =>
    {
        if (_effectiveSeries.Count == 0 || _effectiveSeries[0].DataPoints.Count == 0) return;
        var pts = _effectiveSeries[0].DataPoints;

        double svgW = 650, svgH = 340;
        double padL = 80, padR = 80, padT = 30, padB = 30;
        double plotW = svgW - padL - padR;
        double plotH = svgH - padT - padB;

        var sources = pts.Select(p => p.Source).Distinct().ToList();
        var targets = pts.Select(p => p.Destination).Where(d => !string.IsNullOrEmpty(d)).Distinct().ToList();
        if (targets.Count == 0) targets = new List<string> { "Target" };

        double totalFlow = pts.Sum(p => p.Value);
        if (totalFlow <= 0) totalFlow = 1;

        double srcY = padT;
        double tgtY = padT;
        double nodeW = 16;

        // source nodes: the series Color or ColorPalette[0]; target nodes: ColorPalette[1]; each falls back to its fixed blue
        var srcColor = ThemedSeriesColor("#2563eb");
        var tgtColor = PaletteOr(1, "#0284c7");
        bool themed = ColorPalette is { Length: > 0 } || (_effectiveSeries.Count > 0 && !string.IsNullOrEmpty(_effectiveSeries[0].Color));

        <svg viewBox="0 0 @F0(svgW) @F0(svgH)" preserveAspectRatio="xMidYMid meet"
             style="height:@(Height ?? "340px");" xmlns="http://www.w3.org/2000/svg">

            @for (int pi = 0; pi < pts.Count; pi++)
            {
                var pt = pts[pi];
                var pIdx = pi;
                double flowH = Math.Max(8, (pt.Value / totalFlow) * (plotH * 0.8));
                double x1 = padL + nodeW;
                double x2 = padL + plotW - nodeW;
                double y1 = srcY;
                double y2 = tgtY;

                double cp1X = x1 + (x2 - x1) * 0.5;
                double cp2X = x2 - (x2 - x1) * 0.5;

                // a point's Color paints its ribbon; otherwise a themed chart's ribbons take the source colour, an unthemed one the light blue
                var flowFill = !string.IsNullOrEmpty(pt.Color) ? pt.Color! : themed ? srcColor : "#60a5fa";
                var flowStroke = !string.IsNullOrEmpty(pt.Color) ? pt.Color! : themed ? srcColor : "#3b82f6";

                <!-- Smooth Flow Ribbon -->
                <path d="M @F(x1) @F(y1) C @F(cp1X) @F(y1), @F(cp2X) @F(y2), @F(x2) @F(y2) L @F(x2) @F(y2 + flowH) C @F(cp2X) @F(y2 + flowH), @F(cp1X) @F(y1 + flowH), @F(x1) @F(y1 + flowH) Z"
                      fill="@flowFill" fill-opacity="0.45" stroke="@flowStroke" stroke-width="0.5" class="fx-pt"
                      @onmouseover='e => TipEnter(e, MakeCtx(0, pIdx, flowFill, $"{pt.Source} → {pt.Destination}", pt.Value, null, new[] { Fld("Flow", pt.Value) }, pt.Source), (x1 + x2) / 2, (y1 + y2) / 2, svgW, svgH)' @onmouseout="TipLeave">
                    @if (!ShowTooltips) { <title>@pt.Source → @pt.Destination: @pt.Value</title> }
                </path>

                <!-- Source Node -->
                <rect x="@F(padL)" y="@F(srcY)" width="@F(nodeW)" height="@F(flowH)" fill="@srcColor" rx="2" />
                @SvgText(F(padL - 8), F(srcY + flowH / 2 + 4), pt.Source, anchor: "end", fontSize: "11", fill: "#1e293b", fontWeight: "600")

                <!-- Target Node -->
                <rect x="@F(padL + plotW - nodeW)" y="@F(tgtY)" width="@F(nodeW)" height="@F(flowH)" fill="@tgtColor" rx="2" />
                @SvgText(F(padL + plotW + 8), F(tgtY + flowH / 2 + 4), pt.Destination, anchor: "start", fontSize: "11", fill: "#1e293b", fontWeight: "600")

                srcY += flowH + 10;
                tgtY += flowH + 10;
            }
        </svg>
    };

    #endregion

    #region Render — Advanced Gauges (Radial, Arc, Linear)

    private RenderFragment RenderAdvancedGauges() => RenderGauge();

    #endregion

    #region ChartBar class (backwards compat)

    /// <summary>Single-series bar entry — kept for backwards compatibility.</summary>
    public class ChartBar
    {
        public string Label { get; set; } = "";
        public double Value { get; set; }
        public string? Color { get; set; }

        public ChartBar() { }
        public ChartBar(string label, double value, string? color = null)
        {
            Label = label;
            Value = value;
            Color = color;
        }
    }

    #endregion
}
