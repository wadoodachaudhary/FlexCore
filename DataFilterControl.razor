@namespace Fx.ControlKit

<div class="fx-data-filter @CssClass">
    @RenderGroup(RootGroup, null)
</div>

@code {
    RenderFragment RenderGroup(FilterGroup group, FilterGroup? parentGroup) => @<div @key="group" class="fx-filter-group">
        <div class="fx-filter-actions">
            <ButtonControl CssClass="@(group.LogicalOperator == LogicalFilterOperator.And ? "fx-filter-selected" : null)"
                           aria-pressed="@(group.LogicalOperator == LogicalFilterOperator.And)"
                           OnClick="() => SetGroupOperator(group, LogicalFilterOperator.And)">AND</ButtonControl>
            <ButtonControl CssClass="@(group.LogicalOperator == LogicalFilterOperator.Or ? "fx-filter-selected" : null)"
                           aria-pressed="@(group.LogicalOperator == LogicalFilterOperator.Or)"
                           OnClick="() => SetGroupOperator(group, LogicalFilterOperator.Or)">OR</ButtonControl>
            <ButtonControl Disabled="@(Properties.Count == 0)" OnClick="() => AddCondition(group)">+ Condition</ButtonControl>
            <ButtonControl Disabled="@(Properties.Count == 0)" OnClick="() => AddSubGroup(group)">+ Group</ButtonControl>
            @if (parentGroup != null)
            {
                <ButtonControl OnClick="() => RemoveSubGroup(parentGroup, group)">Remove Group</ButtonControl>
            }
        </div>
        <div class="fx-filter-conditions">
            @foreach (var condition in group.Conditions)
            {
                var property = PropertyFor(condition);
                var type = ValueType(condition);
                var error = ConditionError(condition);
                <div @key="condition" class="fx-filter-condition">
                    <div class="fx-filter-editors">
                        <DropDownListControl TItem="FilterProperty" TValue="string" DataSource="@Properties"
                                             TextFieldName="DisplayTitle" ValueFieldName="Property" Width="160px" AriaLabel="Filter field"
                                             Value="@condition.Field" ValueChanged="field => OnConditionFieldChanged(condition, field)" />
                        <DropDownListControl TItem="OperatorChoice" TValue="GridFilterOperator" DataSource="@OperatorsFor(condition)"
                                             TextFieldName="Label" ValueFieldName="Value" Width="180px" AriaLabel="Filter operator"
                                             Value="@condition.Operator" ValueChanged="op => OnConditionOperatorChanged(condition, op)" />
                        @if (FilterEvaluator.NeedsValue(condition.Operator))
                        {
                            <div class="fx-filter-value" @key="condition.Field">
                                @if (property?.ValueTemplate != null)
                                {
                                    @property.ValueTemplate(new FilterValueTemplateContext { Property = property, Condition = condition,
                                        SetValueAsync = value => OnConditionValueChanged(condition, value) })
                                }
                                else if (type == typeof(DateTime) || type == typeof(DateOnly))
                                {
                                    <DatePickerControl Value="@DateValue(condition)" ValueChanged="value => OnDateValueChanged(condition, value)"
                                                       Culture="@Culture" ShowTime="@(type == typeof(DateTime))" AriaLabel="Filter value" />
                                }
                                else if (type == typeof(bool) || type.IsEnum)
                                {
                                    <DropDownListControl TItem="string" TValue="string" DataSource="@ChoicesFor(condition)"
                                                         Value="@condition.Value" ValueChanged="value => OnConditionValueChanged(condition, value)"
                                                         AriaLabel="Filter value" Placeholder="Choose a value" Width="180px" />
                                }
                                else
                                {
                                    <TextBoxControl Value="@condition.Value" ValueChanged="value => OnConditionValueChanged(condition, value)"
                                                    UpdateOnInput="true" Placeholder="Filter value..." aria-label="Filter value"
                                                    aria-invalid="@(error != null ? "true" : null)" />
                                }
                            </div>
                        }
                        <ButtonControl OnClick="() => RemoveCondition(group, condition)" Title="Remove condition" aria-label="Remove condition">×</ButtonControl>
                    </div>
                    @if (error != null)
                    {
                        <div class="fx-filter-error" role="alert">@error</div>
                    }
                </div>
            }
        </div>
        @foreach (var sub in group.Groups)
        {
            @RenderGroup(sub, group)
        }
    </div>;
}
