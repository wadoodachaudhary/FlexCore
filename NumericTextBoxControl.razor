@namespace Fx.ControlKit
@typeparam TValue

<input @key="_inputEpoch"
       @ref="_inputRef"
       type="@InputType"
       class="fx-numeric @CssClass"
       style="@(string.IsNullOrEmpty(Width) ? "" : $"width:{Width};")"
       value="@FormattedValue"
       disabled="@(!Enabled)"
       step="@StepValue"
       min="@(Min.HasValue ? Min.Value.ToString() : null)"
       max="@(Max.HasValue ? Max.Value.ToString() : null)"
       maxlength="@MaxLength"
       inputmode="@InputMode"
       placeholder="@Placeholder"
       tabindex="@TabIndex"
       aria-invalid="@(_rejectedText != null ? "true" : null)"
       @oninput="OnInputBuffer"
       @onchange="OnNativeChange"
       @onkeydown="OnKeyDown" />

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Format { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }
    [Parameter] public decimal Step { get; set; } = 1;
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public int? TabIndex { get; set; }

    /// <summary>VB6 apply-and-clear fields (Price Change / RoundTo): after a
    /// commit (Enter/Tab/blur) the control clears itself back to blank —
    /// the VB6 txtX.Text = "" after Validate. The bound value is synced to
    /// null through ValueChanged.</summary>
    [Parameter] public bool ClearOnCommit { get; set; }

    /// <summary>Event fired when value changes.</summary>
    [Parameter] public EventCallback<NumericChangeEventArgs<TValue>> ValueChange { get; set; }

    private string StepValue => Step == 1 ? "any" : Step.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private string InputType => MaxLength is > 0 ? "text" : "number";
    private string InputMode => Min is < 0 ? "decimal" : Step == 1 ? "numeric" : "decimal";

    private string FormattedValue
    {
        get
        {
            if (_rejectedText != null) return _rejectedText;
            if (Value == null) return "";
            if (Value is IFormattable formattable && !string.IsNullOrEmpty(Format))
            {
                // For numeric input, strip currency/percent symbols — just show the raw number
                var fmt = Format.Replace("C", "F").Replace("N", "F");
                return formattable.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture);
            }
            return Value.ToString() ?? "";
        }
    }

    // VB6 parity: numeric header fields commit on ENTER (VB6 KeyDown vbKeyReturn →
    // Validate) as well as on blur/Tab (the DOM change event, which for number
    // inputs does NOT fire on Enter). The latest raw text is buffered on input and
    // committed from the Enter keydown; the duplicate-change guard swallows the one
    // native change a browser might also emit for the same Enter press.
    private string? _pendingText;
    private string? _lastEnterCommitText;
    private bool _suppressDuplicateChange;

    // VB6 apply-and-clear parity: hosts often null the bound Value inside the
    // commit (txtDollarChange.Text = "" after applying). Diffing alone cannot be
    // trusted to push that clear into a live input (the browser keeps the typed
    // text when renders coalesce), so when the committed raw text and the final
    // bound value disagree the input element is RECREATED via @key — the fresh
    // element renders the real value unconditionally. Focus is restored only for
    // Enter commits (VB6 keeps the caret in the cleared box); blur/Tab commits
    // leave focus where the user sent it.
    private int _inputEpoch;
    private ElementReference _inputRef;
    private bool _refocusAfterEpochBump;
    private bool _pendingRefocus;
    private string? _rejectedText;
    private void OnInputBuffer(ChangeEventArgs e)
    {
        _pendingText = e.Value?.ToString();
        if (_rejectedText != null) _rejectedText = _pendingText;
        _suppressDuplicateChange = false;
        _refocusAfterEpochBump = false;
    }

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && _pendingText != null)
        {
            var text = _pendingText;
            _pendingText = null;
            _lastEnterCommitText = text;
            _suppressDuplicateChange = true;
            _refocusAfterEpochBump = true;
            await CommitAsync(text);
        }
    }

    private async Task OnNativeChange(ChangeEventArgs e)
    {
        if (_suppressDuplicateChange
            && (e.Value?.ToString() ?? "") == (_lastEnterCommitText ?? ""))
        {
            _suppressDuplicateChange = false;
            return;
        }
        _suppressDuplicateChange = false;
        _pendingText = null;
        _refocusAfterEpochBump = false;
        await CommitAsync(e.Value?.ToString() ?? "");
    }

    private async Task CommitAsync(string rawText)
    {
        try
        {
            if (!await OnValueChanged(new ChangeEventArgs { Value = rawText }))
            {
                // Preserve the exact draft, including numbers beyond TValue's range.
                _rejectedText = rawText;
                _pendingText = rawText;
                _pendingRefocus = true;
                return;
            }
            _rejectedText = null;

            // Clear locally after an accepted commit: parent renders can coalesce
            // a null -> value -> null transition and leave the DOM text unchanged.
            if (ClearOnCommit)
            {
                Value = default;
                if (ValueChanged.HasDelegate)
                    await ValueChanged.InvokeAsync(default);
                _inputEpoch++;
                _pendingRefocus = _refocusAfterEpochBump;
            }
        }
        finally
        {
            _refocusAfterEpochBump = false;
            StateHasChanged();
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRefocus)
        {
            _pendingRefocus = false;
            try { await _inputRef.FocusAsync(); } catch { /* torn down */ }
        }

    }

    private async Task<bool> OnValueChanged(ChangeEventArgs e)
    {
        var strVal = NormalizeInput(e.Value?.ToString() ?? "");
        TValue? newValue = default;
        // TValue may be a Nullable<T> (e.g. decimal? on clear-after-apply fields):
        // match on the UNDERLYING type, or every typed value would fall through to
        // Convert.ChangeType, which throws on nullable targets and silently
        // yielded null for all decimal? fields. Blank input stays null for
        // nullable TValue (the VB6 "empty box" state).
        var numericType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        var isNullable = Nullable.GetUnderlyingType(typeof(TValue)) != null;
        try
        {
            if (isNullable && strVal.Length == 0)
                newValue = default;
            else if (numericType == typeof(decimal))
                newValue = (TValue)(object)ParseDecimalOrBoundary(strVal);
            else if (numericType == typeof(int))
                newValue = (TValue)(object)(int.TryParse(strVal, out var i) ? i : ParseIntBoundary(strVal));
            else if (numericType == typeof(double))
                newValue = (TValue)(object)(double.TryParse(strVal, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var dbl) ? dbl : ParseDoubleBoundary(strVal));
            else if (numericType == typeof(float))
                newValue = (TValue)(object)(float.TryParse(strVal, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : ParseFloatBoundary(strVal));
            else
                newValue = (TValue)Convert.ChangeType(strVal, numericType);
        }
        catch
        {
            newValue = default;
        }

        // Clamp to min/max. Huge double/float input can exceed decimal range;
        // treat that as unclamped unless a bound brings it back into range.
        if (newValue != null && Min.HasValue && TryConvertToDecimal(newValue, out var minDecVal))
        {
            if (minDecVal < Min.Value)
                newValue = ConvertDecimalToValue(Min.Value, newValue);
        }
        if (newValue != null && Max.HasValue && TryConvertToDecimal(newValue, out var maxDecVal))
        {
            if (maxDecVal > Max.Value)
                newValue = ConvertDecimalToValue(Max.Value, newValue);
        }

        Value = newValue;
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(newValue);

        var args = new NumericChangeEventArgs<TValue> { Value = newValue };
        if (ValueChange.HasDelegate)
            await ValueChange.InvokeAsync(args);
        return !args.Cancel;
    }

    public class NumericChangeEventArgs<T>
    {
        public T? Value { get; set; }

        /// <summary>Reject the commit, retaining the typed text and input focus instead of clearing.</summary>
        public bool Cancel { get; set; }
    }

    private static string NormalizeInput(string value) =>
        value.Trim()
             .Replace("%", "", StringComparison.Ordinal)
             .Replace(" ", "", StringComparison.Ordinal);

    private static decimal ParseDecimalOrBoundary(string value)
    {
        if (decimal.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d;

        if (LooksNumeric(value, out var negative))
            return negative ? decimal.MinValue : decimal.MaxValue;

        return 0m;
    }

    private static int ParseIntBoundary(string value)
    {
        // Scientific notation within int range ("1e2") is that number, rounded like VB6 CInt.
        if (value.IndexOfAny(['e', 'E']) >= 0
            && double.TryParse(value, System.Globalization.NumberStyles.Float | System.Globalization.NumberStyles.AllowThousands,
                System.Globalization.CultureInfo.InvariantCulture, out var number)
            && number >= int.MinValue && number <= int.MaxValue)
            return (int)Math.Round(number, MidpointRounding.ToEven);
        if (LooksNumeric(value, out var negative))
            return negative ? int.MinValue : int.MaxValue;
        return 0;
    }

    private static double ParseDoubleBoundary(string value)
    {
        if (LooksNumeric(value, out var negative))
            return negative ? double.NegativeInfinity : double.PositiveInfinity;
        return 0d;
    }

    private static float ParseFloatBoundary(string value)
    {
        if (LooksNumeric(value, out var negative))
            return negative ? float.NegativeInfinity : float.PositiveInfinity;
        return 0f;
    }

    private static bool LooksNumeric(string value, out bool negative)
    {
        // Number inputs accept scientific notation, including exponents beyond decimal range.
        if (double.TryParse(value, System.Globalization.NumberStyles.Float | System.Globalization.NumberStyles.AllowThousands,
            System.Globalization.CultureInfo.InvariantCulture, out var number) && !double.IsNaN(number))
        {
            negative = number < 0;
            return true;
        }
        negative = false;
        var s = value.Trim();
        if (s.Length == 0)
            return false;

        if (s[0] == '-' || s[0] == '+')
        {
            negative = s[0] == '-';
            s = s[1..];
        }

        var hasDigit = false;
        var hasDecimal = false;
        foreach (var ch in s)
        {
            if (char.IsDigit(ch))
            {
                hasDigit = true;
                continue;
            }

            if (ch == ',' || ch == '_')
                continue;

            if (ch == '.' && !hasDecimal)
            {
                hasDecimal = true;
                continue;
            }

            return false;
        }

        return hasDigit;
    }

    private static bool TryConvertToDecimal(TValue value, out decimal result)
    {
        result = 0m;
        try
        {
            switch (value)
            {
                case decimal d:
                    result = d;
                    return true;
                case double d:
                    if (double.IsNaN(d))
                        return false;
                    if (double.IsPositiveInfinity(d) || d > (double)decimal.MaxValue)
                    {
                        result = decimal.MaxValue;
                        return true;
                    }
                    if (double.IsNegativeInfinity(d) || d < (double)decimal.MinValue)
                    {
                        result = decimal.MinValue;
                        return true;
                    }
                    result = (decimal)d;
                    return true;
                case float f:
                    if (float.IsNaN(f))
                        return false;
                    if (float.IsPositiveInfinity(f) || f > (float)decimal.MaxValue)
                    {
                        result = decimal.MaxValue;
                        return true;
                    }
                    if (float.IsNegativeInfinity(f) || f < (float)decimal.MinValue)
                    {
                        result = decimal.MinValue;
                        return true;
                    }
                    result = (decimal)f;
                    return true;
                default:
                    result = Convert.ToDecimal(value, System.Globalization.CultureInfo.InvariantCulture);
                    return true;
            }
        }
        catch
        {
            return false;
        }
    }

    private static TValue? ConvertDecimalToValue(decimal value, TValue? fallback)
    {
        try
        {
            var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return (TValue)Convert.ChangeType(value, targetType, System.Globalization.CultureInfo.InvariantCulture);
        }
        catch
        {
            return fallback;
        }
    }
}
