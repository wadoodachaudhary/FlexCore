@namespace Fx.ControlKit
@inherits FlexControlBase

@if (_context != null && Visible)
{
    <EditForm EditContext="_context" OnSubmit="SubmitAsync" class="@($"fx-form {CssClass}")" style="@Style" id="@Id" @attributes="AdditionalAttributes">
        <CascadingValue Value="this" IsFixed="true">
            @if (EnableDataAnnotations) { <DataAnnotationsValidator /> }
            @ValidatorTemplate
            @if (ShowValidationSummary) { <ValidationSummaryControl /> }
            <div class="fx-form-items" style="@($"--fx-form-columns:{Math.Max(1, Columns)};gap:{ColumnSpacing}")">
                @if (ChildContent != null) { @ChildContent }
                else { <FormAutoGeneratedItemsControl /> }
            </div>
            @if (ButtonsTemplate != null) { @ButtonsTemplate }
            else if (ShowSubmitButton) { <ButtonControl ButtonType="submit" Disabled="@(!Enabled || _submitting)">@SubmitText</ButtonControl> }
        </CascadingValue>
    </EditForm>
}
@code {
    [Parameter] public object? Model { get; set; }
    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public bool EnableDataAnnotations { get; set; } = true;
    [Parameter] public bool ShowValidationSummary { get; set; } = true;
    [Parameter] public bool ShowSubmitButton { get; set; } = true;
    [Parameter] public string SubmitText { get; set; } = "Save";
    [Parameter] public int Columns { get; set; } = 1;
    [Parameter] public string ColumnSpacing { get; set; } = "12px";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? ButtonsTemplate { get; set; }
    [Parameter] public RenderFragment? ValidatorTemplate { get; set; }
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; }
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback<EditContext> OnInvalidSubmit { get; set; }
    [Parameter] public EventCallback<FormFieldChangedArgs> OnUpdate { get; set; }
    private EditContext? _context;
    private bool _submitting;
    public EditContext? CurrentEditContext => _context;
    protected override void OnParametersSet()
    {
        if (Model != null && EditContext != null) throw new InvalidOperationException("Supply Model or EditContext, not both.");
        if (EditContext != null) _context=EditContext;
        else if (Model != null) { if (!ReferenceEquals(_context?.Model, Model)) _context=new(Model); }
        else throw new InvalidOperationException("FormControl requires Model or EditContext.");
    }
    public bool IsValid() => _context?.Validate() == true;
    public async Task SubmitAsync()
    {
        if (_context == null || _submitting || !Enabled) return;
        _submitting=true;
        try
        {
            await OnSubmit.InvokeAsync(_context);
            if (_context.Validate()) await OnValidSubmit.InvokeAsync(_context);
            else await OnInvalidSubmit.InvokeAsync(_context);
        }
        finally { _submitting=false; }
    }
    internal Task FieldChangedAsync(FormFieldChangedArgs args) => OnUpdate.InvokeAsync(args);
}
