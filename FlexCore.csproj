<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespace and CSS prefix are unchanged from FlexCore — only the
         project / assembly / package name changes here. Source code stays
         under Fx.ControlKit.* so consumer code does not need any edits. -->
    <RootNamespace>Fx.ControlKit</RootNamespace>
    <AssemblyName>FlexCore</AssemblyName>
    <!-- NuGet metadata -->
    <PackageId>FlexCore</PackageId>
    <Version>0.2.34</Version>
    <Authors>FlexCore Contributors</Authors>
    <Company>FlexCore Contributors</Company>
    <Product>FlexCore</Product>
    <Description>Enterprise Blazor component suite for .NET — built 100% in C# and SVG, with no npm packages, no webpack pipeline, and no JavaScript interop bottlenecks. The data grid virtualizes tens of thousands of rows at 60 FPS with frozen columns, hierarchical tree grids, multi-column sorting, typed filtering, inline/dialog/batch editing, aggregate footers and native ClosedXML Excel export. Also includes charts, diagrams, a Crystal-compatible report writer, scheduler, pivot, MDI layout and 60+ further controls. Host-agnostic: every external dependency is a clean C# interface, so you wire your own EF Core, Dapper or SQL Server data layer. Designed for VB6 / WinForms / ActiveX modernizations that need desktop-grade behaviour on the web.</Description>
    <PackageTags>blazor;controls;grid;treegrid;reports;charts;ribbon;toolbar;dialog;notification;diagram;dotnet;razor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://flexcoreui.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wadoodachaudhary/FlexCore.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 FlexCore Contributors</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
