@namespace Fx.ControlKit
@inherits FlexControlBase

@if (_visible)
{
    <div class="@ResolvedAlertCss" role="alert" style="@Style" @attributes="AdditionalAttributes">
        @if (ShowIcon)
        {
            <div class="fx-alert-icon">
                @if (Severity == AlertSeverity.Success)
                {
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                }
                else if (Severity == AlertSeverity.Warning)
                {
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                }
                else if (Severity == AlertSeverity.Error)
                {
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.486 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                }
            </div>
        }

        <div class="fx-alert-content">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h6 class="fx-alert-title">@Title</h6>
            }
            @if (!string.IsNullOrEmpty(Text))
            {
                <div class="fx-alert-text">@Text</div>
            }
            @ChildContent
        </div>

        @if (AllowClose)
        {
            <button type="button" class="fx-alert-close" aria-label="Close" @onclick="CloseAlert">
                <span aria-hidden="true">&times;</span>
            </button>
        }
    </div>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public AlertSeverity Severity { get; set; } = AlertSeverity.Info;
    [Parameter] public bool ShowIcon { get; set; } = true;
    [Parameter] public bool AllowClose { get; set; } = false;
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _visible = true;

    private async Task CloseAlert()
    {
        _visible = false;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private string ResolvedAlertCss
    {
        get
        {
            var severityClass = Severity switch
            {
                AlertSeverity.Success => "fx-alert-success",
                AlertSeverity.Warning => "fx-alert-warning",
                AlertSeverity.Error => "fx-alert-error",
                _ => "fx-alert-info"
            };

            return $"fx-alert {severityClass} {CssClass}".Trim();
        }
    }
}
