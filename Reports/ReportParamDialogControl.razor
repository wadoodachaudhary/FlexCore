@* ReportParamDialogControl — modal prompt for Crystal Reports parameter values.

   Mirrors the VB6 / Crystal "Enter Parameter Values" dialog. The title bar carries the
   report's name, centred, with "Enter Parameter Values" small and grey beside it. For
   each required parameter it renders a panel containing:

     - left:  the prompt text (e.g. "Enter Job:")
     - right: a secondary label with the parameter's display name
       (an Available/Selected pair has no heading row: the prompt text sits on the
       Available header line after its search icon, and the display name on the
       Selected header line only when it differs from the prompt)
     - body:  one of:
        * dual-list-box   (AllowMultiple=True with default-values or pick-list)
        * combo dropdown  (AllowMultiple=False with 2+ default values)
        * pick-list combo (single-value pick-list provided by host)
        * date / number / boolean / free-text typed input

   Lives in FlexKit (no DB or app-specific dependencies). The host app
   registers an IReportPickListProvider implementation (or none — the
   dialog gracefully falls back to free-text inputs for parameters with
   neither default values nor a pick-list).

   Output contract:
     - Single-value parameters: result[Name] = the scalar value (string /
       long / decimal / DateTime / bool).
     - Multi-value parameters: result[Name] = string[] of the user's picks.
       Callers should pass these arrays through
       Fx.ControlKit.Reports.MultiValueParameterRewriter.Apply so the SQL's
       "= @Name" placeholder gets expanded into "IN (@Name_0, ...)".

   Usage:
     <ReportParamDialogControl @ref="paramDialog" />
     ...
     var values = await paramDialog.PromptAsync(reportName, definition.Parameters);
     if (values == null) return; // user cancelled
*@

@namespace Fx.ControlKit.Reports

@using Fx.ControlKit
@implements IDisposable

@if (_visible)
{
  <div class="fx-param-dialog-host">
    <DialogControl Visible="true" Header="Enter Parameter Values" Width="min(900px, 94vw)" OnClose="Cancel">
        <HeaderContent>
            @if (string.IsNullOrWhiteSpace(_title))
            {
                @("Enter Parameter Values")
            }
            else
            {
                <span class="fx-param-heading">
                    <span class="fx-param-heading-label">Enter Parameter Values</span>
                    <span class="fx-param-heading-title" title="@_title">@_title</span>
                    <span aria-hidden="true"></span>
                </span>
            }
        </HeaderContent>
        <ChildContent>
            <div class="fx-param-body">
                @foreach (var p in _parameters)
                {
                    var pickList = _pickLists.TryGetValue(p.Name, out var list) ? list : null;
                    var defaults = p.DefaultValues;
                    var isDependent = _dependencies.ContainsKey(p.Name);
                    var hasDefaults = !isDependent && defaults.Count > 0;
                    var promptText = PromptText(p);
                    var secondaryLabel = SecondaryLabel(p);
                    var isDualList = IsDualList(p);
                    <div class="fx-param-panel @(isDualList ? "fx-param-panel-list" : null)">
                        @if (!isDualList)
                        {
                            <div class="fx-param-panel-header">
                                <span class="fx-param-prompt-text">@promptText</span>
                                <span class="fx-param-secondary-label">@secondaryLabel</span>
                            </div>
                        }
                        <div class="fx-param-panel-body">
                            @if (p.AllowRange)
                            {
                                @for (var index = 0; index < _ranges[p.Name].Count; index++)
                                {
                                    var rangeIndex = index;
                                    <ReportRangeControl Type="@p.ParameterType" Value="@_ranges[p.Name][index]"
                                        ValueChanged="value => _ranges[p.Name][rangeIndex] = value" />
                                    @if (p.AllowMultiple)
                                    {
                                        <ButtonControl Title="Remove range" OnClick="() => _ranges[p.Name].RemoveAt(rangeIndex)">Remove range</ButtonControl>
                                    }
                                }
                                @if (p.AllowMultiple)
                                {
                                    <ButtonControl Disabled="@(_ranges[p.Name].Count >= 100)" OnClick="() => _ranges[p.Name].Add(new(null, null))">Add range</ButtonControl>
                                }
                            }
                            else if (p.AllowMultiple)
                            {
                                @* ── Dual-list-box ─────────────────────────
                                   Crystal renders multi-value parameters as an
                                   Available/Selected pair. The Available pool
                                   comes from <ParameterDefaultValues> (the
                                   common case for the DT-style reports),
                                   falling back to the host-provided pick-list
                                   if present. When neither source has items,
                                   the dual-list still renders empty so the
                                   "Enter a Value" input below can populate
                                   it for AllowCustomCurrentValues=True
                                   parameters. *@
                                @* Crystal's prompt lists the values in batches (200 by
                                   default), keeps every value listed under Available and
                                   adds only the batch on screen with >>, so the same clicks
                                   submit the same values in both applications. < and <<
                                   take values out of Selected. The prompt names the lists
                                   on their header line; the lists share the dialog's height
                                   so every prompt shows without scrolling. *@
                                <MultiSelectDualListControl TItem="ListItem"
                                                            Items="@GetMultiAvailable(p.Name)"
                                                            SelectedItems="@GetMultiSelected(p.Name)"
                                                            SelectedItemsChanged="@(items => SetMultiSelected(p.Name, items))"
                                                            LeftHeader="Available Values:"
                                                            RightHeader="Selected Values:"
                                                            LeftCaption="@promptText"
                                                            RightCaption="@(string.Equals(secondaryLabel.Trim(), promptText.Trim(), StringComparison.OrdinalIgnoreCase) ? null : secondaryLabel)"
                                                            KeySelector="@(i => i.Key)"
                                                            LabelSelector="@(i => i.Label)"
                                                            VisibleRows="7"
                                                            Height="@DualListHeight"
                                                            BatchSize="@PromptBatchSize"
                                                            KeepAvailableItems="true" />

                                @if (HasCustomEntryRow(p))
                                {
                                    @* "Enter a Value" custom-entry row — mirrors
                                       the Crystal dialog's inline text input +
                                       > button for adding ad-hoc values to the
                                       Selected pane. *@
                                    <div class="fx-param-custom-row">
                                        <label class="fx-param-value-label">Enter a Value:</label>
                                        <TextBoxControl CssClass="fx-param-value-input" Value="@_customDrafts.GetValueOrDefault(p.Name)"
                                                        ValueChanged="value => _customDrafts[p.Name] = value ?? string.Empty" UpdateOnInput="true"
                                                        OnKeyDown="e => OnCustomKeyDown(e, p.Name)" />
                                        <ButtonControl Title="Add selected value" OnClick="() => AddCustomValue(p.Name)">&gt;</ButtonControl>
                                    </div>
                                }
                            }
                            else if (hasDefaults && defaults.Count >= 2)
                            {
                                @* Crystal default-values dropdown — shows description,
                                   sets value behind it. Same as before. *@
                                <DropDownListControl TValue="string" TItem="ListItem"
                                    DataSource="@defaults.Select(choice => new ListItem(choice.Value, ChoiceLabel(p, choice)))"
                                    ValueFieldName="Key" TextFieldName="Label" Value="@_values.GetValueOrDefault(p.Name)"
                                    ValueChanged="value => SetValue(p.Name, value ?? string.Empty)" AriaLabel="@p.Name" />
                                @if (p.AllowCustomCurrentValues)
                                {
                                    <label class="fx-param-value-label">Enter a Value:</label>
                                    <TextBoxControl Value="@_values.GetValueOrDefault(p.Name)" ValueChanged="value => SetValue(p.Name, value ?? string.Empty)" />
                                }
                            }
                            else if (isDependent || (pickList != null && pickList.Count > 0))
                            {
                                <DropDownListControl TValue="string" TItem="PickListItem" DataSource="@_singlePickLists.GetValueOrDefault(p.Name)"
                                    ValueFieldName="Value" TextFieldName="Display" Value="@PickListValue(p)"
                                    ValueChanged="value => SetPickListValue(p.Name, value)" AllowFiltering="true" AriaLabel="@p.Name"
                                    Enabled="@(!isDependent || _readyLists.Contains(p.Name))" />
                            }
                            else if (p.ParameterType == ReportParameterType.Integer || p.ParameterType == ReportParameterType.Decimal)
                            {
                                <NumericTextBoxControl TValue="decimal?" Value="@ParseNumberValue(_values.GetValueOrDefault(p.Name))"
                                    ValueChanged="value => SetValue(p.Name, value?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? string.Empty)" />
                            }
                            else if (p.ParameterType == ReportParameterType.Date)
                            {
                                <DatePickerControl Value="@ParseDateValue(_values.GetValueOrDefault(p.Name))"
                                                   ValueChanged="@(v => SetValue(p.Name, v.HasValue ? v.Value.ToString("yyyy-MM-dd") : ""))" />
                            }
                            else if (p.ParameterType == ReportParameterType.Boolean)
                            {
                                <DropDownListControl TValue="string" TItem="string" DataSource="@(new[] { "True", "False" })"
                                    Value="@_values.GetValueOrDefault(p.Name)" ValueChanged="value => SetValue(p.Name, value ?? string.Empty)" AriaLabel="@p.Name" />
                            }
                            else
                            {
                                <TextBoxControl Value="@_values.GetValueOrDefault(p.Name)" ValueChanged="value => SetValue(p.Name, value ?? string.Empty)" />
                            }
                            @if (isDependent)
                            {
                                @if (_listErrors.TryGetValue(p.Name, out var listError))
                                {
                                    <div class="fx-param-error" role="alert">@listError</div>
                                    <ButtonControl OnClick="() => RetryDependentChoices(p.Name)">Retry</ButtonControl>
                                }
                                else if (!_readyLists.Contains(p.Name))
                                {
                                    <div role="status" aria-live="polite">@DependentStatus(p.Name)</div>
                                }
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="fx-param-error">@_error</div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <ButtonControl CssClass="fx-button-primary" OnClick="Accept" Disabled="@ChoicesUnavailable">OK</ButtonControl>
            <ButtonControl OnClick="Cancel">Cancel</ButtonControl>
        </FooterContent>
    </DialogControl>
  </div>
}

@code {
    /// <summary>
    /// Optional pick-list source. When null (no implementation registered in DI)
    /// every parameter falls back to a free-text / typed input or — for
    /// multi-value parameters with default values — the dual-list-box sourced
    /// from those defaults.
    /// </summary>
    [Inject] private IServiceProvider? Services { get; set; }
    private IReportPickListProvider? PickLists => Services?.GetService(typeof(IReportPickListProvider)) as IReportPickListProvider;

    private bool _visible;
    private string _title = "";
    private List<ReportParameter> _parameters = new();
    private Dictionary<string, string> _values = new();
    private Dictionary<string, List<ReportRangeValue>> _ranges = new();
    private Dictionary<string, IReadOnlyList<PickListItem>> _pickLists = new();
    private Dictionary<string, IReadOnlyList<PickListItem>> _singlePickLists = new();
    private const string NoValueChoice = "fx-param-no-value";

    private string PickListValue(ReportParameter p)
    {
        var value = _values.GetValueOrDefault(p.Name) ?? "";
        return value.Length == 0 && p.IsOptional ? NoValueChoice : value;
    }

    private Task SetPickListValue(string name, string? value)
        => SetValue(name, value is null or NoValueChoice ? string.Empty : value);

    // Per-parameter dual-list state. Each multi-value parameter gets its
    // own Available pool (seeded from DefaultValues or PickListSql) and
    // Selected list. Keeping these as IList<ListItem> matches what
    // MultiSelectDualListControl binds to.
    private readonly Dictionary<string, List<ListItem>> _multiAvailable =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IList<ListItem>> _multiSelected =
        new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// How many values a multi-value prompt lists per batch under Available Values.
    /// Crystal's "Enter Parameter Values" dialog lists a dynamic list of values 200 at
    /// a time and its &gt;&gt; adds only the loaded batch (SAP's default batch size), so
    /// 200 keeps a prompt answered with "&gt;&gt;" identical in both applications. 0 lists
    /// every value at once.
    /// </summary>
    [Parameter] public int PromptBatchSize { get; set; } = 200;

    // Per-parameter "Enter a Value:" draft state for AllowCustomCurrentValues
    // / no-source multi-value parameters. The custom value is committed to
    // the Selected list when the user clicks the > button or presses Enter.
    private readonly Dictionary<string, string> _customDrafts =
        new(StringComparer.OrdinalIgnoreCase);

    private string? _error;
    private TaskCompletionSource<Dictionary<string, object>?>? _tcs;
    private ReportPickListContext? _pickListContext;
    private IReportDependentPickListProvider? _dependentProvider;
    private readonly Dictionary<string, IReadOnlyList<string>> _dependencies = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<ReportParameter> _dependencyOrder = [];
    private readonly Dictionary<string, string[]> _pendingChoices = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _readyLists = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _loadingLists = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _listErrors = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _lookupCancellation;
    private long _lookupVersion;
    private bool _lookupActive;
    private bool _dependencySetupFailed;
    private bool _disposed;
    private bool ChoicesUnavailable => _lookupActive || _dependencySetupFailed || _listErrors.Count > 0;

    private static string PromptText(ReportParameter p) => !string.IsNullOrEmpty(p.Prompt) ? p.Prompt : p.Name;

    private static string SecondaryLabel(ReportParameter p) => !string.IsNullOrWhiteSpace(p.DisplayName) ? p.DisplayName : p.Name;

    /// <summary>A multi-value prompt without ranges: an Available/Selected pair.</summary>
    private static bool IsDualList(ReportParameter p) => p.AllowMultiple && !p.AllowRange;

    /// <summary>The "Enter a Value:" row under a pair: custom values allowed, or no list to pick from.</summary>
    private bool HasCustomEntryRow(ReportParameter p)
    {
        if (!IsDualList(p) || _dependencies.ContainsKey(p.Name)) return false;
        var hasPickList = _pickLists.TryGetValue(p.Name, out var list) && list is { Count: > 0 };
        return p.AllowCustomCurrentValues || (p.DefaultValues.Count == 0 && !hasPickList);
    }

    // Heights (px at text zoom 1, measured in Chrome) of what surrounds the lists: the title bar, footer and body
    // padding; a list panel's padding, rule, margin and count line; one other prompt; an "Enter a Value:" row.
    // Rounded up, so fractional pixels never leave a 1-4px scrollbar on a dialog that fits.
    private const int DialogChromeHeight = 106;
    private const int ListPanelHeight = 34;
    private const int OtherPromptHeight = 66;
    private const int CustomEntryRowHeight = 42;

    /// <summary>The dialog's height limit (also set in the .razor.css): 90% of the window, and never over 1200px.</summary>
    private const string DialogMaxHeight = "min(90vh, calc(1200px * var(--fx-zoom, 1)))";

    /// <summary>
    /// Height of each Available/Selected pair, for any number of pairs and other prompts. The pairs share what
    /// the title bar, footer and other prompts leave of <see cref="DialogMaxHeight"/>, between 136px and the
    /// former fixed 236px each. So every prompt shows without scrolling while it fits (three pairs fit a
    /// 720px-tall window, five a 1060px one); beyond that, or past 1200px, the lists keep 136px and the dialog
    /// body scrolls.
    /// </summary>
    private string DualListHeight
    {
        get
        {
            var lists = _parameters.Count(IsDualList);
            if (lists == 0) return "236px";
            var around = DialogChromeHeight + lists * ListPanelHeight + (_parameters.Count - lists) * OtherPromptHeight
                + _parameters.Count(HasCustomEntryRow) * CustomEntryRowHeight;
            return string.Create(System.Globalization.CultureInfo.InvariantCulture,
                $"clamp(calc(136px * var(--fx-zoom, 1)), calc(({DialogMaxHeight} - {around}px * var(--fx-zoom, 1)) / {lists}), calc(236px * var(--fx-zoom, 1)))");
        }
    }

    /// <summary>Internal record used as the TItem for the dual-list-box.
    /// Stable key + display label.</summary>
    public sealed record ListItem(string Key, string Label);

    private static string ChoiceLabel(ReportParameter parameter, ReportParameterChoice choice)
    {
        if (parameter.ParameterType != ReportParameterType.Boolean || !bool.TryParse(choice.Value, out var value))
            return string.IsNullOrWhiteSpace(choice.Description) ? choice.Value : choice.Description;
        var text = value ? bool.TrueString : bool.FalseString;
        return string.IsNullOrWhiteSpace(choice.Description) || choice.Description.Equals(choice.Value, StringComparison.OrdinalIgnoreCase)
            ? text : $"{text} - {choice.Description}";
    }

    private static string NormalizeInitialValue(ReportParameter parameter, string value)
    {
        // The authored-choice dropdown compares string keys exactly. Typed Boolean values
        // and saved current values may use different casing from those original keys.
        if (parameter.ParameterType == ReportParameterType.Boolean && parameter.DefaultValues.Count >= 2
            && bool.TryParse(value, out var flag))
            return parameter.DefaultValues.FirstOrDefault(choice => bool.TryParse(choice.Value, out var candidate) && candidate == flag)?.Value ?? value;
        return value;
    }

    /// <summary>
    /// Shows the dialog, waits for user input, and returns a parameter-value
    /// dictionary suitable for <see cref="ReportWriterControl.ShowSqlReport"/>.
    /// Multi-value parameters come back as <c>string[]</c>; everything else
    /// comes back as a typed scalar. Returns null if the user cancelled.
    ///
    /// <para>
    /// <paramref name="initialValues"/> lets a caller re-open the dialog with
    /// the user's previous selections preserved (the "Return to Parameters"
    /// toolbar action in FRptViewer). Multi-value entries are recognized as
    /// <c>string[]</c> or <see cref="IEnumerable{T}"/> of strings; everything
    /// else is treated as a scalar and round-tripped through ToString() into
    /// the underlying input. Values for parameter names that aren't in the
    /// current prompt set are ignored.
    /// </para>
    /// </summary>
    public async Task<Dictionary<string, object>?> PromptAsync(
        string title,
        List<ReportParameter> parameters,
        IReadOnlyDictionary<string, object>? initialValues = null,
        ReportPickListContext? context = null)
    {
        ObjectDisposedException.ThrowIf(_disposed, this);
        StopLookups();
        _tcs?.TrySetResult(null);
        _visible = false;
        _title = title;
        // Only prompt for parameters that are both "Required" and don't already have a default value.
        _parameters = parameters.Where(p => p.Required).ToList();
        if (_parameters.Count == 0)
            return new Dictionary<string, object>();

        _values = _parameters.ToDictionary(p => p.Name, p => NormalizeInitialValue(p, p.DefaultValue ?? ""));
        _ranges = _parameters.Where(p => p.AllowRange).ToDictionary(p => p.Name,
            p => initialValues is not null && initialValues.TryGetValue(p.Name, out var value)
                ? ReportRangeParameters.Ranges(value).Select(ReportRangeValue.From).ToList()
                : new List<ReportRangeValue> { new(null, null) });
        _pickLists = new Dictionary<string, IReadOnlyList<PickListItem>>();
        _singlePickLists = new Dictionary<string, IReadOnlyList<PickListItem>>();
        _multiAvailable.Clear();
        _multiSelected.Clear();
        _customDrafts.Clear();
        _dependencies.Clear();
        _dependencyOrder.Clear();
        _pendingChoices.Clear();
        _readyLists.Clear();
        _loadingLists.Clear();
        _listErrors.Clear();
        _dependencySetupFailed = false;
        _error = null;
        _pickListContext = SnapshotContext(context ?? new(title, parameters.ToArray(), new Dictionary<string, object>()));
        var provider = PickLists;
        _dependentProvider = provider as IReportDependentPickListProvider;
        ConfigureDependencies();
        if (provider != null && !_dependencySetupFailed)
        {
            foreach (var p in _parameters)
            {
                if (_dependencies.ContainsKey(p.Name)) continue;
                // Prefer the ReportParameter overload — the provider can
                // run the loader's auto-derived PickListSql (sourced from
                // the Crystal XML's RecordSelectionFormula binding) so
                // picklists work for any parameter that filters on a
                // table.field, with no host-side per-parameter mapping.
                var list = provider.GetPickList(p);
                // A single-value drop-down leaves out blank values (an authored list keeps them for the
                // dual list below): the drop-down treats "" as no selection, so a blank item could not be
                // chosen and would trap arrow-key movement on itself.
                var choices = p.AllowMultiple ? list : list?.Where(item => !string.IsNullOrEmpty(item.Value)).ToArray();
                if (list != null && choices?.Count > 0)
                {
                    _pickLists[p.Name] = list;
                    // An optional parameter keeps a "..." choice so a picked value can be cleared
                    // again (blank = no filter; Accept skips optional parameters). Its key is a
                    // sentinel, not "", for the same reason. PickListValue/SetPickListValue map it.
                    _singlePickLists[p.Name] = p.IsOptional ? [new PickListItem(NoValueChoice, "..."), .. choices] : choices;
                }
            }
        }

        // Seed dual-list state for every multi-value parameter. The
        // Available pool comes from <ParameterDefaultValues> if any are
        // present, otherwise from the host pick-list (if registered).
        // When neither source contributes items the dual-list still
        // renders empty — the "Enter a Value" custom-entry row below it
        // (visible when AllowCustomCurrentValues=true) lets the user
        // populate the Selected pane by typing.
        foreach (var p in _parameters.Where(p => p.AllowMultiple))
        {
            var available = new List<ListItem>();
            if (!_dependencies.ContainsKey(p.Name) && p.DefaultValues.Count > 0)
            {
                foreach (var choice in p.DefaultValues)
                {
                    if (string.IsNullOrEmpty(choice.Value)) continue;
                    var label = string.IsNullOrWhiteSpace(choice.Description)
                        ? choice.Value : choice.Description;
                    available.Add(new ListItem(choice.Value, label));
                }
            }
            else if (_pickLists.TryGetValue(p.Name, out var list))
            {
                foreach (var item in list)
                {
                    // A list authored in the report keeps its blank value: Crystal lists it
                    // (a blank line, or "- description") and it counts toward the batch of 200.
                    if (string.IsNullOrEmpty(item.Value) && !p.PickListIsAuthored) continue;
                    available.Add(new ListItem(item.Value, item.Display ?? item.Value));
                }
            }
            _multiAvailable[p.Name] = available;
            _multiSelected[p.Name] = new List<ListItem>();
            _customDrafts[p.Name] = "";
        }

        // Overlay caller-supplied initial values onto the seeded state.
        // Done LAST so it wins over picklist/default seeding — this is how
        // the "Return to Parameters" action restores the user's prior picks.
        if (initialValues != null)
        {
            foreach (var p in _parameters)
            {
                if (p.AllowRange || !initialValues.TryGetValue(p.Name, out var raw) || raw is null) continue;

                if (_dependencies.ContainsKey(p.Name))
                {
                    _pendingChoices[p.Name] = raw switch
                    {
                        IEnumerable<string> values => values.Where(value => !string.IsNullOrEmpty(value)).ToArray(),
                        _ => [NormalizeInitialValue(p, Convert.ToString(raw, System.Globalization.CultureInfo.CurrentCulture) ?? "")]
                    };
                    continue;
                }

                if (p.AllowMultiple)
                {
                    // Accept string[] or IEnumerable<string>. Build the
                    // Selected list by looking each value up in Available;
                    // entries not found in Available become ad-hoc Selected
                    // items (covers AllowCustomCurrentValues-typed values).
                    IEnumerable<string>? values = raw switch
                    {
                        string[] arr => arr,
                        IEnumerable<string> en => en,
                        _ => null
                    };
                    if (values == null) continue;

                    var available = _multiAvailable.TryGetValue(p.Name, out var av) ? av : new List<ListItem>();
                    var selected = new List<ListItem>();
                    foreach (var v in values)
                    {
                        if (string.IsNullOrEmpty(v)) continue;
                        var match = available.FirstOrDefault(i => string.Equals(i.Key, v, StringComparison.OrdinalIgnoreCase));
                        selected.Add(match ?? new ListItem(v, v));
                    }
                    _multiSelected[p.Name] = selected;
                }
                else
                {
                    // Scalar — stringify so the underlying typed input shows
                    // the prior value. Date is formatted as ISO so DatePickerControl
                    // parses it back via ParseDateValue.
                    _values[p.Name] = NormalizeInitialValue(p, raw switch
                    {
                        DateTime dt => dt.ToString("yyyy-MM-dd"),
                        bool b      => b ? "True" : "False",
                        IFormattable f => f.ToString(null, System.Globalization.CultureInfo.InvariantCulture),
                        _ => raw.ToString() ?? ""
                    });
                }
            }
        }

        foreach (var p in _parameters.Where(p => _dependencies.ContainsKey(p.Name)))
            _values[p.Name] = ""; // Authoritative choices never inherit an unchecked authored default.
        _visible = true;
        var completion = new TaskCompletionSource<Dictionary<string, object>?>(TaskCreationOptions.RunContinuationsAsynchronously);
        _tcs = completion;
        StateHasChanged();
        // A cancelled/replaced prompt completes immediately even when a provider ignores cancellation.
        // Refresh catches lookup failures and checks its generation before publishing any state.
        if (!_dependencySetupFailed) _ = RefreshDependentChoices();
        return await completion.Task;
    }

    private static ReportPickListContext SnapshotContext(ReportPickListContext context)
        => new(context.ReportName, Array.AsReadOnly(context.Parameters.ToArray()),
            new System.Collections.ObjectModel.ReadOnlyDictionary<string, object>(context.Values.ToDictionary(
                pair => pair.Key, pair => pair.Value is string[] values ? (object)values.ToArray() : pair.Value,
                StringComparer.OrdinalIgnoreCase)));

    private ReportPickListContext CurrentContext()
    {
        var values = _pickListContext!.Values.ToDictionary(pair => pair.Key,
            pair => pair.Value is string[] array ? (object)array.ToArray() : pair.Value, StringComparer.OrdinalIgnoreCase);
        foreach (var parameter in _parameters)
        {
            if (parameter.AllowMultiple)
                values[parameter.Name] = GetMultiSelected(parameter.Name).Select(item => item.Key).ToArray();
            else if (!string.IsNullOrWhiteSpace(_values.GetValueOrDefault(parameter.Name)))
                values[parameter.Name] = ConvertValue(_values[parameter.Name], parameter.ParameterType);
            else
                values.Remove(parameter.Name);
        }
        return SnapshotContext(_pickListContext with { Values = values });
    }

    private void ConfigureDependencies()
    {
        if (_dependentProvider is null) return;
        try
        {
            var context = CurrentContext();
            foreach (var parameter in _parameters)
            {
                var parents = _dependentProvider.GetDependencies(parameter, context);
                if (parents is null) continue;
                if (parents.Any(parent => string.IsNullOrWhiteSpace(parent)
                    || !_pickListContext!.Parameters.Any(item => item.Name.Equals(parent, StringComparison.OrdinalIgnoreCase))
                        && !_pickListContext.Values.ContainsKey(parent)))
                    throw new InvalidDataException("Unknown parameter dependency.");
                _dependencies[parameter.Name] = parents.Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
            }
            var pending = _parameters.Where(parameter => _dependencies.ContainsKey(parameter.Name)).ToList();
            while (pending.Count > 0)
            {
                var next = pending.FirstOrDefault(parameter => _dependencies[parameter.Name].All(parent =>
                    !pending.Any(candidate => candidate.Name.Equals(parent, StringComparison.OrdinalIgnoreCase))));
                if (next is null) throw new InvalidDataException("Cyclic parameter dependencies.");
                _dependencyOrder.Add(next);
                pending.Remove(next);
            }
        }
        catch (Exception)
        {
            _dependencySetupFailed = true;
            _error = "Parameter choices could not be configured. Close the dialog and try again.";
        }
    }

    private bool ParentsSelected(string name)
    {
        var values = CurrentContext().Values;
        return _dependencies[name].All(parent => values.TryGetValue(parent, out var value) && HasSelection(value));
    }

    private static bool HasSelection(object? value) => value switch
    {
        string text => !string.IsNullOrWhiteSpace(text),
        IEnumerable<string> list => list.Any(item => !string.IsNullOrWhiteSpace(item)),
        null or DBNull => false,
        _ => true
    };

    private string DependentStatus(string name) => _loadingLists.Contains(name)
        ? "Loading choices..."
        : "Select " + string.Join(" and ", _dependencies[name].Select(parent =>
            _pickListContext!.Parameters.FirstOrDefault(parameter => parameter.Name.Equals(parent, StringComparison.OrdinalIgnoreCase))
                is { } parameter && !string.IsNullOrWhiteSpace(parameter.DisplayName) ? parameter.DisplayName : parent)) + " first.";

    private bool CurrentLookup(long version, CancellationToken token)
        => !_disposed && _visible && version == _lookupVersion && !token.IsCancellationRequested;

    private void StopLookups()
    {
        _lookupVersion++;
        _lookupCancellation?.Cancel();
        _lookupCancellation?.Dispose();
        _lookupCancellation = null;
        _lookupActive = false;
    }

    private async Task RefreshDependentChoices()
    {
        if (_dependentProvider is null || _dependencyOrder.Count == 0 || !_visible || _dependencySetupFailed) return;
        StopLookups();
        var version = _lookupVersion;
        var cancellation = new CancellationTokenSource();
        _lookupCancellation = cancellation;
        var token = cancellation.Token;
        var provider = _dependentProvider;
        _lookupActive = true;
        _loadingLists.Clear();
        StateHasChanged();
        try
        {
            foreach (var parameter in _dependencyOrder.ToArray())
            {
                if (!CurrentLookup(version, token)) return;
                var name = parameter.Name;
                if (_readyLists.Contains(name) || _listErrors.ContainsKey(name) || !ParentsSelected(name)) continue;
                _loadingLists.Add(name);
                StateHasChanged();
                try
                {
                    var choices = await provider.GetPickListAsync(parameter, CurrentContext(), token);
                    if (!CurrentLookup(version, token)) return;
                    ApplyDependentChoices(parameter, choices ?? throw new InvalidDataException("No choice result."));
                    _readyLists.Add(name);
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { return; }
                catch (Exception)
                {
                    if (!CurrentLookup(version, token)) return;
                    _listErrors[name] = "Could not load choices. Please retry.";
                }
                finally
                {
                    if (CurrentLookup(version, token))
                    {
                        _loadingLists.Remove(name);
                        StateHasChanged();
                    }
                }
            }
        }
        finally
        {
            if (CurrentLookup(version, token))
            {
                _lookupActive = false;
                StateHasChanged();
            }
        }
    }

    private void ApplyDependentChoices(ReportParameter parameter, IReadOnlyList<PickListItem> choices)
    {
        var allowed = choices.Where(choice => !string.IsNullOrEmpty(choice.Value))
            .DistinctBy(choice => choice.Value, StringComparer.OrdinalIgnoreCase).ToArray();
        var names = _pendingChoices.GetValueOrDefault(parameter.Name) ?? [];
        var selected = names.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _pickLists[parameter.Name] = allowed;
        if (parameter.AllowMultiple)
        {
            var items = allowed.Select(choice => new ListItem(choice.Value, choice.Display)).ToList();
            _multiAvailable[parameter.Name] = items;
            _multiSelected[parameter.Name] = items.Where(item => selected.Contains(item.Key)).ToList();
        }
        else
        {
            // As for an independent list: an optional prompt keeps its "..." clear choice under the sentinel key, and a
            // required one starts with no selection rather than a blank item, which arrow keys could not move past.
            _singlePickLists[parameter.Name] = parameter.IsOptional ? [new PickListItem(NoValueChoice, "..."), .. allowed] : allowed;
            _values[parameter.Name] = allowed.FirstOrDefault(choice => selected.Contains(choice.Value))?.Value ?? "";
        }
        _pendingChoices.Remove(parameter.Name);
    }

    private void InvalidateDependentChoices(string parent, bool includeParent = false)
    {
        var values = CurrentContext().Values;
        var preserveCandidates = includeParent || values.TryGetValue(parent, out var value) && HasSelection(value);
        var changed = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { parent };
        foreach (var parameter in _dependencyOrder)
        {
            var name = parameter.Name;
            if (!(includeParent && name.Equals(parent, StringComparison.OrdinalIgnoreCase))
                && !_dependencies[name].Any(changed.Contains)) continue;
            changed.Add(name);
            // Remove stale visible choices immediately; candidates live privately until the new allowed list validates them.
            if (!preserveCandidates)
                _pendingChoices[name] = [];
            else if (!_pendingChoices.ContainsKey(name))
                _pendingChoices[name] = parameter.AllowMultiple
                    ? GetMultiSelected(name).Select(item => item.Key).ToArray()
                    : [_values.GetValueOrDefault(name) ?? ""];
            _multiAvailable[name] = [];
            _multiSelected[name] = new List<ListItem>();
            _singlePickLists[name] = [];
            _pickLists[name] = [];
            _values[name] = "";
            _readyLists.Remove(name);
            _listErrors.Remove(name);
        }
    }

    private Task RetryDependentChoices(string name)
    {
        InvalidateDependentChoices(name, includeParent: true);
        return RefreshDependentChoices();
    }

    private Task SelectionChanged(string name)
    {
        _error = null;
        if (!_dependencies.Values.Any(parents => parents.Contains(name, StringComparer.OrdinalIgnoreCase))) return Task.CompletedTask;
        InvalidateDependentChoices(name);
        return RefreshDependentChoices();
    }

    // ── Multi-select helpers ─────────────────────────────────────────

    private List<ListItem> GetMultiAvailable(string name) =>
        _multiAvailable.TryGetValue(name, out var v) ? v : new List<ListItem>();

    private IList<ListItem> GetMultiSelected(string name) =>
        _multiSelected.TryGetValue(name, out var v) ? v : new List<ListItem>();

    private Task SetMultiSelected(string name, IList<ListItem> items)
    {
        if (_dependencies.ContainsKey(name))
        {
            if (!_readyLists.Contains(name)) return Task.CompletedTask;
            var selected = items.Select(item => item.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _multiSelected[name] = GetMultiAvailable(name).Where(item => selected.Contains(item.Key)).ToList();
        }
        else _multiSelected[name] = items.ToList();
        return SelectionChanged(name);
    }

    private async Task AddCustomValue(string name)
    {
        if (_dependencies.ContainsKey(name)) return;
        if (!_customDrafts.TryGetValue(name, out var raw)) return;
        var trimmed = (raw ?? "").Trim();
        if (string.IsNullOrEmpty(trimmed)) return;

        var current = GetMultiSelected(name);
        // Don't add duplicates — if the value is already selected, just
        // clear the draft. Case-insensitive match mirrors how Crystal
        // dedupes values internally.
        if (current.Any(i => string.Equals(i.Key, trimmed, StringComparison.OrdinalIgnoreCase)))
        {
            _customDrafts[name] = "";
            StateHasChanged();
            return;
        }
        // Replace the bound list with a NEW reference so MultiSelectDualListControl's
        // OnParametersSet ReferenceEquals check fires and the Selected pane re-syncs.
        // Mutating the existing IList in place leaves _lastSelectedRef pointing at
        // the same object, and the dual-list silently ignores the addition.
        var updated = new List<ListItem>(current) { new ListItem(trimmed, trimmed) };
        _multiSelected[name] = updated;
        _customDrafts[name] = "";
        StateHasChanged();
        await SelectionChanged(name);
    }

    private Task OnCustomKeyDown(KeyboardEventArgs e, string name)
    {
        return e.Key == "Enter" ? AddCustomValue(name) : Task.CompletedTask;
    }

    private Task SetValue(string name, string value)
    {
        if (_dependencies.ContainsKey(name))
        {
            if (!_readyLists.Contains(name)) return Task.CompletedTask;
            if (!string.IsNullOrEmpty(value) && !(_pickLists.GetValueOrDefault(name) ?? [])
                .Any(choice => choice.Value.Equals(value, StringComparison.OrdinalIgnoreCase))) return Task.CompletedTask;
        }
        _values[name] = value;
        return SelectionChanged(name);
    }

    // ── Accept / Cancel ──────────────────────────────────────────────

    private void Accept()
    {
        if (ChoicesUnavailable) return;
        // Validate — required (non-optional) params must be filled in.
        var missing = new List<ReportParameter>();
        foreach (var p in _parameters)
        {
            if (p.IsOptional || p.AllowRange) continue;
            if (p.AllowMultiple)
            {
                if (GetMultiSelected(p.Name).Count == 0) missing.Add(p);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_values.GetValueOrDefault(p.Name))) missing.Add(p);
            }
        }
        if (missing.Count > 0)
        {
            _error = "Please provide: " + string.Join(", ",
                missing.Select(p => string.IsNullOrWhiteSpace(p.DisplayName) ? p.Name : p.DisplayName));
            StateHasChanged();
            return;
        }

        var result = new Dictionary<string, object>();
        try
        {
            foreach (var p in _parameters.Where(p => p.AllowRange))
            {
                var ranges = _ranges[p.Name].Select(value => value.ToRange(p.ParameterType)).ToArray();
                if (ranges.Length == 0 && !p.IsOptional) throw new InvalidDataException($"Choose a range for '{p.Name}'.");
                result[p.Name] = p.AllowMultiple ? ranges : ranges.Single();
            }
        }
        catch (Exception ex) when (ex is FormatException or OverflowException or InvalidDataException or InvalidOperationException)
        {
            _error = ex.Message;
            return;
        }
        foreach (var p in _parameters)
        {
            if (p.AllowRange) continue;
            if (p.AllowMultiple)
            {
                // Multi-value → string[]. Callers route these through
                // MultiValueParameterRewriter so each value becomes its own
                // @Name_0 / @Name_1 / … placeholder in the SQL.
                result[p.Name] = GetMultiSelected(p.Name)
                    .Select(i => i.Key)
                    .ToArray();
            }
            else
            {
                var raw = _values.GetValueOrDefault(p.Name, "");
                result[p.Name] = ConvertValue(raw, p.ParameterType);
            }
        }

        _visible = false;
        StopLookups();
        _tcs?.TrySetResult(result);
        StateHasChanged();
    }

    private void Cancel()
    {
        _visible = false;
        StopLookups();
        _tcs?.TrySetResult(null);
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _visible = false;
        StopLookups();
        _tcs?.TrySetResult(null);
    }

    // Parse the ISO date string held in _values back to DateTime? for the
    // DatePickerControl (it binds DateTime?, not the raw <input type=date> string).
    private static DateTime? ParseDateValue(string? raw)
        => DateTime.TryParse(raw, out var dt) ? dt : (DateTime?)null;

    private static decimal? ParseNumberValue(string? raw) => decimal.TryParse(raw, out var value) ? value : null;

    private static object ConvertValue(string raw, ReportParameterType type) => type switch
    {
        ReportParameterType.Integer => long.TryParse(raw, out var i) ? i : 0L,
        ReportParameterType.Decimal => decimal.TryParse(raw, out var d) ? d : 0m,
        ReportParameterType.Date => DateTime.TryParse(raw, out var dt) ? dt : DateTime.MinValue,
        ReportParameterType.Boolean => bool.TryParse(raw, out var b) && b,
        _ => raw
    };
}
