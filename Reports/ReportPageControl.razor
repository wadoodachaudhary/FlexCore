@namespace Fx.ControlKit.Reports

<article class="fx-report-positioned-page" aria-label="@Page.Title" data-page="@Page.Number"
    style="@($"position:relative;box-sizing:content-box;overflow:hidden;background:white;color:black;letter-spacing:0;width:{Px(Page.Size.ContentWidthTwips + Page.Size.MarginLeftTwips + Page.Size.MarginRightTwips)}px;height:{Px(Page.Size.ContentHeightTwips + Page.Size.MarginTopTwips + Page.Size.MarginBottomTwips)}px;break-after:page;")">
    <div style="@($"position:absolute;left:{Px(Page.Size.MarginLeftTwips)}px;top:{Px(Page.Size.MarginTopTwips)}px;width:{Px(Page.Size.ContentWidthTwips)}px;height:{Px(Page.Size.ContentHeightTwips)}px;overflow:hidden;")">
        @foreach (var band in Page.Bands)
        {
            <section data-section="@band.Name" style="@($"position:absolute;overflow:hidden;{(band.WidthTwips > 0 ? $"left:{Px(band.LeftTwips)}px;width:{Px(band.WidthTwips)}px" : "left:0;width:100%")};top:{Px(band.TopTwips)}px;height:{Px(band.HeightTwips)}px;background:{ReportObjectRenderer.Color(band.Background)};")">
                @foreach (var anchor in IncludeNavigationAnchors ? band.NavigationAnchors : Array.Empty<string>())
                {
                    <span id="@anchor" class="fx-rpt-native-anchor" style="position:absolute;inset:0;pointer-events:none;"></span>
                }
                @foreach (var item in band.Objects)
                {
                    <div data-object="@item.Element.Name" style="@ReportObjectRenderer.Style(item.Element, true, Page.Size.MarginLeftTwips + band.LeftTwips, Page.Size.MarginTopTwips + band.TopTwips)">
                        @if (item.Table is not null)
                        {
                            <ReportTableFragmentControl Fragment="item.Table" Title="item.Element.Name" />
                        }
                        else if (item.Analysis is not null)
                        {
                            <ReportAnalysisControl Element="item.Element" Snapshot="item.Analysis" />
                        }
                        else
                        {
                            @((MarkupString)item.FormattedContent)
                        }
                    </div>
                }
            </section>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ReportPageSnapshot Page { get; set; } = default!;
    [Parameter] public bool IncludeNavigationAnchors { get; set; } = true;
    private static string Px(int twips) => ReportObjectRenderer.Number(twips / 15d);
}
