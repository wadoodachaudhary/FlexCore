    private static void ApplyElementFormat(ReportDesignerElement source, ReportDesignerElement target)
    {
        foreach (var run in target.Visual.Runs)
        {
            if (source.FontFamily != target.FontFamily) run.FontFamily = source.FontFamily;
            if (source.FontSize != target.FontSize) run.FontSize = source.FontSize;
            if (source.Bold != target.Bold) run.Bold = source.Bold;
            if (source.Italic != target.Italic) run.Italic = source.Italic;
            if (source.Underline != target.Underline) run.Underline = source.Underline;
            if (source.TextColor != target.TextColor) run.Color = source.TextColor;
        }
        target.FontFamily = source.FontFamily;
        target.FontSize = source.FontSize;
        target.Bold = source.Bold;
        target.Italic = source.Italic;
        target.Underline = source.Underline;
        target.TextColor = source.TextColor;
        target.BackgroundColor = source.BackgroundColor;
        target.HorizontalAlignment = source.HorizontalAlignment;
        target.CanGrow = source.CanGrow;
        target.FormatString = source.FormatString;
        target.LockFormat = source.LockFormat;
        target.IndentTwips = source.IndentTwips;
        target.HighlightRule = source.HighlightRule.Clone();
    }

