    private static ReportDesignerToolbarItem Button(string command, string iconCss, string tooltip, bool hasDropDown = false) =>
        new(command, iconCss, tooltip, HasDropDown: hasDropDown);

    private static ReportDesignerToolbarItem Sep() =>
        new("", "", "", ReportDesignerToolbarItemKind.Separator);

    private string ToolbarButtonCss(ReportDesignerToolbarItem item)
    {
        var active = IsToolbarCommandActive(item.Command) ? " active" : "";
        var pending = IsToolbarCommandImplemented(item.Command) ? "" : " fx-rd-tool-pending";
        var filePicker = item.Kind == ReportDesignerToolbarItemKind.FileOpen ? " fx-rd-file-picker" : "";
        return $"fx-rd-icon-btn{filePicker} {item.IconCss}{active}{pending}";
    }

    private static string ToolbarIconCss(ReportDesignerToolbarItem item) =>
        $"fx-rd-icon {item.IconCss}";

    private bool IsToolbarItemDisabled(ReportDesignerToolbarItem item)
    {
        if (item.Kind != ReportDesignerToolbarItemKind.Button)
            return false;

        if (!IsToolbarCommandImplemented(item.Command))
            return true;

        return item.Command switch
        {
            "save" => _saving || SaveRequested is null,
            "preview" => !PreviewRequested.HasDelegate,
            "reload" => !CanReload,
            "copy" or "cut" or "delete" => _selectedElement is null,
            "paste" => _clipboardElement is null,
            "formatPainter" => _selectedElement is null && _formatPainterElement is null,
            "undo" => _undoStack.Count <= 1,
            "redo" => _redoStack.Count == 0,
            "field" => !CanInsertField,
            "richText" => _selectedElement is null || _selectedElement.Kind is not ("Text" or "FieldHeading") || _selectedElement.LockFormat,
            "image" => _selectedSection?.ReadOnly == true || (_selectedElement?.Kind == "Picture" && _selectedElement.LockFormat),
            "fontGrow" or "fontShrink" => _selectedElement is null,
            "bold" or "italic" or "underline" or
            "align-left" or "align-center" or "align-right" or "align-justified" or
            "fontcolor" or "fill" or "suppress" or
            "indentIncrease" or "indentDecrease" or "textFormat" or "format" or
            "lockFormat" or "lockSize" or
            "currency" or "thousands" or "percent" or "decimalIncrease" or "decimalDecrease" or
            "nudge-left" or "nudge-right" or "nudge-up" or "nudge-down" => _selectedElement is null,
            _ => false
        };
    }

    private bool IsToolbarCommandActive(string command)
    {
        return command switch
        {
            "bold" => _selectedElement?.Bold == true,
            "italic" => _selectedElement?.Italic == true,
            "underline" => _selectedElement?.Underline == true,
            "align-left" => _selectedElement is not null && string.Equals(NormalizeAlignment(_selectedElement.HorizontalAlignment), "Left", StringComparison.OrdinalIgnoreCase),
            "align-center" => _selectedElement is not null && string.Equals(NormalizeAlignment(_selectedElement.HorizontalAlignment), "Center", StringComparison.OrdinalIgnoreCase),
            "align-right" => _selectedElement is not null && string.Equals(NormalizeAlignment(_selectedElement.HorizontalAlignment), "Right", StringComparison.OrdinalIgnoreCase),
            "align-justified" => _selectedElement is not null && string.Equals(NormalizeAlignment(_selectedElement.HorizontalAlignment), "Justified", StringComparison.OrdinalIgnoreCase),
            "suppress" => _selectedElement?.IsSuppressed == true,
            "lockFormat" => _selectedElement?.LockFormat == true,
            "lockSize" => _selectedElement?.LockSizePosition == true,
            "formatPainter" => _formatPainterElement is not null,
            "design" => IsDesignDocumentActive,
            "code" => IsCodeDocumentActive,
            "fieldExplorer" => IsFieldExplorerActive,
            "reportExplorer" => !IsFieldExplorerActive,
            _ => false
        };
    }

    private static bool IsToolbarCommandImplemented(string command)
    {
        if (command.StartsWith("arrange-", StringComparison.Ordinal) || command.StartsWith("layer-", StringComparison.Ordinal) || command == "duplicate") return true;
        return command is
            "new" or "save" or "export" or "preview" or "reload" or "code" or "design" or
            "print" or "browseData" or "find" or
            "copy" or "cut" or "paste" or "delete" or "formatPainter" or "undo" or "redo" or
            "database" or "record" or "group" or "groupsort" or "section" or "sort" or
            "formula" or "parameter" or "summary" or "page" or
            "visualLinking" or "highlightExpert" or "runningTotal" or
            "wizard" or "text" or "field" or "line" or "box" or "subreport" or "image" or "richText" or "chart" or "crosstab" or
            "bold" or "italic" or "underline" or
            "fontGrow" or "fontShrink" or
            "align-left" or "align-center" or "align-right" or "align-justified" or
            "indentIncrease" or "indentDecrease" or "textFormat" or "format" or
            "fontcolor" or "fill" or "suppress" or "lockFormat" or "lockSize" or
            "currency" or "thousands" or "percent" or "decimalIncrease" or "decimalDecrease" or
            "fieldExplorer" or "reportExplorer" or
            "nudge-left" or "nudge-right" or "nudge-up" or "nudge-down";
    }

    private async Task ExecuteToolbarCommandAsync(string command)
    {
        if (command.StartsWith("arrange-", StringComparison.Ordinal)) { await ArrangeSelectionAsync(command[8..]); return; }
        if (command.StartsWith("layer-", StringComparison.Ordinal)) { await ArrangeSelectionAsync(command); return; }
        if (command == "duplicate") { await DuplicateSelected(); return; }
        switch (command)
        {
            case "new":
            case "wizard":
                await OpenNewWizardAsync();
                break;
            case "save":
                await SaveAsync();
                break;
            case "export":
                await ExportXmlAsync();
                break;
            case "print":
                await PrintAsync();
                break;
            case "preview":
                await PreviewAsync();
                break;
            case "reload":
                await ReloadAsync();
                break;
            case "code":
                ShowDocumentTab(CodeDocumentTab);
                break;
            case "design":
                ShowDocumentTab(DesignDocumentTab);
                break;
            case "copy":
                CopySelected();
                break;
            case "cut":
                await CutSelected();
                break;
            case "paste":
                await PasteSelected();
                break;
            case "formatPainter":
                await ApplyOrCaptureFormatPainterAsync();
                break;
            case "undo":
                await UndoAsync();
                break;
            case "redo":
                await RedoAsync();
                break;
            case "delete":
                await RemoveSelected();
                break;
            case "browseData":
                await OpenExpertAsync(BrowseDataExpert);
                break;
            case "find":
                await OpenExpertAsync(FindExpert);
                break;
            case "database":
                await OpenExpertAsync(DatabaseExpert);
                break;
            case "record":
                await OpenExpertAsync(RecordExpert);
                break;
            case "group":
                await OpenExpertAsync(GroupExpert);
                break;
            case "groupsort":
                await OpenExpertAsync(GroupSortExpert);
                break;
            case "section":
                await OpenExpertAsync(SectionExpert);
                break;
            case "sort":
                await OpenExpertAsync(SortExpert);
                break;
            case "formula":
                await OpenExpertAsync(FormulaExpert);
                break;
            case "parameter":
                await OpenExpertAsync(ParameterExpert);
                break;
            case "summary":
                await OpenExpertAsync(SummaryExpert);
                break;
            case "page":
                await OpenExpertAsync(PageExpert);
                break;
            case "visualLinking":
                await OpenExpertAsync(VisualLinkingExpert);
                break;
            case "highlightExpert":
                await OpenExpertAsync(HighlightingExpert);
                break;
            case "runningTotal":
                await OpenExpertAsync(RunningTotalExpert);
                break;
            case "text":
                await AddTextElement();
                break;
            case "field":
                await AddFieldElement();
                break;
            case "line":
                await AddLineElement();
                break;
            case "box":
                await AddBoxElement();
                break;
            case "subreport":
                await AddSubreportElement();
                break;
            case "image":
                await OpenExpertAsync(command);
                break;
            case "chart":
            case "crosstab":
                await AddAnalysisAsync(command == "chart" ? "Chart" : "CrossTab");
                break;
            case "richText":
                await OpenExpertAsync(command);
                break;
            case "bold":
                await ToggleSelectedElementBool(nameof(ReportDesignerElement.Bold));
                break;
            case "italic":
                await ToggleSelectedElementBool(nameof(ReportDesignerElement.Italic));
                break;
            case "underline":
                await ToggleSelectedElementBool(nameof(ReportDesignerElement.Underline));
                break;
            case "fontGrow":
                await AdjustSelectedFontSizeAsync(1m);
                break;
            case "fontShrink":
                await AdjustSelectedFontSizeAsync(-1m);
                break;
            case "align-left":
                await SetSelectedAlignmentAsync("Left");
                break;
            case "align-center":
                await SetSelectedAlignmentAsync("Center");
                break;
            case "align-right":
                await SetSelectedAlignmentAsync("Right");
                break;
            case "align-justified":
                await SetSelectedAlignmentAsync("Justified");
                break;
            case "indentIncrease":
                await AdjustSelectedIndentAsync(180);
                break;
            case "indentDecrease":
                await AdjustSelectedIndentAsync(-180);
                break;
            case "textFormat":
            case "format":
                await OpenExpertAsync(TextFormatExpert);
                break;
            case "fontcolor":
                await CycleSelectedTextColorAsync();
                break;
            case "fill":
                await CycleSelectedFillColorAsync();
                break;
            case "suppress":
                await ToggleSelectedElementBool(nameof(ReportDesignerElement.IsSuppressed));
                break;
            case "lockFormat":
                await ToggleSelectedElementBool(nameof(ReportDesignerElement.LockFormat));
                break;
            case "lockSize":
                await ToggleSelectedElementBool(nameof(ReportDesignerElement.LockSizePosition));
                break;
            case "currency":
                await SetSelectedFormatAsync("C2");
                break;
            case "thousands":
                await SetSelectedFormatAsync("N0");
                break;
            case "percent":
                await SetSelectedFormatAsync("P2");
                break;
            case "decimalIncrease":
                await AdjustSelectedDecimalsAsync(1);
                break;
            case "decimalDecrease":
                await AdjustSelectedDecimalsAsync(-1);
                break;
            case "fieldExplorer":
                ShowExplorerTab(FieldExplorerTab);
                break;
            case "reportExplorer":
                ShowExplorerTab(ReportExplorerTab);
                break;
            case "nudge-left":
                await NudgeSelected(-60, 0);
                break;
            case "nudge-right":
                await NudgeSelected(60, 0);
                break;
            case "nudge-up":
                await NudgeSelected(0, -60);
                break;
            case "nudge-down":
                await NudgeSelected(0, 60);
                break;
            default:
                _status = "This Crystal toolbar command is not implemented yet.";
                break;
        }
    }

    protected override void OnInitialized() => SetDocument(_document);

    protected override async Task OnParametersSetAsync()
    {
        if (Document is not null && !ReferenceEquals(Document, _lastDocument))
        {
            _lastDocument = Document;
            if (await CanReplaceDocumentAsync())
            {
                SetDocument(Document);
                await NotifyDocumentChangedAsync(markDirty: false);
            }
            return;
        }

        if (!string.IsNullOrWhiteSpace(XmlContent) && !string.Equals(XmlContent, _lastXmlContent, StringComparison.Ordinal))
        {
            _lastXmlContent = XmlContent;
            _lastXmlPath = XmlPath;
            await LoadXmlAsync(XmlContent!, Path.GetFileName(XmlPath ?? "Report.xml"));
            return;
        }

        if (!string.IsNullOrWhiteSpace(XmlPath) && !string.Equals(XmlPath, _lastXmlPath, StringComparison.Ordinal))
        {
            _lastXmlPath = XmlPath;
            await LoadPathAsync(XmlPath!);
        }
    }

    public async Task LoadPathAsync(string xmlPath)
    {
        try
        {
            if (!File.Exists(xmlPath))
                throw new FileNotFoundException("Report file not found.", xmlPath);
            if (!await CanReplaceDocumentAsync())
                return;
            var approvedXml = ExportXml();
            var approvedId = _documentId;
            if (xmlPath.EndsWith(".rpt", StringComparison.OrdinalIgnoreCase))
            {
                var directory = Path.Combine(Path.GetTempPath(), $"fx-rpt-{Guid.NewGuid():N}");
                Directory.CreateDirectory(directory);
                _ownedWorkspaces.Add(directory);
                var convertedPath = await ConvertRptPathAsync(xmlPath, Path.Combine(directory, Path.ChangeExtension(Path.GetFileName(xmlPath), ".xml")));
                if (string.IsNullOrWhiteSpace(convertedPath))
                    return;
                xmlPath = convertedPath;
            }
            var xml = await File.ReadAllTextAsync(xmlPath);
            await LoadXmlAsync(xml, Path.GetFileName(xmlPath), xmlPath,
                confirmReplacement: approvedId != _documentId || approvedXml != ExportXml());
        }
        catch (Exception error)
        {
            _status = "Could not open report: " + error.Message;
        }
    }

    public async Task LoadXmlAsync(string xml, string sourceName = "Report.xml", string? sourcePath = null, bool confirmReplacement = true)
    {
        try
        {
            var document = ReportDesignerXmlSerializer.FromXml(xml, sourceName, sourcePath);
            if (confirmReplacement && !await CanReplaceDocumentAsync())
                return;
            SetDocument(document);
            if (_savedPath is not null)
                _savedHash = ReportDesignerFileStore.Fingerprint(xml);
            _status = _document.StatusMessage;
            await NotifyDocumentChangedAsync(markDirty: false);
        }
        catch (Exception ex)
        {
            _status = $"Could not load report XML: {ex.Message}";
        }
    }

    public string ExportXml() => ReportDesignerXmlSerializer.ToXml(_document);

    public async Task<bool> SaveAsync()
    {
        if (_saving)
            return false;
        if (SaveRequested is null)
        {
            _status = "This host has not provided a save destination.";
            return false;
        }
        _saving = true;
        try
        {
            var request = new ReportDesignerSaveRequest(_documentId, ExportXml(), _document.SourceName, _savedPath, _savedHash, _document.SourcePath);
            var result = await SaveRequested(request);
            if (!result.Succeeded || string.IsNullOrWhiteSpace(result.Path))
            {
                _status = "Save failed: " + (result.Error ?? "No saved file was returned.");
                return false;
            }
            if (request.DocumentId != _documentId)
                return false;
            _savedXml = request.Xml;
            _savedPath = result.Path;
            _savedHash = result.Hash ?? ReportDesignerFileStore.Fingerprint(request.Xml);
            // The source path remains the asset base; saving elsewhere must not relocate dependencies.
            _document.IsDirty = ExportXml() != _savedXml;
            _status = _document.IsDirty ? "Saved snapshot; newer edits remain unsaved." : "Report design saved.";
            await NotifyDocumentChangedAsync(markDirty: false);
            return true;
        }
        catch (Exception error)
        {
            _status = "Save failed: " + error.Message;
            return false;
        }
        finally
        {
            _saving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task<bool> CanReplaceDocumentAsync()
    {
        if (_saving || _promptingForReplacement)
            return false;
        if (!_document.IsDirty)
            return true;
        if (_replacementMessageBox is null)
            return false;
        _promptingForReplacement = true;
        try
        {
            var choice = await _replacementMessageBox.ShowAsync(
                $"Save changes to '{_document.Title}' before replacing this report?",
                title: "Unsaved report design", buttons: MessageBoxButtons.YesNoCancel);
            return choice == MessageBoxResult.No ||
                (choice == MessageBoxResult.Yes && await SaveAsync() && !_document.IsDirty);
        }
        finally { _promptingForReplacement = false; }
    }

    private async Task ExportXmlAsync()
    {
        var xml = ExportXml();
        if (XmlChanged.HasDelegate)
            await XmlChanged.InvokeAsync(xml);
        else
            ShowDocumentTab(CodeDocumentTab);

        _status = "XML exported; the saved report is unchanged.";

        await NotifyDocumentChangedAsync(markDirty: false);
    }

    private async Task PreviewAsync()
    {
        if (PreviewRequested.HasDelegate)
        {
            try
            {
                var snapshot = ReportDesignerXmlSerializer.FromXml(ExportXml(), _document.SourceName, _document.SourcePath);
                await PreviewRequested.InvokeAsync(snapshot);
            }
            catch (Exception error)
            {
                _status = "Preview failed: " + error.Message;
            }
        }
    }

    private async Task PrintAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
            _status = "Print requested.";
        }
        catch
        {
            _status = "Print is not available in this host.";
        }
    }

    private async Task ReloadAsync()
    {
        if (!string.IsNullOrWhiteSpace(_savedPath))
            await LoadPathAsync(_savedPath);
        else if (_savedXml is not null)
            await LoadXmlAsync(_savedXml, _document.SourceName, _document.SourcePath);
    }

    private Task OpenExpertAsync(string expert)
    {
        _activeExpert = expert;
        _activeExpertItemIndex = 0;
        _expertSelectedTables = _document.DataSources.Select(CloneTable).ToList();
        _expertFilters = _document.Filters.Select(CloneFilter).ToList();
        _expertRecordSelectionFormula = _document.RecordSelectionFormula;
        _formulaCheckMessage = "";
        _expertGroups = _document.Groups.Select(CloneGroup).ToList();
        _expertGroupFields = _document.Groups
            .Select(group => ResolveDesignerField(group.Condition))
            .Where(field => !string.IsNullOrWhiteSpace(field.DisplayName))
            .Select(CloneField)
            .ToList();
        _expertSorts = _document.Sorts.Select(CloneSort).ToList();
        _expertSortFields = _expertSorts.Select(sort => CloneField(sort.Field)).ToList();
        _expertSummaries = _document.Summaries.Select(CloneSummary).ToList();
        _expertRunningTotals = CloneTotals(_document.RunningTotals);
        _totalError = "";
        _expertSummaryFields = _expertSummaries.Select(summary => CloneField(summary.Field)).ToList();
        _expertFormulaFields = _document.Fields.Where(field => field.IsFormula).Select(CloneField).ToList();
        _expertParameters = _document.Parameters.Select(CloneParameter).ToList();
        _expertSections = _document.Sections.Select(CloneSectionForExpert).ToList();
        _sectionError = "";
        _expertLinks = _document.Links.Select(CloneLink).ToList();
        _expertSqlValidationMessage = "";
        _expertSqlValidationSucceeded = null;
        _expertSql = string.IsNullOrWhiteSpace(_document.CustomSql) ? BuildExpertSql() : _document.CustomSql;
        _expertSqlEditedByUser = !string.IsNullOrWhiteSpace(_document.CustomSql);
        _expertPage = ClonePage(_document.Page);
        _expertTextFormat = _selectedElement is null ? null : CloneElementForClipboard(_selectedElement);
        _expertVisual = expert == "image" && _selectedElement?.Kind != "Picture" ? new() : _selectedElement?.Visual.Clone() ?? new();
        _runIndex = 0;
        _visualError = "";
        if (expert == "richText" && _expertVisual.Runs.Count == 0 && _selectedElement is { } text)
            _expertVisual.Runs.Add(new ReportTextRun { Text = text.Text, FontFamily = text.FontFamily, FontSize = text.FontSize,
                Bold = text.Bold, Italic = text.Italic, Underline = text.Underline, Color = text.TextColor });
        _expertHighlightRule = _selectedElement?.HighlightRule.Clone() ?? new ReportDesignerHighlightRule
        {
            FieldName = _selectedElement is null ? "" : CleanCrystalFormula(_selectedElement.Binding),
            Operator = FilterOperators[0],
            Value = "",
            FontStyle = "Default",
            TextColor = _selectedElement?.TextColor ?? "#000000",
            BackgroundColor = _selectedElement?.BackgroundColor ?? "transparent",
            BorderStyle = "Default border style"
        };
        _expertTitle = _document.Title;
        _findResultText = "";
        return Task.CompletedTask;
    }

    private Task CloseExpertAsync()
    {
        _activeExpert = null;
        _expertTextFormat = null;
        return Task.CompletedTask;
    }

    private async Task ApplyExpertAsync()
    {
        if (_activeExpert is TextFormatExpert or HighlightingExpert && !CanFormatSelection()) return;
        if (_activeExpert == RunningTotalExpert && !ApplyRunningTotals()) return;
        if (_activeExpert == "image" && _expertVisual.VectorImage is null && !ReportObjectVisual.IsEmbeddedImage(_expertVisual.ImageDataUrl))
        { _visualError = "Choose a supported image first."; return; }
        if (_activeExpert == PageExpert && ReportDesignerEditing.ValidatePage(_expertPage) is string pageError)
        {
            _status = pageError;
            return;
        }
        if (_activeExpert == GroupExpert)
        {
            try { ApplyGroupExpert(); }
            catch (InvalidOperationException error)
            {
                _status = error.Message;
                return;
            }
        }
        if (_activeExpert == RecordExpert)
        {
            try
            {
                ReportDesignerXmlSerializer.BuildSelectionFormula(new ReportDesignerDocument
                {
                    RecordSelectionFormula = _expertRecordSelectionFormula, Filters = _expertFilters
                });
            }
            catch (Exception error) when (error is FormatException or NotSupportedException or OverflowException)
            {
                _status = "Selection was not applied: " + error.Message;
                return;
            }
        }
        switch (_activeExpert)
        {
            case "image":
                if (_selectedElement?.Kind == "Picture")
                {
                    if (_selectedElement.LockFormat || GetActiveSection().ReadOnly) return;
                    _selectedElement.Visual = _expertVisual.Clone();
                }
                else
                {
                    var section = GetActiveSection();
                    if (section.ReadOnly) return;
                    var picture = new ReportDesignerElement { Kind = "Picture", Name = NextObjectName("Picture"), SectionId = section.Id,
                        TopTwips = section.Elements.Select(item => item.TopTwips + item.HeightTwips).DefaultIfEmpty(0).Max(),
                        WidthTwips = Math.Min(2880, _document.Page.ContentWidthTwips), HeightTwips = 1440, Visual = _expertVisual.Clone() };
                    section.Elements.Add(picture);
                    section.HeightTwips = Math.Max(section.HeightTwips, picture.TopTwips + picture.HeightTwips);
                    SelectElement(section, picture);
                }
                break;
            case "richText":
                if (_selectedElement is null || _selectedElement.LockFormat || GetActiveSection().ReadOnly) return;
                _selectedElement.Visual = _expertVisual.Clone();
                _selectedElement.Text = string.Concat(_expertVisual.Runs.Select(run => string.IsNullOrEmpty(run.Binding) ? run.Text : run.Binding));
                break;
            case DatabaseExpert:
                ApplyDatabaseExpert();
                break;
            case RecordExpert:
                _document.Filters = _expertFilters.Select(CloneFilter).ToList();
                _document.RecordSelectionFormula = _expertRecordSelectionFormula;
                break;
            case GroupExpert:
                break;
            case GroupSortExpert:
                _document.Groups = _expertGroups.Select(CloneGroup).ToList();
                break;
            case SectionExpert:
                ApplySectionExpert();
                break;
            case SortExpert:
                _document.Sorts = _expertSorts.Select(CloneSort).ToList();
                break;
            case FormulaExpert:
                ApplyFormulaExpert();
                break;
            case ParameterExpert:
                _document.Parameters = _expertParameters.Select(CloneParameter).ToList();
                break;
            case SummaryExpert:
                _document.Summaries = _expertSummaries.Select(CloneSummary).ToList();
                break;
            case PageExpert:
                _document.Page = ClonePage(_expertPage);
                _document.Title = _expertTitle;
                break;
            case TextFormatExpert:
                ApplyTextFormatExpert();
                break;
            case HighlightingExpert:
                ApplyHighlightingExpert();
                break;
            case VisualLinkingExpert:
                _document.Links = _expertLinks.Select(CloneLink).ToList();
                _document.CustomSql = _expertSqlEditedByUser ? _expertSql : "";
                break;
            case RunningTotalExpert:
                break;
        }

        RebuildExplorerNodes();
        _activeExpert = null;
        await MarkDirtyAsync();
    }

    private RenderFragment RenderExpertContent() => _activeExpert switch
    {
        DatabaseExpert => RenderDatabaseExpert(),
        RecordExpert => RenderRecordExpert(),
        GroupExpert => RenderGroupExpert(),
        GroupSortExpert => RenderGroupSortExpert(),
        SectionExpert => RenderSectionExpert(),
        SortExpert => RenderSortExpert(),
        FormulaExpert => RenderFormulaExpert(),
        ParameterExpert => RenderParameterExpert(),
        SummaryExpert => RenderSummaryExpert(),
        PageExpert => RenderPageExpert(),
        BrowseDataExpert => RenderBrowseDataExpert(),
        FindExpert => RenderFindExpert(),
        TextFormatExpert => RenderTextFormatExpert(),
        "image" => RenderPictureExpert(),
        "richText" => RenderRichTextExpert(),
        HighlightingExpert => RenderHighlightingExpert(),
        VisualLinkingExpert => RenderVisualLinkingExpert(),
        RunningTotalExpert => RenderRunningTotalExpert(),
        _ => @<div class="fx-rd-expert-empty">No expert selected.</div>
    };

    private RenderFragment RenderPictureExpert() => @<div class="fx-rd-expert fx-rd-visual-expert">
        <FilePickerControl OnChange="ReadPictureAsync" Accept="image/png,image/jpeg,image/gif,image/webp" Label="Choose picture" />
        <label>Fit <DropDownListControl TValue="string" TItem="string" DataSource="@(new[] { "contain", "cover", "fill" })" @bind-Value="_expertVisual.ImageFit" Width="140px" /></label>
        @if (!string.IsNullOrEmpty(_visualError)) { <div role="alert">@_visualError</div> }
        @if (ReportObjectVisual.IsEmbeddedImage(_expertVisual.ImageDataUrl) || _expertVisual.VectorImage is not null)
        {
            <img class="fx-rd-picture-preview" src="@(ReportObjectVisual.IsEmbeddedImage(_expertVisual.ImageDataUrl) ? _expertVisual.ImageDataUrl : _expertVisual.VectorImage!.ToDataUrl())" alt="Picture preview" />
        }
    </div>;

    private async Task ReadPictureAsync(InputFileChangeEventArgs args)
    {
        _visualError = "";
        try
        {
            await using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
            using var bytes = new MemoryStream();
            await stream.CopyToAsync(bytes);
            _expertVisual.ImageDataUrl = ReportObjectVisual.EmbedImage(bytes.ToArray());
            _expertVisual.VectorImage = null;
        }
        catch (Exception error) when (error is IOException or InvalidDataException)
        { _visualError = error.Message; }
    }

    private RenderFragment RenderRichTextExpert() => @<div class="fx-rd-expert fx-rd-visual-expert">
        <div class="fx-rd-run-tools">
            <DropDownListControl TValue="int" TItem="int" DataSource="@Enumerable.Range(1, _expertVisual.Runs.Count).ToList()" Value="@(_runIndex + 1)" ValueChanged="value => _runIndex = value - 1" Width="75px" />
            <ButtonControl OnClick="@(_ => AddTextRun())">Add Run</ButtonControl>
            <ButtonControl Disabled="@(_expertVisual.Runs.Count < 2)" OnClick="@(_ => RemoveTextRun())">Remove Run</ButtonControl>
        </div>
        @if (_runIndex >= 0 && _runIndex < _expertVisual.Runs.Count)
        {
            var run = _expertVisual.Runs[_runIndex];
            <Fx.ControlKit.TextAreaControl @bind-Value="run.Text" Rows="4" />
            <label>Field <TextBoxControl @bind-Value="run.Binding" /></label>
            <div class="fx-rd-run-tools">
                <DropDownListControl TValue="string" TItem="string" DataSource="@FontFamilies" @bind-Value="run.FontFamily" Width="180px" />
                <NumericTextBoxControl TValue="decimal" @bind-Value="run.FontSize" Min="1" Max="300" Width="80px" />
                <CheckBoxControl @bind-Checked="run.Bold" Label="Bold" /><CheckBoxControl @bind-Checked="run.Italic" Label="Italic" /><CheckBoxControl @bind-Checked="run.Underline" Label="Underline" />
                <ColorPickerControl @bind-Value="run.Color" />
            </div>
        }
        @if (_selectedElement is not null)
        {
            var preview = CloneElementForClipboard(_selectedElement);
            preview.Visual = _expertVisual;
            <div class="fx-rd-rich-preview" style="@ReportObjectRenderer.Style(preview, false)">@((MarkupString)ReportObjectRenderer.Content(preview, design: true))</div>
        }
    </div>;

    private void AddTextRun()
    {
        var run = _expertVisual.Runs.ElementAtOrDefault(_runIndex)?.Clone() ?? new ReportTextRun();
        run.Text = ""; run.Binding = "";
        _expertVisual.Runs.Insert(Math.Min(_runIndex + 1, _expertVisual.Runs.Count), run);
        _runIndex = _expertVisual.Runs.IndexOf(run);
    }

    private void RemoveTextRun()
    {
        if (_expertVisual.Runs.Count < 2 || _runIndex < 0 || _runIndex >= _expertVisual.Runs.Count) return;
        _expertVisual.Runs.RemoveAt(_runIndex); _runIndex = Math.Min(_runIndex, _expertVisual.Runs.Count - 1);
    }

