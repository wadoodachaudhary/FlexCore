    private Task CheckExpertFormula()
    {
        if (ActiveExpertFormula is null) return Task.CompletedTask;
        try
        {
            _ = CrystalFormula.Compile(ActiveExpertFormula.Expression, ActiveExpertFormula.Syntax);
            _formulaCheckMessage = "Native Crystal formula syntax check passed. Field values are checked when the report runs.";
        }
        catch (Exception ex) when (ex is InvalidDataException or NotSupportedException)
        { _formulaCheckMessage = ex.Message; }
