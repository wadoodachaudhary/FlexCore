                    <ButtonControl Disabled="@(ActiveExpertLink is null)" OnClick="@(_ => DeleteActiveExpertLink())">Delete</ButtonControl>
                    <ButtonControl OnClick="@(_ => AutoLinkExpertTables())" Disabled="@(ExpertTableNames.Count < 2)">Auto Link</ButtonControl>
                </div>
            </div>
        </div>
        <div class="fx-rd-sql-panel">
            <div class="fx-rd-sql-toolbar">
                <ButtonControl OnClick="@(_ => RegenerateExpertSql())">Generate SQL</ButtonControl>
                <ButtonControl OnClick="@(_ => ValidateExpertSqlAsync())" Disabled="@(string.IsNullOrWhiteSpace(_expertSql))">Validate SQL</ButtonControl>
                @if (!string.IsNullOrWhiteSpace(_expertSqlValidationMessage))
                {
                    <span class="@($"fx-rd-sql-status {(_expertSqlValidationSucceeded == true ? "ok" : _expertSqlValidationSucceeded == false ? "error" : "")}")">@_expertSqlValidationMessage</span>
                }
            </div>
            <Fx.ControlKit.TextAreaControl CssClass="fx-rd-sql-editor" @bind-Value="_expertSql" UpdateOnInput="true" @bind-Value:after="OnExpertSqlEdited" Rows="12" />
        </div>
    </div>;

