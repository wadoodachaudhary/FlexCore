    private async Task UndoAsync()
    {
        if (_undoStack.Count <= 1)
            return;

        var current = _undoStack[^1];
        _redoStack.Add(current);
        _undoStack.RemoveAt(_undoStack.Count - 1);
        await RestoreHistoryXmlAsync(_undoStack[^1], "Undo");
    }

    private async Task RedoAsync()
    {
        if (_redoStack.Count == 0)
            return;

        var xml = _redoStack[^1];
        _redoStack.RemoveAt(_redoStack.Count - 1);
        _undoStack.Add(xml);
        await RestoreHistoryXmlAsync(xml, "Redo");
    }

    private async Task RestoreHistoryXmlAsync(string xml, string status)
    {
        _restoringHistory = true;
        try
        {
            SetDocument(ReportDesignerXmlSerializer.FromXml(xml, _document.SourceName, _document.SourcePath), resetHistory: false);
            _document.IsDirty = ExportXml() != _savedXml;
            _status = status;
            if (DocumentChanged.HasDelegate)
                await DocumentChanged.InvokeAsync(_document);
        }
        finally
        {
            _restoringHistory = false;
        }
    }

