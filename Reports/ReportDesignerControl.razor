    private async Task OnFontSizeChanged(decimal value)
    {
        if (value <= 0)
            return;
        await FormatSelectionAsync(element => { element.FontSize = value; foreach (var run in element.Visual.Runs) run.FontSize = value; });
    }

    private async Task AdjustSelectedFontSizeAsync(decimal delta)
    {
        await FormatSelectionAsync(element =>
        {
            element.FontSize = Math.Clamp((element.FontSize <= 0 ? 10m : element.FontSize) + delta, 4m, 144m);
            foreach (var run in element.Visual.Runs) run.FontSize = Math.Clamp(run.FontSize + delta, 4m, 144m);
        });
    }

    private string FormatButtonCss(string command)
    {
        var active = command switch
        {
            "bold" => _selectedElement?.Bold == true,
            "italic" => _selectedElement?.Italic == true,
            "underline" => _selectedElement?.Underline == true,
            _ => false
        };

        return $"fx-rd-icon-btn icon-format-{command}{(active ? " active" : "")}";
    }

    private async Task ToggleSelectedElementBool(string propertyName)
    {
        if (_selectedElement is null) return;
        var value = propertyName switch
        {
            nameof(ReportDesignerElement.Bold) => !_selectedElement.Bold,
            nameof(ReportDesignerElement.Italic) => !_selectedElement.Italic,
            nameof(ReportDesignerElement.Underline) => !_selectedElement.Underline,
            nameof(ReportDesignerElement.IsSuppressed) => !_selectedElement.IsSuppressed,
            nameof(ReportDesignerElement.LockFormat) => !_selectedElement.LockFormat,
            nameof(ReportDesignerElement.LockSizePosition) => !_selectedElement.LockSizePosition,
            _ => false
        };
        await FormatSelectionAsync(element =>
        {
        switch (propertyName)
        {
            case nameof(ReportDesignerElement.Bold):
                element.Bold = value;
                foreach (var run in element.Visual.Runs) run.Bold = value;
                break;
            case nameof(ReportDesignerElement.Italic):
                element.Italic = value;
                foreach (var run in element.Visual.Runs) run.Italic = value;
                break;
            case nameof(ReportDesignerElement.Underline):
                element.Underline = value;
                foreach (var run in element.Visual.Runs) run.Underline = value;
                break;
            case nameof(ReportDesignerElement.IsSuppressed):
                element.IsSuppressed = value;
                break;
            case nameof(ReportDesignerElement.LockFormat):
                element.LockFormat = value;
                break;
            case nameof(ReportDesignerElement.LockSizePosition):
                element.LockSizePosition = value;
                break;
        }
        }, propertyName is nameof(ReportDesignerElement.LockFormat) or nameof(ReportDesignerElement.LockSizePosition));
    }

