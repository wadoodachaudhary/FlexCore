    private async Task OpenFileAsync(InputFileChangeEventArgs args)
    {
        if (!await CanReplaceDocumentAsync())
            return;
        var approvedXml = ExportXml();
        var approvedId = _documentId;
        var file = args.File;
        if (file.Name.EndsWith(".rpt", StringComparison.OrdinalIgnoreCase))
        {
            await OpenRptFileAsync(file, approvedXml, approvedId);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxXmlBytes);
            using var reader = new StreamReader(stream);
            var xml = await reader.ReadToEndAsync();
            await LoadXmlAsync(xml, file.Name,
                confirmReplacement: approvedId != _documentId || approvedXml != ExportXml());
        }
        catch (Exception error)
        {
            _status = "Could not open XML: " + error.Message;
        }
    }

    private async Task OpenRptFileAsync(IBrowserFile file, string approvedXml, Guid approvedId)
    {
        if (OperatingSystem.IsBrowser())
        {
            _status = "Crystal RPT conversion requires server-side .NET.";
            return;
        }

        var tempDirectory = Path.Combine(Path.GetTempPath(), $"fx-rpt-{Guid.NewGuid():N}");
        Directory.CreateDirectory(tempDirectory);
        _ownedWorkspaces.Add(tempDirectory);
        try
        {
            var tempRptPath = Path.Combine(tempDirectory, Path.GetFileName(file.Name));
            await using (var source = file.OpenReadStream(MaxRptBytes))
            await using (var target = File.Create(tempRptPath))
            {
                await source.CopyToAsync(target);
            }

            var xmlPath = await ConvertRptPathAsync(tempRptPath);
            if (string.IsNullOrWhiteSpace(xmlPath))
                return;

            var xml = await File.ReadAllTextAsync(xmlPath);
            await LoadXmlAsync(xml, Path.ChangeExtension(file.Name, ".xml"), xmlPath,
                confirmReplacement: approvedId != _documentId || approvedXml != ExportXml());
        }
        catch (Exception error)
        {
            _status = "Could not open RPT: " + error.Message;
        }
    }

    private async Task<string?> ConvertRptPathAsync(string rptPath, string? outputPath = null)
    {
        if (OperatingSystem.IsBrowser())
        {
            _status = "Crystal RPT conversion requires server-side .NET.";
            return null;
        }

        try
        {
            outputPath ??= GetDefaultXmlOutputPath(rptPath);
            var result = await CrystalRptToXml.ConvertAsync(
                rptPath,
                outputPath,
                new CrystalRptConversionOptions(ExtractSubreports: true));

            _status = $"Converted {Path.GetFileName(rptPath)}.";
            return result.ReportXmlPath;
        }
        catch (Exception ex)
        {
            _status = $"Could not convert RPT: {ex.Message}";
            return null;
        }
    }

    private static string GetDefaultXmlOutputPath(string rptPath)
    {
        var dir = Path.GetDirectoryName(rptPath) ?? "";
        var baseName = Path.GetFileNameWithoutExtension(rptPath);
        if (!string.IsNullOrEmpty(dir) &&
            Path.GetFileName(dir).Equals("rpt", StringComparison.OrdinalIgnoreCase))
        {
            return Path.Combine(Path.GetDirectoryName(dir) ?? "", "xml", baseName + ".xml");
        }

        return Path.Combine(dir, baseName + ".xml");
    }

    private void SetDocument(ReportDesignerDocument document, bool resetHistory = true)
    {
        _document = document;
        _activeExpert = null;
        _expertTextFormat = null;
        if (resetHistory)
            _insertionFieldReference = null;
        _selectedSection = _document.Sections.FirstOrDefault();
        _selectedElement = null;
        _status = _document.StatusMessage;
        _selectedElementIds.Clear();
        _activeDocumentTab = DesignDocumentTab;
        RebuildExplorerNodes();
        if (resetHistory)
        {
            _documentId = Guid.NewGuid();
            _savedXml = document.IsDirty ? null : ExportXml();
            _savedPath = !string.IsNullOrWhiteSpace(document.SourcePath) && File.Exists(document.SourcePath) &&
                !_ownedWorkspaces.Any(folder => Path.GetFullPath(document.SourcePath).StartsWith(folder + Path.DirectorySeparatorChar, StringComparison.Ordinal))
                ? document.SourcePath : null;
            _savedHash = _savedPath is null ? null : ReportDesignerFileStore.Fingerprint(File.ReadAllText(_savedPath));
            ResetHistory();
        }
    }

