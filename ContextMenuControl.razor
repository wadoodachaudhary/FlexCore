@namespace Fx.ControlKit
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (Visible)
{
    <div class="fx-context-menu-backdrop"
         style="z-index:@(ZIndex - 1);"
         @onclick="CloseAsync"
         @oncontextmenu="CloseAsync"
         @oncontextmenu:preventDefault="true"></div>
    <CascadingValue Value="this" IsFixed="true">
        <div class="@RootCssClass"
             style="@PositionStyle"
             @ref="_menuElement"
             role="menu"
             tabindex="-1"
             @onkeydown="HandleMenuKeyDownAsync"
             @onkeydown:preventDefault="_menuKeyHandled"
             @onclick:stopPropagation="true"
             @oncontextmenu:stopPropagation="true">
            @ChildContent
        </div>
    </CascadingValue>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public int ZIndex { get; set; } = 10000;
    [Parameter] public int MinWidth { get; set; } = 160;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _menuElement;
    private IJSObjectReference? _contextMenuJsModule;
    private bool _menuOpened;
    private bool _menuKeyHandled = true;   // seeded: swallow the first arrow too

    private string RootCssClass =>
        string.IsNullOrWhiteSpace(CssClass)
            ? "fx-context-menu"
            : $"fx-context-menu {CssClass.Trim()}";

    private string PositionStyle =>
        $"left:{X}px;top:{Y}px;min-width:{MinWidth}px;z-index:{ZIndex};{Style}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible)
            return;

        var module = await GetContextMenuJsModuleAsync();
        if (module == null)
            return;

        await module.InvokeVoidAsync("positionContextMenu", _menuElement, X, Y, MinWidth, ZIndex);

        // Open with the first item highlighted, as the Win32 popup menu did.
        if (!_menuOpened)
        {
            _menuOpened = true;
            await FocusMenuItemAsync("first");
        }
    }

    // Enter and Space are left to the focused <button>'s own activation; this
    // owns only the arrows, Home/End and Escape.
    private async Task HandleMenuKeyDownAsync(KeyboardEventArgs e)
    {
        string mode;
        switch (e.Key)
        {
            case "ArrowDown": mode = "next"; break;
            case "ArrowUp": mode = "prev"; break;
            case "Home": mode = "first"; break;
            case "End": mode = "last"; break;
            case "Escape":
                _menuKeyHandled = true;
                await CloseAsync();
                return;
            default:
                _menuKeyHandled = false;
                return;
        }

        _menuKeyHandled = true;
        await FocusMenuItemAsync(mode);
    }

    private async Task FocusMenuItemAsync(string mode)
    {
        try
        {
            var module = await GetContextMenuJsModuleAsync();
            if (module != null)
                await module.InvokeVoidAsync("focusMenuItem", _menuElement, mode);
        }
        catch
        {
            // Mouse and Tab still work without it.
        }
    }

    public async Task CloseAsync()
    {
        _menuOpened = false;

        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false);

        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    internal Task RequestCloseAsync() => CloseAsync();

    private async ValueTask<IJSObjectReference?> GetContextMenuJsModuleAsync()
    {
        try
        {
            return _contextMenuJsModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", $"./_content/{typeof(ContextMenuControl).Assembly.GetName().Name}/context-menu-control.js");
        }
        catch
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_contextMenuJsModule != null)
        {
            try { await _contextMenuJsModule.DisposeAsync(); }
            catch { }
            _contextMenuJsModule = null;
        }
    }
}
