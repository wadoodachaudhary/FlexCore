@namespace Fx.ControlKit.Grid
@typeparam TItem
@typeparam TValue

<div class="fx-dropdown-grid @CssClass @(Disabled ? "fx-disabled" : "") @(_isOpen ? "fx-open" : "")" style="@ComputedContainerStyle" @ref="_containerRef" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true">
    <div class="fx-dropdown-grid-input-wrap"
         @onmousedown="HandleInputWrapMouseDown"
         @onmousedown:stopPropagation="true"
         @onclick="ToggleDropdown"
         @onclick:stopPropagation="true">
        <input type="text"
               class="fx-dropdown-grid-input"
               value="@DisplayText"
               placeholder="@Placeholder"
               readonly
               disabled="@Disabled"
               tabindex="@(Disabled ? -1 : 0)"
               @onmousedown="HandleInputWrapMouseDown"
               @onmousedown:stopPropagation="true"
               @onclick="ToggleDropdown"
               @onclick:stopPropagation="true"
               @ref="_inputRef" />

        @if (AllowClear && HasValue && !Disabled && !ReadOnly)
        {
            <button type="button" class="fx-dropdown-grid-clear-btn" @onclick:stopPropagation="true" @onclick="ClearValue" title="Clear">✕</button>
        }
        <span class="fx-dropdown-grid-arrow" aria-hidden="true" @onclick="ToggleDropdown" @onclick:stopPropagation="true">▼</span>
    </div>

    @if (_isOpen)
    {
        @* Fixed backdrop (same scheme as DropDownListControl): outside clicks
           close the popup instead of leaking into the page underneath. *@
        <button type="button" class="fx-dropdown-grid-backdrop" tabindex="-1" aria-hidden="true" @onclick="ClosePopupAsync"></button>
        <div class="fx-dropdown-grid-popup shadow @(ShowColumnHeaders ? "" : "fx-dropdown-grid-headerless")"
             style="@ComputedPopupStyle"
             @ref="_popupRef"
             @onclick:stopPropagation="true">
            @if (ShowSearch)
            {
                <div class="fx-dropdown-grid-search-bar p-1 border-bottom bg-light">
                    <input type="text"
                           class="fx-dropdown-grid-search-input"
                           placeholder="@(SearchPlaceholder ?? "Search...")"
                           value="@_searchText"
                           @oninput="OnSearchInput"
                           autofocus />
                </div>
            }
            <div class="fx-dropdown-grid-body" style="@($"height: {PopupHeight}; max-height: {PopupHeight}; overflow: hidden;")">
                <GridControl @ref="_gridRef"
                             TValue="TItem"
                             DataSource="@FilteredDataSource"
                             Height="100%"
                             RowHeight="@RowHeight"
                             AllowPaging="@AllowPaging"
                             PageSize="@PageSize"
                             AllowSorting="true"
                             AllowSelection="true"
                             Density="GridDensity.Compact"
                             ShowRowCountInFooter="false"
                             ShowSearchBar="false"
                             SearchText="@_searchText"
                             EventsRef="@_gridEvents">
                    <GridColumnsBase>
                        @if (Columns != null)
                        {
                            @Columns
                        }
                    </GridColumnsBase>
                </GridControl>
            </div>
        </div>
    }
</div>
