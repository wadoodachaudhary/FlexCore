@namespace Fx.ControlKit.Grid
@inherits FlexControlBase
@typeparam TValue
@using Fx.ControlKit
@using System.Reflection
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

@{ BeginGridRenderPass(); }

<div class="@($"{GridHostCssClass} {PresentationCssClass}")"
     style="@($"{HostStyle}{StackedLayoutStyle}")"
     data-fx-row-reveal-index="@(_pendingRowRevealIndex?.ToString(CultureInfo.InvariantCulture))"
     data-fx-row-reveal-token="@(_pendingRowRevealIndex.HasValue ? _pendingRowRevealToken.ToString(CultureInfo.InvariantCulture) : null)"
     data-fx-grid-tab-navigation="@(TabNavigationMode == GridTabNavigationMode.PageControl ? "page-control" : "wrap-rows")"
     data-fx-client-buffered-editing="@(UsesClientBufferedTextEditing ? "true" : "false")"
     data-fx-row-highlight="@(HighlightSelectedRows ? "true" : "false")"
     data-fx-custom-keyboard-shortcuts="@CustomKeyboardShortcutDomValue"
     data-fx-column-virtualization="@ColumnVirtualizationDomState"
     data-fx-column-virtualization-fallback="@ColumnVirtualizationFallbackReason"
     @ref="_gridHostElement"
     @onkeydown="HandleKeyDown"
     @onfocusout="@NonRenderingGridFocusOut"
     @oncontextmenu="HandleGridContextMenu"
     @oncontextmenu:preventDefault="@GridContextMenuPreventDefault"
     @oncontextmenu:stopPropagation="@StopContextMenuPropagation"
     @onmousedown="HandleGridHostMouseDown"
     @onmouseup="@NonRenderingGridMouseUp">

    @if (!string.IsNullOrWhiteSpace(_exportStatusMessage))
    {
        <div class="fx-grid-export-status-pill" role="status" aria-live="polite">
            @_exportStatusMessage
        </div>
    }


    @if (!string.IsNullOrWhiteSpace(_validationStatusMessage))
    {
        <div class="fx-grid-validation-status-pill" role="alert" aria-live="assertive">
            @_validationStatusMessage
        </div>
    }

    @if (EnableColumnVirtualization
        && ShowColumnVirtualizationFallback
        && ColumnVirtualizationStatus == GridColumnVirtualizationStatus.Fallback)
    {
        <div class="fx-grid-column-virtualization-fallback"
             role="status"
             title="@ColumnVirtualizationFallbackReason">
            Columns: full render (@ColumnVirtualizationFallbackReason)
        </div>
    }

    @* ── Toolbar ──────────────────────────────────────────────── *@
    @* Built-in grid toolbar. Honors custom Toolbar items / ShowSearchBar. *@
    @if (ShouldRenderToolbar)
    {
        <div class="fx-grid-toolbar">
            @if (Toolbar is { Count: > 0 })
            {
                @foreach (var item in Toolbar)
                {
                    <button class="fx-toolbar-btn" @onclick="() => OnToolbarClick(item)">@item</button>
                }
            }
            @if (ShowSearchBar)
            {
                <div class="fx-toolbar-search">
                    <svg class="fx-toolbar-search-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398l3.85 3.85a1 1 0 0 0 1.415-1.415l-3.85-3.85a1 1 0 0 0-.018-.017zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                    </svg>
                    @* Uncontrolled while typing: keystrokes land in _pendingSearchText
                       through a non-rendering callback (a bound oninput re-rendered the
                       whole grid AND recomputed the search filter on every keystroke);
                       the debounce commits once per pause. Value renders from the pending
                       text so unrelated renders never repaint stale input. *@
                    <input type="text" placeholder="Search..."
                           value="@(_pendingSearchText ?? SearchText)"
                           @oninput="NonRenderingSearchInput" />
                </div>
            }
            @if (GridToolBarTemplate != null)
            {
                @GridToolBarTemplate
            }
        </div>
    }

    @* ── Group Drop Area (drag-and-drop grouping) ────────────── *@
    @if (AllowGrouping)
    {
        <div class="fx-group-drop-area @(_dragOverGroupArea ? "fx-group-drop-hover" : "")"
             @ondragover="HandleGroupAreaDragOver"
             @ondragover:preventDefault="true"
             @ondragleave="HandleGroupAreaDragLeave"
             @ondrop="HandleGroupAreaDrop"
             @oncontextmenu:preventDefault="true"
             @oncontextmenu:stopPropagation="true">
            <div class="fx-group-drop-main">
                @if (ShouldRenderAdvancedViewToggle)
                {
                    <button class="fx-group-advanced-toggle-btn @(AdvancedViewEnabled ? "active" : "")"
                            type="button"
                            title="@AdvancedViewToggleTitle"
                            aria-label="@AdvancedViewToggleTitle"
                            aria-pressed="@AdvancedViewTogglePressed"
                            @onclick="ToggleAdvancedView"
                            @onclick:stopPropagation="true">
                        &#9881;
                    </button>
                }
                @if (HasAnyActiveFilter)
                {
                    @* HHM-871 follow-up: one-click clear of every active column /
                       expression filter — first icon of the group bar, rendered
                       only while a filter is applied. *@
                    <button class="fx-group-expand-collapse-btn fx-clear-all-filters-btn"
                            type="button"
                            title="Clear all filters"
                            aria-label="Clear all filters"
                            @onclick="ClearFilteringAsync"
                            @onclick:stopPropagation="true">✕</button>
                }
                @if (_groupDescriptors.Count == 0)
                {
                    <span class="fx-group-drop-hint">Drag a column header here to group by that column</span>
                }
                else
                {
                    @if (ShowGroupExpandCollapse)
                    {
                        <button class="fx-group-expand-collapse-btn" @onclick="ToggleExpandCollapseAll" @onclick:stopPropagation="true"
                                title="@(_allGroupsCollapsed ? "Expand All Groups" : "Collapse All Groups")">
                            @(_allGroupsCollapsed ? "⊞" : "⊟")
                        </button>
                        <button class="fx-group-clear-all-btn"
                                type="button"
                                title="Clear All Grouping"
                                aria-label="Clear all grouping"
                                @onclick="ClearAllGroupsAsync"
                                @onclick:stopPropagation="true">
                            🗑
                        </button>
                    }
                    @foreach (var gd in _groupDescriptors)
                    {
                        @* Capture per-iteration field locally — without this the @onclick /
                           @oncontextmenu lambdas would all close over the same `gd` and
                           fire with the LAST descriptor's field after the loop. *@
                        var capturedField = gd.Field;
                        <span class="fx-group-chip" draggable="true"
                              @ondragstart="() => StartGroupChipDrag(capturedField)"
             @oncontextmenu="@(e => OpenHeaderContextMenu(e, capturedField))"
             @oncontextmenu:preventDefault="true"
             @oncontextmenu:stopPropagation="@EnableHeaderContextMenu"
             title="Right-click for options">
                            <span class="fx-group-chip-text">@gd.HeaderText</span>
                            <span class="fx-group-chip-remove"
                                  role="button"
                                  tabindex="0"
                                  title="@($"Ungroup by {gd.HeaderText}")"
                                  aria-label="@($"Ungroup by {gd.HeaderText}")"
                                  @onclick="() => RemoveGroup(capturedField)"
                                  @onclick:stopPropagation="true"
                                  @oncontextmenu="@(e => OpenHeaderContextMenu(e, capturedField))"
                                  @oncontextmenu:preventDefault="true"
                                  @oncontextmenu:stopPropagation="@EnableHeaderContextMenu">×</span>
                        </span>
                    }
                }
            </div>
            @if (ShouldRenderExpressionFilterButton)
            {
                <div class="fx-expression-filter-area" @onclick:stopPropagation="true">
                    <button class="fx-expression-filter-btn @((_expressionFilterOpen || HasExpressionFilter) ? "active" : "")"
                            type="button"
                            title="@ExpressionFilterToggleTitle"
                            aria-label="@ExpressionFilterToggleTitle"
                            aria-expanded="@ExpressionFilterToggleExpanded"
                            @onclick="ToggleExpressionFilter">
                        @if (_expressionFilterOpen)
                        {
                            <span aria-hidden="true">×</span>
                        }
                        else
                        {
                            <span aria-hidden="true">&#128269;</span>
                        }
                    </button>
                    @if (_expressionFilterOpen)
                    {
                        <div class="fx-expression-filter-editor">
                            <input class="fx-expression-filter-input"
                                   placeholder="OrderQty > 100 and Price Level like Community"
                                   value="@ExpressionFilterDraft"
                                   @oninput="OnExpressionFilterInput"
                                   @onkeydown="HandleExpressionFilterKeyDown" />
                            <button class="fx-expression-filter-apply"
                                    type="button"
                                    title="Apply filter expression"
                                    @onclick="ApplyExpressionFilterAsync">Apply</button>
                            <button class="fx-expression-filter-clear"
                                    type="button"
                                    title="Clear filter expression"
                                    aria-label="Clear filter expression"
                                    @onclick="ClearExpressionFilterAsync">Clear</button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_expressionFilterError))
                    {
                        <span class="fx-expression-filter-error" title="@_expressionFilterError">@_expressionFilterError</span>
                    }
                </div>
            }
        </div>
    }

    @* ── Selection Info Bar ─────────────────────────────────── *@
    @if (AllowSelection && ShowSelectionInfoBar && (_selectedItems.Count > 1 || _selectedCells.Count > 0))
    {
        <div class="fx-selection-info-bar">
            @if (_selectedItems.Count > 1)
            {
                <span>@_selectedItems.Count rows selected</span>
                @if (_typeAheadBuffer.Length > 0)
                {
                    <span class="fx-typeahead-display">typing: @_typeAheadBuffer</span>
                }
            }
            @if (_selectedCells.Count > 0)
            {
                <span>@_selectedCells.Count cells selected</span>
            }
            <button class="fx-selection-clear-btn" @onclick="ClearSelectionAsync">Clear Selection</button>
        </div>
    }

    @* ── Collect column definitions ───────────────────────────── *@
    <CascadingValue Value="@((IGridOwner)this)" IsFixed="true">
        <div style="display:none">
            @ChildContent
        </div>
    </CascadingValue>

    @* ── Grid Options Rail / Side Panels ───────────────────────── *@
    @if (ShouldRenderGridOptionsRail)
    {
        <div class="fx-grid-options-rail" @onclick:stopPropagation="true">
            <div class="fx-grid-options-rail-top">
                @if (ShowGridBackButton)
                {
                    <button type="button"
                            class="fx-grid-option-btn"
                            title="Back to grid"
                            aria-label="Back to grid"
                            @onclick="ReturnToGridView">
                        ↩
                    </button>
                }
                @if (ShowColumnOptionsButton)
                {
                    <button type="button"
                            class="fx-grid-option-btn @(_activeOptionsPanel == GridOptionsPanel.Columns ? "active" : "")"
                            title="Column options"
                            aria-label="Column options"
                            @onclick="() => ToggleOptionsPanel(GridOptionsPanel.Columns)">
                        ▤
                    </button>
                }
                @if (AllowPivoting && ShowPivotPanelButton)
                {
                    <button type="button"
                            class="fx-grid-option-btn @(_activeOptionsPanel == GridOptionsPanel.Pivot || _pivotMode ? "active" : "")"
                            title="Pivot mode"
                            aria-label="Pivot mode"
                            @onclick="() => ToggleOptionsPanel(GridOptionsPanel.Pivot)">
                        ▦
                    </button>
                }
            </div>
            @if (ShowGridThemeToggle)
            {
                <button type="button"
                        class="fx-grid-option-btn fx-grid-theme-btn @(_activeOptionsPanel == GridOptionsPanel.Theme ? "active" : "")"
                        title="Theme"
                        aria-label="Theme"
                        @onclick="ToggleGridDarkMode">
                    Theme
                </button>
            }
        </div>
    }

    @if (ShouldRenderGridOptionsRail && _activeOptionsPanel != GridOptionsPanel.None)
    {
        <aside class="fx-grid-side-panel" @onclick:stopPropagation="true">
            <div class="fx-grid-side-panel-header">
                <span>@ActiveOptionsPanelTitle</span>
                <button type="button"
                        class="fx-grid-side-panel-close"
                        title="Close"
                        aria-label="Close"
                        @onclick="CloseOptionsPanel">×</button>
            </div>

            @if (_activeOptionsPanel == GridOptionsPanel.Columns)
            {
                <div class="fx-grid-side-panel-body">
                    <input class="fx-grid-side-search"
                           placeholder="Search columns..."
                           value="@_columnPanelSearch"
                           @oninput="e => _columnPanelSearch = e.Value?.ToString() ?? string.Empty" />
                    <div class="fx-grid-column-option-list">
                        @foreach (var col in ColumnPanelColumns)
                        {
                            var capturedCol = col;
                            var canToggle = !IsColumnVisible(col) || CanHideColumn(col);
                            <label class="fx-grid-check-row">
                                <input type="checkbox"
                                       checked="@IsColumnVisible(col)"
                                       disabled="@(!canToggle)"
                                       @onchange="async e => await SetColumnPanelVisibleAsync(capturedCol, e.Value is bool b && b)" />
                                <span>@HeaderColumnDisplay(col)</span>
                            </label>
                        }
                    </div>
                    <button type="button"
                            class="fx-grid-panel-action"
                            @onclick="HeaderMenuOpenChooseColumns">
                        Advanced columns...
                    </button>
                </div>
            }
            else if (_activeOptionsPanel == GridOptionsPanel.Pivot)
            {
                <div class="fx-grid-side-panel-body fx-grid-pivot-panel-body">
                    <label class="fx-grid-pivot-toggle">
                        <input type="checkbox"
                               checked="@_pivotMode"
                               @onchange="e => SetPivotMode(e.Value is bool b && b)" />
                        <span>Pivot Mode</span>
                    </label>

                    <input class="fx-grid-side-search"
                           placeholder="Search fields..."
                           value="@_pivotFieldSearch"
                           @oninput="e => _pivotFieldSearch = e.Value?.ToString() ?? string.Empty" />

                    <div class="fx-grid-pivot-field-list">
                        @foreach (var col in PivotPanelColumns)
                        {
                            var field = col.Field;
                            <div class="fx-grid-pivot-field-row">
                                <span class="fx-grid-pivot-field-name">@HeaderColumnDisplay(col)</span>
                                <div class="fx-grid-pivot-field-actions">
                                    <button type="button"
                                            title="Add to row groups"
                                            disabled="@IsPivotFieldInArea(field, PivotFieldArea.Row)"
                                            @onclick="() => AddPivotField(field, PivotFieldArea.Row)">R</button>
                                    <button type="button"
                                            title="Add to column labels"
                                            disabled="@IsPivotFieldInArea(field, PivotFieldArea.Column)"
                                            @onclick="() => AddPivotField(field, PivotFieldArea.Column)">C</button>
                                    <button type="button"
                                            title="Add to values"
                                            disabled="@IsPivotFieldInArea(field, PivotFieldArea.Value)"
                                            @onclick="() => AddPivotField(field, PivotFieldArea.Value)">Σ</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="fx-grid-pivot-zones">
                        <section class="fx-grid-pivot-zone">
                            <div class="fx-grid-pivot-zone-title">Row Groups</div>
                            @foreach (var field in _pivotRowFields)
                            {
                                <span class="fx-grid-pivot-chip">
                                    @GetPivotFieldLabel(field)
                                    <button type="button" @onclick="() => RemovePivotField(field, PivotFieldArea.Row)">×</button>
                                </span>
                            }
                            @if (_pivotRowFields.Count == 0)
                            {
                                <div class="fx-grid-panel-empty">No row groups</div>
                            }
                        </section>

                        <section class="fx-grid-pivot-zone">
                            <div class="fx-grid-pivot-zone-title">Values</div>
                            @foreach (var valueField in _pivotValueFields)
                            {
                                <span class="fx-grid-pivot-chip fx-grid-pivot-value-chip">
                                    @valueField.DisplayLabel
                                    <DropDownListControl TValue="AggregateType" TItem="AggregateType"
                                                         DataSource="@PivotAggregateTypes"
                                                         Value="@valueField.Aggregation"
                                                         ValueChanged="aggregate => ChangePivotAggregation(valueField, aggregate)"
                                                         CssClass="fx-pivot-agg-select" />
                                    <input class="fx-grid-pivot-format-input"
                                           value="@valueField.Format"
                                           placeholder="Format"
                                           title=".NET format, e.g. N0, N2, C2. Blank uses plain numbers."
                                           @oninput="e => SetPivotValueFormat(valueField, e)" />
                                    <button type="button" @onclick="() => RemovePivotField(valueField.Field, PivotFieldArea.Value)">×</button>
                                </span>
                            }
                            @if (_pivotValueFields.Count == 0)
                            {
                                <div class="fx-grid-panel-empty">No values</div>
                            }
                        </section>

                        <section class="fx-grid-pivot-zone">
                            <div class="fx-grid-pivot-zone-title">Column Labels</div>
                            @foreach (var field in _pivotColumnFields)
                            {
                                <span class="fx-grid-pivot-chip">
                                    @GetPivotFieldLabel(field)
                                    <button type="button" @onclick="() => RemovePivotField(field, PivotFieldArea.Column)">×</button>
                                </span>
                            }
                            @if (_pivotColumnFields.Count == 0)
                            {
                                <div class="fx-grid-panel-empty">No column labels</div>
                            }
                        </section>
                    </div>
                </div>
            }
            else if (_activeOptionsPanel == GridOptionsPanel.Theme)
            {
                <div class="fx-grid-side-panel-body fx-grid-theme-panel-body">
                    <div class="fx-grid-theme-current">
                        Current theme:
                        <strong>@(GetThemeGalleryItem(_activeGridTheme)?.Name ?? _activeGridTheme.ToString())</strong>
                    </div>
                    @foreach (var group in ThemeGalleryGroups)
                    {
                        <section class="fx-grid-theme-section">
                            <div class="fx-grid-theme-section-title">@group.Key</div>
                            <div class="fx-grid-theme-gallery">
                                @foreach (var item in group)
                                {
                                    <button type="button"
                                            class="fx-grid-theme-tile @(item.Theme == _activeGridTheme ? "selected" : "")"
                                            style="@ThemePreviewStyle(item)"
                                            title="@item.Name"
                                            aria-label="@($"Select {item.Name} theme")"
                                            @onclick="() => SelectGridTheme(item.Theme)">
                                        <span class="fx-grid-theme-preview">
                                            <span></span><span></span><span></span><span></span>
                                        </span>
                                        <span class="fx-grid-theme-name">@item.Name</span>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        </aside>
    }

    @* ── Chart View ──────────────────────────────────────────── *@
    @if (_pivotMode)
    {
        <div class="fx-grid-content fx-grid-pivot-shell"
             style="@(string.IsNullOrEmpty(Height) ? "" : "overflow:auto; flex:1;")">
            <PivotControl TValue="TValue"
                          @ref="_pivotControlRef"
                          DataSource="@PivotData"
                          RowFields="@_pivotRowFields"
                          ColumnFields="@_pivotColumnFields"
                          ValueFields="@_pivotValueFields"
                          FieldLabels="@PivotFieldLabels"
                          Height="@ResolvedPivotHeight"
                          Width="@Width"
                          ShowGrandTotals="true"
                          ShowSubTotals="true"
                          AllowSorting="@AllowSorting"
                          CssClass="fx-grid-embedded-pivot" />
        </div>
    }
    else if (ShowAsChart && ChartValueFields is { Count: > 0 })
    {
        <div class="fx-grid-content fx-grid-chart-content"
             style="@(string.IsNullOrEmpty(Height) ? "" : "overflow:auto; flex:1;")">
            <Fx.ControlKit.Charts.ChartControl
                DataSource="@GetPassFlatRows()"
                ValueFields="@ChartValueFields"
                ValueLabels="@ChartValueLabels"
                LabelField="@(ChartLabelField ?? VisibleColumns.FirstOrDefault()?.Field)"
                BarColor="@ChartBarColor"
                ShowValues="@ChartShowValues"
                ShowAxisLabels="true" />
        </div>
    }
    else
    {

    @* ── Grid Table ───────────────────────────────────────────── *@
    @* @ref="_scrollElement" — the custom-windowing scroll reader (grid-control.js
       registerGridWindowScroll) attaches its throttled scroll listener here. This
       is the vertical scroll container (overflow:auto, bounded by Height) whenever
       UseRowWindowing is active (flat, non-paged, bounded-height, non-grouped). *@
    @if (IsPagingActive && ShowPagerAtTop)
    {
        <GridPagerControl Context="@BuildPagerContext()"
                          Template="@PagerTemplate"
                          ShowRowCount="@ShowRowCountInFooter" />
    }
    <div class="fx-grid-content"
         style="@GridContentStyle"
         data-fx-window-scroll-token="@(_windowScrollResponseToken == 0 ? null : _windowScrollResponseToken.ToString(CultureInfo.InvariantCulture))"
         data-fx-window-mode="@(UseGroupedRowWindowing ? "grouped" : UseRowWindowing ? "flat" : "none")"
         data-fx-performance-mode="@PerformanceMode"
         data-fx-configured-row-height="@_rowHeightPx.ToString(CultureInfo.InvariantCulture)"
         data-fx-scroll-boundary-guard="@((EnableScrollBoundaryGuard && !ScrollTrack).ToString().ToLowerInvariant())"
         data-fx-window-diagnostic-delay="@Math.Clamp(DiagnosticWindowScrollDelayMs, 0, 5_000)"
         data-fx-window-overscan="@Math.Max(0, WindowOverscanRows)"
         data-fx-deferred-window-overscan="@DeferredScrollReleaseOverscanRows"
         data-fx-deferred-scroll-token="@(_deferredScrollCommitToken == 0 ? null : _deferredScrollCommitToken.ToString(CultureInfo.InvariantCulture))"
        data-fx-deferred-scroll-top="@(_deferredScrollCommitToken == 0 ? null : _deferredScrollCommitTop.ToString(CultureInfo.InvariantCulture))"
         @ref="_scrollElement">
        <table class="fx-grid-table"
               id="@_accessibleGridDomId"
               style="@GetTableStyle()"
               role="grid"
               tabindex="@(HostTabIndex ?? 0)"
               @ref="_gridFocusElement"
               @onfocus="HandleHostFocusSeed"
               aria-label="@AccessibleLabel"
               aria-activedescendant="@GridActiveDescendantId"
               aria-rowcount="@GridAriaRowCount"
               aria-colcount="@GridAriaColumnCount">
            @{
                var columnVirtualizationLayout = GetColumnVirtualizationRenderLayout();
                var columnHeaderBandRuns = ShowHeader && HasColumnHeaderBandConfiguration()
                    ? GetColumnHeaderBandRuns()
                    : Array.Empty<ColumnHeaderBandRun>();
                var renderColumnHeaderBands = columnHeaderBandRuns.Any(run => run.Band != null);
            }
            @if (renderColumnHeaderBands || columnVirtualizationLayout.IsVirtualized)
            {
                @* A fixed-layout table derives widths from its colgroup before
                   considering the first (spanning) band row. Without this, a
                   two-column band could redistribute a 60px + 180px pair into
                   two 120px columns and misalign the body. *@
                <colgroup>
                    @if (ShowRowReorderColumn)
                    {
                        <col style="width:@($"{RowReorderColumnWidth}px")" />
                    }
                    @if (ShowRowSelectorHandleColumn)
                    {
                        <col style="width:@($"{ResolvedRowSelectorHandleWidth}px")" />
                    }
                    @if (ShowCheckboxColumn)
                    {
                        <col style="width:50px" />
                    }
                    @if (ShowDetailExpandColumn)
                    {
                        <col style="width:36px" />
                    }
                    @if (AllowGrouping && HideGroupedColumns && GroupedLayoutColumns.Count > 0)
                    {
                        @foreach (var groupedColumn in GroupedLayoutColumns)
                        {
                            <col style="width:@groupedColumn.GetEffectiveWidthCss()" />
                        }
                    }
                    @foreach (var columnSlot in columnVirtualizationLayout.Slots)
                    {
                        @if (columnSlot.IsSpacer)
                        {
                            <col class="fx-column-window-spacer-col" style="@ColumnVirtualizationSpacerStyle(columnSlot.WidthPx)" />
                        }
                        else
                        {
                            <col style="@(columnVirtualizationLayout.IsVirtualized
                                ? ColumnVirtualizationColumnWidthStyle(columnSlot.WidthPx)
                                : $"width:{columnSlot.Column!.GetEffectiveWidthCss()}")" />
                        }
                    }
                </colgroup>
            }

            @* Header *@
            @if (ShowHeader)
            {
                <thead class="fx-grid-header">
                    @if (renderColumnHeaderBands)
                    {
                        <tr class="fx-column-header-band-row" role="row" aria-rowindex="1">
                            @if (ShowRowReorderColumn)
                            {
                                <th class="fx-header-cell fx-column-header-band-spacer" aria-hidden="true" style="@RowReorderColumnStyle"></th>
                            }
                            @if (ShowRowSelectorHandleColumn)
                            {
                                <th class="fx-header-cell fx-column-header-band-spacer" aria-hidden="true" style="@RowSelectorHandleColumnStyle"></th>
                            }
                            @if (ShowCheckboxColumn)
                            {
                                <th class="fx-header-cell fx-column-header-band-spacer" aria-hidden="true" style="width:50px;"></th>
                            }
                            @if (ShowDetailExpandColumn)
                            {
                                <th class="fx-header-cell fx-column-header-band-spacer" aria-hidden="true" style="width:36px;min-width:36px;"></th>
                            }
                            @if (AllowGrouping && HideGroupedColumns && GroupedLayoutColumns.Count > 0)
                            {
                                @foreach (var groupedColumn in GroupedLayoutColumns)
                                {
                                    <th class="fx-header-cell fx-column-header-band-spacer" aria-hidden="true" style="@GetGroupedPlaceholderStyle(groupedColumn)"></th>
                                }
                            }
                            @foreach (var bandRun in columnHeaderBandRuns)
                            {
                                var band = bandRun.Band;
                                <th class="fx-header-cell fx-column-header-band-cell @(band == null ? "fx-column-header-band-empty" : band.CssClass)"
                                    colspan="@bandRun.Columns.Count"
                                    scope="colgroup"
                                    aria-hidden="@(band == null ? "true" : null)"
                                    style="@GetColumnHeaderBandStyle(bandRun)"
                                    title="@band?.HeaderText">
                                    @if (band?.HeaderTemplate != null)
                                    {
                                        @band.HeaderTemplate
                                    }
                                    else
                                    {
                                        @band?.HeaderText
                                    }
                                </th>
                            }
                        </tr>
                    }
                    <tr role="row" aria-rowindex="@(renderColumnHeaderBands ? 2 : 1)">
                        @if (ShowRowReorderColumn)
                        {
                            <th class="fx-header-cell fx-row-reorder-header-cell" style="@RowReorderColumnStyle"></th>
                        }
                        @if (ShowRowSelectorHandleColumn)
                        {
                            <th class="fx-header-cell fx-row-selector-header-cell" style="@RowSelectorHandleColumnStyle"></th>
                        }
                        @if (ShowCheckboxColumn)
                        {
                            <th class="fx-header-cell fx-checkbox-cell" style="width:50px;">
                                <CheckBoxControl Checked="@AllRowsSelected"
                                                 CheckedChanged="@SelectAllCheckedChanged"
                                                 TabIndex="-1"
                                                 StopClickPropagation="true"
                                                 StopMouseDownPropagation="true" />
                            </th>
                        }
                        @if (ShowDetailExpandColumn)
                        {
                            <th class="fx-header-cell fx-detail-expand-header-cell" style="width:36px; min-width:36px; text-align:center;">
                                @if (ShowExpandAll && ExpandMode == GridExpandMode.Multiple)
                                {
                                    <button type="button" class="fx-expand-all-btn btn btn-sm btn-link p-0 text-decoration-none"
                                            style="font-size:0.75rem; width:20px; height:20px; color:inherit;"
                                            aria-label="@(AllRowsExpanded ? "Collapse all row details" : "Expand all row details")"
                                            aria-expanded="@(AllRowsExpanded ? "true" : "false")"
                                            @onclick="ToggleExpandAll">
                                        @(AllRowsExpanded ? "▼" : "▶")
                                    </button>
                                }
                            </th>
                        }
                        @if (AllowGrouping && HideGroupedColumns && GroupedLayoutColumns.Count > 0)
                        {
                            @foreach (var gcol in GroupedLayoutColumns)
                            {
                                @* Capture per-iteration so the @oncontextmenu lambda
                                   binds the right field instead of closing over the
                                   loop variable. *@
                                var capturedGroupField = gcol.Field;
                                <th class="fx-header-cell fx-group-indent" style="@GetGroupedPlaceholderStyle(gcol)"
                                    @oncontextmenu="@(e => OpenHeaderContextMenu(e, capturedGroupField))"
                                    @oncontextmenu:preventDefault="true"
                                    @oncontextmenu:stopPropagation="@EnableHeaderContextMenu"
                                    title="Right-click for options">
                                    <span class="fx-header-text">@HeaderColumnDisplay(gcol)</span>
                                </th>
                            }
                        }
                        @{ GridColumn? prevResizeCol = null; }
                        @foreach (var columnSlot in columnVirtualizationLayout.Slots)
                        {
                            @if (columnSlot.IsSpacer)
                            {
                                prevResizeCol = null;
                                <th class="fx-header-cell fx-column-window-spacer"
                                    aria-hidden="true"
                                    style="@ColumnVirtualizationSpacerStyle(columnSlot.WidthPx)"></th>
                            }
                            else
                            {
                            var col = columnSlot.Column!;
                            var state = GetColumnState(col.Field);
                            var headerDraggable = AllowColumnReorder || (AllowGrouping && col.AllowGrouping);
                            var capturedField = col.Field;
                            var headerLabel = HeaderColumnDisplay(col);
                            var leftGripCol = prevResizeCol;
                            prevResizeCol = AllowResizing && col.AllowResizing ? col : null;
                            @* data-field CSS hook (header) — matches the data-cell hook so a
                               single rule like `[data-field="Total"]` paints both the column
                               header AND every cell underneath. *@
                            <th class="fx-header-cell @(state.SortDirection.HasValue ? "fx-sorted" : "") @(HasActiveColumnFilter(capturedField) ? "fx-filtered" : "") @(AllowResizing && col.AllowResizing ? "fx-resizable" : "")"
                                style="@col.GetHeaderStyle(); position:relative;"
                                data-field="@capturedField"
                                scope="col"
                                aria-colindex="@GetColumnAriaIndex(columnSlot.ColumnIndex)"
                                aria-sort="@GetColumnAriaSort(state)"
                                @onclick="() => HandleSort(col)"
                                @oncontextmenu="@(e => OpenHeaderContextMenu(e, capturedField))"
                                @oncontextmenu:preventDefault="true"
                                @oncontextmenu:stopPropagation="@(EnableHeaderContextMenu || ShowColumnMenu)"
                                title="@headerLabel"
                                draggable="@(headerDraggable ? "true" : "false")"
                                @ondragstart="(e => StartColumnDrag(capturedField, e))"
                                @ondragend="EndColumnDrag">

                                @if (col.HeaderTemplate != null)
                                {
                                    @col.HeaderTemplate
                                }
                                else
                                {
                                    <span class="fx-header-text">@headerLabel</span>
                                }

                                @if (AllowSorting && col.AllowSorting && state.SortDirection.HasValue)
                                {
                                    <span class="fx-sort-icon">@(state.SortDirection == SortDirection.Ascending ? "▲" : "▼")</span>
                                    @if (ShowMultiColumnSortingIndex && GetSortPriorityIndex(capturedField) is int sortPriority)
                                    {
                                        <span class="fx-sort-index badge bg-secondary text-white ms-1" style="font-size:0.60rem; padding:1px 3px;">@sortPriority</span>
                                    }
                                }

                                @if (HasActiveColumnFilter(capturedField))
                                {
                                    @* HHM-871: the passive "filter applied" dot is now a
                                       click-to-clear badge — one click removes the column's
                                       filter without opening the popup. *@
                                    <span class="fx-filter-clear"
                                          role="button"
                                          title="Filter applied — click to clear"
                                          aria-label="Clear filter on @headerLabel"
                                          @onmousedown:stopPropagation="true"
                                          @onclick:stopPropagation="true"
                                          @onclick="() => ClearFilterFromHeader(col.Field)">×</span>
                                }

                                @if (AllowFiltering && col.AllowFiltering && ShowHeaderFilterIcon)
                                {
                                    <span class="fx-filter-icon @(UseDefaultHeaderFilterIcon ? "fx-filter-icon-default" : "fx-filter-icon-custom") @(HasActiveColumnFilter(capturedField) ? "active" : "")"
                                          title="Filter"
                                          aria-label="Filter @headerLabel"
                                          @onclick:stopPropagation="true"
                                          @onclick="e => ToggleFilterPopup(col.Field, e)">
                                        @if (!UseDefaultHeaderFilterIcon)
                                        {
                                            @ResolvedHeaderFilterIcon
                                        }
                                    </span>
                                }

                                @if (ShowColumnMenuButton && (EnableHeaderContextMenu || ShowColumnMenu))
                                {
                                    <ButtonControl BareStyle="true" CssClass="fx-column-menu-button"
                                                   Title="Column menu" aria-label="@($"Column menu for {headerLabel}")"
                                                   @onmousedown:stopPropagation="true"
                                                   StopPropagation="true"
                                                   OnClick="e => OpenHeaderContextMenu(e, capturedField)">⋮</ButtonControl>
                                }

                                @* ── Resize Handle ────────────────────────── *@
                                @if (AllowResizing && col.AllowResizing)
                                {
                                    <span class="fx-resize-handle"
                                          draggable="false"
                                          @onmousedown="e => StartResize(col, e)"
                                          @onmousedown:preventDefault="true"
                                          @onmousedown:stopPropagation="true"
                                          @onclick:stopPropagation="true"
                                          @ondblclick="() => HandleResizeHandleDoubleClickAsync(col)"
                                          @ondblclick:preventDefault="true"
                                          @ondblclick:stopPropagation="true"></span>
                                }
                                @* The divider's right half. Each header cell is isolation:isolate, so
                                   the previous cell's grip cannot overhang into this one — instead this
                                   cell owns a left-edge strip that resizes the PREVIOUS column, giving
                                   the divider line a hit zone on both sides like VB6/Excel. *@
                                @if (leftGripCol != null)
                                {
                                    var capturedPrev = leftGripCol;
                                    <span class="fx-resize-handle fx-resize-handle-prev"
                                          draggable="false"
                                          @onmousedown="e => StartResize(capturedPrev, e)"
                                          @onmousedown:preventDefault="true"
                                          @onmousedown:stopPropagation="true"
                                          @onclick:stopPropagation="true"
                                          @ondblclick="() => HandleResizeHandleDoubleClickAsync(capturedPrev)"
                                          @ondblclick:preventDefault="true"
                                          @ondblclick:stopPropagation="true"></span>
                                }

                                @if (AllowColumnReorder)
                                {
                                    <span class="fx-header-drop-zone fx-header-drop-zone-left"
                                          @ondragover="e => HandleHeaderDropZoneDragOver(capturedField, insertAfter: false, e)"
                                          @ondragover:preventDefault="true"
                                          @ondragover:stopPropagation="true"
                                          @ondrop="e => HandleHeaderDropZoneDrop(capturedField, insertAfter: false, e)"
                                          @ondrop:preventDefault="true"
                                          @ondrop:stopPropagation="true"></span>
                                    <span class="fx-header-drop-zone fx-header-drop-zone-right"
                                          @ondragover="e => HandleHeaderDropZoneDragOver(capturedField, insertAfter: true, e)"
                                          @ondragover:preventDefault="true"
                                          @ondragover:stopPropagation="true"
                                          @ondrop="e => HandleHeaderDropZoneDrop(capturedField, insertAfter: true, e)"
                                          @ondrop:preventDefault="true"
                                          @ondrop:stopPropagation="true"></span>
                                }
                            </th>
                            }
                        }
                    </tr>

                    @if (FilterMode is GridFilterMode.Simple or GridFilterMode.SimpleWithMenu or GridFilterMode.Excel)
                    {
                        <tr class="fx-filter-row" role="row" aria-rowindex="@(renderColumnHeaderBands ? 3 : 2)">
                            @if (ShowRowReorderColumn) { <th class="fx-filter-cell"></th> }
                            @if (ShowRowSelectorHandleColumn) { <th class="fx-filter-cell"></th> }
                            @if (ShowCheckboxColumn) { <th class="fx-filter-cell"></th> }
                            @if (ShowDetailExpandColumn) { <th class="fx-filter-cell"></th> }
                            @if (AllowGrouping && HideGroupedColumns && GroupedLayoutColumns.Count > 0)
                            {
                                @foreach (var groupedColumn in GroupedLayoutColumns)
                                {
                                    <th class="fx-filter-cell fx-group-indent"
                                        aria-hidden="true"
                                        style="@GetGroupedPlaceholderStyle(groupedColumn)"></th>
                                }
                            }
                            @foreach (var columnSlot in columnVirtualizationLayout.Slots)
                            {
                                @if (columnSlot.IsSpacer)
                                {
                                    <th class="fx-filter-cell fx-column-window-spacer"
                                        aria-hidden="true"
                                        style="@ColumnVirtualizationSpacerStyle(columnSlot.WidthPx)"></th>
                                }
                                else
                                {
                                var fCol = columnSlot.Column!;
                                <th class="fx-filter-cell" style="@fCol.GetHeaderStyle()">
                                    @if (fCol.AllowFiltering)
                                    {
                                        @if (fCol.FilterCellTemplate != null)
                                        {
                                            @fCol.FilterCellTemplate(CreateFilterCellTemplateContext(fCol))
                                        }
                                        else if (fCol.FilterTemplate != null)
                                        {
                                            @fCol.FilterTemplate(fCol)
                                        }
                                        else
                                        {
                                            var filterRowOperator = GetFilterRowOperator(fCol);
                                            var filterRowNeedsValue = !FilterOperatorNeedsNoValue(filterRowOperator);
                                            <div class="fx-grid-filter-input-wrap fx-grid-filter-typed-wrap @(!ShowFilterRowOperators ? "fx-grid-filter-value-only" : null)">
                                                @if (ShowFilterRowOperators)
                                                {
                                                    <DropDownListControl TValue="TextFilterOperator" TItem="TextFilterOperatorChoice"
                                                                         DataSource="@GetFilterRowOperatorChoices(fCol)"
                                                                         TextFieldName="Text" ValueFieldName="Value"
                                                                         Value="@filterRowOperator"
                                                                         ValueChanged="@(filterOperator => OnFilterRowOperatorChanged(fCol, filterOperator))"
                                                                         AriaLabel="@($"Filter operator for {HeaderColumnDisplay(fCol)}")"
                                                                         PanelFitContentWidth="true" Width="100%"
                                                                         CssClass="fx-grid-filter-operator" />
                                                }
                                                @if (ShowFilterRowOperators && fCol.Type is (ColumnType.Boolean or ColumnType.CheckBox))
                                                {
                                                    <DropDownListControl TValue="string" TItem="BooleanFilterChoice"
                                                                         DataSource="@BooleanFilterChoices"
                                                                         TextFieldName="Text" ValueFieldName="Value"
                                                                         Value="@GetColumnFilterValue(fCol.Field)"
                                                                         ValueChanged="@(value => OnColumnFilterInput(fCol.Field, value))"
                                                                         Enabled="@filterRowNeedsValue"
                                                                         AriaLabel="@($"Filter value for {HeaderColumnDisplay(fCol)}")"
                                                                         PanelFitContentWidth="true" Width="100%"
                                                                         CssClass="fx-grid-filter-boolean" />
                                                }
                                                else
                                                {
                                                    <TextBoxControl InputType="@GetFilterRowInputType(fCol)"
                                                                    CssClass="fx-grid-filter-input"
                                                                    Placeholder="Filter..."
                                                                    Enabled="@filterRowNeedsValue"
                                                                    Value="@GetColumnFilterValue(fCol.Field)"
                                                                    UpdateOnInput="true"
                                                                    ValueChanged="@(value => OnColumnFilterInput(fCol.Field, value))"
                                                                    aria-label="@($"Filter value for {HeaderColumnDisplay(fCol)}")" />
                                                }
                                                @if (!string.IsNullOrEmpty(GetColumnFilterValue(fCol.Field)) || FilterOperatorNeedsNoValue(filterRowOperator))
                                                {
                                                    <ButtonControl BareStyle="true" CssClass="fx-grid-filter-clear"
                                                                   Title="@($"Clear filter for {HeaderColumnDisplay(fCol)}")"
                                                                   OnClick="@(() => ClearFilterRowAsync(fCol.Field))"
                                                                   StopPropagation="true">✕</ButtonControl>
                                                }
                                            </div>
                                        }
                                    }
                                </th>
                                }
                            }
                        </tr>
                    }
                </thead>
            }

            @* Body *@
            <tbody class="fx-grid-body">
                @if (_isEditing && EditSettingsRef?.Mode == EditMode.Inline && _editingRowIndex == -1 && EditSettingsRef.NewRowPosition == NewRowPosition.Top)
                {
                    @RenderEditRow()
                }

                @* ── Grouped or flat rendering ─────────────────── *@
                @if (AllowGrouping && _groupDescriptors.Count > 0 && (!UsesItemsProvider || UsesProviderGrouping))
                {
                    @if (UsesProviderGrouping)
                    {
                        @RenderProviderGroupedRows()
                    }
                    @* Grouped windowing: flatten headers/items/footers into one
                       display stream and window over it (mixed-height prefix
                       math); falls back to the classic render-everything
                       recursion when windowing does not apply. *@
                    else if (UseGroupedRowWindowing)
                    {
                        @RenderGroupedRowsWindowed()
                    }
                    else
                    {
                        @RenderGroupedRows(GetPassGroups(), 0)
                    }
                }
                else
                {
                    @* ── Flat (non-grouped) rows ───────────────────────
                       Shared row template so the virtualized branch and the
                       non-virtualized (paged / no-height) branch render
                       byte-identical <tr> markup. `row` carries the item AND
                       its ABSOLUTE index into PagedData: with virtualization
                       only a subset of rows render, so a running counter would
                       be wrong — every place that used the old loop `item` /
                       `currentIdx` now reads `row.Item` / `row.Index`. *@
                    RenderFragment<(TValue Item, int Index)> rowTemplate = row =>
                    @<text>
                        @{
                            var item = row.Item;
                            var currentIdx = row.Index;
                            var isSelected = _selectedItems.Contains(item);
                            var isCellSelectedRow = IsCellSelectionRow(item, currentIdx);
                            var isEditingThis = _isEditing && EditSettingsRef?.Mode == EditMode.Inline && _editingRowIndex == currentIdx;
                            // Inline background for selected rows as a
                            // belt-and-suspenders backstop. The scoped
                            // .fx-row.fx-selected CSS can lose specificity
                            // fights inside isolated batch-edit cells; an
                            // inline style wins every battle by spec.
                            var rowStyle = GetRowStyle(item, currentIdx, isSelected);
                            var rowCssClass = GetRowCssClass(item, currentIdx);
                        }
                        @if (isEditingThis)
                        {
                            @RenderEditRow()
                        }
                        else
                        {
                            <tr @key="GetRowRenderKey(item)"
                                class="fx-row @(currentIdx % 2 == 1 && EnableAltRow ? "fx-alt-row" : "") @(isSelected && HighlightSelectedRows ? "fx-selected" : "") @(isCellSelectedRow && HighlightSelectedRows ? "fx-cell-row-selected" : "") @(EnableHover ? "fx-hover" : "") @(ShowRowReorderColumn && _rowReorderDragTargetIndex == ResolveRowIndex(item, currentIdx) ? "fx-row-reorder-target" : "") @rowCssClass"
                                role="row"
                                aria-rowindex="@GetGridDataAriaRowIndex(currentIdx)"
                                aria-selected="@(isSelected ? "true" : "false")"
                                @onclick="@RowClickHandler(item, currentIdx)"
                                @ondblclick="@RowDblClickHandler(item, currentIdx)"
                                @onmousedown="@RowMouseDownHandler(item, currentIdx)"
                                data-ari="@currentIdx"
                                @ondragover="@RowDragOverHandler(item, currentIdx)"
                                @ondragover:preventDefault="true"
                                @ondrop="@RowDropHandler(item, currentIdx)"
                                @ondrop:preventDefault="true"
                                @ondragend="EndRowReorderDrag"
                                style="@rowStyle">

                                @if (ShowRowReorderColumn)
                                {
                                    <td class="fx-cell fx-row-reorder-cell @(CanStartRowReorder(item) ? "" : "disabled")"
                                        style="@RowReorderColumnStyle"
                                        draggable="@(CanStartRowReorder(item) ? "true" : "false")"
                                        title="Drag to move row"
                                        @onclick:stopPropagation="true"
                                        @onmousedown:stopPropagation="true"
                                        @ondragstart="(DragEventArgs e) => StartRowReorderDrag(item, currentIdx, e)"
                                        @ondragend="EndRowReorderDrag">
                                        <span class="fx-row-reorder-grip" aria-hidden="true"></span>
                                    </td>
                                }

                                @if (ShowRowSelectorHandleColumn)
                                {
                                    @RenderRowSelectorHandleCell(item, currentIdx)
                                }

                                @if (ShowCheckboxColumn)
                                {
                                    @RenderRowSelectionCheckboxCell(item, currentIdx)
                                }

                                @if (ShowDetailExpandColumn)
                                {
                                    <td class="fx-cell fx-detail-expand-cell" style="width:36px; min-width:36px; text-align:center;" @onclick:stopPropagation="true">
                                        <button type="button" class="fx-detail-expand-btn btn btn-sm btn-link p-0 text-decoration-none"
                                                style="font-size:0.75rem; width:20px; height:20px; color:inherit;"
                                                aria-label="@(IsRowExpanded(item) ? "Collapse row details" : "Expand row details")"
                                                aria-expanded="@(IsRowExpanded(item) ? "true" : "false")"
                                                @onclick="() => ToggleRowExpand(item)">
                                            @(IsRowExpanded(item) ? "▼" : "▶")
                                        </button>
                                    </td>
                                }

                                @if (RowTemplate != null)
                                {
                                    @RowTemplate(BuildRowTemplateContext(item, currentIdx, isSelected))
                                }
                                else
                                {
                                    @RenderDataCells(item, currentIdx, col => col)
                                }
                            </tr>

                            @if (HasDetailTemplate && IsRowExpanded(item))
                            {
                                <tr class="fx-detail-row" role="row" @key="@((GetRowRenderKey(item), "detail"))">
                                    <td colspan="@WindowSpacerColspan" role="gridcell" class="fx-detail-cell p-2 bg-light border-bottom">
                                        @DetailTemplate!(item)
                                    </td>
                                </tr>
                            }
                        }
                    </text>;

                    @* Materialize the sorted/paged list ONCE per render so slicing
                       is O(1) and SortedData isn't re-enumerated per row. *@
                    var pagedList = GetPassFlatRows();

                    @* ── Custom row windowing (scroll-driven) ──────────────
                       Render only the visible slice plus overscan, bracketed by two
                       zero-content spacer rows whose heights stand in for the
                       un-rendered rows above and below. The scroll reader in
                       grid-control.js reports scrollTop/clientHeight to
                       OnGridWindowScrollAsync, which recomputes _winStart / _winCount;
                       PrepareRowWindow clamps the offset (and resets it to the top
                       when the list identity changes). Each row renders with its
                       ABSOLUTE index into pagedList so selection / active-cell /
                       batch-edit / inline-edit match all stay correct. Replaces
                       Blazor <Virtualize>, whose IntersectionObserver did not track
                       scrolling inside this <table>. *@
                    @if (UsesItemsProvider)
                    {
                        @* Provider rows are already the requested window. Their
                           render indices are absolute positions in the complete
                           query, while spacers represent all unfetched rows. *@
                        var providerTotal = Math.Max(0, _providerTotalCount);
                        var providerStart = Math.Min(_providerWindowStart, providerTotal);
                        var providerItems = _providerWindowItems;
                        var providerEnd = Math.Min(providerTotal, providerStart + providerItems.Count);

                        @if (IsItemsProviderLoading && providerItems.Count == 0)
                        {
                            <tr class="fx-provider-group-status-row">
                                <td colspan="@WindowSpacerColspan"
                                    class="fx-cell fx-provider-group-status-cell"
                                    role="status"
                                    aria-live="polite">Loading rows…</td>
                            </tr>
                        }
                        else if (ItemsProviderLastError is not null && providerItems.Count == 0)
                        {
                            <tr class="fx-provider-group-status-row">
                                <td colspan="@WindowSpacerColspan"
                                    class="fx-cell fx-provider-group-status-cell"
                                    role="alert">
                                    <button type="button"
                                            class="fx-provider-group-more"
                                            title="@ItemsProviderLastError.Message"
                                            @onclick="ReloadItemsAsync">Could not load rows. Retry</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr aria-hidden="true" class="fx-grid-window-spacer" data-fx-window-spacer="top">
                                <td colspan="@WindowSpacerColspan" style="@WindowSpacerStyle(providerStart * _rowHeightPx)"></td>
                            </tr>
                            @for (int pi = 0; pi < providerItems.Count; pi++)
                            {
                                @rowTemplate((providerItems[pi], providerStart + pi))
                            }
                            <tr aria-hidden="true" class="fx-grid-window-spacer" data-fx-window-spacer="bottom">
                                <td colspan="@WindowSpacerColspan" style="@WindowSpacerStyle(Math.Max(0, providerTotal - providerEnd) * _rowHeightPx)"></td>
                            </tr>
                        }
                    }
                    else if (UseRowWindowing)
                    {
                        PrepareRowWindow(pagedList);
                        var winTotal = pagedList.Count;
                        var winStart = _winStart;
                        var winEnd = Math.Min(winTotal, winStart + _winCount);

                        @* TOP spacer — height of all rows above the window. *@
                        <tr aria-hidden="true" class="fx-grid-window-spacer" data-fx-window-spacer="top">
                            <td colspan="@WindowSpacerColspan" style="@WindowSpacerStyle(winStart * _rowHeightPx)"></td>
                        </tr>
                        @for (int wi = winStart; wi < winEnd; wi++)
                        {
                            @rowTemplate((pagedList[wi], wi))
                        }
                        @* BOTTOM spacer — height of all rows below the window. *@
                        <tr aria-hidden="true" class="fx-grid-window-spacer" data-fx-window-spacer="bottom">
                            <td colspan="@WindowSpacerColspan" style="@WindowSpacerStyle((winTotal - winEnd) * _rowHeightPx)"></td>
                        </tr>
                    }
                    else
                    {
                        @* Paged / unbounded-height / grouped-off-but-no-Height grids
                           keep the plain loop over every row — no scroll viewport to
                           window against, so old behavior is preserved exactly. *@
                        @for (int fi = 0; fi < pagedList.Count; fi++)
                        {
                            @rowTemplate((pagedList[fi], fi))
                        }
                    }
                }

                @if (_isEditing && EditSettingsRef?.Mode == EditMode.Inline && _editingRowIndex == -1 && EditSettingsRef.NewRowPosition == NewRowPosition.Bottom)
                {
                    @RenderEditRow()
                }

                @if (!HasAnyData)
                {
                    <tr role="row" aria-rowindex="@(HasIndeterminateAriaRowStructure ? null : GridHeaderAriaRowCount + 1)">
                        <td role="gridcell" colspan="@(IsColumnVirtualizationActive ? RenderedColumnSlotCount : TotalColumnCount)" class="fx-empty-row">
                            @if (NoDataTemplate != null)
                            {
                                @NoDataTemplate
                            }
                            else
                            {
                                <text>No records to display</text>
                            }
                        </td>
                    </tr>
                }

            </tbody>

            @* ── Grid Footer (aggregates across all data) ──────── *@
            @if ((!UsesItemsProvider || _providerQueryAggregates.Count > 0) && AggregateRows is { Count: > 0 })
            {
                var footerRows = AggregateRows.Where(r => r.ShowInFooter).ToList();
                if (footerRows.Count > 0)
                {
                    var footerAggs = UsesItemsProvider
                        ? _providerQueryAggregates
                        : ComputeAggregates(GetPassSortedRows());
                    <tfoot class="fx-grid-footer">
                        @foreach (var aggRow in footerRows)
                        {
                            <tr class="fx-aggregate-footer-row">
                                @if (ShowRowReorderColumn)
                                {
                                    <td class="fx-cell fx-aggregate-cell fx-row-reorder-cell disabled" style="@RowReorderColumnStyle"></td>
                                }
                                @if (ShowRowSelectorHandleColumn)
                                {
                                    <td class="fx-cell fx-aggregate-cell fx-row-selector-cell" style="@RowSelectorHandleColumnStyle"></td>
                                }
                                @if (ShowCheckboxColumn)
                                {
                                    <td class="fx-cell fx-aggregate-cell"></td>
                                }
                                @if (ShowDetailExpandColumn)
                                {
                                    <td class="fx-cell fx-aggregate-cell fx-detail-expand-cell"
                                        style="width:36px; min-width:36px;"></td>
                                }
                                @if (AllowGrouping && HideGroupedColumns && GroupedLayoutColumns.Count > 0)
                                {
                                    @foreach (var groupedColumn in GroupedLayoutColumns)
                                    {
                                        <td class="fx-cell fx-group-indent"
                                            style="@GetGroupedPlaceholderStyle(groupedColumn)"></td>
                                    }
                                }
                                @foreach (var columnSlot in columnVirtualizationLayout.Slots)
                                {
                                    @if (columnSlot.IsSpacer)
                                    {
                                        <td class="fx-cell fx-aggregate-cell fx-column-window-spacer"
                                            aria-hidden="true"
                                            style="@ColumnVirtualizationSpacerStyle(columnSlot.WidthPx)"></td>
                                    }
                                    else
                                    {
                                    var col = columnSlot.Column!;
                                    var aggCol = aggRow.Columns.FirstOrDefault(a => a.Field == col.Field);
                                    <td class="fx-cell fx-aggregate-cell" style="@GetBlazorServerRenderCellStyle(col)">
                                        @if (aggCol != null)
                                        {
                                            var key = $"{aggCol.Field}_{aggCol.Type}";
                                            footerAggs.TryGetValue(key, out var val);
                                            <span class="fx-aggregate-value">@FormatAggregateValue(aggCol, val)</span>
                                        }
                                    </td>
                                    }
                                }
                            </tr>
                        }
                    </tfoot>
                }
            }
        </table>
    </div>
    @if (!ScrollTrack && (UseRowWindowing || UseGroupedRowWindowing))
    {
        @* Browser-owned proxy: Blazor owns the nodes, JS owns only geometry and
           pointer state. That keeps the render tree stable while the thumb can
           preview without dispatching a Blazor event on every pointer move. *@
        <div class="fx-grid-deferred-vscroll"
             role="scrollbar"
             aria-orientation="vertical"
             aria-label="Vertical grid scroll"
             tabindex="0"
             @ref="_deferredScrollLaneElement">
            <button type="button"
                    class="fx-grid-deferred-vscroll-button fx-grid-deferred-vscroll-up"
                    aria-label="Scroll up"
                    tabindex="-1"><span aria-hidden="true"></span></button>
            <div class="fx-grid-deferred-vscroll-thumb"
                 @ref="_deferredScrollThumbElement"></div>
            <button type="button"
                    class="fx-grid-deferred-vscroll-button fx-grid-deferred-vscroll-down"
                    aria-label="Scroll down"
                    tabindex="-1"><span aria-hidden="true"></span></button>
        </div>
    }
    }   @* /else (table render — closes ShowAsChart branch above) *@

    @if (ShowRowCountInFooter && !IsPagingActive)
    {
        <small class="fx-grid-row-count fx-grid-row-count-text">@GridRowCountText</small>
    }

    @* ── Pager ────────────────────────────────────────────────── *@
    @if (IsPagingActive && ShowPagerAtBottom)
    {
        <GridPagerControl Context="@BuildPagerContext()"
                          Template="@PagerTemplate"
                          ShowRowCount="@ShowRowCountInFooter" />
    }

    @* ── Column Filter Popup ───────────────────────────────────── *@
    @if (_filterPopupField != null)
    {
        var col = VisibleColumns.FirstOrDefault(c => c.Field == _filterPopupField);
        var filterHeader = col == null ? _filterPopupField : HeaderColumnDisplay(col);
        var isNumericFilter = IsNumericFilterColumn(col);

        <div class="fx-filter-popup-overlay" @onclick="CloseFilterPopup">
            <div class="fx-filter-popup" style="@FilterPopupStyle" @onclick:stopPropagation="true">
                <div class="fx-filter-popup-header">
                    <span>Filter: @filterHeader</span>
                    <button type="button"
                            class="fx-filter-popup-close"
                            title="Close"
                            aria-label="Close filter"
                            @onclick="CloseFilterPopup">x</button>
                </div>

                @if (col?.FilterMenuTemplate != null)
                {
                    <div class="fx-filter-menu-template">
                        @col.FilterMenuTemplate(CreateFilterMenuTemplateContext(col))
                    </div>
                }
                else if (isNumericFilter)
                {
                    var numericRanges = GetNumericFilterRanges(_filterPopupField);
                    var selectedRangeCount = GetSelectedNumericRangeCount(_filterPopupField, numericRanges);

                    <div class="fx-filter-number-panel">
                        @if (EnableAdvancedFilterPopup)
                        {
                            <div class="fx-filter-condition">
                                <DropDownListControl TValue="TextFilterOperator" TItem="TextFilterOperatorChoice"
                                                     DataSource="@GetFilterMenuOperatorChoices(col!)"
                                                     TextFieldName="Text"
                                                     ValueFieldName="Value"
                                                     Value="@_filterOperatorDraft"
                                                     ValueChanged="OnTextFilterOperatorValueChanged"
                                                     CssClass="fx-filter-operator-select" />
                                <input type="number"
                                       class="fx-filter-popup-input fx-filter-condition-input"
                                       placeholder="First value..."
                                       value="@_filterTextDraft"
                                       @oninput="OnTextFilterInput"
                                       @oninput:stopPropagation="true"
                                       @onkeydown:stopPropagation="true"
                                       @onkeyup:stopPropagation="true"
                                       @onclick:stopPropagation="true" />
                            </div>

                            <div class="fx-filter-logical-operator d-flex align-items-center justify-content-center gap-3 my-1">
                                <label class="form-check-label small mb-0 d-flex align-items-center gap-1" style="font-size: 0.72rem; cursor: pointer;">
                                    <input type="radio"
                                           name="fx-filter-logic-@_filterPopupField"
                                           checked="@(_filterLogicalOperatorDraft == LogicalFilterOperator.And)"
                                           @onchange="() => OnFilterLogicalOperatorChanged(LogicalFilterOperator.And)" />
                                    <span class="fw-bold">AND</span>
                                </label>
                                <label class="form-check-label small mb-0 d-flex align-items-center gap-1" style="font-size: 0.72rem; cursor: pointer;">
                                    <input type="radio"
                                           name="fx-filter-logic-@_filterPopupField"
                                           checked="@(_filterLogicalOperatorDraft == LogicalFilterOperator.Or)"
                                           @onchange="() => OnFilterLogicalOperatorChanged(LogicalFilterOperator.Or)" />
                                    <span class="fw-bold">OR</span>
                                </label>
                            </div>

                            <div class="fx-filter-condition fx-filter-second-condition mb-2">
                                <DropDownListControl TValue="TextFilterOperator" TItem="TextFilterOperatorChoice"
                                                     DataSource="@GetFilterMenuOperatorChoices(col!)"
                                                     TextFieldName="Text"
                                                     ValueFieldName="Value"
                                                     Value="@_secondFilterOperatorDraft"
                                                     ValueChanged="OnSecondTextFilterOperatorValueChanged"
                                                     CssClass="fx-filter-operator-select" />
                                <input type="number"
                                       class="fx-filter-popup-input fx-filter-condition-input"
                                       placeholder="Second value..."
                                       value="@_secondFilterTextDraft"
                                       @oninput="OnSecondTextFilterInput"
                                       @oninput:stopPropagation="true"
                                       @onkeydown:stopPropagation="true"
                                       @onkeyup:stopPropagation="true"
                                       @onclick:stopPropagation="true" />
                            </div>
                        }

                        <div class="fx-filter-popup-summary">
                            @GetNumericFilterSummary(_filterPopupField, numericRanges, selectedRangeCount)
                        </div>

                        <div class="fx-filter-number-custom">
                            <div class="fx-filter-number-inputs">
                                <label class="fx-filter-number-field">
                                    <span>Min</span>
                                    <input type="number"
                                           class="fx-filter-number-input"
                                           value="@GetNumericFilterMinText(_filterPopupField)"
                                           @oninput="e => SetNumericFilterMinText(_filterPopupField, e.Value?.ToString())" />
                                </label>
                                <label class="fx-filter-number-field">
                                    <span>Max</span>
                                    <input type="number"
                                           class="fx-filter-number-input"
                                           value="@GetNumericFilterMaxText(_filterPopupField)"
                                           @oninput="e => SetNumericFilterMaxText(_filterPopupField, e.Value?.ToString())" />
                                </label>
                            </div>
                            <button type="button"
                                    class="fx-filter-popup-btn"
                                    @onclick="() => ApplyNumericBoundsFilter(_filterPopupField)">
                                Apply Range
                            </button>
                        </div>

                        <div class="fx-filter-range-list">
                            @foreach (var range in numericRanges)
                            {
                                var capturedRange = range;
                                <label class="fx-filter-checkbox-item fx-filter-range-item">
                                    <input type="checkbox"
                                           checked="@IsNumericRangeChecked(_filterPopupField, capturedRange)"
                                           @onchange="e => SetNumericRangeChecked(_filterPopupField, capturedRange, e.Value is bool b && b)" />
                                    <span>@capturedRange.Label</span>
                                    <em>@capturedRange.CountLabel</em>
                                </label>
                            }
                            @if (numericRanges.Count == 0)
                            {
                                <div class="fx-filter-popup-empty">No numeric values</div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    var candidates = GetColumnFilterValueCandidates(_filterPopupField);
                    var values = candidates.Select(v => v.Value).ToList();
                    var totalValueCount = GetDistinctValues(_filterPopupField).Count;
                    var selectedValueCount = GetSelectedFilterValueCount(_filterPopupField);
                    var selectAllState = GetFilterFieldSelectionState(_filterPopupField, values);
                    @if (EnableBlankRowFilter)
                    {
                        <div class="fx-filter-blank-row-bar d-flex align-items-center gap-1 mb-2 p-1 bg-light border rounded" style="font-size: 0.72rem;">
                            <span class="text-muted fw-bold me-1">Blanks:</span>
                            <button type="button"
                                    class="btn btn-sm py-0 px-2 @(_blankRowFilterDraft == BlankRowFilterMode.All ? "btn-primary" : "btn-outline-secondary")"
                                    style="font-size: 0.68rem; height: 20px;"
                                    @onclick="() => SetBlankRowFilterDraft(BlankRowFilterMode.All)">
                                All
                            </button>
                            <button type="button"
                                    class="btn btn-sm py-0 px-2 @(_blankRowFilterDraft == BlankRowFilterMode.BlanksOnly ? "btn-primary" : "btn-outline-secondary")"
                                    style="font-size: 0.68rem; height: 20px;"
                                    @onclick="() => SetBlankRowFilterDraft(BlankRowFilterMode.BlanksOnly)">
                                Blanks Only
                            </button>
                            <button type="button"
                                    class="btn btn-sm py-0 px-2 @(_blankRowFilterDraft == BlankRowFilterMode.NonBlanksOnly ? "btn-primary" : "btn-outline-secondary")"
                                    style="font-size: 0.68rem; height: 20px;"
                                    @onclick="() => SetBlankRowFilterDraft(BlankRowFilterMode.NonBlanksOnly)">
                                Non-Blanks
                            </button>
                        </div>
                    }

                    <div class="fx-filter-condition">
                        <DropDownListControl TValue="TextFilterOperator" TItem="TextFilterOperatorChoice"
                                             DataSource="@GetFilterMenuOperatorChoices(col!)"
                                             TextFieldName="Text"
                                             ValueFieldName="Value"
                                             Value="@_filterOperatorDraft"
                                             ValueChanged="OnTextFilterOperatorValueChanged"
                                             CssClass="fx-filter-operator-select" />
                        <input type="text"
                               @ref="_filterConditionInputRef"
                               class="fx-filter-popup-input fx-filter-condition-input"
                               placeholder="Filter value..."
                               value="@_filterTextDraft"
                               @oninput="OnTextFilterInput"
                               @oninput:stopPropagation="true"
                               @onkeydown:stopPropagation="true"
                               @onkeyup:stopPropagation="true"
                               @onclick:stopPropagation="true" />
                    </div>

                    @if (EnableAdvancedFilterPopup)
                    {
                        <div class="fx-filter-logical-operator d-flex align-items-center justify-content-center gap-3 my-1">
                            <label class="form-check-label small mb-0 d-flex align-items-center gap-1" style="font-size: 0.72rem; cursor: pointer;">
                                <input type="radio"
                                       name="fx-filter-logic-@_filterPopupField"
                                       checked="@(_filterLogicalOperatorDraft == LogicalFilterOperator.And)"
                                       @onchange="() => OnFilterLogicalOperatorChanged(LogicalFilterOperator.And)" />
                                <span class="fw-bold">AND</span>
                            </label>
                            <label class="form-check-label small mb-0 d-flex align-items-center gap-1" style="font-size: 0.72rem; cursor: pointer;">
                                <input type="radio"
                                       name="fx-filter-logic-@_filterPopupField"
                                       checked="@(_filterLogicalOperatorDraft == LogicalFilterOperator.Or)"
                                       @onchange="() => OnFilterLogicalOperatorChanged(LogicalFilterOperator.Or)" />
                                <span class="fw-bold">OR</span>
                            </label>
                        </div>

                        <div class="fx-filter-condition fx-filter-second-condition mb-2">
                            <DropDownListControl TValue="TextFilterOperator" TItem="TextFilterOperatorChoice"
                                                 DataSource="@GetFilterMenuOperatorChoices(col!)"
                                                 TextFieldName="Text"
                                                 ValueFieldName="Value"
                                                 Value="@_secondFilterOperatorDraft"
                                                 ValueChanged="OnSecondTextFilterOperatorValueChanged"
                                                 CssClass="fx-filter-operator-select" />
                            <input type="text"
                                   class="fx-filter-popup-input fx-filter-condition-input"
                                   placeholder="Second filter value..."
                                   value="@_secondFilterTextDraft"
                                   @oninput="OnSecondTextFilterInput"
                                   @oninput:stopPropagation="true"
                                   @onkeydown:stopPropagation="true"
                                   @onkeyup:stopPropagation="true"
                                   @onclick:stopPropagation="true" />
                        </div>
                    }

                    <div class="fx-filter-checklist-search">
                        <span aria-hidden="true">⌕</span>
                        <input type="search"
                               class="fx-filter-popup-input"
                               aria-label="Search values for @filterHeader"
                               placeholder="Search values..."
                               value="@_filterChecklistSearchDraft"
                               @oninput="SetFilterChecklistSearch"
                               @oninput:stopPropagation="true"
                               @onkeydown:stopPropagation="true"
                               @onkeyup:stopPropagation="true"
                               @onclick:stopPropagation="true" />
                    </div>

                    <div class="fx-filter-popup-summary fx-filter-value-summary">
                        @selectedValueCount of @totalValueCount selected
                    </div>

                    <div class="fx-filter-checkbox-item fx-filter-select-all-row">
                        <button type="button"
                                class="fx-filter-tristate fx-filter-tristate-@selectAllState.ToString().ToLowerInvariant()"
                                role="checkbox"
                                aria-checked="@GetFilterSelectionAriaValue(selectAllState)"
                                aria-label="Select all visible values"
                                @onclick="() => SetFilterFieldSelected(_filterPopupField, selectAllState != GridFilterSelectionState.All, values)">
                            <span aria-hidden="true">@(selectAllState == GridFilterSelectionState.All ? "✓" : selectAllState == GridFilterSelectionState.Some ? "−" : "")</span>
                        </button>
                        <span>(Select All)</span>
                    </div>

                    <div class="fx-filter-checkbox-list">
                        @if (UsesItemsProvider && EnableProviderFilterValueRequests && IsProviderFilterValuesLoading)
                        {
                            <div class="fx-filter-popup-empty">Loading distinct values…</div>
                        }
                        else if (UsesItemsProvider && EnableProviderFilterValueRequests && ProviderFilterValuesLastError is not null)
                        {
                            <div class="fx-filter-popup-empty" role="alert">Unable to load distinct values.</div>
                        }
                        @foreach (var candidate in candidates)
                        {
                            var v = candidate.Value;
                            <label class="fx-filter-checkbox-item">
                                <input type="checkbox"
                                       checked="@IsFilterValueChecked(_filterPopupField, v)"
                                       @onchange="e => SetFilterValueChecked(_filterPopupField, v, e.Value is bool b && b)" />
                                <span>@candidate.DisplayText</span>
                            </label>
                        }
                        @if (values.Count == 0)
                        {
                            <div class="fx-filter-popup-empty">@(IsProviderFilterValuesLoading ? "Loading values…" : "No matching values")</div>
                        }
                        else if (ProviderFilterValuesHaveMore(_filterPopupField))
                        {
                            <div class="fx-filter-popup-empty">Showing the first @values.Count values. Refine the provider query for more.</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_filterChecklistCommitError))
                        {
                            <div class="fx-filter-popup-empty" role="alert">@_filterChecklistCommitError</div>
                        }
                    </div>
                }

                @if (col?.FilterMenuButtonsTemplate != null)
                {
                    <div class="fx-filter-popup-actions fx-filter-menu-buttons-template">
                        @col.FilterMenuButtonsTemplate(CreateFilterMenuButtonsTemplateContext(col))
                    </div>
                }
                else
                {
                    <div class="fx-filter-popup-actions">
                        <label class="fx-filter-auto-apply">
                            <input type="checkbox"
                                   checked="@_filterPopupAutoApply"
                                   @onchange="OnFilterPopupAutoApplyChanged" />
                            <span>Auto Apply</span>
                        </label>
                        <div class="fx-filter-popup-action-buttons">
                            <button class="fx-filter-popup-btn" @onclick="() => ClearFilterFromPopup(_filterPopupField)">Clear Filter</button>
                            <button class="fx-filter-popup-btn fx-primary"
                                    disabled="@_filterPopupAutoApply"
                                    @onclick="() => ApplyFilterPopupAsync(close: true)">Apply</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_pendingRowDeletion != null)
    {
        <div @onkeydown:stopPropagation="true" @onmousedown:stopPropagation="true">
            <DialogControl Header="Delete records" Visible="true" Width="380px" Resizable="false"
                           CssClass="fx-grid-delete-dialog" ShowCloseIcon="false" OnClose="CancelRowDeletion"
                           CloseOnOverlayClick="true">
                <ChildContent>
                    <p>Delete @(_pendingRowDeletion.Count == 1 ? "this record" : $"these {_pendingRowDeletion.Count} records")?</p>
                    @if (_rowDeletionError != null)
                    {
                        <div role="alert">@_rowDeletionError</div>
                    }
                </ChildContent>
                <FooterContent>
                    <ButtonControl AutoFocus="true" Disabled="@_rowDeletionBusy" OnClick="CancelRowDeletion">Cancel</ButtonControl>
                    <ButtonControl Disabled="@_rowDeletionBusy" OnClick="ConfirmRowDeletionAsync">Delete</ButtonControl>
                </FooterContent>
            </DialogControl>
        </div>
    }

    @* ── Edit Dialog ──────────────────────────────────────────── *@
    @if (_isEditing && EditSettingsRef?.Mode == EditMode.Dialog)
    {
        <div @onkeydown:stopPropagation="true" @onmousedown:stopPropagation="true">
            <DialogControl Header="@(_editingRowIndex >= 0 ? "Edit Record" : "Add New Record")"
                           Visible="true" Width="400px" CssClass="fx-grid-edit-dialog"
                           Resizable="false" CloseOnOverlayClick="true" OnClose="CancelEdit">
                <ChildContent>
                    <CascadingValue TValue="EditContext" Value="@_rowEditContext" IsFixed="false">
                    @if (_rowEditContext != null && ValidationSettings?.ValidatorTemplate != null)
                    {
                        @ValidationSettings.ValidatorTemplate(_rowEditContext)
                    }
                    @if (ValidationSettings?.ShowValidationSummary == true && GetRowValidationMessages() is { Count: > 0 } dialogValidationMessages)
                    {
                        <div class="fx-edit-validation-summary" role="alert">
                            @foreach (var message in dialogValidationMessages)
                            {
                                <div>@message</div>
                            }
                        </div>
                    }
                    @foreach (var col in VisibleColumns.Where(c => c.AllowEditing && !string.IsNullOrEmpty(c.Field) && c.Commands == null))
                    {
                        <div class="fx-dialog-field">
                            @if (col.EditTemplate != null || col.Type is not (ColumnType.Boolean or ColumnType.CheckBox))
                            {
                                <label>@col.DisplayHeader</label>
                            }
                            @if (col.EditTemplate != null && _editItem != null)
                            {
                                @col.EditTemplate((object)_editItem)
                            }
                            else
                            {
                                @RenderGeneratedRowEditor(col)
                            }
                            @if (ValidationSettings?.ShowFieldMessages == true)
                            {
                                @foreach (var message in GetRowValidationMessages(col.Field))
                                {
                                    <div class="fx-edit-validation-message" role="alert">@message</div>
                                }
                            }
                        </div>
                    }
                    </CascadingValue>
                </ChildContent>
                <FooterContent>
                    <ButtonControl OnClick="CancelEdit">Cancel</ButtonControl>
                    <ButtonControl CssClass="fx-primary" OnClick="SaveEdit">Save</ButtonControl>
                </FooterContent>
            </DialogControl>
        </div>
    }

    @* ── Resize Overlay (captures mousemove/mouseup during resize) ─ *@
    @if (_resizingCol != null || _resizingRowIndex >= 0)
    {
        <div class="fx-resize-overlay @(_resizingRowIndex >= 0 ? "fx-row-resize-overlay" : "")"
             @onmousemove="HandleGridResizeMove"
             @onmouseup="EndGridResize"
             @onmouseleave="EndGridResize"></div>
    }

    @* ── Cell Context Menu (opt-in right-click on data cells) ───── *@
    @if (_showCellContextMenu)
    {
        <div class="fx-grid-cell-context-backdrop"
             @onclick="CloseCellContextMenu"
             @oncontextmenu="CloseCellContextMenu"
             @oncontextmenu:preventDefault="true"></div>
        <div class="fx-grid-cell-context-menu"
             style="left:@(_cellContextMenuX)px;top:@(_cellContextMenuY)px;"
             @ref="_cellMenuElement"
             role="menu"
             tabindex="-1"
             @onkeydown="HandleMenuKeyDownAsync"
             @onkeydown:preventDefault="true"
             @onkeydown:stopPropagation="true"
             @onclick:stopPropagation="true">
            <button type="button"
                    class="fx-grid-cell-context-item"
                    disabled="@(!CanApplyCellContextEdit)"
                    @onclick="CellContextCutAsync">
                <span>Cut</span>
                <span class="fx-grid-cell-context-shortcut">Ctrl+X</span>
            </button>
            <button type="button"
                    class="fx-grid-cell-context-item"
                    disabled="@(!CanReadCellContext)"
                    @onclick="CellContextCopyAsync">
                <span>Copy</span>
                <span class="fx-grid-cell-context-shortcut">Ctrl+C</span>
            </button>
            <button type="button"
                    class="fx-grid-cell-context-item"
                    disabled="@(!CanApplyCellContextEdit)"
                    @onclick="CellContextPasteAsync">
                <span>Paste</span>
                <span class="fx-grid-cell-context-shortcut">Ctrl+V</span>
            </button>
            <button type="button"
                    class="fx-grid-cell-context-item"
                    disabled="@(!CanApplyCellContextEdit)"
                    @onclick="CellContextDeleteAsync">
                <span>Delete</span>
                <span class="fx-grid-cell-context-shortcut">Del</span>
            </button>
        </div>
    }

    @* ── Header Context Menu (right-click on a column header) ────── *@
    @* Generic across all grids — see GridControl.razor.cs for handlers.
       Backdrop catches clicks/right-clicks anywhere outside and dismisses. *@
    @if (_showHeaderContextMenu)
    {
        <div style="position:fixed;inset:0;z-index:999;background:transparent;"
             @onclick="CloseHeaderContextMenu"
             @oncontextmenu="CloseHeaderContextMenu"
             @oncontextmenu:preventDefault="true"></div>
        <div class="fx-grid-header-context-menu"
             style="left:@(_headerContextMenuX)px;top:@(_headerContextMenuY)px;"
             @ref="_headerMenuElement"
             role="menu"
             tabindex="-1"
             @onkeydown="HandleMenuKeyDownAsync"
             @onkeydown:preventDefault="true"
             @onkeydown:stopPropagation="true"
             @onclick:stopPropagation="true">

            @if (HeaderContextMenuShowsColumns)
            {
                @foreach (var col in HeaderContextMenuColumns)
                {
                    var capturedCol = col;
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(!CanToggleHeaderContextColumn(col))"
                            @onclick="() => ToggleHeaderContextColumnAsync(capturedCol)">
                        <span class="fx-grid-header-context-check">@(IsColumnVisible(col) ? "✓" : "")</span>
                        @HeaderColumnDisplay(col)
                    </button>
                }
            }
            else
            {
                @if (AllowSorting && AllowMultiSorting)
                {
                    <div role="group" aria-label="Multi-sort">
                        <div class="fx-grid-header-context-heading" aria-hidden="true">Multi-sort</div>
                        <ButtonControl BareStyle="true" CssClass="fx-grid-header-context-item" role="menuitem"
                                       Disabled="@(!CanOpenSortDialog)" OnClick="OpenSortDialogAsync">
                            <span class="fx-grid-header-context-check"></span>
                            Custom Sort...
                        </ButtonControl>
                    </div>
                    <div class="fx-grid-header-context-sep" role="separator"></div>
                }
                @if (ShowColumnMenu)
                {
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(!CanColumnMenuSort)"
                            @onclick="HeaderMenuSortAscending">
                        <span class="fx-grid-header-context-check">@(CurrentHeaderColumn is { } asc && GetColumnState(asc.Field).SortDirection == SortDirection.Ascending ? "✓" : "")</span>
                        Sort ascending
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(!CanColumnMenuSort)"
                            @onclick="HeaderMenuSortDescending">
                        <span class="fx-grid-header-context-check">@(CurrentHeaderColumn is { } desc && GetColumnState(desc.Field).SortDirection == SortDirection.Descending ? "✓" : "")</span>
                        Sort descending
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(!CurrentColumnHasSort)"
                            @onclick="HeaderMenuClearSort">
                        <span class="fx-grid-header-context-check"></span>
                        Clear sort
                    </button>
                    <div class="fx-grid-header-context-sep"></div>
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(!CanColumnMenuFilter)"
                            @onclick="HeaderMenuOpenFilter">
                        <span class="fx-grid-header-context-check">@(CurrentColumnHasFilter ? "✓" : "")</span>
                        Filter...
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(!CurrentColumnHasFilter)"
                            @onclick="HeaderMenuClearFilter">
                        <span class="fx-grid-header-context-check"></span>
                        Clear filter
                    </button>
                    <div class="fx-grid-header-context-sep"></div>
                    <button type="button" class="fx-grid-header-context-item"
                            @onclick="HeaderMenuFreezeLeft">
                        <span class="fx-grid-header-context-check">@(CurrentColumnIsFrozenLeft ? "✓" : "")</span>
                        Lock left
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            @onclick="HeaderMenuFreezeRight">
                        <span class="fx-grid-header-context-check">@(CurrentColumnIsFrozenRight ? "✓" : "")</span>
                        Lock right
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(!(CurrentColumnIsFrozenLeft || CurrentColumnIsFrozenRight))"
                            @onclick="HeaderMenuUnfreeze">
                        <span class="fx-grid-header-context-check"></span>
                        Unlock column
                    </button>
                    <div class="fx-grid-header-context-sep"></div>
                }
                @if (AllowGrouping && (CurrentHeaderColumn?.AllowGrouping ?? false))
                {
                    <button type="button" class="fx-grid-header-context-item"
                            @onclick="HeaderMenuToggleGroup">
                        <span class="fx-grid-header-context-check">@(IsHeaderColumnGrouped ? "✓" : "")</span>
                        Group on this column
                    </button>
                }
                @if (AllowGrouping)
                {
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(_groupDescriptors.Count == 0)"
                            @onclick="HeaderMenuExpandAll">
                        <span class="fx-grid-header-context-check"></span>
                        Expand All
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(_groupDescriptors.Count == 0)"
                            @onclick="HeaderMenuCollapseAll">
                        <span class="fx-grid-header-context-check"></span>
                        Collapse All
                    </button>
                    <div class="fx-grid-header-context-sep"></div>
                }

                <button type="button" class="fx-grid-header-context-item"
                        disabled="@(!CanHideHeaderColumn)"
                        @onclick="HeaderMenuHideColumn">
                    <span class="fx-grid-header-context-check"></span>
                    Hide this column
                </button>
                <button type="button" class="fx-grid-header-context-item"
                        disabled="@(!CanInsertHeaderColumn)"
                        @onclick="HeaderMenuOpenChooseColumns">
                    <span class="fx-grid-header-context-check"></span>
                    Insert a column...
                </button>
                <button type="button" class="fx-grid-header-context-item"
                        @onclick="HeaderMenuStartRename">
                    <span class="fx-grid-header-context-check"></span>
                    Rename this column...
                </button>
                @if (AllowColumnAutoFit)
                {
                    <div class="fx-grid-header-context-sep"></div>
                    <button type="button" class="fx-grid-header-context-item"
                            disabled="@(CurrentHeaderColumn == null)"
                            @onclick="HeaderMenuBestFitColumn">
                        <span class="fx-grid-header-context-check"></span>
                        Best Fit
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            @onclick="HeaderMenuBestFitAllColumns">
                        <span class="fx-grid-header-context-check"></span>
                        Best Fit All Columns
                    </button>
                    <button type="button" class="fx-grid-header-context-item"
                            @onclick="HeaderMenuBestFitToGrid">
                        <span class="fx-grid-header-context-check"></span>
                        Best Fit to Grid
                    </button>
                }

                <div class="fx-grid-header-context-sep"></div>

                <button type="button" class="fx-grid-header-context-item"
                        @onclick="HeaderMenuPrint">
                    <span class="fx-grid-header-context-check"></span>
                    Print...
                </button>
                <button type="button" class="fx-grid-header-context-item"
                        @onclick="HeaderMenuSaveAs">
                    <span class="fx-grid-header-context-check"></span>
                    Save As...
                </button>
                @if (OnHeaderAttachmentsRequested.HasDelegate)
                {
                    <div class="fx-grid-header-context-sep"></div>
                    <button type="button" class="fx-grid-header-context-item"
                            @onclick="HeaderMenuOpenAttachments">
                        <span class="fx-grid-header-context-check"></span>
                        Attachments...
                    </button>
                }
            }
        </div>
    }

    @if (_showSortDialog)
    {
        <DialogControl Header="Sort" Visible="true" Width="650px"
                       CssClass="fx-dialog-classic fx-sort-dialog" Resizable="false"
                       ShowCloseIcon="@(!_sortDialogApplying)" CloseOnEscape="@(!_sortDialogApplying)"
                       OnClose="CloseSortDialog">
            <ChildContent>
                <div class="fx-sort-editor" role="group" aria-label="Sort levels">
                    <div class="fx-sort-toolbar">
                        <ButtonControl CssClass="fx-button-classic" OnClick="AddSortDialogLevel" Disabled="@(!CanAddSortDialogLevel)">Add Level</ButtonControl>
                        <ButtonControl CssClass="fx-button-classic" OnClick="DeleteSortDialogLevel" Disabled="@(_sortDialogApplying || SelectedSortDialogIndex < 0)">Delete Level</ButtonControl>
                        <ButtonControl CssClass="fx-button-classic" OnClick="() => MoveSortDialogLevel(-1)" Disabled="@(_sortDialogApplying || SelectedSortDialogIndex <= 0)">Move Up</ButtonControl>
                        <ButtonControl CssClass="fx-button-classic" OnClick="() => MoveSortDialogLevel(1)" Disabled="@(_sortDialogApplying || SelectedSortDialogIndex < 0 || SelectedSortDialogIndex >= _sortDialogLevels.Count - 1)">Move Down</ButtonControl>
                        <ButtonControl CssClass="fx-button-classic" OnClick="ClearSortDialogLevels" Disabled="@(_sortDialogApplying || _sortDialogLevels.Count == 0)">Clear All</ButtonControl>
                    </div>
                    <p class="fx-sort-hint">Sort on cell values. Levels are applied from top to bottom.</p>
                    <div class="fx-sort-levels">
                        <div class="fx-sort-level fx-sort-heading" aria-hidden="true">
                            <span>Priority</span><span>Column</span><span>Order</span>
                        </div>
                        @for (var index = 0; index < _sortDialogLevels.Count; index++)
                        {
                            var level = _sortDialogLevels[index];
                            var levelNumber = index + 1;
                            <div @key="level" class="fx-sort-level @(ReferenceEquals(level, _selectedSortDialogLevel) ? "fx-sort-level-selected" : null)"
                                 role="group" aria-label="Sort level @levelNumber">
                                <ButtonControl BareStyle="true" CssClass="fx-sort-level-select"
                                               Disabled="@_sortDialogApplying" OnClick="() => SelectSortDialogLevel(level)"
                                               aria-label="@($"Select sort level {levelNumber}")"
                                               aria-pressed="@(ReferenceEquals(level, _selectedSortDialogLevel) ? "true" : "false")">
                                    @(levelNumber == 1 ? "Sort by" : "Then by")
                                </ButtonControl>
                                <DropDownListControl TValue="string" TItem="SortDialogColumn"
                                                     DataSource="@GetSortDialogColumnChoices(level)" TextFieldName="Header" ValueFieldName="Field"
                                                     Value="@level.Field" ValueChanged="field => SetSortDialogColumn(level, field)"
                                                     Enabled="@(!_sortDialogApplying)" Width="100%" PanelFitContentWidth="true"
                                                     AriaLabel="@($"Sort column level {levelNumber}")" />
                                <DropDownListControl TValue="SortDirection" TItem="SortDialogOrder"
                                                     DataSource="@GetSortDialogOrderChoices(level)" TextFieldName="Label" ValueFieldName="Direction"
                                                     Value="@level.Direction" ValueChanged="direction => SetSortDialogOrder(level, direction)"
                                                     Enabled="@(!_sortDialogApplying)" Width="100%" PanelFitContentWidth="true"
                                                     AriaLabel="@($"Sort order level {levelNumber}")" />
                            </div>
                        }
                        @if (_sortDialogLevels.Count == 0)
                        {
                            <p class="fx-sort-empty">No sort levels. Apply to clear sorting.</p>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_sortDialogError))
                    {
                        <p class="fx-sort-error" role="alert">@_sortDialogError</p>
                    }
                </div>
            </ChildContent>
            <FooterContent>
                <ButtonControl CssClass="fx-button-classic" Disabled="@_sortDialogApplying" OnClick="ApplySortDialogAsync">Apply</ButtonControl>
                <ButtonControl CssClass="fx-button-classic" Disabled="@_sortDialogApplying" OnClick="CloseSortDialog">Cancel</ButtonControl>
            </FooterContent>
        </DialogControl>
    }

    @if (_showRenameColumn)
    {
        <div class="fx-grid-rename-overlay"
             @onclick="HeaderMenuCancelRename"
             @oncontextmenu="HeaderMenuCancelRename"
             @oncontextmenu:preventDefault="true"></div>
        <div class="fx-grid-rename-dialog" @onclick:stopPropagation="true">
            <div class="fx-grid-rename-header">
                <span>@RenameColumnDialogTitle</span>
                <button type="button"
                        class="fx-grid-rename-close"
                        title="Close"
                        aria-label="Close"
                        @onclick="HeaderMenuCancelRename">x</button>
            </div>
            @* VB6 InputBox layout: OK over Cancel at the TOP RIGHT, the prompt to
               their left, and a full-width entry box along the bottom. *@
            <div class="fx-grid-rename-body">
                <div class="fx-grid-rename-footer">
                    <button type="button" class="fx-grid-rename-ok"
                            @onclick="HeaderMenuCommitRename">OK</button>
                    <button type="button" class="fx-grid-rename-cancel"
                            @onclick="HeaderMenuCancelRename">Cancel</button>
                </div>
                <span class="fx-grid-rename-prompt">@RenameColumnPrompt</span>
                <input type="text"
                       class="fx-grid-rename-input"
                       autofocus
                       value="@_renameColumnDraft"
                       @oninput="@(e => _renameColumnDraft = e.Value?.ToString() ?? "")"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await HeaderMenuCommitRename(); else if (e.Key == "Escape") HeaderMenuCancelRename(); })" />
            </div>
        </div>
    }

    @* ── Print Options Dialog ─────────────────────────────────────── *@
    @if (_showPrintOptionsDialog)
    {
        <div class="fx-grid-print-options-overlay"
             @onclick="PrintOptionsCancel"
             @oncontextmenu="PrintOptionsCancel"
             @oncontextmenu:preventDefault="true"></div>
        <div class="fx-grid-print-options-dialog" @onclick:stopPropagation="true">
            <div class="fx-grid-print-options-header">
                <span>Print Grid</span>
                <button type="button" class="fx-grid-print-options-close"
                        title="Close" aria-label="Close"
                        @onclick="PrintOptionsCancel">×</button>
            </div>
            <div class="fx-grid-print-options-body">
                <label class="fx-grid-print-options-field">
                    <span>Orientation</span>
                    <select @bind="_printOrientation">
                        <option value="@GridPdfOrientation.Portrait">Portrait</option>
                        <option value="@GridPdfOrientation.Landscape">Landscape</option>
                    </select>
                </label>
                <label class="fx-grid-print-options-field">
                    <span>Page size</span>
                    <select @bind="_printPageSize">
                        <option value="@GridPdfPageSize.Letter">Letter</option>
                        <option value="@GridPdfPageSize.Legal">Legal</option>
                        <option value="@GridPdfPageSize.A4">A4</option>
                    </select>
                </label>
                <label class="fx-grid-print-options-field">
                    <span>Columns</span>
                    <select @bind="_printColumnLayout">
                        <option value="@GridPdfColumnLayout.WrapText">Wrap text</option>
                        <option value="@GridPdfColumnLayout.ClipText">Clip text</option>
                        <option value="@GridPdfColumnLayout.FitColumnsToPage">Fit columns</option>
                    </select>
                </label>
                <label class="fx-grid-print-options-field">
                    <span>Grid lines</span>
                    <span class="fx-grid-print-options-check">
                        <input type="checkbox" @bind="_printShowGridLines" />
                        <span>On</span>
                    </span>
                </label>
                <label class="fx-grid-print-options-field">
                    <span>Zoom</span>
                    <select @bind="_printZoomMode">
                        <option value="@GridPdfZoomMode.Percent">Zoom %</option>
                        <option value="@GridPdfZoomMode.FitToPage">Fit to page</option>
                    </select>
                </label>
                <label class="fx-grid-print-options-field">
                    <span>Zoom %</span>
                    <input type="number"
                           min="25"
                           max="200"
                           step="5"
                           disabled="@(_printZoomMode == GridPdfZoomMode.FitToPage)"
                           @bind="_printZoomPercent" />
                </label>
            </div>
            <div class="fx-grid-print-options-footer">
                <button type="button" class="fx-grid-print-options-ok"
                        @onclick="PrintOptionsOk">Print</button>
                <button type="button" class="fx-grid-print-options-cancel"
                        @onclick="PrintOptionsCancel">Cancel</button>
            </div>
        </div>
    }

    @* ── Choose Columns Dialog (modal) ─────────────────────────── *@
    @* Mirrors the legacy VB6 "Choose Columns" dialog — checkbox list of
       every column with Move Up / Move Down / Show / Hide / Show All /
       Hide All / Restore Default Layout actions. OK commits to
       _visibilityOverrides and reorders the underlying column list. *@
    @if (_showChooseColumnsDialog)
    {
        <div class="fx-choose-columns-overlay"
             @onclick="ChooseColumnsCancel"
             @oncontextmenu="ChooseColumnsCancel"
             @oncontextmenu:preventDefault="true"></div>
        <div class="fx-choose-columns-dialog" @onclick:stopPropagation="true">
            <div class="fx-choose-columns-header">
                <span>Choose Columns</span>
                <button type="button" class="fx-choose-columns-close"
                        title="Close" aria-label="Close"
                        @onclick="ChooseColumnsCancel">×</button>
            </div>
            <div class="fx-choose-columns-instructions">
                Check the columns that you would like visible in this view. Use
                the Move Up and Move Down buttons to reorder the columns as you
                would like them to appear.
            </div>
            <div class="fx-choose-columns-body">
                @if (ColumnChooserTemplate != null)
                {
                    @ColumnChooserTemplate(BuildColumnChooserTemplateContext())
                }
                else
                {
                @* The list is a focusable listbox: VB6's dialog is a grid where Up/Down move the
                   highlight and Space ticks the box. Without tabindex + its own key handler the
                   arrows bubbled out to the GRID BEHIND the dialog and moved ITS row selection.
                   Keys are swallowed here (preventDefault + stopPropagation) so nothing reaches
                   the grid or scrolls the page while the dialog is up. *@
                <div class="fx-choose-columns-list"
                     tabindex="0"
                     role="listbox"
                     @ref="_chooseColumnsListRef"
                     @onkeydown="ChooseColumnsKeyDown"
                     @onkeydown:preventDefault="@_chooseColumnsHandledKey"
                     @onkeydown:stopPropagation="true">
                    @foreach (var row in _chooseColumnsRows)
                    {
                        var capturedRow = row;
                        @* tabindex -1 = programmatically focusable but out of the tab order. Focusing
                           the selected row is what SCROLLS it into view — the browser does it natively,
                           so no JS and no manual offset maths. Keydown still reaches the list handler
                           above by bubbling. *@
                        <div @key="capturedRow.Field"
                             tabindex="-1"
                             role="option"
                             aria-selected="@(row.Field == _chooseColumnsSelectedField)"
                             @ref="_chooseColumnsRowRefs[capturedRow.Field]"
                             class="fx-choose-columns-row @(row.Field == _chooseColumnsSelectedField ? "selected" : "")"
                             @onclick="() => ChooseColumnsSelect(capturedRow.Field)">
                            <input type="checkbox"
                                   checked="@row.Visible"
                                   disabled="@(!row.CanHide)"
                                   @onchange="e => ChooseColumnsSetVisible(capturedRow, e)"
                                   @onclick:stopPropagation="true" />
                            <span class="fx-choose-columns-label">@row.Header</span>
                        </div>
                    }
                </div>
                <div class="fx-choose-columns-buttons">
                    <button type="button" @onclick="ChooseColumnsMoveUp"
                            disabled="@(_chooseColumnsRows.FindIndex(r => r.Field == _chooseColumnsSelectedField) <= 0)">
                        Move Up
                    </button>
                    <button type="button" @onclick="ChooseColumnsMoveDown"
                            disabled="@(_chooseColumnsRows.FindIndex(r => r.Field == _chooseColumnsSelectedField) < 0
                                        || _chooseColumnsRows.FindIndex(r => r.Field == _chooseColumnsSelectedField) >= _chooseColumnsRows.Count - 1)">
                        Move Down
                    </button>
                    <button type="button" @onclick="ChooseColumnsShow">Show</button>
                    <button type="button" @onclick="ChooseColumnsShowAll">Show All</button>
                    <button type="button" @onclick="ChooseColumnsHide">Hide</button>
                    <button type="button" @onclick="ChooseColumnsHideAll">Hide All</button>
                    <button type="button" class="fx-choose-columns-restore"
                            @onclick="ChooseColumnsRestoreDefault">
                        Restore<br/>Default Layout
                    </button>
                </div>
                }
            </div>
            <div class="fx-choose-columns-footer">
                <button type="button" class="fx-choose-columns-ok"
                        @onclick="ChooseColumnsOk">OK</button>
                <button type="button" class="fx-choose-columns-cancel"
                        @onclick="ChooseColumnsCancel">Cancel</button>
            </div>
        </div>
    }

    @{ EndGridRenderPass(); }
    <span class="fx-grid-deferred-scroll-server-metrics"
          hidden
          aria-hidden="true"
          data-fx-token="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollDiagnosticsToken.ToString(CultureInfo.InvariantCulture))"
          data-fx-window-ms="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollWindowMathMs.ToString("0.###", CultureInfo.InvariantCulture))"
          data-fx-render-queue-ms="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollRenderQueueMs.ToString("0.###", CultureInfo.InvariantCulture))"
          data-fx-render-build-ms="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollRenderBuildMs.ToString("0.###", CultureInfo.InvariantCulture))"
          data-fx-grouped-build-ms="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollGroupedBuildMs.ToString("0.###", CultureInfo.InvariantCulture))"
          data-fx-grouped-entry-count="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollGroupedEntryCount.ToString(CultureInfo.InvariantCulture))"
          data-fx-window-start="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollWindowStart.ToString(CultureInfo.InvariantCulture))"
          data-fx-window-count="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollWindowCount.ToString(CultureInfo.InvariantCulture))"
          data-fx-window-mode="@(_deferredScrollDiagnosticsToken == 0 ? null : _deferredScrollWindowMode)"></span>
</div>
