@namespace Fx.ControlKit
@typeparam TItem
@using Fx.ControlKit.Grid
@using Microsoft.AspNetCore.Components.Rendering

@*
    Multi-Select Dual List Control
    -------------------------------
    A two-pane "shuttle" control imitating the Crystal / VB6 Reports parameter screen:

        [ Available values ]   [ >  ]   [ Selected values ]
                               [ >> ]
                               [ <  ]
                               [ << ]

    Each pane is a one-column GridControl, so both lists have the grid's header
    search (the magnifier), header sorting, type-to-jump (type the first letters of
    a value while the list has the focus) and, for the Available pane, paging.

    Buttons:
      >            Move the highlighted Available rows to Selected (double-click too)
      >>           Move every Available row on screen (the current batch, after any
                   search and sort) to Selected
      <            Take the highlighted Selected rows out (double-click too)
      <<           Empty Selected

    Crystal prompt mode (opt-in, used by the report parameter dialog):
      BatchSize > 0               the Available pane pages the pool BatchSize values at
                                  a time (Crystal's "Enter Parameter Values" lists a
                                  dynamic list of values 200 at a time) and >> adds only
                                  the batch on screen, as Crystal's >> does.
      KeepAvailableItems          the Available pane always lists the whole pool; adding
                                  copies an item to Selected and removing only takes it
                                  out of Selected (Crystal layout).

    LeftCaption / RightCaption name what a pane lists (e.g. the report parameter) on its
    header line, after the pane's caption (LeftHeader / RightHeader) and its search icon.
    A long name ends in an ellipsis; its tooltip shows it whole.

    Public API:
      - SelectedItems  (two-way bindable IList<TItem>)
      - SelectedItemsChanged (EventCallback)
      - GetSelected()  (programmatic accessor)

    Reflection-style field selectors (TextField / ValueField) match the convention
    used by the other FlexCore list controls.
*@

<div class="fx-dual-list @CssClass" style="@RootStyle">
    <div class="fx-dual-pane">
        <GridControl @ref="_availableGrid"
                     TValue="MultiSelectDualListRow"
                     DataSource="@_availableRows"
                     AllowSorting="true"
                     AllowMultiSorting="false"
                     AllowFiltering="true"
                     AllowSelection="true"
                     HighlightSelectedRows="true"
                     AllowResizing="false"
                     AllowColumnReorder="false"
                     EnableHeaderContextMenu="false"
                     EnableTypeSearch="true"
                     TypeSearchDelaySeconds="@TypeSearchDelaySeconds"
                     AllowPaging="@(BatchSize > 0)"
                     PageSize="@(BatchSize > 0 ? BatchSize : 50)"
                     PageSizes="@_pageSizes"
                     ShowSelectionInfoBar="false"
                     ShowGridToolbar="false"
                     ClearFiltersOnDataSourceChange="false"
                     GridLines="GridLines.None"
                     EnableAltRow="false"
                     Height="@PaneHeight"
                     Width="100%"
                     SelectionSettingsRef="@_availableSelection"
                     FilterSettingsRef="@_availableFilter"
                     EventsRef="@_availableEvents"
                     CssClass="fx-dual-grid">
            <GridColumnsBase>
                <GridColumn Field="Label" HeaderText="@(LeftHeader ?? "Available")" AllowSorting="true" AllowFiltering="true"
                            HeaderSuffixTemplate="@_leftCaptionSlot" />
            </GridColumnsBase>
        </GridControl>
        <div class="fx-dual-meta">@_availableRows.Count value(s)</div>
    </div>

    <div class="fx-dual-buttons">
        <button type="button" class="fx-dual-btn"
                title="Move selected"
                disabled="@(_availableRows.Count == 0)"
                @onclick="MoveSelectedRight">&gt;</button>
        <button type="button" class="fx-dual-btn"
                title="@MoveAllTitle"
                disabled="@(_availableRows.Count == 0)"
                @onclick="MoveAllRight">&gt;&gt;</button>
        <button type="button" class="fx-dual-btn"
                title="Remove selected"
                disabled="@(_selectedRows.Count == 0)"
                @onclick="MoveSelectedLeft">&lt;</button>
        <button type="button" class="fx-dual-btn"
                title="Remove all"
                disabled="@(_selectedRows.Count == 0)"
                @onclick="MoveAllLeft">&lt;&lt;</button>
    </div>

    <div class="fx-dual-pane">
        <GridControl @ref="_selectedGrid"
                     TValue="MultiSelectDualListRow"
                     DataSource="@_selectedRows"
                     AllowSorting="true"
                     AllowMultiSorting="false"
                     AllowFiltering="true"
                     AllowSelection="true"
                     HighlightSelectedRows="true"
                     AllowResizing="false"
                     AllowColumnReorder="false"
                     EnableHeaderContextMenu="false"
                     EnableTypeSearch="true"
                     TypeSearchDelaySeconds="@TypeSearchDelaySeconds"
                     ShowSelectionInfoBar="false"
                     ShowGridToolbar="false"
                     ClearFiltersOnDataSourceChange="false"
                     GridLines="GridLines.None"
                     EnableAltRow="false"
                     Height="@PaneHeight"
                     Width="100%"
                     SelectionSettingsRef="@_selectedSelection"
                     FilterSettingsRef="@_selectedFilter"
                     EventsRef="@_selectedEvents"
                     CssClass="fx-dual-grid">
            <GridColumnsBase>
                <GridColumn Field="Label" HeaderText="@(RightHeader ?? "Selected")" AllowSorting="true" AllowFiltering="true"
                            HeaderSuffixTemplate="@_rightCaptionSlot" />
            </GridColumnsBase>
        </GridControl>
        <div class="fx-dual-meta">@_selectedRows.Count selected</div>
    </div>
</div>

@code {
    // --- Parameters ---

    /// <summary>The full pool of items the user can choose from.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Items currently in the right-hand "Selected" pane (two-way bound).</summary>
    [Parameter] public IList<TItem> SelectedItems { get; set; } = new List<TItem>();

    /// <summary>Fires whenever the selected list changes (after every move).</summary>
    [Parameter] public EventCallback<IList<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>Property name on TItem used for the visible label (or use LabelSelector).</summary>
    [Parameter] public string? TextField { get; set; }

    /// <summary>Property name on TItem used as the unique key (or use KeySelector).</summary>
    [Parameter] public string? ValueField { get; set; }

    /// <summary>Function returning the visible label.  Wins over TextField if both are set.</summary>
    [Parameter] public Func<TItem, string>? LabelSelector { get; set; }

    /// <summary>Function returning the unique key.  Wins over ValueField if both are set.</summary>
    [Parameter] public Func<TItem, string>? KeySelector { get; set; }

    /// <summary>Header text of the left (Available) pane: the column caption that carries the search and sort.</summary>
    [Parameter] public string? LeftHeader { get; set; } = "Available";

    /// <summary>Header text of the right (Selected) pane.</summary>
    [Parameter] public string? RightHeader { get; set; } = "Selected";

    /// <summary>Number of rows visible in each pane when <see cref="Height"/> is not set.</summary>
    [Parameter] public int VisibleRows { get; set; } = 10;

    /// <summary>Optional fixed pane width (CSS value).  Default = flex.</summary>
    [Parameter] public string? PaneWidth { get; set; }

    /// <summary>Optional fixed height of each pane's grid (CSS value).</summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>Extra CSS class applied to the root.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>
    /// When greater than zero, the Available pane pages the pool this many values at a
    /// time and <c>&gt;&gt;</c> adds only the batch on screen. Crystal's "Enter Parameter
    /// Values" dialog lists a dynamic list of values 200 at a time and its <c>&gt;&gt;</c>
    /// adds the loaded batch only (SAP's default batch size); the report parameter dialog
    /// passes 200 so a prompt answered the same way in both applications submits the same
    /// values. 0 (the default) lists every value.
    /// </summary>
    [Parameter] public int BatchSize { get; set; }

    /// <summary>
    /// When true the Available pane always lists the whole pool (Crystal's prompt):
    /// adding puts a copy in Selected, an item already selected is not added twice,
    /// and removing only takes the item out of Selected. When false (the default)
    /// items shuttle between the panes.
    /// </summary>
    [Parameter] public bool KeepAvailableItems { get; set; }

    /// <summary>
    /// Optional name shown on the Available pane's header line after its caption and search icon
    /// (the report parameter dialog puts the parameter's prompt there instead of a heading above the lists).
    /// </summary>
    [Parameter] public string? LeftCaption { get; set; }

    /// <summary>Optional name shown on the Selected pane's header line after its caption and search icon.</summary>
    [Parameter] public string? RightCaption { get; set; }

    /// <summary>Seconds before the type-to-jump buffer resets (VB6 AutoSearchDelay).</summary>
    [Parameter] public int TypeSearchDelaySeconds { get; set; } = 2;

    // --- State ---

    private GridControl<MultiSelectDualListRow>? _availableGrid;
    private GridControl<MultiSelectDualListRow>? _selectedGrid;
    private List<MultiSelectDualListRow> _availableRows = new();
    private List<MultiSelectDualListRow> _selectedRows = new();
    private int[] _pageSizes = [50];
    // One slot per pane, created once, that reads the caption when the grid draws its header. A grid column's
    // own parameters reach the grid one render late, so a changed caption must not travel as a new fragment.
    private RenderFragment? _leftCaptionSlot;
    private RenderFragment? _rightCaptionSlot;

    private readonly SelectionSettings _availableSelection = new() { Type = SelectionType.Multiple, Mode = SelectionMode.Row };
    private readonly SelectionSettings _selectedSelection = new() { Type = SelectionType.Multiple, Mode = SelectionMode.Row };
    private readonly FilterSettings _availableFilter = new() { Type = FilterType.Menu, SearchAsYouType = true };
    private readonly FilterSettings _selectedFilter = new() { Type = FilterType.Menu, SearchAsYouType = true };
    private readonly GridControlEvents<MultiSelectDualListRow> _availableEvents = new();
    private readonly GridControlEvents<MultiSelectDualListRow> _selectedEvents = new();

    /// <summary>Tracks the last (Items, SelectedItems) reference pair we synced from.</summary>
    private object? _lastItemsRef;
    private object? _lastSelectedRef;

    // --- Lifecycle ---

    protected override void OnInitialized()
    {
        _leftCaptionSlot = builder => RenderCaption(builder, LeftCaption);
        _rightCaptionSlot = builder => RenderCaption(builder, RightCaption);
        _availableEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<MultiSelectDualListRow>>(this, OnAvailableDoubleClick);
        _selectedEvents.OnRecordDoubleClick = EventCallback.Factory.Create<CellClickEventArgs<MultiSelectDualListRow>>(this, OnSelectedDoubleClick);
    }

    protected override void OnParametersSet()
    {
        _pageSizes = [BatchSize > 0 ? BatchSize : 50];

        // Re-sync only when the parent passes a different reference; avoid
        // clobbering local moves on every render.
        var itemsChanged = !ReferenceEquals(Items, _lastItemsRef);
        var selectedChanged = !ReferenceEquals(SelectedItems, _lastSelectedRef);
        if (!itemsChanged && !selectedChanged) return;

        var allItems = (Items ?? Enumerable.Empty<TItem>()).ToList();
        var selected = (SelectedItems ?? new List<TItem>()).ToList();
        var selectedKeys = new HashSet<string>(selected.Select(ResolveKey), StringComparer.OrdinalIgnoreCase);

        _selectedRows = selected.Select(ToRow).ToList();
        if (itemsChanged || !KeepAvailableItems)
            _availableRows = allItems
                .Where(i => KeepAvailableItems || !selectedKeys.Contains(ResolveKey(i)))
                .Select(ToRow)
                .ToList();

        _lastItemsRef = Items;
        _lastSelectedRef = SelectedItems;
    }

    // --- Helpers ---

    private static void RenderCaption(RenderTreeBuilder __builder, string? caption)
    {
        if (string.IsNullOrWhiteSpace(caption)) return;
        <span class="fx-dual-caption" title="@caption">@caption</span>
    }

    private string MoveAllTitle => BatchSize > 0 ? "Move all values on screen (this batch)" : "Move all values on screen";

    private MultiSelectDualListRow ToRow(TItem item) => new() { Key = ResolveKey(item), Label = ResolveLabel(item), Item = item };

    private static TItem ItemOf(MultiSelectDualListRow row) => (TItem)row.Item!;

    private string ResolveKey(TItem item)
    {
        if (item is null) return string.Empty;
        if (KeySelector != null) return KeySelector(item) ?? string.Empty;
        if (!string.IsNullOrEmpty(ValueField))
            return GetPropertyString(item, ValueField);
        if (!string.IsNullOrEmpty(TextField))
            return GetPropertyString(item, TextField);
        return item.ToString() ?? string.Empty;
    }

    private string ResolveLabel(TItem item)
    {
        if (item is null) return string.Empty;
        if (LabelSelector != null) return LabelSelector(item) ?? string.Empty;
        if (!string.IsNullOrEmpty(TextField))
            return GetPropertyString(item, TextField);
        return item.ToString() ?? string.Empty;
    }

    private static string GetPropertyString(TItem item, string propName)
    {
        if (item is null) return string.Empty;
        var prop = item.GetType().GetProperty(propName);
        if (prop == null) return string.Empty;
        var v = prop.GetValue(item);
        return v?.ToString() ?? string.Empty;
    }

    private string RootStyle =>
        string.IsNullOrEmpty(PaneWidth) ? string.Empty : $"--fx-dual-pane-width:{PaneWidth};";

    /// <summary>Each pane's grid height: the explicit Height, else room for VisibleRows rows plus the header and pager.</summary>
    private string PaneHeight => !string.IsNullOrEmpty(Height) ? Height! : $"{Math.Max(3, VisibleRows) * 22 + 64}px";

    // --- Move actions ---

    private Task OnAvailableDoubleClick(CellClickEventArgs<MultiSelectDualListRow> args)
        => args.Data is { } row ? AddRowsAsync([row]) : Task.CompletedTask;

    private Task OnSelectedDoubleClick(CellClickEventArgs<MultiSelectDualListRow> args)
        => args.Data is { } row ? RemoveRowsAsync([row]) : Task.CompletedTask;

    private Task MoveSelectedRight()
        => AddRowsAsync(_availableGrid?.GetSelectedRecords().ToList() ?? []);

    /// <summary>Crystal's &gt;&gt;: every value on screen, i.e. the current batch after search and sort.</summary>
    private Task MoveAllRight()
        => AddRowsAsync(_availableGrid?.GetCurrentViewRecords().ToList() ?? _availableRows.ToList());

    private Task MoveSelectedLeft()
        => RemoveRowsAsync(_selectedGrid?.GetSelectedRecords().ToList() ?? []);

    private Task MoveAllLeft()
        => RemoveRowsAsync(_selectedRows.ToList());

    private async Task AddRowsAsync(List<MultiSelectDualListRow> moving)
    {
        if (moving.Count == 0) return;
        // An item already selected is not added twice (the Available pane keeps every row in Crystal mode).
        var selectedKeys = new HashSet<string>(_selectedRows.Select(r => r.Key), StringComparer.OrdinalIgnoreCase);
        var added = moving.Where(r => selectedKeys.Add(r.Key)).ToList();
        if (added.Count == 0)
        {
            if (_availableGrid != null) await _availableGrid.ClearSelectionAsync();
            return;
        }
        _selectedRows = [.. _selectedRows, .. added];
        if (!KeepAvailableItems)
        {
            var addedKeys = new HashSet<string>(added.Select(r => r.Key), StringComparer.OrdinalIgnoreCase);
            _availableRows = _availableRows.Where(r => !addedKeys.Contains(r.Key)).ToList();
        }
        if (_availableGrid != null) await _availableGrid.ClearSelectionAsync();
        await NotifyChanged();
    }

    private async Task RemoveRowsAsync(List<MultiSelectDualListRow> moving)
    {
        if (moving.Count == 0) return;
        var removedKeys = new HashSet<string>(moving.Select(r => r.Key), StringComparer.OrdinalIgnoreCase);
        var removed = _selectedRows.Where(r => removedKeys.Contains(r.Key)).ToList();
        if (removed.Count == 0) return;
        _selectedRows = _selectedRows.Where(r => !removedKeys.Contains(r.Key)).ToList();
        if (!KeepAvailableItems) _availableRows = [.. _availableRows, .. removed];
        if (_selectedGrid != null) await _selectedGrid.ClearSelectionAsync();
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        // Hand the parent a fresh List so [Parameter] change-detection fires
        // (Blazor compares references for IList).
        var snapshot = _selectedRows.Select(ItemOf).ToList();
        SelectedItems = snapshot;
        _lastSelectedRef = snapshot;
        if (SelectedItemsChanged.HasDelegate)
            await SelectedItemsChanged.InvokeAsync(snapshot);
        StateHasChanged();
    }

    // --- Public API ---

    /// <summary>
    /// Returns the items in the "Selected" pane.  Useful for scenarios where
    /// the caller doesn't bind two-way and wants to read the value on demand
    /// (e.g. a "Run Report" button click handler).
    /// </summary>
    public IReadOnlyList<TItem> GetSelected() => _selectedRows.Select(ItemOf).ToList();

    /// <summary>
    /// Returns the items in the "Available" pane (i.e. NOT chosen; with
    /// <see cref="KeepAvailableItems"/> the whole pool).
    /// </summary>
    public IReadOnlyList<TItem> GetAvailable() => _availableRows.Select(ItemOf).ToList();

    /// <summary>
    /// Convenience helper returning the resolved keys of the selected items.
    /// </summary>
    public IReadOnlyList<string> GetSelectedKeys() => _selectedRows.Select(r => r.Key).ToList();
}
