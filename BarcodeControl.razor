@namespace Fx.ControlKit
@inherits FlexControlBase

<div class="fx-barcode @CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (ErrorMessage is not null)
    {
        <span class="fx-barcode-error" role="alert">@ErrorMessage</span>
    }
    else if (_matrix is not null)
    {
        <svg viewBox="0 0 @SvgWidth @SvgHeight" width="@WidthString" height="@HeightString"
             shape-rendering="crispEdges" role="img" aria-label="@(AriaLabel ?? $"{Type} barcode: {Value}")">
            <rect width="@SvgWidth" height="@SvgHeight" fill="@BackgroundColor" />
            @foreach (var bar in _bars)
            {
                <rect x="@bar.X" y="5" width="@bar.W" height="@EffectiveBarHeight" fill="@ForegroundColor" />
            }
            @if (ShowText)
            {
                <g><text x="@(SvgWidth / 2.0)" y="@(EffectiveBarHeight + 21)" text-anchor="middle"
                         font-family="monospace" font-size="11" font-weight="600" fill="@ForegroundColor">@Value</text></g>
            }
        </svg>
    }
</div>

@code {
    private record Bar(int X, int W);
    [Parameter] public string Value { get; set; } = "FLEX-12345";
    [Parameter] public BarcodeType Type { get; set; } = BarcodeType.Code128;
    [Parameter] public bool ShowText { get; set; } = true;
    [Parameter] public string ForegroundColor { get; set; } = "#000000";
    [Parameter] public string BackgroundColor { get; set; } = "#ffffff";
    [Parameter] public int BarHeight { get; set; } = 50;
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    public string? ErrorMessage { get; private set; }

    private readonly List<Bar> _bars = new();
    private ZXing.Common.BitMatrix? _matrix;
    private int EffectiveBarHeight => Math.Max(1, BarHeight);
    private int SvgWidth => _matrix?.Width ?? 0;
    private int SvgHeight => EffectiveBarHeight + (ShowText ? 27 : 10);
    private string WidthString => string.IsNullOrEmpty(Width) ? $"{SvgWidth}px" : Width;
    private string HeightString => string.IsNullOrEmpty(Height) ? $"{SvgHeight}px" : Height;

    protected override void OnParametersSet()
    {
        _bars.Clear();
        _matrix = null;
        ErrorMessage = null;
        if (string.IsNullOrEmpty(Value)) return;
        try
        {
            var format = Type switch
            {
                BarcodeType.Code128 => ZXing.BarcodeFormat.CODE_128,
                BarcodeType.Code39 => ZXing.BarcodeFormat.CODE_39,
                BarcodeType.Code93 => ZXing.BarcodeFormat.CODE_93,
                BarcodeType.Ean8 => ZXing.BarcodeFormat.EAN_8,
                BarcodeType.Ean13 => ZXing.BarcodeFormat.EAN_13,
                BarcodeType.UpcA => ZXing.BarcodeFormat.UPC_A,
                BarcodeType.UpcE => ZXing.BarcodeFormat.UPC_E,
                BarcodeType.Itf => ZXing.BarcodeFormat.ITF,
                BarcodeType.Codabar => ZXing.BarcodeFormat.CODABAR,
                _ => throw new ArgumentException("Unsupported barcode type.")
            };
            _matrix = new ZXing.MultiFormatWriter().encode(Value, format, 0, 1,
                new Dictionary<ZXing.EncodeHintType, object> { [ZXing.EncodeHintType.MARGIN] = 20 });
            for (var x = 0; x < _matrix.Width;)
            {
                if (!_matrix[x, 0]) { x++; continue; }
                var start = x++;
                while (x < _matrix.Width && _matrix[x, 0]) x++;
                _bars.Add(new(start, x - start));
            }
        }
        catch (Exception ex) when (ex is ArgumentException or ZXing.WriterException)
        {
            ErrorMessage = $"Cannot encode {Type} barcode: {ex.Message}";
        }
    }
}
