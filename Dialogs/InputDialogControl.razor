@namespace Fx.ControlKit.Dialogs

@*
    InputDialogControl — prompt dialog for collecting a single text value.
    Usage: call ShowAsync("Enter name:", "New Item") and await the result.
*@

@if (Visible)
{
    <DialogControl Visible="true" Header="@Title" OnClose="Cancel"
                   Width="calc(420px * var(--fx-zoom, 1))" Resizable="false"
                   CssClass="@($"fx-dialog-classic fx-inputdlg {CssClass}")">
        <div class="fx-inputdlg-layout">
            <label class="fx-inputdlg-label" for="@_inputId">@Prompt</label>
            <div class="fx-inputdlg-editor">
                @* DialogControl owns initial focus; a second pass can steal it back after Tab. *@
                <TextBoxControl @key="_inputId" @ref="_input" @bind-Value="InputValue" id="@_inputId"
                                InputType="@InputType" Placeholder="@Placeholder" MaxLength="@MaxLength"
                                Width="100%" CssClass="fx-textbox-classic" AutoFocus="false"
                                TypingBehavior="TextBoxTypingBehavior.ClientBuffered"
                                KeepNativeTab="true" OnKeyDown="HandleKeyDown" />
            </div>
            <div class="fx-inputdlg-actions">
                <ButtonControl CssClass="fx-button-classic" OnClick="Confirm">OK</ButtonControl>
                <ButtonControl CssClass="fx-button-classic" OnClick="Cancel">Cancel</ButtonControl>
            </div>
        </div>
    </DialogControl>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Input";
    [Parameter] public string? Prompt { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string InputValue { get; set; } = "";
    [Parameter] public EventCallback<string?> OnResult { get; set; }
    [Parameter] public string InputType { get; set; } = "text";
    [Parameter] public int MaxLength { get; set; } = 256;
    [Parameter] public string? CssClass { get; set; }

    private TaskCompletionSource<string?>? _tcs;
    private (TaskCompletionSource<string?>? Completion, string? Result)? _pendingResult;
    private TextBoxControl? _input;
    private string _inputId = $"fx-inputdlg-{Guid.NewGuid():N}";
    private bool _confirming;

    public Task<string?> ShowAsync(string prompt, string title = "Input", string defaultValue = "")
    {
        Prompt = prompt;
        Title = title;
        InputValue = defaultValue;
        _inputId = $"fx-inputdlg-{Guid.NewGuid():N}";
        Visible = true;
        var completion = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);
        _tcs = completion;
        StateHasChanged();
        return completion.Task;
    }

    private async Task Confirm()
    {
        if (!Visible || _confirming) return;
        _confirming = true;
        try
        {
            if (_input is not null)
                await _input.FlushClientBufferedValueAsync();
            await CompleteAsync(InputValue);
        }
        finally { _confirming = false; }
    }

    private Task Cancel() => CompleteAsync(null);

    private Task CompleteAsync(string? result)
    {
        if (!Visible) return Task.CompletedTask;
        _pendingResult = (_tcs, result);
        _tcs = null;
        Visible = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A chained prompt must not reopen until the closed dialog has rendered.
        if (Visible || _pendingResult is not { } pending) return;
        _pendingResult = null;
        _input = null;
        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false);
        if (OnResult.HasDelegate)
            await OnResult.InvokeAsync(pending.Result);
        pending.Completion?.TrySetResult(pending.Result);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Confirm();
    }
}
