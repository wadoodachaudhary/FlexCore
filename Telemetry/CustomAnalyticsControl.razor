    private async Task RunDemoCustomDomainGraphAsync()
    {
        var customApi = Services.GetService(typeof(IFlexCustomAnalytics)) as IFlexCustomAnalytics
                        ?? new FlexCustomAnalyticsService(Services.GetService(typeof(IFlexControlLogSink)) as IFlexControlLogSink);

        using (var scope = customApi.BeginScope("Workflow.BulkQuoteApproval", "BusinessGraph", screen: Title, controlType: "ApprovalEngine", controlId: "QuoteBatchApprover"))
        {
            scope.Builder
                 .WithSubKind("MultiLineApproval")
                 .WithMetric(FlexCustomAnalyticsEvents.Metrics.SelectedRows, 4)
                 .WithMetric(FlexCustomAnalyticsEvents.Metrics.UpdatedCells, 4)
                 .WithTag("department", "Purchasing")
                 .AddNode("selection", "QuoteSelection", "4 Selected Quote Lines", 4)
                 .AddNode("rule", "MarginCheck", "Margin Validation Passed", 4)
                 .AddNode("commit", "ApprovedPOs", "4 POs Generated", 4)
                 .AddEdge("selection", "rule", "validates", 4)
                 .AddEdge("rule", "commit", "approves", 4);
            scope.Complete("Approved", "Approved 4 selected quote lines into POs via IFlexCustomAnalytics");
        }

        _sandboxStatus = "Captured Custom Domain Graph: Workflow.BulkQuoteApproval (3 nodes, 2 edges)";
        await RefreshAfterSandboxActionAsync();
    }

    private async Task RefreshAfterSandboxActionAsync()
    {
        if (CustomSnapshot is null)
            RebuildStandaloneSnapshot();
        if (OnCapturesMutated.HasDelegate)
            await OnCapturesMutated.InvokeAsync();
        StateHasChanged();
    }

    public (string Suffix, string CsvContent) BuildCurrentCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("EventName,SubKind,Category,CaptureCount,TotalSelectedRows,TotalEffectMetric,AvgPerCapture,MaxSingleCapture,ChainedCount,UniqueUsers,UniqueScreens,LastCaptured");
        foreach (var r in FilteredCountRows)
        {
            sb.AppendLine($"{Csv(r.EventName)},{Csv(r.SubKind)},{Csv(r.Category)},{r.CaptureCount},{r.TotalSelectedRows.ToString("0.#", CultureInfo.InvariantCulture)},{r.TotalUpdatedOrMatched.ToString("0.#", CultureInfo.InvariantCulture)},{r.AvgPrimaryMetric.ToString("0.0", CultureInfo.InvariantCulture)},{r.MaxPrimaryMetric.ToString("0.#", CultureInfo.InvariantCulture)},{r.ChainedCount},{r.UniqueUsers},{r.UniqueScreens},{Csv(r.LastCapturedLocal.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture))}");
        }
        return ("custom-capture-counts", sb.ToString());
    }

    public async Task ExportCsvAsync(string? filePrefix = null)
    {
        var effectivePrefix = string.IsNullOrWhiteSpace(filePrefix) ? ExportFilePrefix : filePrefix;
        var (suffix, csv) = BuildCurrentCsv();
        var fileName = $"{effectivePrefix}-{suffix}-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv)).ToArray();

        if (Services.GetService(typeof(ITelemetryExportHandler)) is ITelemetryExportHandler handler)
        {
            await handler.ExportBytesAsync(bytes, fileName, "text/csv");
            return;
        }

        _browserInterop ??= new BrowserInterop(JSRuntime);
        await _browserInterop.InvokeAsync<object?>("download", null, new { bytes, name = fileName, type = "text/csv" });
    }

    private ITelemetryDataSource ResolveDataSource()
    {
        if (Services.GetService(typeof(ITelemetryDataSource)) is ITelemetryDataSource registered)
            return registered;

        _ownedFallbackSource ??= new DefaultFlexTelemetryDataSource(
            Services.GetService(typeof(IFlexControlLogSink)) as IFlexControlLogSink,
            Services.GetService(typeof(ITelemetryCatalogProvider)) as ITelemetryCatalogProvider);
        return _ownedFallbackSource;
    }

    private bool MatchesEventFilter(string eventName)
    {
        if (_eventFilter == "All") return true;
        if (_eventFilter == "Other")
        {
            return !string.Equals(eventName, FlexCustomAnalyticsEvents.GridSort, StringComparison.OrdinalIgnoreCase)
                   && !string.Equals(eventName, FlexCustomAnalyticsEvents.GridFind, StringComparison.OrdinalIgnoreCase)
                   && !string.Equals(eventName, FlexCustomAnalyticsEvents.GridDrag, StringComparison.OrdinalIgnoreCase)
                   && !string.Equals(eventName, FlexCustomAnalyticsEvents.GridMultiSelectEdit, StringComparison.OrdinalIgnoreCase);
        }
        return string.Equals(eventName, _eventFilter, StringComparison.OrdinalIgnoreCase);
    }

    private string ResolveBarColor(string eventName)
    {
        bool vb = EffectiveTheme == TelemetryTheme.VBClassic;
        if (string.Equals(eventName, FlexCustomAnalyticsEvents.GridSort, StringComparison.OrdinalIgnoreCase))
            return vb ? "#0a246a" : "#38bdf8";
        if (string.Equals(eventName, FlexCustomAnalyticsEvents.GridFind, StringComparison.OrdinalIgnoreCase))
            return vb ? "#3a6ea5" : "#60a5fa";
        if (string.Equals(eventName, FlexCustomAnalyticsEvents.GridDrag, StringComparison.OrdinalIgnoreCase))
            return vb ? "#8b5a00" : "#f59e0b";
        if (string.Equals(eventName, FlexCustomAnalyticsEvents.GridMultiSelectEdit, StringComparison.OrdinalIgnoreCase))
            return vb ? "#2e7d32" : "#10b981";
        return vb ? "#6a1b9a" : "#a855f7";
    }

    private static string PillCss(bool active) => active ? "fx-tel-pill fx-tel-pill-active" : "fx-tel-pill";

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    public async ValueTask DisposeAsync()
    {
        _ownedFallbackSource?.Dispose();
        if (_browserInterop is not null)
            await _browserInterop.DisposeAsync();
    }
