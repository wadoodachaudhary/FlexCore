@code {
    public sealed record FilterOption(string Value, string Text);
    public sealed record RefreshOption(int Seconds, string Label);
    public sealed record TimePreset(string Key, string Label, int DaysBack, int? MinutesBack);
    public sealed record ThemeOption(TelemetryTheme Value, string Text);

    public const int BuiltInTabCount = 5;
    public const int ProductAnalyticsTabCount = 6;

    private static readonly List<ThemeOption> ThemeOptions = new()
