    [Parameter] public EventCallback<string> OnSearchTextChanged { get; set; }

    /// <summary>Notifies the host when the active tab index changes.</summary>
    [Parameter] public EventCallback<int> OnSelectedTabChanged { get; set; }

    /// <summary>Optional CSV builder invoked when Export CSV is clicked on a host <see cref="AdditionalTabs"/> tab.</summary>
    [Parameter] public Func<int, (string Suffix, string CsvContent)?>? OnCustomTabExportCsv { get; set; }

    private ControlActivityControl? _controlActivity;
    private LogControl? _logControl;
    private SqlTelemetryControl? _sqlControl;
    private FeatureAdoptionControl? _featureAdoption;
    private FunnelAnalyticsControl? _funnelAnalytics;
    private UserJourneyControl? _userJourneys;
    private RetentionCohortControl? _retentionCohorts;
    private FrictionInsightsControl? _frictionInsights;
    private TelemetryPivotControl? _telemetryPivot;
    private BrowserInterop? _browserInterop;
    private DefaultFlexTelemetryDataSource? _ownedFallbackSource;
    private CancellationTokenSource? _autoRefreshCts;

    private TelemetryTheme _internalTheme = TelemetryTheme.VBClassic;
    private bool _themeInitialized;
    private TelemetryWorkspaceMode _internalWorkspaceMode = TelemetryWorkspaceMode.Observability;
    private bool _workspaceModeInitialized;
    private int _selectedTab;
    private int _refreshVersion;

    private bool _canCrossTenant;
    private string _defaultTenant = string.Empty;
    private string _selectedTenant = string.Empty;
    private string _tenantCaption = "Database";
    private List<FilterOption> _tenantOptions = new();
    private List<FilterOption> _moduleOptions = new() { new("All", "All Modules") };
    private List<FilterOption> _userOptions = new() { new("All", "All Users") };

    private string _selectedTimePresetKey = "30d";
    private int _selectedDays = 30;
    private int? _selectedMinutesBack;
    private int _autoRefreshSeconds;
    private string _selectedModule = "All";
    private string _selectedUser = "All";
    private string _searchText = string.Empty;

    private string _volumeChartStyle = "Bars";
    private string _screenSubMode = "Screens";
    private string _usageStatusFilter = "All";

    private FlexTelemetrySnapshot? _snapshot;
    private FlexProductAnalyticsSnapshot? _productSnapshot;
    private readonly List<ChartSeries> _timeSeriesHistogramSeries = new();
    private readonly List<ChartSeries> _controlTypeDonutSeries = new();
    private readonly List<ChartSeries> _screenHourHeatmapSeries = new();
    private readonly List<ChartSeries> _screenParetoSeries = new();
    private readonly List<ChartControl.ChartBar> _topScreensBars = new();
    private readonly List<ChartControl.ChartBar> _topControlsBars = new();
    private readonly List<string> _zeroUseModulesSummary = new();

    private FlexControlLocation ChildLocation => GetOrCreateChildLocation("TelemetryControl", () => Title, isScreenRoot: IsScreenRoot);
    protected override string? ResolveControlIdentifier() => Title;

    public TelemetryTheme ActiveTheme => Theme ?? _internalTheme;
    public TelemetryWorkspaceMode ActiveWorkspaceMode =>
        EnableProductAnalytics ? (WorkspaceMode ?? _internalWorkspaceMode) : TelemetryWorkspaceMode.Observability;
    public FlexTelemetrySnapshot? CurrentSnapshot => _snapshot;
    public FlexProductAnalyticsSnapshot? CurrentProductSnapshot => _productSnapshot;
    public int SelectedTabIndex => _selectedTab;
    public string SearchQuery => _searchText;
    public string EffectiveTenant => _canCrossTenant ? _selectedTenant : _defaultTenant;
    private string TenantCaption => _tenantCaption;

    private string EffectiveTenantLabel =>
        string.Equals(_selectedTenant, "*", StringComparison.Ordinal)
            ? $"All {_tenantCaption}s"
            : (string.IsNullOrWhiteSpace(_selectedTenant) ? _defaultTenant : _selectedTenant);

    private string ThemeClass => ActiveTheme switch
    {
        TelemetryTheme.GrafanaDark => "fx-tel-theme-grafana",
        TelemetryTheme.ModernLight => "fx-tel-theme-light",
        _ => "fx-tel-theme-vb"
    };

    private List<TabStripItem> TabItems
    {
        get
        {
            if (ActiveWorkspaceMode == TelemetryWorkspaceMode.ProductAnalytics)
            {
                return new List<TabStripItem>(ProductAnalyticsTabCount)
                {
                    new TabStripItem { Text = "Feature Adoption & Stickiness" },
                    new TabStripItem { Text = "Conversion Funnels" },
                    new TabStripItem { Text = "User Journeys & Flows" },
                    new TabStripItem { Text = "Retention & Cohorts" },
                    new TabStripItem { Text = "UX Friction & Replay" },
                    new TabStripItem { Text = "Slice & Dice Pivot" }
                };
            }

            var overviewLabel = ActiveTheme == TelemetryTheme.GrafanaDark ? "Grafana Overview" : "Telemetry Overview";
            var logLabel = ActiveTheme == TelemetryTheme.GrafanaDark ? "Loki / CloudWatch Logs" : "Log Explorer";
            var items = new List<TabStripItem>(BuiltInTabCount + (AdditionalTabs?.Count ?? 0))
            {
                new TabStripItem { Text = overviewLabel },
                new TabStripItem { Text = "Control Telemetry & Grids" },
                new TabStripItem { Text = "Screens, Tasks & Zero-Use" },
                new TabStripItem { Text = logLabel },
                new TabStripItem { Text = "SQL Queries" }
            };
            if (AdditionalTabs is not null)
            {
                foreach (var custom in AdditionalTabs)
                    items.Add(new TabStripItem { Text = custom.Title });
            }
            return items;
        }
    }

    private double UiScreenCoveragePercent =>
        _snapshot is null || _snapshot.CatalogScreenCount <= 0
            ? 0
            : Math.Round(100.0 * Math.Min(_snapshot.UniqueScreensVisited, _snapshot.CatalogScreenCount) / _snapshot.CatalogScreenCount, 1);

    private int ActiveControlCount =>
        _snapshot?.RegisteredControlRows.Count(r => r.ActionCount > 0) ?? 0;

    private double ActiveRegisteredControlsPercent =>
        _snapshot is null || _snapshot.RegisteredControlCount <= 0
            ? 0
            : Math.Round(100.0 * ActiveControlCount / _snapshot.RegisteredControlCount, 1);

    private List<FlexTelemetryScreenRow> FilteredScreenRows =>
        (_snapshot?.ScreenRows ?? Array.Empty<FlexTelemetryScreenRow>())
            .Where(r => MatchesUsageStatus(r.UsageStatus))
            .ToList();

    private List<FlexTelemetryTaskRow> FilteredTaskRows =>
        (_snapshot?.TaskAndReportRows ?? Array.Empty<FlexTelemetryTaskRow>())
            .Where(r => MatchesUsageStatus(r.UsageStatus))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        RegisterControlPresence();
        if (!_themeInitialized)
        {
            _internalTheme = DefaultTheme;
            _themeInitialized = true;
        }

        if (!_workspaceModeInitialized)
        {
            _internalWorkspaceMode = DefaultWorkspaceMode;
            _workspaceModeInitialized = true;
        }

        if (Services.GetService(typeof(ITelemetryTenantProvider)) is ITelemetryTenantProvider tenantProvider)
        {
            _tenantCaption = tenantProvider.TenantLabel;
            _defaultTenant = await tenantProvider.GetDefaultTenantAsync();
            _selectedTenant = _defaultTenant;
            _canCrossTenant = await tenantProvider.CanSelectAcrossTenantsAsync();

            if (_canCrossTenant)
            {
                var tenants = await tenantProvider.GetAvailableTenantsAsync();
                _tenantOptions = new List<FilterOption> { new("*", $"All {_tenantCaption}s (Logs)") };
                foreach (var t in tenants)
                    _tenantOptions.Add(new FilterOption(t, t));
                if (!string.IsNullOrWhiteSpace(_defaultTenant)
                    && !_tenantOptions.Any(o => string.Equals(o.Value, _defaultTenant, StringComparison.OrdinalIgnoreCase)))
                {
                    _tenantOptions.Add(new FilterOption(_defaultTenant, _defaultTenant));
                }
            }
        }

        RefreshSnapshot();
    }

    public async Task RefreshAsync()
    {
        var ds = ResolveDataSource();
        try { await ds.FlushAsync(); } catch { }
        _refreshVersion++;
        RefreshSnapshot();
        _sqlControl?.ReloadQueries();
        RecordControlAction("Refreshed", EffectiveTenantLabel);
    }

    public void SelectWorkspaceMode(TelemetryWorkspaceMode mode)
    {
        _internalWorkspaceMode = mode;
        _selectedTab = 0;
        RefreshProductSnapshotIfNeeded();
        StateHasChanged();
    }

    private async Task SwitchWorkspaceModeAsync(TelemetryWorkspaceMode nextMode)
    {
        if (ActiveWorkspaceMode == nextMode) return;
        _internalWorkspaceMode = nextMode;
        _selectedTab = 0;
        RefreshProductSnapshotIfNeeded();
        RecordControlAction("WorkspaceModeChanged", nextMode.ToString());
        if (WorkspaceModeChanged.HasDelegate)
            await WorkspaceModeChanged.InvokeAsync(nextMode);
    }

    public void SelectTab(int index)
    {
        var max = ActiveWorkspaceMode == TelemetryWorkspaceMode.ProductAnalytics
            ? ProductAnalyticsTabCount - 1
            : BuiltInTabCount + (AdditionalTabs?.Count ?? 0) - 1;
        _selectedTab = Math.Clamp(index, 0, Math.Max(0, max));
        StateHasChanged();
    }

    public void SelectCustomTab(string key)
    {
        if (AdditionalTabs is null) return;
        for (int i = 0; i < AdditionalTabs.Count; i++)
        {
            if (string.Equals(AdditionalTabs[i].Key, key, StringComparison.OrdinalIgnoreCase))
            {
                _internalWorkspaceMode = TelemetryWorkspaceMode.Observability;
                _selectedTab = BuiltInTabCount + i;
                StateHasChanged();
                return;
            }
        }
    }

    private void RefreshSnapshot()
    {
        var ds = ResolveDataSource();
        var queryFilter = new FlexTelemetryQueryFilter
        {
            Tenant = EffectiveTenant,
            DaysBack = _selectedDays,
            MinutesBack = _selectedMinutesBack,
            UserId = _selectedUser,
            ModuleFilter = _selectedModule,
            SearchText = _searchText
        };
        _snapshot = ds.BuildSnapshot(queryFilter, _defaultTenant);

        _moduleOptions = new List<FilterOption> { new("All", "All Modules") };
        foreach (var mod in _snapshot.AvailableModules)
            _moduleOptions.Add(new FilterOption(mod, mod));

        _userOptions = new List<FilterOption> { new("All", "All Users") };
        foreach (var usr in _snapshot.AvailableUsers)
            _userOptions.Add(new FilterOption(usr, usr));

        RebuildCharts();
        if (EnableProductAnalytics)
            BuildProductSnapshotInternal(ds, queryFilter);
    }

    private void RefreshProductSnapshotIfNeeded()
    {
        if (!EnableProductAnalytics || _productSnapshot is not null)
            return;

        var ds = ResolveDataSource();
        BuildProductSnapshotInternal(ds, new FlexTelemetryQueryFilter
        {
            Tenant = EffectiveTenant,
            DaysBack = _selectedDays,
            MinutesBack = _selectedMinutesBack,
            UserId = _selectedUser,
            ModuleFilter = _selectedModule,
            SearchText = _searchText
        });
    }

    private void BuildProductSnapshotInternal(ITelemetryDataSource ds, FlexTelemetryQueryFilter queryFilter)
    {
        var span = _selectedMinutesBack.HasValue
            ? TimeSpan.FromMinutes(_selectedMinutesBack.Value * 2)
            : TimeSpan.FromDays(Math.Max(30, _selectedDays * 2));
        var sinceUtc = DateTime.UtcNow - span;

        var rawEvents = ds.QueryEvents(sinceUtc, EffectiveTenant, _defaultTenant, maxCount: 50_000);
        var sqlProvider = Services.GetService(typeof(IFlexSqlTelemetryProvider)) as IFlexSqlTelemetryProvider;
        var sqlEntries = sqlProvider?.GetRecentQueries(
            tenant: EffectiveTenant,
            excludeBackgroundPolls: true,
            maxCount: 2_000) ?? Array.Empty<FlexSqlTelemetryEntry>();
        var catalog = Services.GetService(typeof(ITelemetryCatalogProvider)) as ITelemetryCatalogProvider;
        var workflows = Services.GetService(typeof(ITelemetryWorkflowProvider)) as ITelemetryWorkflowProvider;

        _productSnapshot = FlexProductAnalyticsEngine.BuildProductSnapshot(
            rawEvents,
            sqlEntries,
            catalog,
            workflows,
            queryFilter,
            _defaultTenant);
    }

    private void RebuildCharts()
    {
        _timeSeriesHistogramSeries.Clear();
        _controlTypeDonutSeries.Clear();
        _screenHourHeatmapSeries.Clear();
        _screenParetoSeries.Clear();
        _topScreensBars.Clear();
        _topControlsBars.Clear();
        _zeroUseModulesSummary.Clear();

        if (_snapshot is null)
            return;

        var isVb = ActiveTheme == TelemetryTheme.VBClassic;
        var palette = isVb ? VbPalette : GrafanaPalette;
        var chartType = _volumeChartStyle == "Area" ? ChartType.StackedArea : ChartType.StackedBar;

        var clicksSeries = new ChartSeries("Control Clicks", chartType, color: isVb ? "#0a246a" : "#10b981");
        var gridsSeries = new ChartSeries("Grid Ops", chartType, color: isVb ? "#3a6ea5" : "#a855f7");
        var inputsSeries = new ChartSeries("Input Commits", chartType, color: isVb ? "#2e7d32" : "#f59e0b");
        var opensSeries = new ChartSeries("Screen Opens", chartType, color: isVb ? "#8b5a00" : "#38bdf8");
        var tasksSeries = new ChartSeries("Tasks & Reports", chartType, color: isVb ? "#6a1b9a" : "#3b82f6");

        foreach (var pt in _snapshot.TimeSeriesBuckets)
        {
            clicksSeries.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.ButtonClicks));
            gridsSeries.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.GridOperations));
            inputsSeries.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.ControlChanges));
            opensSeries.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.ScreenOpens));
            tasksSeries.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.TasksAndReports));
        }

        _timeSeriesHistogramSeries.Add(clicksSeries);
        _timeSeriesHistogramSeries.Add(gridsSeries);
        _timeSeriesHistogramSeries.Add(inputsSeries);
        _timeSeriesHistogramSeries.Add(opensSeries);
        _timeSeriesHistogramSeries.Add(tasksSeries);

        var ctlDonut = new ChartSeries("Control Types", ChartType.Donut);
        int ci = 0;
        foreach (var ct in _snapshot.ControlTypeRows.Take(8))
            ctlDonut.DataPoints.Add(new ChartDataPoint(ct.ControlType, ct.EventCount, palette[ci++ % palette.Length]));
        if (ctlDonut.DataPoints.Count > 0)
            _controlTypeDonutSeries.Add(ctlDonut);

        foreach (var row in _snapshot.ScreenHourHeatmap)
        {
            var heatSeries = new ChartSeries(Shorten(row.Screen, 14), ChartType.Heatmap);
            for (int b = 0; b < HourBlockLabels.Length && b < row.BlockCounts.Length; b++)
                heatSeries.DataPoints.Add(new ChartDataPoint(HourBlockLabels[b], row.BlockCounts[b]));
            _screenHourHeatmapSeries.Add(heatSeries);
        }

        var pareto = new ChartSeries("Screen Activity", ChartType.Pareto, color: isVb ? "#0a246a" : "#38bdf8");
        foreach (var s in _snapshot.ScreenRows
                     .Select(r => new { r.ScreenTitle, Score = r.OpenCount + r.ControlActionsOnScreen + r.GridOpsOnScreen })
                     .Where(x => x.Score > 0)
                     .OrderByDescending(x => x.Score)
                     .Take(8))
        {
            pareto.DataPoints.Add(new ChartDataPoint(Shorten(s.ScreenTitle, 14), s.Score));
        }
        if (pareto.DataPoints.Count > 0)
            _screenParetoSeries.Add(pareto);

        foreach (var s in _snapshot.ScreenRows.Where(r => r.OpenCount > 0).Take(8))
            _topScreensBars.Add(new ChartControl.ChartBar(s.ScreenTitle, s.OpenCount, isVb ? "#0a246a" : "#38bdf8"));

        foreach (var c in _snapshot.ControlRows.Take(8))
        {
            var lbl = Shorten($"{c.Screen}: {c.Control} ({c.Action})", 44);
            _topControlsBars.Add(new ChartControl.ChartBar(lbl, c.ActionCount, isVb ? "#2e7d32" : "#10b981"));
        }

        _zeroUseModulesSummary.AddRange(
            _snapshot.ScreenRows
                .Where(r => r.OpenCount == 0 && r.ControlActionsOnScreen == 0 && r.GridOpsOnScreen == 0)
                .GroupBy(r => r.Module)
                .Select(g => $"{g.Key}: {g.Count()} unused")
                .OrderByDescending(s => s));
    }

    private ITelemetryDataSource ResolveDataSource()
    {
        if (Services.GetService(typeof(ITelemetryDataSource)) is ITelemetryDataSource registered)
            return registered;

        _ownedFallbackSource ??= new DefaultFlexTelemetryDataSource(
            Services.GetService(typeof(IFlexControlLogSink)) as IFlexControlLogSink,
            Services.GetService(typeof(ITelemetryCatalogProvider)) as ITelemetryCatalogProvider);
        return _ownedFallbackSource;
    }

    private async Task OnThemeSelectedAsync(TelemetryTheme nextTheme)
    {
        _internalTheme = nextTheme;
        RebuildCharts();
        RecordControlAction("ThemeChanged", nextTheme.ToString());
        if (ThemeChanged.HasDelegate)
            await ThemeChanged.InvokeAsync(nextTheme);
    }

    private void SetVolumeChartStyle(string style)
    {
        _volumeChartStyle = style;
        RebuildCharts();
    }

    private void SelectTimePreset(TimePreset preset)
    {
        _selectedTimePresetKey = preset.Key;
        _selectedDays = preset.DaysBack;
        _selectedMinutesBack = preset.MinutesBack;
        RefreshSnapshot();
    }

    private async Task OnTenantSelectionChangedAsync(string? nextTenant)
    {
        _selectedTenant = nextTenant ?? _defaultTenant;
        RefreshSnapshot();
        if (OnTenantChanged.HasDelegate)
            await OnTenantChanged.InvokeAsync(_selectedTenant);
    }

    private void OnModuleChanged(string? mod)
    {
        _selectedModule = mod ?? "All";
        RefreshSnapshot();
    }

    private void OnUserChanged(string? user)
    {
        _selectedUser = user ?? "All";
        RefreshSnapshot();
    }

    private async Task OnSearchChangedAsync(string? text)
    {
        _searchText = text ?? string.Empty;
        RefreshSnapshot();
        if (OnSearchTextChanged.HasDelegate)
            await OnSearchTextChanged.InvokeAsync(_searchText);
    }

    private async Task OnTabChangedAsync(int idx)
    {
        _selectedTab = idx;
        if (OnSelectedTabChanged.HasDelegate)
            await OnSelectedTabChanged.InvokeAsync(idx);
    }

    private void OnAutoRefreshChanged(int seconds)
    {
        _autoRefreshSeconds = seconds;
        StopAutoRefreshTimer();
        if (seconds > 0)
        {
            var cts = new CancellationTokenSource();
            _autoRefreshCts = cts;
            _ = RunAutoRefreshLoopAsync(seconds, cts.Token);
        }
    }

    private async Task RunAutoRefreshLoopAsync(int seconds, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Clamp(seconds, 3, 300)));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(() =>
                {
                    if (!Busy)
                    {
                        _refreshVersion++;
                        RefreshSnapshot();
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopAutoRefreshTimer()
    {
        if (_autoRefreshCts is not null)
        {
            try { _autoRefreshCts.Cancel(); } catch { }
            _autoRefreshCts.Dispose();
            _autoRefreshCts = null;
        }
    }

    private async Task ExportStructuredLogsAsync(bool clefFormat)
    {
        if (_logControl is not null)
        {
            await _logControl.ExportStructuredAsync(clefFormat, ExportFilePrefix);
            return;
        }

        var ds = ResolveDataSource();
        try { await ds.FlushAsync(); } catch { }
        var rows = _snapshot?.RecentEvents ?? Array.Empty<FlexTelemetryEventRow>();
        var sb = new StringBuilder(rows.Count * 240);
        foreach (var r in rows)
            sb.AppendLine(clefFormat ? r.SerilogClefJson : r.CloudWatchJson);

        var ext = clefFormat ? "clef" : "ndjson";
        var label = clefFormat ? "serilog" : "cloudwatch";
        var fileName = $"{ExportFilePrefix}-{label}-logs-{DateTime.Now:yyyyMMdd-HHmm}.{ext}";
        await DownloadBytesAsync(Encoding.UTF8.GetBytes(sb.ToString()), fileName, "application/x-ndjson");
        RecordControlAction("ExportedStructuredLogs", label, $"rows={rows.Count}");
    }

    private async Task ExportCurrentViewCsvAsync()
    {
        if (ActiveWorkspaceMode == TelemetryWorkspaceMode.ProductAnalytics)
        {
            (string suffixPa, string csvPa) = _selectedTab switch
            {
                0 when _featureAdoption is not null => _featureAdoption.BuildCurrentCsv(),
                1 when _funnelAnalytics is not null => _funnelAnalytics.BuildCurrentCsv(),
                2 when _userJourneys is not null => _userJourneys.BuildCurrentCsv(),
                3 when _retentionCohorts is not null => _retentionCohorts.BuildCurrentCsv(),
                4 when _frictionInsights is not null => _frictionInsights.BuildCurrentCsv(),
                5 when _telemetryPivot is not null => _telemetryPivot.BuildCurrentCsv(),
                _ => BuildScreensOrTasksCsv()
            };
            var paFile = $"{ExportFilePrefix}-{suffixPa}-{DateTime.Now:yyyyMMdd-HHmm}.csv";
            var paBytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csvPa)).ToArray();
            await DownloadBytesAsync(paBytes, paFile, "text/csv");
            RecordControlAction("ExportedCsv", suffixPa);
            return;
        }

        if (_selectedTab == 3 && _logControl is not null)
        {
            await _logControl.ExportCsvAsync(ExportFilePrefix);
            return;
        }

        string suffix;
        string csvBody;

        if (_selectedTab >= BuiltInTabCount && OnCustomTabExportCsv is not null)
        {
            var customExport = OnCustomTabExportCsv(_selectedTab - BuiltInTabCount);
            if (customExport.HasValue)
            {
                suffix = customExport.Value.Suffix;
                csvBody = customExport.Value.CsvContent;
            }
            else
            {
                (suffix, csvBody) = BuildScreensOrTasksCsv();
            }
        }
        else if (_selectedTab == 1 && _controlActivity is not null)
        {
            (suffix, csvBody) = _controlActivity.BuildCurrentCsv();
        }
        else if (_selectedTab == 4 && _sqlControl is not null)
        {
            suffix = "sql-queries";
            csvBody = _sqlControl.BuildCsv();
        }
        else
        {
            (suffix, csvBody) = BuildScreensOrTasksCsv();
        }

        var fileName = $"{ExportFilePrefix}-{suffix}-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csvBody)).ToArray();
        await DownloadBytesAsync(bytes, fileName, "text/csv");
        RecordControlAction("ExportedCsv", suffix);
    }

    private (string Suffix, string CsvContent) BuildScreensOrTasksCsv()
    {
        var sb = new StringBuilder();
        if (_selectedTab == 2 && _screenSubMode == "TasksReports")
        {
            sb.AppendLine("Type,Name,Module,Status,Executions,Users,LastExecuted");
            foreach (var r in FilteredTaskRows)
                sb.AppendLine($"{Csv(r.KindLabel)},{Csv(r.Name)},{Csv(r.Module)},{Csv(r.UsageStatus)},{r.RunCount},{r.UniqueUsers},{Csv(r.LastRunLocal?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture))}");
            return ("tasks-reports", sb.ToString());
        }

        sb.AppendLine("Screen,Module,Status,Opens,TabFocuses,ControlActions,GridOps,Users,TotalDwellMinutes,AvgDwellSeconds,LastUsed,Route");
        foreach (var r in FilteredScreenRows)
            sb.AppendLine($"{Csv(r.ScreenTitle)},{Csv(r.Module)},{Csv(r.UsageStatus)},{r.OpenCount},{r.FocusCount},{r.ControlActionsOnScreen},{r.GridOpsOnScreen},{r.UniqueUsers},{r.TotalDwellMinutes.ToString("0.0", CultureInfo.InvariantCulture)},{r.AvgDwellSeconds.ToString("0.0", CultureInfo.InvariantCulture)},{Csv(r.LastUsedLocal?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture))},{Csv(r.Route)}");
        return ("screen-usage", sb.ToString());
    }

    private async Task DownloadBytesAsync(byte[] bytes, string fileName, string contentType)
    {
        if (Services.GetService(typeof(ITelemetryExportHandler)) is ITelemetryExportHandler handler)
        {
            await handler.ExportBytesAsync(bytes, fileName, contentType);
            return;
        }

        _browserInterop ??= new BrowserInterop(JSRuntime);
        await _browserInterop.InvokeAsync<object?>("download", null, new { bytes, name = fileName, type = contentType });
    }

    private bool MatchesUsageStatus(string status) => _usageStatusFilter switch
    {
        "Unused" => status.StartsWith("Unused", StringComparison.OrdinalIgnoreCase),
        "Rare" => status.StartsWith("Rarely", StringComparison.OrdinalIgnoreCase),
        "Active" => status is "Active" or "Moderate",
        _ => true
    };

    private static string PillCss(bool active) => active ? "fx-tel-pill fx-tel-pill-active" : "fx-tel-pill";

    private static BadgeVariant StatusBadgeVariant(string status)
    {
        if (status.StartsWith("Unused", StringComparison.OrdinalIgnoreCase)) return BadgeVariant.Danger;
        if (status.StartsWith("Rarely", StringComparison.OrdinalIgnoreCase)) return BadgeVariant.Warning;
        if (status.Equals("Moderate", StringComparison.OrdinalIgnoreCase)) return BadgeVariant.Info;
        return BadgeVariant.Success;
    }

    private static string Shorten(string text, int max) =>
        text.Length > max ? text[..(max - 3)] + "..." : text;

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    public async ValueTask DisposeAsync()
    {
        StopAutoRefreshTimer();
        _ownedFallbackSource?.Dispose();
        if (_browserInterop is not null)
            await _browserInterop.DisposeAsync();
    }
}
