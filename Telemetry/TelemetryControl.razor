        new("1h", "1h", 1, 60),
        new("6h", "6h", 1, 360),
        new("24h", "24h", 1, 1440),
        new("7d", "7d", 7, null),
        new("30d", "30d", 30, null),
        new("90d", "90d", 90, null),
        new("365d", "365d", 365, null)
    };

    private static readonly List<RefreshOption> RefreshOptions = new()
    {
        new(0, "Off"),
        new(5, "5s Live"),
        new(15, "15s Live"),
        new(30, "30s Live")
    };

    private static readonly string[] HourBlockLabels =
    {
        "00h", "03h", "06h", "09h", "12h", "15h", "18h", "21h"
    };

    private static readonly string[] GrafanaPalette =
    {
        "#38bdf8", "#10b981", "#a855f7", "#f59e0b", "#f43f5e", "#3b82f6", "#14b8a6", "#eab308"
    };

    private static readonly string[] VbPalette =
    {
        "#0a246a", "#3a6ea5", "#2e7d32", "#8b5a00", "#8b0000", "#4b0082", "#00695c", "#5d4037"
    };

    private static readonly IReadOnlyList<GaugeRange> GaugeRanges = new[]
    {
        new GaugeRange(0, 35, "#dc2626", "Low"),
        new GaugeRange(35, 70, "#d97706", "Moderate"),
        new GaugeRange(70, 100, "#16a34a", "Healthy")
    };

    /// <summary>Logical screen/control title used in FlexKit hierarchical control locations.</summary>
    [Parameter] public string Title { get; set; } = "TelemetryStudio";

    /// <summary>When true, marks this TelemetryControl as a screen root in FlexControlLocation hierarchy.</summary>
    [Parameter] public bool IsScreenRoot { get; set; }

    /// <summary>Whether to render the top toolbar and global filter strip.</summary>
    [Parameter] public bool ShowChrome { get; set; } = true;

    /// <summary>
    /// Default visual look and feel when <see cref="Theme"/> is not bound.
    /// Defaults to <see cref="TelemetryTheme.VBClassic"/> (VB6 / Windows Classic desktop style),
    /// with <see cref="TelemetryTheme.GrafanaDark"/> and <see cref="TelemetryTheme.ModernLight"/> selectable.
    /// </summary>
    [Parameter] public TelemetryTheme DefaultTheme { get; set; } = TelemetryTheme.VBClassic;

    /// <summary>Optional two-way bound theme override.</summary>
