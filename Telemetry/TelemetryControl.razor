    [Parameter] public RenderFragment? ToolbarActions { get; set; }

    /// <summary>Optional host-supplied tabs appended after the built-in FlexKit telemetry tabs.</summary>
    [Parameter] public IReadOnlyList<TelemetryCustomTab>? AdditionalTabs { get; set; }

    /// <summary>Optional 6th KPI card shown on the Overview tab.</summary>
    [Parameter] public TelemetryCustomKpiCard? CustomKpiCard { get; set; }

    /// <summary>Optional custom subtitle on the Active Users KPI card.</summary>
    [Parameter] public string? UsersKpiSubText { get; set; }

    /// <summary>Optional 2nd gauge card shown alongside UI Screen Coverage on the Overview tab.</summary>
    [Parameter] public TelemetrySecondaryGauge? SecondaryGauge { get; set; }

    /// <summary>Optional bulleted insights rendered in the Overview findings card.</summary>
    [Parameter] public IReadOnlyList<string>? AdditionalFindings { get; set; }

    /// <summary>Optional fallback content inside the Overview findings card when <see cref="AdditionalFindings"/> is empty.</summary>
    [Parameter] public RenderFragment? OverviewEmptyFindingsContent { get; set; }

