@* TelemetryControl — Generalized FlexKit Telemetry, Control Hierarchy, SQL & Log Studio.
   Application-agnostic (like ReportWriterControl): every host integration point is an optional
   interface (ITelemetryDataSource, ITelemetryCatalogProvider, ITelemetryTenantProvider,
   IFlexSqlTelemetryProvider, ITelemetryExportHandler) with built-in defaults over FlexKit's
   server-side FlexControlLogStore.
   Default Look & Feel: VB Classic (TelemetryTheme.VBClassic), with Grafana Dark
   (TelemetryTheme.GrafanaDark) and Modern Light (TelemetryTheme.ModernLight) selectable as options. *@

@namespace Fx.ControlKit.Telemetry
@inherits Fx.ControlKit.FlexKitControlBase
@implements IAsyncDisposable

@using System.Globalization
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Charts
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Logging
@using Microsoft.JSInterop

@inject IServiceProvider Services
@inject IJSRuntime JSRuntime

<CascadingValue Value="@ChildLocation" IsFixed="true">
    <div class="fx-tel-shell @ThemeClass">
        @if (ShowChrome)
        {
            <ToolbarControl CssClass="fx-tel-toolbar" ShowCaptions="true" ShowCaptionsToggle="false" Tag="fx-tel-main-toolbar">
                <ChildContent>
                    <ToolbarButtonControl Label="Refresh Telemetry"
                                          Title="Flush pending server-side FlexKit control logs and recalculate telemetry views"
                                          Tag="fx-tel-refresh"
                                          OnClick="RefreshAsync"
                                          Disabled="@Busy" />

                    @if (ToolbarActions is not null)
                    {
                        @ToolbarActions
                    }

                    <ToolbarButtonControl Label="Export CSV"
                                          Title="Export the active telemetry view to CSV"
                                          Tag="fx-tel-export-csv"
                                          OnClick="ExportCurrentViewCsvAsync" />
                    <ToolbarButtonControl Label="Export CloudWatch NDJSON"
                                          Title="Export structured AWS CloudWatch Logs Insights / Grafana Loki NDJSON rows"
                                          Tag="fx-tel-export-cloudwatch"
                                          OnClick="() => ExportStructuredLogsAsync(clefFormat: false)" />
                    <ToolbarButtonControl Label="Export Serilog CLEF"
                                          Title="Export structured Serilog Compact Log Event Format (.clef) rows"
                                          Tag="fx-tel-export-clef"
                                          OnClick="() => ExportStructuredLogsAsync(clefFormat: true)" />
                </ChildContent>
                <TrailingContent>
                    <div class="fx-tel-toolbar-trailing">
                        <div class="fx-tel-style-picker">
                            <span class="fx-tel-filter-label">Look &amp; Feel</span>
                            <DropDownListControl TValue="TelemetryTheme" TItem="ThemeOption"
                                                 Tag="fx-tel-theme-selector"
                                                 DataSource="@ThemeOptions"
                                                 Value="@ActiveTheme"
                                                 ValueChanged="OnThemeSelectedAsync"
                                                 ValueFieldName="@nameof(ThemeOption.Value)"
                                                 TextFieldName="@nameof(ThemeOption.Text)"
                                                 Width="138px"
                                                 SuppressUnchangedValueChange="true" />
                        </div>
                        <span class="fx-tel-stamp">
                            @if (_autoRefreshSeconds > 0)
                            {
                                <span class="fx-tel-live-dot" title="Live auto-refresh active"></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(EffectiveTenantLabel))
                            {
                                <span>@TenantCaption: <strong>@EffectiveTenantLabel</strong></span>
                            }
                            @if (_snapshot is not null)
                            {
                                <span> · <strong>@_snapshot.TimeWindowLabel</strong> · @_snapshot.GeneratedAtLocal.ToString("HH:mm:ss")</span>
                            }
                        </span>
                    </div>
                </TrailingContent>
            </ToolbarControl>

            <div class="fx-tel-filter-bar">
                @if (EnableProductAnalytics)
                {
                    <div class="fx-tel-filter-item">
                        <div class="fx-tel-mode-switch" role="group" aria-label="Telemetry Workspace Mode">
                            <ButtonControl CssClass="@PillCss(ActiveWorkspaceMode == TelemetryWorkspaceMode.Observability)"
                                           Tag="fx-tel-mode-observability"
                                           OnClick="() => SwitchWorkspaceModeAsync(TelemetryWorkspaceMode.Observability)">
                                Observability
                            </ButtonControl>
                            <ButtonControl CssClass="@PillCss(ActiveWorkspaceMode == TelemetryWorkspaceMode.ProductAnalytics)"
                                           Tag="fx-tel-mode-product"
                                           OnClick="() => SwitchWorkspaceModeAsync(TelemetryWorkspaceMode.ProductAnalytics)">
                                Product Analytics
                            </ButtonControl>
                        </div>
                    </div>
                }

                @if (_canCrossTenant && _tenantOptions.Count > 1)
                {
                    <div class="fx-tel-filter-item">
                        <label class="fx-tel-filter-label">@TenantCaption</label>
                        <DropDownListControl TValue="string" TItem="FilterOption"
                                             Tag="fx-tel-tenant-picker"
                                             DataSource="@_tenantOptions"
                                             Value="@_selectedTenant"
                                             ValueChanged="OnTenantSelectionChangedAsync"
                                             ValueFieldName="@nameof(FilterOption.Value)"
                                             TextFieldName="@nameof(FilterOption.Text)"
                                             Width="190px"
                                             PanelMaxHeight="300"
                                             SuppressUnchangedValueChange="true" />
                    </div>
                }

                <div class="fx-tel-filter-item">
                    <label class="fx-tel-filter-label">Time Range</label>
                    <div class="fx-tel-pill-group">
                        @foreach (var preset in TimePresets)
                        {
                            var p = preset;
                            <ButtonControl CssClass="@PillCss(_selectedTimePresetKey == p.Key)"
                                           Tag="@($"fx-tel-range-{p.Key}")"
                                           OnClick="() => SelectTimePreset(p)">
                                @p.Label
                            </ButtonControl>
                        }
                    </div>
                </div>

                <div class="fx-tel-filter-item">
                    <label class="fx-tel-filter-label">Auto-Refresh</label>
                    <DropDownListControl TValue="int" TItem="RefreshOption"
                                         Tag="fx-tel-autorefresh"
                                         DataSource="@RefreshOptions"
                                         Value="@_autoRefreshSeconds"
                                         ValueChanged="OnAutoRefreshChanged"
                                         ValueFieldName="@nameof(RefreshOption.Seconds)"
                                         TextFieldName="@nameof(RefreshOption.Label)"
                                         Width="95px"
                                         SuppressUnchangedValueChange="true" />
                </div>

                @if (_moduleOptions.Count > 1)
                {
                    <div class="fx-tel-filter-item">
                        <label class="fx-tel-filter-label">Module</label>
                        <DropDownListControl TValue="string" TItem="FilterOption"
                                             Tag="fx-tel-module-filter"
                                             DataSource="@_moduleOptions"
                                             Value="@_selectedModule"
                                             ValueChanged="OnModuleChanged"
                                             ValueFieldName="@nameof(FilterOption.Value)"
                                             TextFieldName="@nameof(FilterOption.Text)"
                                             Width="170px"
                                             PanelMaxHeight="280"
                                             SuppressUnchangedValueChange="true" />
                    </div>
                }

                <div class="fx-tel-filter-item">
                    <label class="fx-tel-filter-label">User</label>
                    <DropDownListControl TValue="string" TItem="FilterOption"
                                         Tag="fx-tel-user-filter"
                                         DataSource="@_userOptions"
                                         Value="@_selectedUser"
                                         ValueChanged="OnUserChanged"
                                         ValueFieldName="@nameof(FilterOption.Value)"
                                         TextFieldName="@nameof(FilterOption.Text)"
                                         Width="135px"
                                         PanelMaxHeight="280"
                                         SuppressUnchangedValueChange="true" />
                </div>

                <div class="fx-tel-filter-item fx-tel-filter-search">
                    <label class="fx-tel-filter-label">Query</label>
                    <TextBoxControl Value="@_searchText"
                                    Tag="fx-tel-query-box"
                                    ValueChanged="OnSearchChangedAsync"
                                    UpdateOnInput="true"
                                    ClearableText="true"
                                    Placeholder="Filter screen, location, tag, control, value..."
                                    Width="240px" />
                </div>
            </div>
        }

        <TabStripControl Items="@TabItems"
                         Tag="fx-tel-tabs"
                         SelectedIndex="@_selectedTab"
                         SelectedIndexChanged="OnTabChangedAsync"
                         Orientation="TabOrientation.Horizontal"
                         ShowOrientationMenu="false"
                         CssClass="fx-tel-tabstrip" />

        <div class="fx-tel-body">
            @if (ActiveWorkspaceMode == TelemetryWorkspaceMode.ProductAnalytics)
            {
                @if (_selectedTab == 0)
                {
                    <FeatureAdoptionControl @ref="_featureAdoption"
                                            Theme="@ActiveTheme"
                                            ProductSnapshot="@_productSnapshot" />
                }
                else if (_selectedTab == 1)
                {
                    <FunnelAnalyticsControl @ref="_funnelAnalytics"
                                            Theme="@ActiveTheme"
                                            ProductSnapshot="@_productSnapshot" />
                }
                else if (_selectedTab == 2)
                {
                    <UserJourneyControl @ref="_userJourneys"
                                        Theme="@ActiveTheme"
                                        ProductSnapshot="@_productSnapshot" />
                }
                else if (_selectedTab == 3)
                {
                    <RetentionCohortControl @ref="_retentionCohorts"
                                            Theme="@ActiveTheme"
                                            ProductSnapshot="@_productSnapshot" />
                }
                else if (_selectedTab == 4)
                {
                    <FrictionInsightsControl @ref="_frictionInsights"
                                             Theme="@ActiveTheme"
                                             ProductSnapshot="@_productSnapshot" />
                }
                else if (_selectedTab == 5)
                {
                    <TelemetryPivotControl @ref="_telemetryPivot"
                                           Theme="@ActiveTheme"
                                           ProductSnapshot="@_productSnapshot" />
                }
            }
            else if (_selectedTab == 0 && _snapshot is not null)
            {
                <div class="fx-tel-scroll-pane">
                    <div class="fx-tel-kpi-grid">
                        <CardControl CssClass="fx-tel-card fx-tel-kpi-card fx-tel-accent-cyan" Elevation="1">
                            <div class="fx-tel-kpi-label">Total Telemetry Events</div>
                            <div class="fx-tel-kpi-value fx-tel-val-cyan">@_snapshot.TotalEvents.ToString("N0")</div>
                            <div class="fx-tel-kpi-sub">@_snapshot.TotalScreenOpens.ToString("N0") screen opens · @_snapshot.TotalTaskAndReportRuns.ToString("N0") tasks/reports</div>
                        </CardControl>

                        <CardControl CssClass="fx-tel-card fx-tel-kpi-card fx-tel-accent-emerald" Elevation="1">
                            <div class="fx-tel-kpi-label">Control &amp; Button Actions</div>
                            <div class="fx-tel-kpi-value fx-tel-val-emerald">@((_snapshot.TotalButtonClicks + _snapshot.TotalControlChanges).ToString("N0"))</div>
                            <div class="fx-tel-kpi-sub">@_snapshot.TotalButtonClicks.ToString("N0") clicks · @_snapshot.TotalControlChanges.ToString("N0") input/picker commits</div>
                        </CardControl>

                        <CardControl CssClass="fx-tel-card fx-tel-kpi-card fx-tel-accent-violet" Elevation="1">
                            <div class="fx-tel-kpi-label">GridControl Operations</div>
                            <div class="fx-tel-kpi-value fx-tel-val-violet">@_snapshot.TotalGridOperations.ToString("N0")</div>
                            <div class="fx-tel-kpi-sub">@_snapshot.GridActionSummaryRows.Count distinct grid verbs · zero extra server trips</div>
                        </CardControl>

                        <CardControl CssClass="fx-tel-card fx-tel-kpi-card fx-tel-accent-blue" Elevation="1">
                            <div class="fx-tel-kpi-label">Registered FlexKit Controls</div>
                            <div class="fx-tel-kpi-value">@_snapshot.RegisteredControlCount.ToString("N0")</div>
                            <div class="fx-tel-kpi-sub">@_snapshot.ControlTypeRows.Count control types with parent locations</div>
                        </CardControl>

                        <CardControl CssClass="fx-tel-card fx-tel-kpi-card fx-tel-accent-amber" Elevation="1">
                            <div class="fx-tel-kpi-label">Active Users</div>
                            <div class="fx-tel-kpi-value">@_snapshot.UniqueUsers.ToString("N0")</div>
                            <div class="fx-tel-kpi-sub">@(string.IsNullOrWhiteSpace(UsersKpiSubText) ? _snapshot.TimeWindowLabel : UsersKpiSubText)</div>
                        </CardControl>

                        @if (CustomKpiCard is not null)
                        {
                            <CardControl CssClass="@($"fx-tel-card fx-tel-kpi-card fx-tel-accent-{CustomKpiCard.AccentKind}")" Elevation="1">
                                <div class="fx-tel-kpi-label">@CustomKpiCard.Label</div>
                                <div class="fx-tel-kpi-value @(CustomKpiCard.IsWarning ? "fx-tel-val-warn" : "")">@CustomKpiCard.ValueText</div>
                                <div class="fx-tel-kpi-sub">
                                    @if (CustomKpiCard.ActionContent is not null)
                                    {
                                        @CustomKpiCard.ActionContent
                                    }
                                    else
                                    {
                                        @CustomKpiCard.SubText
                                    }
                                </div>
                            </CardControl>
                        }
                        else
                        {
                            <CardControl CssClass="fx-tel-card fx-tel-kpi-card fx-tel-accent-rose" Elevation="1">
                                <div class="fx-tel-kpi-label">Zero-Activity Screens</div>
                                <div class="fx-tel-kpi-value @(_snapshot.UnusedCatalogScreenCount > 0 ? "fx-tel-val-warn" : "")">@_snapshot.UnusedCatalogScreenCount.ToString("N0")</div>
                                <div class="fx-tel-kpi-sub">of @_snapshot.CatalogScreenCount.ToString("N0") known screens in @_snapshot.TimeWindowLabel</div>
                            </CardControl>
                        }
                    </div>

                    <div class="fx-tel-hero-row">
                        <CardControl Title="@($"Control Telemetry Volume ({_snapshot.TimeWindowLabel})")" CssClass="fx-tel-card fx-tel-hero-main" Elevation="1">
                            <div class="fx-tel-panel-toolbar">
                                <span class="fx-tel-panel-hint">Server-side FlexKit control actions buffered in memory &amp; flushed without extra network trips</span>
                                <div class="fx-tel-pill-group">
                                    <ButtonControl CssClass="@PillCss(_volumeChartStyle == "Bars")" Tag="fx-tel-vol-bars" OnClick='() => SetVolumeChartStyle("Bars")'>Histogram Bars</ButtonControl>
                                    <ButtonControl CssClass="@PillCss(_volumeChartStyle == "Area")" Tag="fx-tel-vol-area" OnClick='() => SetVolumeChartStyle("Area")'>Stacked Area</ButtonControl>
                                </div>
                            </div>
                            @if (_timeSeriesHistogramSeries.Count > 0 && _snapshot.TotalEvents > 0)
                            {
                                <ChartControl Type="@(_volumeChartStyle == "Area" ? ChartType.StackedArea : ChartType.StackedBar)"
                                              Series="@_timeSeriesHistogramSeries"
                                              Height="220px" />
                            }
                            else
                            {
                                <div class="fx-tel-empty">No events recorded in @_snapshot.TimeWindowLabel. Interact with buttons, dropdowns, inputs, or grids — actions flush in-memory on the server automatically.</div>
                            }
                        </CardControl>

                        <CardControl Title="UI Screen Coverage (%)" CssClass="fx-tel-card fx-tel-gauge-card" Elevation="1">
                            <ArcGaugeControl Value="@UiScreenCoveragePercent"
                                             Min="0"
                                             Max="100"
                                             Ranges="@GaugeRanges"
                                             ValueFormat="0.0"
                                             Height="180px"
                                             AriaLabel="UI Screen Coverage Percentage" />
                            <div class="fx-tel-gauge-caption">
                                <strong>@_snapshot.UniqueScreensVisited</strong> of <strong>@_snapshot.CatalogScreenCount</strong> screens active ·
                                <BadgeControl Variant="BadgeVariant.Warning" Size="BadgeSize.Small" Text="@($"{_snapshot.UnusedCatalogScreenCount} zero-open")" />
                            </div>
                        </CardControl>

                        @if (SecondaryGauge is not null)
                        {
                            <CardControl Title="@SecondaryGauge.Title" CssClass="fx-tel-card fx-tel-gauge-card" Elevation="1">
                                @if (SecondaryGauge.ValuePercent.HasValue)
                                {
                                    <ArcGaugeControl Value="@SecondaryGauge.ValuePercent.Value"
                                                     Min="0"
                                                     Max="100"
                                                     Ranges="@GaugeRanges"
                                                     ValueFormat="0.0"
                                                     Height="180px"
                                                     AriaLabel="@SecondaryGauge.Title" />
                                    <div class="fx-tel-gauge-caption">@SecondaryGauge.CaptionText</div>
                                }
                                else
                                {
                                    <div class="fx-tel-empty">@SecondaryGauge.EmptyMessage</div>
                                }
                            </CardControl>
                        }
                        else
                        {
                            <CardControl Title="Active Registered Controls (%)" CssClass="fx-tel-card fx-tel-gauge-card" Elevation="1">
                                <ArcGaugeControl Value="@ActiveRegisteredControlsPercent"
                                                 Min="0"
                                                 Max="100"
                                                 Ranges="@GaugeRanges"
                                                 ValueFormat="0.0"
                                                 Height="180px"
                                                 AriaLabel="Active Registered Controls Percentage" />
                                <div class="fx-tel-gauge-caption">
                                    <strong>@ActiveControlCount</strong> of <strong>@_snapshot.RegisteredControlCount</strong> registered controls exercised
                                </div>
                            </CardControl>
                        }
                    </div>

                    <div class="fx-tel-charts-row fx-tel-charts-three">
                        <CardControl Title="FlexKit Control Type Mix" CssClass="fx-tel-card" Elevation="1">
                            @if (_controlTypeDonutSeries.Count > 0 && _controlTypeDonutSeries[0].DataPoints.Count > 0)
                            {
                                <ChartControl Type="ChartType.Donut"
                                              Series="@_controlTypeDonutSeries"
                                              Height="235px" />
                            }
                            else
                            {
                                <div class="fx-tel-empty">Control type breakdown populates as FlexKit controls emit telemetry.</div>
                            }
                        </CardControl>

                        <CardControl Title="Screen × Time-of-Day Activity Heatmap" CssClass="fx-tel-card" Elevation="1">
                            @if (_screenHourHeatmapSeries.Count > 0)
                            {
                                <ChartControl Type="ChartType.Heatmap"
                                              Series="@_screenHourHeatmapSeries"
                                              ColorPalette="@(new[] { ActiveTheme == TelemetryTheme.VBClassic ? "#0a246a" : "#06b6d4" })"
                                              Height="235px" />
                            }
                            else
                            {
                                <div class="fx-tel-empty">Heatmap populates once screens record activity across time-of-day blocks.</div>
                            }
                        </CardControl>

                        <CardControl Title="Screen Usage Concentration (Pareto)" CssClass="fx-tel-card" Elevation="1">
                            @if (_screenParetoSeries.Count > 0 && _screenParetoSeries[0].DataPoints.Count > 0)
                            {
                                <ChartControl Type="ChartType.Pareto"
                                              Series="@_screenParetoSeries"
                                              ColorPalette="@(ActiveTheme == TelemetryTheme.VBClassic ? new[] { "#0a246a", "#8b0000" } : new[] { "#3b82f6", "#f59e0b" })"
                                              Height="235px" />
                            }
                            else
                            {
                                <div class="fx-tel-empty">No screen opens recorded in @_snapshot.TimeWindowLabel.</div>
                            }
                        </CardControl>
                    </div>

                    <div class="fx-tel-charts-row fx-tel-charts-two">
                        <CardControl Title="Most Active FlexKit Controls (Screen &gt; Control)" CssClass="fx-tel-card" Elevation="1">
                            @if (_topControlsBars.Count > 0)
                            {
                                <ChartControl Bars="@_topControlsBars"
                                              ShowValues="true"
                                              ValueFormat="N0"
                                              BarColor="@(ActiveTheme == TelemetryTheme.VBClassic ? "#2e7d32" : "#10b981")"
                                              LabelStyle="min-width:210px;" />
                            }
                            else
                            {
                                <div class="fx-tel-empty">Button, toolbar, dropdown, and input actions appear here automatically.</div>
                            }
                        </CardControl>

                        <CardControl Title="Top Visited Screens" CssClass="fx-tel-card" Elevation="1">
                            @if (_topScreensBars.Count > 0)
                            {
                                <ChartControl Bars="@_topScreensBars"
                                              ShowValues="true"
                                              ValueFormat="N0"
                                              BarColor="@(ActiveTheme == TelemetryTheme.VBClassic ? "#0a246a" : "#38bdf8")"
                                              LabelStyle="min-width:190px;" />
                            }
                            else
                            {
                                <div class="fx-tel-empty">No screen opens recorded in @_snapshot.TimeWindowLabel.</div>
                            }
                        </CardControl>
                    </div>

                    <div class="fx-tel-insights-row">
                        <CardControl Title="Rarely or Never Used Functions &amp; Telemetry Findings" CssClass="fx-tel-card fx-tel-insights-card" Elevation="1">
                            @if (AdditionalFindings is { Count: > 0 })
                            {
                                <ul class="fx-tel-findings-list">
                                    @foreach (var finding in AdditionalFindings)
                                    {
                                        <li>@finding</li>
                                    }
                                </ul>
                            }
                            else if (OverviewEmptyFindingsContent is not null)
                            {
                                @OverviewEmptyFindingsContent
                            }

                            @if (_zeroUseModulesSummary.Count > 0)
                            {
                                <div class="fx-tel-zero-summary">
                                    <strong>Zero-Activity UI Screens in @_snapshot.TimeWindowLabel (@_snapshot.UnusedCatalogScreenCount of @_snapshot.CatalogScreenCount):</strong>
                                    <div class="fx-tel-badge-wrap">
                                        @foreach (var item in _zeroUseModulesSummary)
                                        {
                                            <BadgeControl Variant="BadgeVariant.Secondary" Size="BadgeSize.Small" Text="@item" />
                                        }
                                    </div>
                                </div>
                            }
                        </CardControl>
                    </div>
                </div>
            }
            else if (_selectedTab == 1 && _snapshot is not null)
            {
                <ControlActivityControl @ref="_controlActivity"
                                        Theme="@ActiveTheme"
                                        Snapshot="@_snapshot" />
            }
            else if (_selectedTab == 2 && _snapshot is not null)
            {
                <div class="fx-tel-grid-pane">
                    <div class="fx-tel-subbar">
                        <div class="fx-tel-pill-group">
                            <ButtonControl CssClass="@PillCss(_screenSubMode == "Screens")"
                                           Tag="fx-tel-sub-screens"
                                           OnClick='() => _screenSubMode = "Screens"'>
                                Screens &amp; Forms (@FilteredScreenRows.Count)
                            </ButtonControl>
                            <ButtonControl CssClass="@PillCss(_screenSubMode == "TasksReports")"
                                           Tag="fx-tel-sub-tasks"
                                           OnClick='() => _screenSubMode = "TasksReports"'>
                                Tasks, Reports &amp; Inquiries (@FilteredTaskRows.Count)
                            </ButtonControl>
                        </div>

                        <div class="fx-tel-pill-group">
                            <span class="fx-tel-subbar-label">Usage Filter:</span>
                            <ButtonControl CssClass="@PillCss(_usageStatusFilter == "All")" Tag="fx-tel-st-all" OnClick='() => _usageStatusFilter = "All"'>All</ButtonControl>
                            <ButtonControl CssClass="@PillCss(_usageStatusFilter == "Unused")" Tag="fx-tel-st-unused" OnClick='() => _usageStatusFilter = "Unused"'>Unused (0)</ButtonControl>
                            <ButtonControl CssClass="@PillCss(_usageStatusFilter == "Rare")" Tag="fx-tel-st-rare" OnClick='() => _usageStatusFilter = "Rare"'>Rarely Used</ButtonControl>
                            <ButtonControl CssClass="@PillCss(_usageStatusFilter == "Active")" Tag="fx-tel-st-active" OnClick='() => _usageStatusFilter = "Active"'>Active</ButtonControl>
                        </div>
                    </div>

                    <div class="fx-tel-grid-host">
                        @if (_screenSubMode == "Screens")
                        {
                            <GridControl TValue="FlexTelemetryScreenRow"
                                         Tag="fx-grid-screens"
                                         DataSource="@FilteredScreenRows"
                                         AllowSorting="true"
                                         AllowFiltering="true"
                                         AllowResizing="true"
                                         AllowSelection="true"
                                         EnableHover="true"
                                         Height="100%"
                                         WidthMode="GridWidthMode.FillAvailable">
                                <GridColumnsBase>
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.ScreenTitle)" HeaderText="Screen / Function" Width="245px" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.Module)" HeaderText="Module" Width="170px" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.UsageStatus)" HeaderText="Status" Width="135px" AllowEditing="false">
                                        <Template>
                                            @{
                                                var r = (FlexTelemetryScreenRow)context;
                                            }
                                            <BadgeControl Variant="@StatusBadgeVariant(r.UsageStatus)" Size="BadgeSize.Small" Text="@r.UsageStatus" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.OpenCount)" HeaderText="Opens" Width="80px" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.FocusCount)" HeaderText="Tab Focuses" Width="95px" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.ControlActionsOnScreen)" HeaderText="Control Actions" Width="110px" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.GridOpsOnScreen)" HeaderText="Grid Ops" Width="85px" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.UniqueUsers)" HeaderText="Users" Width="75px" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.TotalDwellMinutes)" HeaderText="Total Min" Width="90px" Type="ColumnType.Number" Format="N1" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.AvgDwellSeconds)" HeaderText="Avg Sec" Width="85px" Type="ColumnType.Number" Format="N1" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.LastUsedLocal)" HeaderText="Last Used" Width="145px" Type="ColumnType.Date" Format="yyyy-MM-dd HH:mm" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryScreenRow.Route)" HeaderText="Route" Width="175px" AllowEditing="false" />
                                </GridColumnsBase>
                            </GridControl>
                        }
                        else
                        {
                            <GridControl TValue="FlexTelemetryTaskRow"
                                         Tag="fx-grid-tasks"
                                         DataSource="@FilteredTaskRows"
                                         AllowSorting="true"
                                         AllowFiltering="true"
                                         AllowResizing="true"
                                         AllowSelection="true"
                                         EnableHover="true"
                                         Height="100%"
                                         WidthMode="GridWidthMode.FillAvailable">
                                <GridColumnsBase>
                                    <GridColumn Field="@nameof(FlexTelemetryTaskRow.KindLabel)" HeaderText="Type" Width="95px" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryTaskRow.Name)" HeaderText="Task / Report / Inquiry Name" Width="300px" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryTaskRow.Module)" HeaderText="Module" Width="190px" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryTaskRow.UsageStatus)" HeaderText="Status" Width="140px" AllowEditing="false">
                                        <Template>
                                            @{
                                                var r = (FlexTelemetryTaskRow)context;
                                            }
                                            <BadgeControl Variant="@StatusBadgeVariant(r.UsageStatus)" Size="BadgeSize.Small" Text="@r.UsageStatus" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(FlexTelemetryTaskRow.RunCount)" HeaderText="Executions" Width="105px" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryTaskRow.UniqueUsers)" HeaderText="Users" Width="85px" Type="ColumnType.Number" Format="N0" TextAlign="TextAlign.Right" AllowEditing="false" />
                                    <GridColumn Field="@nameof(FlexTelemetryTaskRow.LastRunLocal)" HeaderText="Last Executed" Width="155px" Type="ColumnType.Date" Format="yyyy-MM-dd HH:mm" AllowEditing="false" />
                                </GridColumnsBase>
                            </GridControl>
                        }
                    </div>
                </div>
            }
            else if (_selectedTab == 3 && _snapshot is not null)
            {
                <LogControl @ref="_logControl"
                            Theme="@ActiveTheme"
                            Snapshot="@_snapshot"
                            ExternalHistogramSeries="@_timeSeriesHistogramSeries"
                            ShowChrome="false" />
            }
            else if (_selectedTab == 4)
            {
                <SqlTelemetryControl @ref="_sqlControl"
                                     Theme="@ActiveTheme"
                                     Tenant="@EffectiveTenant"
                                     SearchText="@_searchText"
                                     RefreshVersion="@_refreshVersion" />
            }
            else if (_selectedTab >= BuiltInTabCount && AdditionalTabs is not null)
            {
                var customIdx = _selectedTab - BuiltInTabCount;
                if (customIdx >= 0 && customIdx < AdditionalTabs.Count)
                {
                    var customTab = AdditionalTabs[customIdx];
                    var ctx = new TelemetryCustomTabContext(
                        ActiveTheme,
                        EffectiveTenant,
                        _searchText,
                        _selectedDays,
                        _selectedMinutesBack,
                        _snapshot);
                    @customTab.Content(ctx)
                }
            }
        </div>
    </div>
