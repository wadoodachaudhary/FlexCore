@namespace Fx.ControlKit.Telemetry
@inherits Fx.ControlKit.FlexKitControlBase
@implements IAsyncDisposable

@using System.Globalization
@using System.Text
@using Fx.ControlKit
@using Fx.ControlKit.Charts
@using Fx.ControlKit.Grid
@using Fx.ControlKit.Logging
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@inject IServiceProvider Services
@inject IJSRuntime JSRuntime

<CascadingValue Value="@ChildLocation" IsFixed="true">
    <div class="fx-log-root @ThemeClass" tabindex="-1" @onkeydown="OnRootKeyDownAsync">
        @if (EffectiveShowChrome)
        {
            <ToolbarControl CssClass="fx-tel-toolbar" ShowCaptions="true" ShowCaptionsToggle="false" Tag="fx-log-toolbar">
                <ChildContent>
                    <ToolbarButtonControl Label="Refresh Logs"
                                          Title="Flush pending in-memory control actions and refresh log stream"
                                          Tag="fx-log-refresh"
                                          OnClick="RefreshStandaloneAsync" />
                    <ToolbarButtonControl Label="Find... (Ctrl+F)"
                                          Title="Open Find dialog to locate logs by text or wildcard across columns"
                                          Tag="fx-log-open-find"
                                          OnClick="() => OpenFindDialog()" />
                    <ToolbarButtonControl Label="Export CSV"
                                          Title="Export filtered log rows to CSV"
                                          Tag="fx-log-export-csv"
                                          OnClick="() => ExportCsvAsync()" />
                    <ToolbarButtonControl Label="Export CloudWatch NDJSON"
                                          Title="Export single-line AWS CloudWatch / Loki NDJSON rows"
                                          Tag="fx-log-export-cw"
                                          OnClick="() => ExportStructuredAsync(clefFormat: false)" />
                    <ToolbarButtonControl Label="Export Serilog CLEF"
                                          Title="Export Serilog Compact Log Event Format (.clef) rows"
                                          Tag="fx-log-export-clef"
                                          OnClick="() => ExportStructuredAsync(clefFormat: true)" />
                </ChildContent>
                <TrailingContent>
                    <div class="fx-log-toolbar-right">
                        <TextBoxControl Value="@_standaloneSearch"
                                        Tag="fx-log-search"
                                        ValueChanged="OnStandaloneSearchChanged"
                                        UpdateOnInput="true"
                                        ClearableText="true"
                                        Placeholder="Search date, type, screen, control, value..."
                                        Width="240px" />
                        <DropDownListControl TValue="TelemetryTheme" TItem="ThemeChoice"
                                             Tag="fx-log-theme-picker"
                                             DataSource="@ThemeChoices"
                                             Value="@EffectiveTheme"
                                             ValueChanged="OnThemeChangedAsync"
                                             ValueFieldName="@nameof(ThemeChoice.Value)"
                                             TextFieldName="@nameof(ThemeChoice.Label)"
                                             Width="145px"
                                             SuppressUnchangedValueChange="true" />
                    </div>
                </TrailingContent>
            </ToolbarControl>
        }

        @* ── Quick What's-Happening Strip (Categorized by Date & Type) ── *@
        <div class="fx-log-summary-strip">
            <div class="fx-log-summary-stats">
                <span class="fx-log-stat-chip">
                    <span class="fx-log-stat-lbl">Today</span>
                    <strong>@TodayLogCount.ToString("N0")</strong>
                </span>
                <span class="fx-log-stat-chip">
                    <span class="fx-log-stat-lbl">Total Logs</span>
                    <strong>@AllWindowRows.Count.ToString("N0")</strong>
                </span>
                <span class="fx-log-stat-chip">
                    <span class="fx-log-stat-lbl">Dates</span>
                    <strong>@DistinctDateCount.ToString("N0")</strong>
                </span>
                <span class="fx-log-stat-chip">
                    <span class="fx-log-stat-lbl">Users</span>
                    <strong>@DistinctUserCount.ToString("N0")</strong>
                </span>
                @if (ErrorRowCount > 0)
                {
                    <span class="fx-log-stat-chip fx-log-stat-err">
                        <span class="fx-log-stat-lbl">Errors</span>
                        <strong>@ErrorRowCount.ToString("N0")</strong>
                    </span>
                }
            </div>

            <div class="fx-log-actions-right">
                <ButtonControl CssClass="fx-tel-pill fx-tel-pill-active fx-log-find-btn"
                               Tag="fx-log-find-btn"
                               Title="Find logs by text or wildcard (*, ?) across any column (Ctrl+F / F3)"
                               OnClick="() => OpenFindDialog()">
                    &#128269; Find...
                </ButtonControl>

                @if (!string.IsNullOrWhiteSpace(_activeFindFilterText))
                {
                    <ButtonControl CssClass="fx-tel-pill fx-log-clear-find-btn"
                                   Tag="fx-log-clear-find-filter"
                                   OnClick="ClearFindFilter">
                        ✕ Find Filter: "@_activeFindFilterText" (@FilteredRows.Count)
                    </ButtonControl>
                }

                <span class="fx-tel-subbar-label">Group By:</span>
                @foreach (var gp in GroupPresets)
                {
                    var preset = gp;
                    <ButtonControl CssClass="@PillCss(_groupPresetKey == preset.Key)"
                                   Tag="@($"fx-log-grp-{preset.Key}")"
                                   OnClick="() => ApplyGroupPreset(preset.Key)">
                        @preset.Label
                    </ButtonControl>
                }

                @if (_activeGroupColumns.Count > 0)
                {
                    <ButtonControl CssClass="fx-tel-pill"
                                   Tag="fx-log-expand-all"
                                   Title="Expand all Date and Type groups"
                                   OnClick="ExpandAllAsync">
                        ⊞ Expand
                    </ButtonControl>
                    <ButtonControl CssClass="fx-tel-pill"
                                   Tag="fx-log-collapse-all"
                                   Title="Collapse all Date and Type groups to summary headers"
                                   OnClick="CollapseAllAsync">
                        ⊟ Collapse
                    </ButtonControl>
                }

                <ButtonControl CssClass="@PillCss(_showHistogramPanel)"
                               Tag="fx-log-toggle-hist"
                               Title="Show or hide the log volume histogram"
                               OnClick="() => _showHistogramPanel = !_showHistogramPanel">
                    Chart
                </ButtonControl>
                <ButtonControl CssClass="@PillCss(_showInspectorPanel)"
                               Tag="fx-log-toggle-inspector"
                               Title="Show or hide the structured JSON / SQL row inspector"
                               OnClick="() => _showInspectorPanel = !_showInspectorPanel">
                    Inspector
                </ButtonControl>
            </div>
        </div>

        @* ── Log Type Category Pills ── *@
        <div class="fx-tel-subbar fx-log-type-bar">
            <div class="fx-tel-pill-group">
                <span class="fx-tel-subbar-label">Log Type:</span>
                <ButtonControl CssClass="@PillCss(_selectedType == "All")"
                               Tag="fx-log-type-all"
                               OnClick='() => SelectType("All")'>
                    All (@AllWindowRows.Count)
                </ButtonControl>
                @foreach (var tc in TypeCategorySummaries)
                {
                    var cat = tc;
                    <ButtonControl CssClass="@PillCss(_selectedType == cat.Label)"
                                   Tag="@($"fx-log-type-{cat.Label}")"
                                   OnClick="() => SelectType(cat.Label)">
                        @cat.Label (@cat.Count)
                    </ButtonControl>
                }
            </div>

            <div class="fx-tel-pill-group">
                <ButtonControl CssClass="@PillCss(_includeSqlLogs)"
                               Tag="fx-log-toggle-sql"
                               Title="Include SQL statements, slow queries, and database errors in the unified log grid"
                               OnClick="ToggleIncludeSqlLogs">
                    @(_includeSqlLogs ? "✓ SQL Included" : "+ Include SQL")
                </ButtonControl>
                @if (!string.IsNullOrWhiteSpace(_findStatusBanner))
                {
                    <span class="fx-log-find-status">@_findStatusBanner</span>
                }
                else if (!string.IsNullOrWhiteSpace(ActiveSnapshot?.StorageHint))
                {
                    <span class="fx-tel-subbar-hint">@ActiveSnapshot!.StorageHint</span>
                }
            </div>
        </div>

        @if (_showHistogramPanel && ActiveSnapshot is not null)
        {
            <CardControl Title="@($"Log Volume Histogram — {FilteredRows.Count:N0} matching logs ({ActiveSnapshot.TimeWindowLabel})")"
                         CssClass="fx-tel-card fx-log-hist-card"
                         Elevation="1">
                @if (HistogramSeries.Count > 0 && AllWindowRows.Count > 0)
                {
                    <ChartControl Type="ChartType.StackedBar"
                                  Series="@HistogramSeries"
                                  Height="98px" />
                }
                else
                {
                    <div class="fx-tel-empty fx-tel-empty-compact">No log lines recorded in @ActiveSnapshot.TimeWindowLabel.</div>
                }
            </CardControl>
        }

        <div class="fx-log-split">
            <div class="fx-tel-grid-host fx-log-grid-pane">
                <GridControl @ref="_gridRef"
                             TValue="FlexTelemetryEventRow"
                             Tag="fx-log-stream-grid"
                             DataSource="@FilteredRows"
                             EventsRef="@_gridEvents"
                             AllowGrouping="true"
                             GroupColumns="@_activeGroupColumns"
                             GroupHeaderTextSelector="@FormatGroupHeader"
                             HideGroupedColumns="false"
                             ShowGroupExpandCollapse="true"
                             ShowSearchBar="true"
                             ShowExpressionFilterButton="true"
                             AllowSorting="true"
                             AllowFiltering="true"
                             EnableAdvancedFilterPopup="true"
                             AllowResizing="true"
                             AllowSelection="true"
                             EnableHover="true"
                             RowCssClassSelector="@ResolveRowCssClass"
                             Height="100%"
                             WidthMode="GridWidthMode.FillAvailable">
                    <GridColumnsBase>
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.LogDate)" HeaderText="Date" Width="108px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.TimeText)" HeaderText="Time" Width="102px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.LogType)" HeaderText="Type" Width="152px" AllowEditing="false">
                            <Template>
                                @{
                                    var row = (FlexTelemetryEventRow)context;
                                    var tv = row.LogType.Priority switch
                                    {
                                        1 => BadgeVariant.Danger,
                                        2 => BadgeVariant.Info,
                                        3 => BadgeVariant.Primary,
                                        4 => BadgeVariant.Secondary,
                                        6 => BadgeVariant.Success,
                                        7 => BadgeVariant.Warning,
                                        _ => BadgeVariant.Secondary
                                    };
                                }
                                <BadgeControl Variant="@tv" Size="BadgeSize.Small" Text="@row.LogType.Label" />
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Level)" HeaderText="Level" Width="74px" AllowEditing="false">
                            <Template>
                                @{
                                    var row = (FlexTelemetryEventRow)context;
                                    var variant = string.Equals(row.Level, "ERROR", StringComparison.OrdinalIgnoreCase)
                                        ? BadgeVariant.Danger
                                        : (string.Equals(row.Level, "WARN", StringComparison.OrdinalIgnoreCase)
                                            ? BadgeVariant.Warning
                                            : BadgeVariant.Success);
                                }
                                <BadgeControl Variant="@variant" Size="BadgeSize.Small" Text="@row.Level" />
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Summary)" HeaderText="What Happened" Width="300px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.UserId)" HeaderText="User" Width="105px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Screen)" HeaderText="Screen" Width="170px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Action)" HeaderText="Action" Width="118px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Control)" HeaderText="Control / Target" Width="165px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Value)" HeaderText="Value" Width="155px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Location)" HeaderText="Location Hierarchy" Width="255px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.ControlType)" HeaderText="ControlType" Width="135px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Tag)" HeaderText="Tag" Width="110px" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.DurationSeconds)" HeaderText="Sec" Width="75px" Type="ColumnType.Number" Format="N2" TextAlign="TextAlign.Right" AllowEditing="false" />
                        <GridColumn Field="@nameof(FlexTelemetryEventRow.Detail)" HeaderText="Detail / SQL" Width="220px" AllowEditing="false" />
                    </GridColumnsBase>
                </GridControl>
            </div>

            @if (_showInspectorPanel)
            {
                var inspected = SelectedOrLatestRow;
                <CardControl Title="Standard Structured Log &amp; SQL Row Inspector (CloudWatch Logs Insights &amp; Serilog CLEF)"
                             CssClass="fx-tel-card fx-log-inspector"
                             Elevation="1">
                    @if (inspected is not null)
                    {
                        <div class="fx-log-inspector-header">
                            <div class="fx-tel-badge-wrap">
                                <BadgeControl Variant="BadgeVariant.Info" Size="BadgeSize.Small" Text="@inspected.LogType.Label" />
                                <BadgeControl Variant="BadgeVariant.Primary" Size="BadgeSize.Small" Text="@inspected.Action" />
                                @if (!string.IsNullOrEmpty(inspected.Tag))
                                {
                                    <BadgeControl Variant="BadgeVariant.Warning" Size="BadgeSize.Small" Text="@($"tag:{inspected.Tag}")" />
                                }
                                <span class="fx-log-inspector-loc">@inspected.Location</span>
                            </div>
                            <div class="fx-tel-pill-group">
                                @if (inspected.IsSqlRow && !string.IsNullOrWhiteSpace(inspected.SqlStatement))
                                {
                                    <ButtonControl CssClass="@PillCss(_inspectorFormat == "SQL")"
                                                   Tag="fx-log-fmt-sql"
                                                   OnClick='() => SetInspectorFormat("SQL")'>
                                        SQL Statement
                                    </ButtonControl>
                                }
                                <ButtonControl CssClass="@PillCss(_inspectorFormat == "CloudWatch")"
                                               Tag="fx-log-fmt-cw"
                                               OnClick='() => SetInspectorFormat("CloudWatch")'>
                                    AWS CloudWatch / Loki JSON
                                </ButtonControl>
                                <ButtonControl CssClass="@PillCss(_inspectorFormat == "CLEF")"
                                               Tag="fx-log-fmt-clef"
                                               OnClick='() => SetInspectorFormat("CLEF")'>
                                    Serilog CLEF JSON
                                </ButtonControl>
                            </div>
                        </div>
                        @if (_inspectorFormat == "SQL" && inspected.IsSqlRow && !string.IsNullOrWhiteSpace(inspected.SqlStatement))
                        {
                            <pre class="fx-log-json-pre">@inspected.SqlStatement@(!string.IsNullOrWhiteSpace(inspected.SqlParameters) ? $"\n-- Parameters: {FlexDiagnosticSnapshotService.RedactSqlParameters(inspected.SqlParameters)}" : string.Empty)</pre>
                        }
                        else
                        {
                            <pre class="fx-log-json-pre">@(_inspectorFormat == "CLEF" ? inspected.SerilogClefJsonIndented : inspected.CloudWatchJsonIndented)</pre>
                        }
                    }
                    else
                    {
                        <div class="fx-tel-empty fx-tel-empty-compact">Select any log line above to inspect its CloudWatch &amp; Serilog CLEF JSON payload.</div>
                    }
                </CardControl>
            }
        </div>

        @* ── VB / FlexKit Modal Find Dialog (Ctrl+F / Find...) ── *@
        @if (_findDialogVisible)
        {
            <DialogControl Visible="true"
                           Header="Find in Logs"
                           Width="460px"
                           IsModal="true"
                           CloseOnEscape="true"
                           OnClose="CloseFindDialog">
                <ChildContent>
                    <div class="fx-log-find-form">
                        <div class="fx-log-find-row">
                            <label class="fx-log-find-lbl">Find what:</label>
                            <TextBoxControl @ref="_findInputRef"
                                            Value="@_findText"
                                            Tag="fx-log-find-input"
                                            ValueChanged="OnFindTextChanged"
                                            UpdateOnInput="true"
                                            SelectOnFocus="true"
                                            ClearableText="true"
                                            Placeholder="Text or wildcard (e.g. Purchase*, *Error*, PO-104)..."
                                            OnKeyDown="OnFindDialogKeyDownAsync"
                                            Width="100%" />
                        </div>

                        <div class="fx-log-find-row">
                            <label class="fx-log-find-lbl">Look in:</label>
                            <DropDownListControl TValue="string" TItem="FindFieldOption"
                                                 Tag="fx-log-find-field"
                                                 DataSource="@FindFieldOptions"
                                                 Value="@_findField"
                                                 ValueChanged="v => _findField = v ?? AllColumnsField"
                                                 ValueFieldName="@nameof(FindFieldOption.Field)"
                                                 TextFieldName="@nameof(FindFieldOption.Label)"
                                                 Width="100%"
                                                 SuppressUnchangedValueChange="true" />
                        </div>

                        <div class="fx-log-find-opts">
                            <div class="fx-log-find-checks">
                                <CheckBoxControl @bind-Checked="_findMatchWholeWord"
                                                 Tag="fx-log-find-whole"
                                                 Label="Match whole word only" />
                                <CheckBoxControl @bind-Checked="_findMatchCase"
                                                 Tag="fx-log-find-case"
                                                 Label="Match case" />
                            </div>

                            <div class="fx-log-find-dir">
                                <span class="fx-log-find-dir-title">Direction</span>
                                <RadioControl TValue="bool"
                                              Name="fx-log-find-direction"
                                              Value="false"
                                              @bind-SelectedValue="_findSearchDown"
                                              Label="Up" />
                                <RadioControl TValue="bool"
                                              Name="fx-log-find-direction"
                                              Value="true"
                                              @bind-SelectedValue="_findSearchDown"
                                              Label="Down" />
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_findDialogMessage))
                        {
                            <div class="fx-log-find-msg @(_findDialogNoMatch ? "fx-log-find-msg-warn" : "fx-log-find-msg-ok")">
                                @_findDialogMessage
                            </div>
                        }
                    </div>
                </ChildContent>
                <FooterContent>
                    <ButtonControl Tag="fx-log-find-next"
                                   Disabled="@string.IsNullOrWhiteSpace(_findText)"
                                   Style="@(string.IsNullOrWhiteSpace(_findText) ? "" : "background:#0a246a;color:#fff;border-color:#0a246a;")"
                                   OnClick="() => FindNextCoreAsync()">
                        Find Next
                    </ButtonControl>
                    <ButtonControl Tag="fx-log-find-filter-all"
                                   Disabled="@string.IsNullOrWhiteSpace(_findText)"
                                   OnClick="ApplyFindAsGridFilterAsync">
                        Filter Grid to Matches
                    </ButtonControl>
                    <ButtonControl Tag="fx-log-find-cancel"
                                   OnClick="CloseFindDialog">
                        Close
                    </ButtonControl>
                </FooterContent>
            </DialogControl>
        }
    </div>
</CascadingValue>

@code {
    public sealed record ThemeChoice(TelemetryTheme Value, string Label);
    public sealed record GroupPreset(string Key, string Label, string[] Columns);
    public sealed record FindFieldOption(string Field, string Label);
    public sealed record TypeCategorySummary(int Priority, string Label, int Count);

    public const string AllColumnsField = "*";

    private static readonly List<ThemeChoice> ThemeChoices = new()
    {
        new(TelemetryTheme.VBClassic, "Style: VB Classic"),
        new(TelemetryTheme.GrafanaDark, "Style: Grafana Dark"),
        new(TelemetryTheme.ModernLight, "Style: Modern Light")
    };

    private static readonly GroupPreset[] GroupPresets =
    {
        new("date-type", "Date → Type", new[] { nameof(FlexTelemetryEventRow.LogDate), nameof(FlexTelemetryEventRow.LogType) }),
        new("date", "Date Only", new[] { nameof(FlexTelemetryEventRow.LogDate) }),
        new("type-date", "Type → Date", new[] { nameof(FlexTelemetryEventRow.LogType), nameof(FlexTelemetryEventRow.LogDate) }),
        new("screen-type", "Screen → Type", new[] { nameof(FlexTelemetryEventRow.Screen), nameof(FlexTelemetryEventRow.LogType) }),
        new("user-date", "User → Date", new[] { nameof(FlexTelemetryEventRow.UserId), nameof(FlexTelemetryEventRow.LogDate) }),
        new("flat", "Flat Stream", Array.Empty<string>())
    };

    private static readonly List<FindFieldOption> FindFieldOptions = new()
    {
        new(AllColumnsField, "All Columns (Entire Log Row)"),
        new(nameof(FlexTelemetryEventRow.Summary), "What Happened (Summary)"),
        new(nameof(FlexTelemetryEventRow.LogType), "Log Type"),
        new(nameof(FlexTelemetryEventRow.LogDate), "Date (yyyy-MM-dd)"),
        new(nameof(FlexTelemetryEventRow.UserId), "User"),
        new(nameof(FlexTelemetryEventRow.Screen), "Screen"),
        new(nameof(FlexTelemetryEventRow.Action), "Action"),
        new(nameof(FlexTelemetryEventRow.Control), "Control / Target"),
        new(nameof(FlexTelemetryEventRow.Value), "Value"),
        new(nameof(FlexTelemetryEventRow.Location), "Location Hierarchy"),
        new(nameof(FlexTelemetryEventRow.ControlType), "ControlType"),
        new(nameof(FlexTelemetryEventRow.Tag), "Tag"),
        new(nameof(FlexTelemetryEventRow.Detail), "Detail / SQL")
    };

    [Parameter] public string Title { get; set; } = "LogExplorer";
    [Parameter] public TelemetryTheme Theme { get; set; } = TelemetryTheme.VBClassic;
    [Parameter] public EventCallback<TelemetryTheme> ThemeChanged { get; set; }
    [Parameter] public FlexTelemetrySnapshot? Snapshot { get; set; }
    [Parameter] public List<ChartSeries>? ExternalHistogramSeries { get; set; }
    [Parameter] public string? Tenant { get; set; }
    [Parameter] public string? SearchText { get; set; }
    [Parameter] public bool? ShowChrome { get; set; }
    [Parameter] public bool ShowHistogram { get; set; } = false;
    [Parameter] public bool ShowInspector { get; set; } = true;
    [Parameter] public int StandaloneDaysBack { get; set; } = 30;
    [Parameter] public string DefaultGroupPreset { get; set; } = "date-type";

    private GridControl<FlexTelemetryEventRow>? _gridRef;
    private TextBoxControl? _findInputRef;
    private readonly GridControlEvents<FlexTelemetryEventRow> _gridEvents = new();
    private BrowserInterop? _browserInterop;
    private DefaultFlexTelemetryDataSource? _ownedFallbackSource;
    private FlexTelemetrySnapshot? _standaloneSnapshot;
    private List<ChartSeries> _standaloneHistogram = new();
    private TelemetryTheme? _localThemeOverride;
    private string _standaloneSearch = string.Empty;
    private string _selectedType = "All";
    private bool _includeSqlLogs = true;
    private string _groupPresetKey = "date-type";
    private List<string> _activeGroupColumns = new()
    {
        nameof(FlexTelemetryEventRow.LogDate),
        nameof(FlexTelemetryEventRow.LogType)
    };
    private bool _groupPresetInitialized;
    private bool _showHistogramPanel;
    private bool _showInspectorPanel = true;
    private bool _panelsInitialized;
    private string _inspectorFormat = "CloudWatch";
    private FlexTelemetryEventRow? _selectedRow;

    // Find dialog & Find-Next state
    private bool _findDialogVisible;
    private bool _focusFindInputPending;
    private string _findText = string.Empty;
    private string _findField = AllColumnsField;
    private bool _findMatchWholeWord;
    private bool _findMatchCase;
    private bool _findSearchDown = true;
    private int _findCursorIndex = -1;
    private FlexTelemetryEventRow? _findMatchedRow;
    private string _findDialogMessage = string.Empty;
    private bool _findDialogNoMatch;
    private string _findStatusBanner = string.Empty;
    private string _activeFindFilterText = string.Empty;

    private FlexControlLocation ChildLocation => GetOrCreateChildLocation("LogControl", () => Title);
    protected override string? ResolveControlIdentifier() => Title;

    private TelemetryTheme EffectiveTheme => _localThemeOverride ?? Theme;
    private bool EffectiveShowChrome => ShowChrome ?? (Snapshot is null);
    private FlexTelemetrySnapshot? ActiveSnapshot => Snapshot ?? _standaloneSnapshot;
    private string EffectiveSearch => !string.IsNullOrWhiteSpace(SearchText) ? SearchText! : _standaloneSearch;

    private List<ChartSeries> HistogramSeries =>
        ExternalHistogramSeries ?? _standaloneHistogram;

    private string ThemeClass => EffectiveTheme switch
    {
        TelemetryTheme.GrafanaDark => "fx-tel-theme-grafana",
        TelemetryTheme.ModernLight => "fx-tel-theme-light",
        _ => "fx-tel-theme-vb"
    };

    public IReadOnlyList<FlexTelemetryEventRow> AllWindowRows => BuildUnifiedWindowRows();

    public IReadOnlyList<FlexTelemetryEventRow> FilteredRows
    {
        get
        {
            IEnumerable<FlexTelemetryEventRow> query = AllWindowRows;
            if (!string.Equals(_selectedType, "All", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(r => string.Equals(r.LogType.Label, _selectedType, StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(r.Kind, _selectedType, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(_activeFindFilterText))
            {
                var pattern = BuildWildcardPattern(_activeFindFilterText, _findMatchWholeWord);
                query = query.Where(r => RowMatchesFind(r, _findField, pattern, _findMatchCase));
            }
            return query.ToList();
        }
    }

    private int TodayLogCount
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Now);
            return AllWindowRows.Count(r => r.LogDate.Date == today);
        }
    }

    private int DistinctDateCount =>
        AllWindowRows.Select(r => r.LogDate.Date).Distinct().Count();

    private int DistinctUserCount =>
        AllWindowRows
            .Select(r => r.UserId)
            .Where(u => !string.IsNullOrWhiteSpace(u) && !string.Equals(u, "anonymous", StringComparison.OrdinalIgnoreCase) && !string.Equals(u, "(system)", StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private int ErrorRowCount =>
        AllWindowRows.Count(r => r.LogType.Priority == 1 || string.Equals(r.Level, "ERROR", StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<TypeCategorySummary> TypeCategorySummaries =>
        AllWindowRows
            .GroupBy(r => r.LogType)
            .OrderBy(g => g.Key)
            .Select(g => new TypeCategorySummary(g.Key.Priority, g.Key.Label, g.Count()))
            .ToList();

    private FlexTelemetryEventRow? SelectedOrLatestRow =>
        _selectedRow ?? _findMatchedRow ?? FilteredRows.FirstOrDefault();

    protected override void OnInitialized()
    {
        RegisterControlPresence();
        if (!_groupPresetInitialized)
        {
            _groupPresetInitialized = true;
            ApplyGroupPresetCore(DefaultGroupPreset);
        }
        if (!_panelsInitialized)
        {
            _panelsInitialized = true;
            _showHistogramPanel = ShowHistogram;
            _showInspectorPanel = ShowInspector;
        }

        _gridEvents.RowSelected = EventCallback.Factory.Create<RowSelectEventArgs<FlexTelemetryEventRow>>(this, OnRowSelected);
        if (Snapshot is null)
        {
            BuildStandaloneSnapshot();
        }
    }

    protected override void OnParametersSet()
    {
        if (ThemeChanged.HasDelegate)
            _localThemeOverride = null;

        if (_selectedRow is not null)
        {
            var all = AllWindowRows;
            if (!all.Any(r => r.TimestampUtc == _selectedRow.TimestampUtc && r.Action == _selectedRow.Action))
                _selectedRow = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_findDialogVisible && _focusFindInputPending && _findInputRef is not null)
        {
            _focusFindInputPending = false;
            try { await _findInputRef.FocusAsync(); } catch { }
        }
    }

    private IReadOnlyList<FlexTelemetryEventRow> BuildUnifiedWindowRows()
    {
        var snap = ActiveSnapshot;
        var baseEvents = snap?.RecentEvents ?? Array.Empty<FlexTelemetryEventRow>();
        var list = new List<FlexTelemetryEventRow>(baseEvents.Count + 64);
        list.AddRange(baseEvents);

        if (_includeSqlLogs && Services.GetService(typeof(IFlexSqlTelemetryProvider)) is IFlexSqlTelemetryProvider sqlProvider)
        {
            var nowUtc = DateTime.UtcNow;
            int daysBack = snap?.DaysBack > 0 ? snap.DaysBack : StandaloneDaysBack;
            var cutoffUtc = snap?.MinutesBack is > 0
                ? nowUtc.AddMinutes(-snap.MinutesBack.Value)
                : nowUtc.AddDays(-daysBack);

            var tenantScope = !string.IsNullOrWhiteSpace(Tenant) && !string.Equals(Tenant, "*", StringComparison.Ordinal)
                ? Tenant
                : null;

            var sqlHistory = sqlProvider.GetRecentQueries(tenant: tenantScope, excludeBackgroundPolls: true, maxCount: 500);
            var qSearch = EffectiveSearch;
            foreach (var sq in sqlHistory)
            {
                if (sq.TimestampUtc < cutoffUtc)
                    continue;
                var row = sq.ToEventRow();
                if (!string.IsNullOrWhiteSpace(qSearch) && !MatchesQuickSearch(row, qSearch))
                    continue;
                list.Add(row);
            }
        }

        list.Sort((a, b) => b.TimestampUtc.CompareTo(a.TimestampUtc));
        return list;
    }

    private static bool MatchesQuickSearch(FlexTelemetryEventRow r, string q) =>
        r.Summary.Contains(q, StringComparison.OrdinalIgnoreCase)
        || r.LogType.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
        || r.LogDate.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
        || r.UserId.Contains(q, StringComparison.OrdinalIgnoreCase)
        || r.Screen.Contains(q, StringComparison.OrdinalIgnoreCase)
        || r.Action.Contains(q, StringComparison.OrdinalIgnoreCase)
        || r.Control.Contains(q, StringComparison.OrdinalIgnoreCase)
        || r.Location.Contains(q, StringComparison.OrdinalIgnoreCase)
        || (!string.IsNullOrEmpty(r.Tag) && r.Tag.Contains(q, StringComparison.OrdinalIgnoreCase))
        || (!string.IsNullOrEmpty(r.Value) && r.Value.Contains(q, StringComparison.OrdinalIgnoreCase))
        || r.Detail.Contains(q, StringComparison.OrdinalIgnoreCase);

    private string FormatGroupHeader(string field, string key, IReadOnlyList<FlexTelemetryEventRow> items)
    {
        if (string.Equals(field, nameof(FlexTelemetryEventRow.LogDate), StringComparison.OrdinalIgnoreCase))
        {
            var dateLabel = key;
            if (DateOnly.TryParseExact(key, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
            {
                var today = DateOnly.FromDateTime(DateTime.Now);
                var rel = parsed == today
                    ? "Today · "
                    : (parsed == today.AddDays(-1) ? "Yesterday · " : string.Empty);
                dateLabel = $"{key} ({rel}{parsed.ToString("ddd, MMM d", CultureInfo.InvariantCulture)})";
            }

            int users = items
                .Select(i => i.UserId)
                .Where(u => !string.IsNullOrWhiteSpace(u) && !string.Equals(u, "(system)", StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
            int errs = items.Count(i => i.LogType.Priority == 1 || string.Equals(i.Level, "ERROR", StringComparison.OrdinalIgnoreCase));
            var errSuffix = errs > 0 ? $" · {errs} error{(errs == 1 ? "" : "s")}" : string.Empty;
            return $"{dateLabel} — {items.Count:N0} log{(items.Count == 1 ? "" : "s")} · {users} user{(users == 1 ? "" : "s")}{errSuffix}";
        }

        if (string.Equals(field, nameof(FlexTelemetryEventRow.LogType), StringComparison.OrdinalIgnoreCase))
        {
            return $"{key} — {items.Count:N0} log{(items.Count == 1 ? "" : "s")}";
        }

        return $"{key} ({items.Count:N0})";
    }

    private string? ResolveRowCssClass(FlexTelemetryEventRow row, int index)
    {
        if (_findMatchedRow is not null && ReferenceEquals(row, _findMatchedRow))
            return "fx-log-find-match";
        if (string.Equals(row.Level, "ERROR", StringComparison.OrdinalIgnoreCase))
            return "fx-log-row-error";
        return null;
    }

