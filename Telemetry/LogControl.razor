    public async Task RefreshStandaloneAsync()
    {
        var ds = ResolveDataSource();
        await ds.FlushAsync();
        BuildStandaloneSnapshot();
        RecordControlAction("Refreshed");
    }

    private void BuildStandaloneSnapshot()
    {
        var ds = ResolveDataSource();
        _standaloneSnapshot = ds.BuildSnapshot(new FlexTelemetryQueryFilter
        {
            DaysBack = StandaloneDaysBack,
            SearchText = _standaloneSearch
        });

        _standaloneHistogram.Clear();
        var clicks = new ChartSeries("Control Clicks", ChartType.StackedBar, color: EffectiveTheme == TelemetryTheme.VBClassic ? "#0a246a" : "#10b981");
        var grids = new ChartSeries("Grid Ops", ChartType.StackedBar, color: EffectiveTheme == TelemetryTheme.VBClassic ? "#3a6ea5" : "#a855f7");
        var inputs = new ChartSeries("Input Commits", ChartType.StackedBar, color: EffectiveTheme == TelemetryTheme.VBClassic ? "#2e7d32" : "#f59e0b");
        var opens = new ChartSeries("Screen Opens", ChartType.StackedBar, color: EffectiveTheme == TelemetryTheme.VBClassic ? "#8b5a00" : "#38bdf8");

        foreach (var pt in _standaloneSnapshot.TimeSeriesBuckets)
        {
            clicks.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.ButtonClicks));
            grids.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.GridOperations));
            inputs.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.ControlChanges));
            opens.DataPoints.Add(new ChartDataPoint(pt.BucketLabel, pt.ScreenOpens));
        }
        _standaloneHistogram.Add(clicks);
        _standaloneHistogram.Add(grids);
        _standaloneHistogram.Add(inputs);
        _standaloneHistogram.Add(opens);
    }

    private ITelemetryDataSource ResolveDataSource()
    {
        if (Services.GetService(typeof(ITelemetryDataSource)) is ITelemetryDataSource registered)
            return registered;

        _ownedFallbackSource ??= new DefaultFlexTelemetryDataSource(
            Services.GetService(typeof(IFlexControlLogSink)) as IFlexControlLogSink,
            Services.GetService(typeof(ITelemetryCatalogProvider)) as ITelemetryCatalogProvider);
        return _ownedFallbackSource;
    }

    public async Task ExportStructuredAsync(bool clefFormat, string filePrefix = "flexkit")
    {
        var ds = Services.GetService(typeof(ITelemetryDataSource)) as ITelemetryDataSource;
        if (ds is not null)
            await ds.FlushAsync();

        var rows = FilteredRows;
        var sb = new StringBuilder(rows.Count * 240);
        foreach (var r in rows)
            sb.AppendLine(clefFormat ? r.SerilogClefJson : r.CloudWatchJson);

        var ext = clefFormat ? "clef" : "ndjson";
        var label = clefFormat ? "serilog" : "cloudwatch";
        var fileName = $"{filePrefix}-{label}-logs-{DateTime.Now:yyyyMMdd-HHmm}.{ext}";
        await DownloadBytesAsync(Encoding.UTF8.GetBytes(sb.ToString()), fileName, "application/x-ndjson");
        RecordControlAction("ExportedLogs", label, $"rows={rows.Count}");
    }

    public async Task ExportCsvAsync(string filePrefix = "flexkit")
    {
        var rows = FilteredRows;
        var sb = new StringBuilder(rows.Count * 200 + 180);
        sb.AppendLine("Date,Time,LogType,Level,Summary,User,Division,Stream,ControlType,Action,Screen,Location,ControlId,Tag,Value,Seconds,Detail");
        foreach (var r in rows)
        {
            sb.AppendLine($"{Csv(r.LogDate.ToString())},{Csv(r.TimeText)},{Csv(r.LogType.Label)},{Csv(r.Level)},{Csv(r.Summary)},{Csv(r.UserId)},{r.DivisionId},{Csv(r.Kind)},{Csv(r.ControlType)},{Csv(r.Action)},{Csv(r.Screen)},{Csv(r.Location)},{Csv(r.Control)},{Csv(r.Tag)},{Csv(r.Value)},{Csv(r.DurationSeconds?.ToString("0.00", CultureInfo.InvariantCulture))},{Csv(r.Detail)}");
        }

        var fileName = $"{filePrefix}-log-stream-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        await DownloadBytesAsync(bytes, fileName, "text/csv");
        RecordControlAction("ExportedCsv", fileName, $"rows={rows.Count}");
    }

    private async Task DownloadBytesAsync(byte[] bytes, string fileName, string contentType)
    {
        if (Services.GetService(typeof(ITelemetryExportHandler)) is ITelemetryExportHandler handler)
        {
            await handler.ExportBytesAsync(bytes, fileName, contentType);
            return;
        }

        _browserInterop ??= new BrowserInterop(JSRuntime);
        await _browserInterop.InvokeAsync<object?>("download", null, new { bytes, name = fileName, type = contentType });
    }

    private static string PillCss(bool active) => active ? "fx-tel-pill fx-tel-pill-active" : "fx-tel-pill";

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    public async ValueTask DisposeAsync()
    {
        _ownedFallbackSource?.Dispose();
        if (_browserInterop is not null)
            await _browserInterop.DisposeAsync();
    }
