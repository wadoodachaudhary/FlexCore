    private async Task OnRootKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.CtrlKey && string.Equals(e.Key, "f", StringComparison.OrdinalIgnoreCase))
        {
            OpenFindDialog();
        }
        else if (string.Equals(e.Key, "F3", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(_findText))
        {
            await FindNextCoreAsync(searchDownOverride: !e.ShiftKey);
        }
    }

    public void OpenFindDialog(string? initialText = null)
    {
        if (!string.IsNullOrWhiteSpace(initialText))
            _findText = initialText!;

        if (_gridRef is not null)
        {
            var currentCol = _gridRef.GetCurrentColumnField();
            if (!string.IsNullOrWhiteSpace(currentCol)
                && FindFieldOptions.Any(o => string.Equals(o.Field, currentCol, StringComparison.OrdinalIgnoreCase))
                && _findField != AllColumnsField)
            {
                _findField = currentCol!;
            }
        }

        _findDialogMessage = string.Empty;
        _findDialogNoMatch = false;
        _findDialogVisible = true;
        _focusFindInputPending = true;
        RecordControlAction("FindDialogOpened", _findField);
        StateHasChanged();
    }

