    public Task<FlexTelemetryEventRow?> FindNextAsync(
        string? queryOverride = null,
        string? fieldOverride = null,
        bool? matchCaseOverride = null,
        bool? wholeWordOverride = null,
        bool? searchDownOverride = null)
    {
        if (queryOverride is not null)
            _findText = queryOverride;
        if (fieldOverride is not null)
            _findField = fieldOverride;
        if (matchCaseOverride.HasValue)
            _findMatchCase = matchCaseOverride.Value;
        if (wholeWordOverride.HasValue)
            _findMatchWholeWord = wholeWordOverride.Value;
        return FindNextCoreAsync(searchDownOverride);
    }

    private async Task<FlexTelemetryEventRow?> FindNextCoreAsync(bool? searchDownOverride = null)
    {
        if (string.IsNullOrWhiteSpace(_findText))
            return null;

        bool down = searchDownOverride ?? _findSearchDown;
        var rows = (_gridRef is not null ? _gridRef.GetFilteredRecords().ToList() : FilteredRows.ToList());
        if (rows.Count == 0)
        {
            _findDialogNoMatch = true;
            _findDialogMessage = $"No log rows in the current view to search.";
            _findStatusBanner = _findDialogMessage;
            return null;
        }

        var pattern = BuildWildcardPattern(_findText, _findMatchWholeWord);
        var matchIndices = new List<int>();
        for (int i = 0; i < rows.Count; i++)
        {
            if (RowMatchesFind(rows[i], _findField, pattern, _findMatchCase))
                matchIndices.Add(i);
        }

        if (matchIndices.Count == 0)
        {
            _findMatchedRow = null;
            _findDialogNoMatch = true;
            _findDialogMessage = $"Cannot find \"{_findText}\"";
            _findStatusBanner = _findDialogMessage;
            RecordControlAction("FindNoMatch", _findText, _findField);
            StateHasChanged();
            return null;
        }

        int currentIdx = _findCursorIndex;
        if (currentIdx < 0 && _selectedRow is not null)
            currentIdx = rows.IndexOf(_selectedRow);

        int chosenMatchOrdinal;
        if (down)
        {
            chosenMatchOrdinal = matchIndices.FindIndex(idx => idx > currentIdx);
            if (chosenMatchOrdinal < 0)
                chosenMatchOrdinal = 0; // Wrap to top
        }
        else
        {
            chosenMatchOrdinal = matchIndices.FindLastIndex(idx => idx < (currentIdx < 0 ? rows.Count : currentIdx));
            if (chosenMatchOrdinal < 0)
                chosenMatchOrdinal = matchIndices.Count - 1; // Wrap to bottom
        }

        int targetRowIdx = matchIndices[chosenMatchOrdinal];
        var matched = rows[targetRowIdx];
        _findCursorIndex = targetRowIdx;
        _findMatchedRow = matched;
        _selectedRow = matched;
        _findDialogNoMatch = false;
        _findDialogMessage = $"Match {chosenMatchOrdinal + 1} of {matchIndices.Count:N0} — {matched.LogDate} {matched.TimeText} ({matched.LogType.Label})";
        _findStatusBanner = $"Find \"{_findText}\": {chosenMatchOrdinal + 1}/{matchIndices.Count:N0}";

        if (_gridRef is not null)
        {
            if (_activeGroupColumns.Count > 0)
                await _gridRef.ExpandAllGroupAsync();
            await _gridRef.SelectAndRevealRowAsync(matched, clearExistingSelection: true);
        }

        RecordControlAction("FindMatched", _findText, $"match={chosenMatchOrdinal + 1}/{matchIndices.Count}");
        StateHasChanged();
        return matched;
    }

    private async Task ApplyFindAsGridFilterAsync()
    {
        if (string.IsNullOrWhiteSpace(_findText))
            return;

        _activeFindFilterText = _findText.Trim();
        _findCursorIndex = -1;
        var count = FilteredRows.Count;
        _findStatusBanner = $"Filtered by Find \"{_activeFindFilterText}\" ({count:N0} rows)";
        _findDialogVisible = false;
        if (_gridRef is not null && _activeGroupColumns.Count > 0)
            await _gridRef.ExpandAllGroupAsync();
        RecordControlAction("FindAppliedAsFilter", _activeFindFilterText, $"rows={count}");
    }

