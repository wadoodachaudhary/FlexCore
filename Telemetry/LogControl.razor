    private static string BuildWildcardPattern(string findText, bool wholeWord)
    {
        var trimmed = findText.Trim();
        if (wholeWord)
            return $"* {trimmed} *";
        if (trimmed.Contains('*') || trimmed.Contains('?'))
            return trimmed.StartsWith('*') || trimmed.EndsWith('*') ? trimmed : $"*{trimmed}*";
        return $"*{trimmed}*";
    }

    private static bool RowMatchesFind(FlexTelemetryEventRow row, string field, string pattern, bool matchCase)
    {
        if (string.Equals(field, AllColumnsField, StringComparison.Ordinal))
        {
            return FieldMatches(row.Summary, pattern, matchCase)
                   || FieldMatches(row.LogType.Label, pattern, matchCase)
                   || FieldMatches(row.LogDate.ToString(), pattern, matchCase)
                   || FieldMatches(row.TimeText, pattern, matchCase)
                   || FieldMatches(row.Level, pattern, matchCase)
                   || FieldMatches(row.UserId, pattern, matchCase)
                   || FieldMatches(row.Screen, pattern, matchCase)
                   || FieldMatches(row.Action, pattern, matchCase)
                   || FieldMatches(row.Control, pattern, matchCase)
                   || FieldMatches(row.Value, pattern, matchCase)
                   || FieldMatches(row.Location, pattern, matchCase)
                   || FieldMatches(row.ControlType, pattern, matchCase)
                   || FieldMatches(row.Tag, pattern, matchCase)
                   || FieldMatches(row.Detail, pattern, matchCase)
                   || FieldMatches(row.SqlStatement, pattern, matchCase);
        }

        var singleValue = field switch
        {
            nameof(FlexTelemetryEventRow.Summary) => row.Summary,
            nameof(FlexTelemetryEventRow.LogType) => row.LogType.Label,
            nameof(FlexTelemetryEventRow.LogDate) => row.LogDate.ToString(),
            nameof(FlexTelemetryEventRow.TimeText) => row.TimeText,
            nameof(FlexTelemetryEventRow.Level) => row.Level,
            nameof(FlexTelemetryEventRow.UserId) => row.UserId,
            nameof(FlexTelemetryEventRow.Screen) => row.Screen,
            nameof(FlexTelemetryEventRow.Action) => row.Action,
            nameof(FlexTelemetryEventRow.Control) => row.Control,
            nameof(FlexTelemetryEventRow.Value) => row.Value,
            nameof(FlexTelemetryEventRow.Location) => row.Location,
            nameof(FlexTelemetryEventRow.ControlType) => row.ControlType,
            nameof(FlexTelemetryEventRow.Tag) => row.Tag,
            nameof(FlexTelemetryEventRow.Detail) => row.Detail,
            _ => row.Summary
        };
        return FieldMatches(singleValue, pattern, matchCase);
    }

    private static bool FieldMatches(string? cellText, string pattern, bool matchCase)
    {
        if (string.IsNullOrEmpty(cellText))
            return false;
        var padded = " " + cellText + " ";
        return matchCase
            ? WildcardMatch(padded, pattern)
            : WildcardMatch(padded.ToUpperInvariant(), pattern.ToUpperInvariant());
    }

    private static bool WildcardMatch(string text, string pattern)
    {
        int tIdx = 0, pIdx = 0;
        int tStar = -1, pStar = -1;

        while (tIdx < text.Length)
        {
            if (pIdx < pattern.Length && (pattern[pIdx] == '?' || pattern[pIdx] == text[tIdx]))
            {
                tIdx++;
                pIdx++;
            }
            else if (pIdx < pattern.Length && pattern[pIdx] == '*')
            {
                pStar = pIdx++;
                tStar = tIdx;
            }
            else if (pStar >= 0)
            {
                pIdx = pStar + 1;
                tIdx = ++tStar;
            }
            else
            {
                return false;
            }
        }

        while (pIdx < pattern.Length && pattern[pIdx] == '*')
            pIdx++;

        return pIdx == pattern.Length;
    }

