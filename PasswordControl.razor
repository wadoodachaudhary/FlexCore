@namespace Fx.ControlKit
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable

@{
    var generation = _generation;
}
<TextBoxControl @key="_generation" @ref="_editor"
                InputType="password" Value="@_draft"
                ValueChanged="@((string? value) => HandleChangeAsync(value, generation))"
                ExistingPasswordViewable="@(!IsReplacement || _draft is not null)"
                ShowPasswordToggle="@ShowPasswordToggle"
                RevealLastTypedCharacter="@RevealLastTypedCharacter"
                PasswordRevealDurationMs="@PasswordRevealDurationMs"
                CssClass="@CssClass" Width="@Width" Placeholder="@Placeholder"
                Enabled="@Enabled" MaxLength="@MaxLength"
                UpdateOnInput="@UpdateOnInput" Uncontrolled="@Uncontrolled"
                TypingBehavior="@TypingBehavior" KeepNativeTab="@KeepNativeTab"
                AutoFocus="@AutoFocus" SelectOnFocus="@SelectOnFocus"
                OnKeyDown="@OnKeyDown" OnBlur="@OnBlur"
                ElementReferenceCaptured="@ElementReferenceCaptured"
                AdditionalAttributes="@EditorAttributes" />

@code {
    [Parameter] public PasswordBehavior Behavior { get; set; }

    /// <summary>Normal-mode value. Ignored entirely in Replacement mode, including
    /// its callback and validation expression. Do not load stored secrets just to bind this control.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>Replacement-mode draft, never the stored password. Null means unchanged;
    /// empty means an explicitly cleared replacement. Persist only a non-null replacement
    /// after validation and Save. Set null on save/discard; preserve this draft across tab remounts.</summary>
    [Parameter] public string? Replacement { get; set; }
    [Parameter] public EventCallback<string?> ReplacementChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ReplacementExpression { get; set; }

    /// <summary>Change when loading/reloading a record, even if its bound value is unchanged,
    /// to drop any uncommitted browser draft and reset the eye. Supply that record's draft separately.</summary>
    [Parameter] public object? EditSessionKey { get; set; }

    [Parameter] public bool ShowPasswordToggle { get; set; } = true;
    [Parameter] public bool RevealLastTypedCharacter { get; set; }
    [Parameter] public int PasswordRevealDurationMs { get; set; } = 1000;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool UpdateOnInput { get; set; } = true;
    [Parameter] public bool Uncontrolled { get; set; } = true;
    [Parameter] public TextBoxTypingBehavior TypingBehavior { get; set; }
    [Parameter] public bool KeepNativeTab { get; set; } = true;
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public bool SelectOnFocus { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback OnBlur { get; set; }
    [Parameter] public Action<ElementReference>? ElementReferenceCaptured { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] private EditContext? EditContext { get; set; }

    private TextBoxControl? _editor;
    private string? _draft;
    private string? _lastAgreedValue;
    private string? _lastReceivedValue;
    private bool _publishing;
    private PasswordBehavior _lastBehavior;
    private object? _lastSessionKey;
    private bool _initialized;
    private bool _disposed;
    private int _generation;
    private bool IsReplacement => Behavior == PasswordBehavior.Replacement;

    private IDictionary<string, object> EditorAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            if (AdditionalAttributes is not null)
                foreach (var attribute in AdditionalAttributes)
                    if (!string.Equals(attribute.Key, "value", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(attribute.Key, "type", StringComparison.OrdinalIgnoreCase))
                        attributes[attribute.Key] = attribute.Value;
            if (!attributes.ContainsKey("autocomplete"))
                attributes["autocomplete"] = IsReplacement ? "new-password" : "current-password";
            return attributes;
        }
    }

    protected override void OnParametersSet()
    {
        var value = IsReplacement ? Replacement : Value;
        // A cascading form render can replay the old parameters while its binding
        // callback is publishing the new draft. Wait for the actual binding echo.
        if (_publishing && Behavior == _lastBehavior && Equals(EditSessionKey, _lastSessionKey)
            && string.Equals(value, _lastReceivedValue, StringComparison.Ordinal))
            return;
        if (!_initialized || Behavior != _lastBehavior || !Equals(EditSessionKey, _lastSessionKey)
            || !string.Equals(value, _lastAgreedValue, StringComparison.Ordinal))
        {
            _generation++;
            _draft = value;
        }
        _initialized = true;
        _lastAgreedValue = value;
        _lastReceivedValue = value;
        _lastBehavior = Behavior;
        _lastSessionKey = EditSessionKey;
    }

    private async Task HandleChangeAsync(string? value, int generation)
    {
        if (_disposed || !Enabled || generation != _generation)
            return;
        if (IsReplacement && _draft is null && string.IsNullOrEmpty(value))
            return;

        _draft = value ?? "";
        _lastAgreedValue = _draft;
        var editContext = EditContext;
        var expression = IsReplacement ? ReplacementExpression : ValueExpression;
        _publishing = true;
        try
        {
            if (IsReplacement)
                await ReplacementChanged.InvokeAsync(_draft);
            else
                await ValueChanged.InvokeAsync(_draft);
        }
        finally
        {
            _publishing = false;
        }
        if (!_disposed && generation == _generation && editContext is not null && expression is not null)
            editContext.NotifyFieldChanged(FieldIdentifier.Create(expression));
    }

    public ValueTask FocusAsync(bool preventScroll = true) =>
        _editor?.FocusAsync(preventScroll) ?? ValueTask.CompletedTask;

    /// <summary>Flush before validating/saving when using ClientBuffered typing.</summary>
    public Task FlushClientBufferedValueAsync(bool requireCurrentValue = false) =>
        _editor?.FlushClientBufferedValueAsync(requireCurrentValue) ?? Task.CompletedTask;

    public void Dispose()
    {
        _disposed = true;
        _draft = null;
    }
}
