@namespace Fx.ControlKit
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Linq.Expressions
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@* FlexKit multi-line text input. Dedicated, lightweight TextArea (EditorControl is a
   rich editor — overkill for plain multi-line text). Supports two-way binding via
   @bind-Value. Renders a native <textarea> directly so the scoped .fx-textarea CSS
   applies. *@
@if (UseClassicScrollBar)
{
    <div class="@ResolvedHostCssClass" @ref="_hostElement">
        <textarea class="@ResolvedCssClass"
                  value="@EffectiveValue"
                  rows="@(Rows ?? 4)"
                  wrap="@WrapMode"
                  placeholder="@Placeholder"
                  maxlength="@MaxLength"
                  disabled="@(!Enabled)"
                  @ref="_inputElement"
                  @oninput="@InputDispatch"
                  @onchange="@ChangeDispatch"
                  @onfocus="@FocusDispatch"
                  @ondblclick="@DoubleClickDispatch"
                  @oncontextmenu="@ContextMenuDispatch"
                  @oncontextmenu:preventDefault="UseClassicContextMenu"
                  @oncontextmenu:stopPropagation="UseClassicContextMenu"></textarea>
        <div class="fx-textarea-scrollbar fx-textarea-scrollbar-vertical is-disabled" @ref="_scrollbarElement">
            <button type="button" class="fx-scrollbar-arrow fx-scrollbar-arrow-up" tabindex="-1" disabled aria-hidden="true">
                <span class="fx-scrollbar-arrow-glyph">▲</span>
            </button>
            <div class="fx-scrollbar-track">
                <div class="fx-scrollbar-thumb" style="display: none;"></div>
            </div>
            <button type="button" class="fx-scrollbar-arrow fx-scrollbar-arrow-down" tabindex="-1" disabled aria-hidden="true">
                <span class="fx-scrollbar-arrow-glyph">▼</span>
            </button>
        </div>
    </div>
}
else
{
    <textarea class="@ResolvedCssClass"
              value="@EffectiveValue"
              rows="@(Rows ?? 4)"
              wrap="@WrapMode"
              placeholder="@Placeholder"
              maxlength="@MaxLength"
              disabled="@(!Enabled)"
              @ref="_inputElement"
              @oninput="@InputDispatch"
              @onchange="@ChangeDispatch"
              @onfocus="@FocusDispatch"
              @ondblclick="@DoubleClickDispatch"
              @oncontextmenu="@ContextMenuDispatch"
              @oncontextmenu:preventDefault="UseClassicContextMenu"
              @oncontextmenu:stopPropagation="UseClassicContextMenu"></textarea>
}

@if (_showTextContextMenu)
{
    <div class="fx-text-context-backdrop"
         @onclick="CloseTextContextMenu"
         @oncontextmenu="CloseTextContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="fx-text-context-menu"
         style="@TextContextMenuStyle"
         @onclick:stopPropagation="true"
         @onmousedown:stopPropagation="true">
        @if (HasTextContextMenuItem(TextContextMenuItems.Undo))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("undo")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("undo"))">Undo</button>
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Cut))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("cut")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("cut"))">Cut</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Copy))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("copy")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("copy"))">Copy</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Paste))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("paste")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("paste"))">Paste</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Delete))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("delete")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("delete"))">Delete</button>
        }
        @if (HasAnyTextContextMenuItem(TextContextMenuItems.Cut | TextContextMenuItems.Copy | TextContextMenuItems.Paste | TextContextMenuItems.Delete)
            && HasTextContextMenuItem(TextContextMenuItems.SelectAll))
        {
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.SelectAll))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("selectAll")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("selectAll"))">Select All</button>
        }
        @if (HasAnyTextContextMenuItem(TextContextMenuItems.ReadingOrder | TextContextMenuItems.UnicodeOptions | TextContextMenuItems.Ime | TextContextMenuItems.Reconversion))
        {
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.ReadingOrder))
        {
            <button type="button"
                    class="@(_textContextMenuState.IsRightToLeft ? "is-checked" : null)"
                    disabled="@IsTextContextCommandDisabled("readingOrder")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("readingOrder"))">Right to left Reading order</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.UnicodeOptions))
        {
            <button type="button" disabled>Show Unicode control characters</button>
            <button type="button" disabled>
                <span>Insert Unicode control character</span>
                <span class="fx-text-context-arrow">&gt;</span>
            </button>
        }
        @if (HasAnyTextContextMenuItem(TextContextMenuItems.Ime | TextContextMenuItems.Reconversion))
        {
            <div class="fx-text-context-separator"></div>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Ime))
        {
            <button type="button"
                    disabled="@IsTextContextCommandDisabled("ime")"
                    @onclick="@(() => ExecuteTextContextCommandAsync("ime"))">Open IME</button>
        }
        @if (HasTextContextMenuItem(TextContextMenuItems.Reconversion))
        {
            <button type="button" disabled>Reconversion</button>
        }
    </div>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    // Accepted so @bind-Value compiles; not otherwise used (no EditForm dependency).
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public int? Rows { get; set; }
    /// <summary>Controls which native textarea scrollbars are available.</summary>
    [Parameter] public TextAreaScrollBars ScrollBars { get; set; } = TextAreaScrollBars.Auto;
    /// <summary>Enables the classic VB6-style dedicated vertical scrollbar with disabled/enabled states.</summary>
    [Parameter] public bool? ClassicScrollBar { get; set; }
    /// <summary>Commit the typed value to the parent on every keystroke (oninput) rather than
    /// only on change/blur. Set this on textareas that stay mounted while background re-renders
    /// can occur — otherwise a parent StateHasChanged mid-typing passes the stale (empty) model
    /// value back in and Blazor reverts the DOM, wiping in-progress text (the Feedback comment
    /// box lost text when the fire-and-forget Jira sync re-rendered the page).</summary>
    [Parameter] public bool UpdateOnInput { get; set; }

    /// <summary>The DOM owns the text while typing: the textarea renders its initial
    /// value ONCE and later re-renders never rewrite it. This is the fix for fast
    /// typing losing characters on a slow link — a controlled value attribute snaps
    /// the DOM back to the server's stale copy whenever a second render slips past
    /// the one-shot suppression (rendering ValueChanged receivers produce two).
    /// Re-key the component (@key) to load a different value.</summary>
    [Parameter] public bool Uncontrolled { get; set; }

    /// <summary>Same contract as TextBoxControl: ClientBuffered keeps every
    /// keystroke in the browser (input/change dispatches are stopped at the
    /// element) and commits the whole text in ONE call on blur. Enter stays a
    /// newline — the buffer intercepts no keys for a textarea.</summary>
    [Parameter] public TextBoxTypingBehavior TypingBehavior { get; set; } = TextBoxTypingBehavior.ServerBacked;

    private bool _uncontrolledInitialized;
    private string? _uncontrolledRenderedText;
    private bool _clientBufferAttached;
    private DotNetObjectReference<TextAreaControl>? _clientBufferRef;

    private bool IsDomOwned => Uncontrolled || TypingBehavior == TextBoxTypingBehavior.ClientBuffered;

    private string? EffectiveValue => IsDomOwned ? _uncontrolledRenderedText : Value;

    private bool UseClassicScrollBar =>
        ClassicScrollBar ?? (ScrollBars is TextAreaScrollBars.Vertical or TextAreaScrollBars.Both);

    protected override void OnParametersSet()
    {
        if (IsDomOwned && !_uncontrolledInitialized)
        {
            _uncontrolledInitialized = true;
            _uncontrolledRenderedText = Value;
        }
    }

    [JSInvokable]
    public Task CommitClientBufferedTypingAsync(
        string? value, string key, bool shiftKey, bool ctrlKey, bool altKey, bool metaKey)
    {
        return InvokeAsync(async () =>
        {
            if (string.Equals(key, "Escape", StringComparison.Ordinal))
                return;

            var committed = value ?? string.Empty;
            if (MaxLength is > 0 && committed.Length > MaxLength.Value)
                committed = committed[..MaxLength.Value];

            Value = committed;
            _uncontrolledRenderedText = committed;
            _uncontrolledInitialized = true;
            _suppressNextNativeInputRender = true;
            if (ValueChanged.HasDelegate)
                await ValueChanged.InvokeAsync(committed);
        });
    }

    /// <summary>
    /// When &gt; 0, Tab is captured by the editor and inserts this many
    /// spaces at the caret instead of moving focus out of the app.
    /// </summary>
    [Parameter] public int TabSpaces { get; set; }
    [Parameter] public bool ReplaceOnFirstInput { get; set; }
    [Parameter] public bool SelectAllOnDoubleClick { get; set; }
    [Parameter] public bool UseClassicContextMenu { get; set; }
    [Parameter] public TextContextMenuItems ContextMenuItems { get; set; } = TextContextMenuItems.Legacy;

    /// <summary>Bind only events that have observable behavior. A bound Blazor
    /// event crosses the SignalR circuit even when its handler is a no-op.
    /// Controlled ServerBacked textareas retain input synchronization so a parent
    /// render cannot replace in-progress text with its stale model value.</summary>
    private bool NeedsInputDispatch =>
        TypingBehavior == TextBoxTypingBehavior.ClientBuffered
        || !IsDomOwned
        || UpdateOnInput;

    private EventCallback<ChangeEventArgs> InputDispatch =>
        NeedsInputDispatch
            ? EventCallback.Factory.Create<ChangeEventArgs>(this, OnNativeInput)
            : default;

    private EventCallback<ChangeEventArgs> ChangeDispatch =>
        !UpdateOnInput && ValueChanged.HasDelegate
            ? EventCallback.Factory.Create<ChangeEventArgs>(this, OnNativeValueChanged)
            : default;

    private EventCallback<FocusEventArgs> FocusDispatch =>
        ReplaceOnFirstInput
            ? EventCallback.Factory.Create<FocusEventArgs>(this, OnInputFocus)
            : default;

    private EventCallback<MouseEventArgs> DoubleClickDispatch =>
        SelectAllOnDoubleClick
            ? EventCallback.Factory.Create<MouseEventArgs>(this, OnInputDoubleClick)
            : default;

    private EventCallback<MouseEventArgs> ContextMenuDispatch =>
        UseClassicContextMenu
            ? EventCallback.Factory.Create<MouseEventArgs>(this, OpenTextContextMenuAsync)
            : default;

    private ElementReference _inputElement;
    private ElementReference _hostElement;
    private ElementReference _scrollbarElement;
    private IJSObjectReference? _controlJsModule;
    private bool _showTextContextMenu;
    private int _textContextMenuX;
    private int _textContextMenuY;
    private TextContextMenuState _textContextMenuState = new();
    private bool _suppressNextNativeInputRender;

    protected override bool ShouldRender()
    {
        if (_suppressNextNativeInputRender)
        {
            _suppressNextNativeInputRender = false;
            return false;
        }

        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wantsClientBuffer = TypingBehavior == TextBoxTypingBehavior.ClientBuffered;
        if (wantsClientBuffer != _clientBufferAttached)
        {
            var bufModule = await GetControlJsModuleAsync();
            if (bufModule != null)
            {
                try
                {
                    if (wantsClientBuffer)
                    {
                        _clientBufferRef ??= DotNetObjectReference.Create(this);
                        // handlesNavigationKeys: false — Enter must stay a newline
                        // in a textarea; the only commit is the blur.
                        await bufModule.InvokeVoidAsync(
                            "enableClientBufferedTyping", _inputElement, _clientBufferRef, false);
                        _clientBufferAttached = true;
                    }
                    else
                    {
                        await bufModule.InvokeVoidAsync("disableClientBufferedTyping", _inputElement);
                        _clientBufferAttached = false;
                    }
                }
                catch { _clientBufferAttached = false; }
            }
        }

        if (firstRender)
        {
            if (TabSpaces > 0)
            {
                var tabModule = await GetControlJsModuleAsync();
                if (tabModule != null)
                {
                    try { await tabModule.InvokeVoidAsync("registerTabCapture", _inputElement, TabSpaces); }
                    catch { /* circuit teardown */ }
                }
            }

            if (ReplaceOnFirstInput)
            {
                var module = await GetControlJsModuleAsync();
                if (module != null)
                    await module.InvokeVoidAsync("enableReplaceOnFirstInput", _inputElement);
            }

            if (UseClassicScrollBar)
            {
                var module = await GetControlJsModuleAsync();
                if (module != null)
                {
                    try { await module.InvokeVoidAsync("registerTextAreaScrollBar", _hostElement, _inputElement, _scrollbarElement); }
                    catch { }
                }
            }
        }
        else if (UseClassicScrollBar)
        {
            var module = await GetControlJsModuleAsync();
            if (module != null)
            {
                try { await module.InvokeVoidAsync("updateTextAreaScrollBar", _inputElement); }
                catch { }
            }
        }
    }

    private string ResolvedHostCssClass =>
        string.IsNullOrWhiteSpace(CssClass)
            ? "fx-textarea-host"
            : $"fx-textarea-host {CssClass}";

    private string ResolvedCssClass
    {
        get
        {
            var scrollClass = ScrollBars switch
            {
                TextAreaScrollBars.None => "fx-textarea-scroll-none",
                TextAreaScrollBars.Horizontal => "fx-textarea-scroll-horizontal",
                TextAreaScrollBars.Vertical => "fx-textarea-scroll-vertical",
                TextAreaScrollBars.Both => "fx-textarea-scroll-both",
                _ => "fx-textarea-scroll-auto"
            };

            var baseClass = UseClassicScrollBar
                ? $"fx-textarea fx-textarea-custom-scroll {scrollClass}"
                : $"fx-textarea {scrollClass}";

            return string.IsNullOrWhiteSpace(CssClass) || UseClassicScrollBar
                ? baseClass
                : $"{baseClass} {CssClass}";
        }
    }

    private string? WrapMode =>
        ScrollBars is TextAreaScrollBars.Horizontal or TextAreaScrollBars.Both ? "off" : null;

    private async Task OnNativeInput(ChangeEventArgs e)
    {
        // Live-update callers need the parent model on each keystroke, but the
        // browser already painted the typed character. Skip this child render so
        // typing stays native-fast.
        Value = e.Value?.ToString();
        _suppressNextNativeInputRender = true;
        if (UpdateOnInput && ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnNativeValueChanged(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnInputFocus()
    {
        if (!ReplaceOnFirstInput)
            return;

        var module = await GetControlJsModuleAsync();
        if (module != null)
            await module.InvokeVoidAsync("armReplaceOnFirstInput", _inputElement);
    }

    private async Task OnInputDoubleClick()
    {
        if (!SelectAllOnDoubleClick)
            return;

        var module = await GetControlJsModuleAsync();
        if (module != null)
            await module.InvokeVoidAsync("select", _inputElement);
    }

    private async Task OpenTextContextMenuAsync(MouseEventArgs e)
    {
        if (!UseClassicContextMenu)
            return;

        var module = await GetControlJsModuleAsync();
        if (module == null)
            return;

        try
        {
            _textContextMenuState = await module.InvokeAsync<TextContextMenuState>(
                "getTextContextMenuState", _inputElement);
            var position = await module.InvokeAsync<TextContextMenuPosition>(
                "positionTextContextMenu", e.ClientX, e.ClientY);
            _textContextMenuX = (int)Math.Round(position.X);
            _textContextMenuY = (int)Math.Round(position.Y);
            _showTextContextMenu = true;
        }
        catch
        {
            _showTextContextMenu = false;
        }
    }

    private void CloseTextContextMenu() => _showTextContextMenu = false;

    private string TextContextMenuStyle => $"left:{_textContextMenuX}px;top:{_textContextMenuY}px";

    private bool HasTextContextMenuItem(TextContextMenuItems item) =>
        (ContextMenuItems & item) == item;

    private bool HasAnyTextContextMenuItem(TextContextMenuItems items) =>
        (ContextMenuItems & items) != 0;

    private bool IsTextContextCommandDisabled(string command) => command switch
    {
        "undo" => !Enabled,
        "cut" => !Enabled || !_textContextMenuState.HasSelection,
        "copy" => !_textContextMenuState.HasSelection,
        "paste" => !Enabled,
        "delete" => !Enabled || !_textContextMenuState.HasSelection,
        "selectAll" => !_textContextMenuState.HasValue || _textContextMenuState.AllSelected,
        "ime" => !Enabled,
        _ => false
    };

    private async Task ExecuteTextContextCommandAsync(string command)
    {
        _showTextContextMenu = false;
        var module = await GetControlJsModuleAsync();
        if (module == null)
            return;

        try
        {
            var result = await module.InvokeAsync<TextContextCommandResult>(
                "applyTextContextCommand", _inputElement, command);
            if (result.ValueChanged)
            {
                Value = result.Value;
                if (ValueChanged.HasDelegate)
                    await ValueChanged.InvokeAsync(Value);
            }
        }
        catch
        {
            // Browser clipboard commands are best-effort and may be blocked by policy.
        }
    }

    private async ValueTask<IJSObjectReference?> GetControlJsModuleAsync()
    {
        try
        {
            return _controlJsModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", $"./_content/{GetType().Assembly.GetName().Name}/textbox-control.js");
        }
        catch
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_clientBufferAttached && _controlJsModule != null)
        {
            try { await _controlJsModule.InvokeVoidAsync("disableClientBufferedTyping", _inputElement); }
            catch { /* circuit teardown */ }
        }
        _clientBufferRef?.Dispose();
        _clientBufferRef = null;
        if (_controlJsModule != null)
        {
            try
            {
                if (UseClassicScrollBar)
                    await _controlJsModule.InvokeVoidAsync("unregisterTextAreaScrollBar", _inputElement);
                await _controlJsModule.DisposeAsync();
            }
            catch { }
        }
    }
}
